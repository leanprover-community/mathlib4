module

public import Mathlib.Data.List.MinMax
public import Mathlib.Order.Hom.WithTopBot

import all Mathlib.Tactic.Translate.Core

@[expose] public section

namespace ToDualUnfoldBoundary

variable {α β : Type*} [Preorder α] [Preorder β]

-- These two opaque proofs hide the private auxiliary lemmas generated by `simp`.
private theorem lt_iff (f : α ↪o β) :
    ∀ a b, f.toEmbedding a < f.toEmbedding b ↔ a < b := by
  simp [lt_iff_le_not_ge, f.map_rel_iff]

private theorem lt_iff_copy (f : α ↪o β) :
    ∀ a b, f.toEmbedding a < f.toEmbedding b ↔ a < b :=
  lt_iff f

@[to_dual gtEmbedding]
def ltEmbedding (f : α ↪o β) : ((· < ·) : α → α → Prop) ↪r ((· < ·) : β → β → Prop) :=
  { f with map_rel_iff' := by exact lt_iff_copy f _ _ }

example (f : α ↪o β) : ((· > ·) : α → α → Prop) ↪r ((· > ·) : β → β → Prop) :=
  gtEmbedding f

-- The initial cleanup cannot see through opaque proofs. Expanding them later exposes real
-- private `simp` auxiliaries, which must be handled in both public and private scopes.
open Lean Meta Mathlib.Tactic Translate UnfoldBoundary in
run_meta withoutExporting do
  let src ← getConstInfo ``ltEmbedding
  let cleaned ← declUnfoldSimpAuxLemmas src
  let value := cleaned.value!
  unless !value.foldConsts false (fun n found => found || isSimpAuxLemma n) do
    throwError "initial cleanup left simp auxiliaries"
  let expanded ← deltaExpand value (allowOpaque := true) fun n =>
    (privateToUserName n).getPrefix == ``ltEmbedding ||
      (isPrivateName n && !isSimpAuxLemma n)
  unless expanded.foldConsts false (fun n found =>
      found || (isPrivateName n && isSimpAuxLemma n)) do
    throwError "proof expansion did not expose private simp auxiliaries"
  let b := ToDual.unfoldBoundaries.getState (← getEnv)
  let proof ← getConstInfo ``lt_iff_copy
  let expectedType ← b.insertBoundaries proof.type `to_dual
  for exporting in [false, true] do
    withExporting (isExporting := exporting) do
      let result ← b.insertBoundaries (proof.value! (allowOpaque := true)) `to_dual
        (some expectedType)
      unless !result.foldConsts false (fun n found => found || isSimpAuxLemma n) do
        throwError "auxiliaries remain with exporting={exporting}"
      -- Well-typed public proofs are preserved rather than unfolded indiscriminately.
      guard <| result.foldConsts false (fun n found => found || n == ``lt_iff_le_not_ge)
      check result

-- Check the duals whose failures in CI cascaded from `OrderEmbedding.ltEmbedding`.
example (f : α ↪o β) (a : α) : f.gtEmbedding a = f a :=
  OrderEmbedding.gtEmbedding_apply f a

example [WellFoundedGT β] (f : α ↪o β) : WellFoundedGT α :=
  f.wellFoundedGT

end ToDualUnfoldBoundary

-- The direct `grind` proof of `argmax_cons` must still produce this dual declaration.
example {α β : Type*} [LinearOrder β] (f : α → β) (a : α) (l : List α) :
    (a :: l).argmin f =
      Option.casesOn (l.argmin f) (some a) fun c => if f c < f a then some c else some a :=
  List.argmin_cons f a l

-- Unnecessary proof expansion used to break the inherited structure fields of this dual.
example {α β : Type*} [LE α] [LE β] (e : α ≃o β) : WithBot α ≃o WithBot β :=
  e.withBotCongr
