import Mathlib.Tactic.Simps.Generalized
import Mathlib.CategoryTheory.Limits.Shapes.Kernels
import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
import Mathlib.CategoryTheory.Limits.Shapes.Products

/-! # `simps!!` with the generalized projections registered in Mathlib -/

open CategoryTheory Limits

namespace SimpsGenMathlibTest

variable {C : Type*} [Category* C]

section Prod
variable {X Y : C} [HasBinaryProduct X Y] [HasBinaryProduct Y X]

@[simps!!]
noncomputable def braid : X ⨯ Y ≅ Y ⨯ X := prod.braiding X Y

@[simps!!]
def fan {W : C} (a : W ⟶ X) (b : W ⟶ Y) : BinaryFan X Y := BinaryFan.mk a b

@[simps!!]
noncomputable def fanIsLimit : IsLimit (BinaryFan.mk (prod.fst : X ⨯ Y ⟶ X) prod.snd) :=
  prodIsProd X Y

example : (braid (X := X) (Y := Y)).hom ≫ prod.fst = prod.snd := braid_hom_fst
example : (braid (X := X) (Y := Y)).inv ≫ prod.snd = prod.fst := braid_inv_snd
example {W : C} (a : W ⟶ X) (b : W ⟶ Y) : prod.lift a b ≫ braid.hom = prod.lift b a :=
  braid_lift_hom a b
example {W : C} (a : W ⟶ X) (b : W ⟶ Y) : (fan a b).fst = a := fan_fst a b
#guard_msgs (drop error) in #check fan_π_app
-- `prod.lift f g` unfolds to the right-hand side, which `simps!!` doesn't fold back
example {W : C} (f : W ⟶ X) (g : W ⟶ Y) : BinaryFan.IsLimit.lift fanIsLimit f g = prod.lift f g :=
  fanIsLimit_lift f g
end Prod

section Coprod
variable {X Y : C} [HasBinaryCoproduct X Y] [HasBinaryCoproduct Y X]

@[simps!!]
noncomputable def cobraid : X ⨿ Y ≅ Y ⨿ X := coprod.braiding X Y

example : coprod.inl ≫ (cobraid (X := X) (Y := Y)).hom = coprod.inr := cobraid_inl_hom
example {W : C} (a : Y ⟶ W) (b : X ⟶ W) : cobraid.hom ≫ coprod.desc a b = coprod.desc b a :=
  cobraid_hom_desc a b
end Coprod

section Pi
variable {β : Type*} [HasProductsOfShape β C] {f g : β → C}

@[simps!!]
noncomputable def toPi {W : C} (p : ∀ b, W ⟶ f b) : W ⟶ ∏ᶜ f := Pi.lift p

@[simps!!]
noncomputable def piIso (p : ∀ b, f b ≅ g b) : ∏ᶜ f ≅ ∏ᶜ g := Pi.mapIso p

example {W : C} (p : ∀ b, W ⟶ f b) (b : β) : toPi p ≫ Pi.π f b = p b := toPi_π p b
example (p : ∀ b, f b ≅ g b) (b : β) : (piIso p).hom ≫ Pi.π g b = Pi.π f b ≫ (p b).hom :=
  piIso_hom_π p b
example (p : ∀ b, f b ≅ g b) {W : C} (q : ∀ b, W ⟶ f b) :
    Pi.lift q ≫ (piIso p).hom = Pi.lift fun b => q b ≫ (p b).hom :=
  piIso_lift_hom p q
end Pi

section Sigma
variable {β : Type*} [HasCoproductsOfShape β C] {f g : β → C}

@[simps!!]
noncomputable def fromSigma {W : C} (p : ∀ b, f b ⟶ W) : ∐ f ⟶ W := Sigma.desc p

@[simps!!]
noncomputable def sigmaIso (p : ∀ b, f b ≅ g b) : ∐ f ≅ ∐ g := Sigma.mapIso p

example {W : C} (p : ∀ b, f b ⟶ W) (b : β) : Sigma.ι f b ≫ fromSigma p = p b := ι_fromSigma p b
example (p : ∀ b, f b ≅ g b) (b : β) : Sigma.ι f b ≫ (sigmaIso p).hom = (p b).hom ≫ Sigma.ι g b :=
  sigmaIso_ι_hom p b
example (p : ∀ b, f b ≅ g b) {W : C} (q : ∀ b, g b ⟶ W) :
    (sigmaIso p).hom ≫ Sigma.desc q = Sigma.desc fun b => (p b).hom ≫ q b :=
  sigmaIso_hom_desc p q
end Sigma

section PullbackCone
variable {X Y Z : C} (f : X ⟶ Z) (g : Y ⟶ Z) [HasPullback f g]

@[simps!!]
noncomputable def pbIsLimit :
    IsLimit (PullbackCone.mk (pullback.fst f g) (pullback.snd f g) pullback.condition) :=
  pullbackIsPullback f g

example {W : C} (h : W ⟶ X) (k : W ⟶ Y) (w : h ≫ f = k ≫ g) :
    PullbackCone.IsLimit.lift (pbIsLimit f g) h k w = pullback.lift h k w :=
  pbIsLimit_lift f g h k w
end PullbackCone

section Cokernel
variable [HasZeroMorphisms C] {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) [Epi f] [HasCokernel g]

@[simps!!]
noncomputable def ckIso [HasCokernel (f ≫ g)] : cokernel (f ≫ g) ≅ cokernel g :=
  cokernelEpiComp g f

example [HasCokernel (f ≫ g)] : cokernel.π (f ≫ g) ≫ (ckIso f g).hom = cokernel.π g :=
  ckIso_π_hom f g
example [HasCokernel (f ≫ g)] {W : C} (k : Z ⟶ W) (w : g ≫ k = 0) :
    (ckIso f g).hom ≫ cokernel.desc g k w = cokernel.desc (f ≫ g) k (by simp [w]) :=
  ckIso_hom_desc f g k w
-- the lemmas are about `cokernel.π`, not `coequalizer.π _ 0`, which it unfolds to
#guard_msgs (drop error) in #check ckIso_π_hom_1
end Cokernel

/-! ### Duals, from the registrations generated by `to_dual` -/

section Pushout
variable {X Y Z : C} {f : X ⟶ Y} {g : X ⟶ Z}

@[simps!!]
def cocone {W : C} (a : Y ⟶ W) (b : Z ⟶ W) (w : f ≫ a = g ≫ b) : PushoutCocone f g :=
  PushoutCocone.mk a b w

example {W : C} (a : Y ⟶ W) (b : Z ⟶ W) (w : f ≫ a = g ≫ b) : (cocone a b w).inl = a :=
  cocone_inl a b w
-- `ι` is replaced by `inl` and `inr`
#guard_msgs (drop error) in #check cocone_ι_app

variable [HasPushout f g] [HasPushout g f]

@[simps!!]
noncomputable def poSwap : pushout f g ≅ pushout g f := pushoutSymmetry f g

example : pushout.inl f g ≫ poSwap.hom = pushout.inr g f := poSwap_inl_hom
example {W : C} (a : Z ⟶ W) (b : Y ⟶ W) (w : g ≫ a = f ≫ b) :
    poSwap.hom ≫ pushout.desc a b w = pushout.desc b a w.symm :=
  poSwap_hom_desc a b w
end Pushout

/-! ### `to_dual (attr := simps!!)` -/

section ToDual
variable {X Y Z : C} {f : X ⟶ Z} {g : Y ⟶ Z} [HasPullback f g] [HasPullback g f]

/-- An isomorphism between pullbacks. -/
@[to_dual (attr := simps!!) pushoutSwap /-- An isomorphism between pushouts. -/]
noncomputable def pbSwap : pullback f g ≅ pullback g f := pullbackSymmetry f g

example : pbSwap.hom ≫ pullback.fst g f = pullback.snd f g := pbSwap_hom_fst

open Lean in
run_meta do
  for (src, tgt) in [(``pbSwap_hom_fst, ``pushoutSwap_inl_inv),
      (``pbSwap_lift_hom, ``pushoutSwap_inv_desc)]
    do
    let some tgt' := Mathlib.Tactic.Translate.findTranslationName? (← getEnv)
      Mathlib.Tactic.ToDual.data src | throwError "{src} has no translation"
    unless tgt' == tgt do throwError "{src} is translated to {tgt'}, not {tgt}"
end ToDual

end SimpsGenMathlibTest
