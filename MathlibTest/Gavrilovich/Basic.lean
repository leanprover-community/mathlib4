example : P := pt[("b", 2)]

def g₃ : P → ℕ
  | pt[("a", 1)] => 0
  | pt[("b", 2)] => 1

example : g₃ pt[("b", 2)] = 1 := rfl

example (x : P) : x = pt[("a", 1)] ∨ x = pt[("b", 2)] := by
  pt_cases x <;> simp

