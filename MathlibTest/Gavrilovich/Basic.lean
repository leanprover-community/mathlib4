/-! ## Morphisms -/

def q :=
    ⌜a   b⌝      ⌜ a=b ⌝
      ↘ ↙    ⇢      ↓
    ⌞  c  ⌟      ⌞  c  ⌟

/-- info: q.{u_1} : ⌜a → c ← b⌟ ⟶ ⌜a=b → c⌟ -/
#guard_msgs in
#check q

/-- info: [(a, a=b), (b, a=b), (c, c)] -/
#guard_msgs in
#eval (Space.all.map fun x => (x, q.{0} x))

def toPt : ⌜a  b⌟ ⟶ ⌜a=b⌟ := ⌜a  b⌟ ⇢ ⌜a=b⌟       -- one-row morphism, used as a term
def collapse : ⌜a → b⌟ ⟶ ⌜a=b⌟ := ⌜a → b⌟ ⇢ ⌜a=b⌟
def incl : ⌜a⌟ ⟶ ⌜a → b⌟ := ⌜a⌟ ⇢ ⌜a → b⌟

/-- info: incl ≫ collapse : ⌜a⌟ ⟶ ⌜a=b⌟ -/
#guard_msgs in
#check incl ≫ collapse                 -- labels match: composes

/-- info: a=b -/
#guard_msgs in
#eval (incl.{0} ≫ collapse) pt(a)

-- the box types are honest arguments: ordinary Lean around single-row boxes still works
example : ⌜a⌟ → Prop := fun _ => True

/-! ## Morphisms to and from terms -/

section
variable (X : TopCat) (x : X)

def f₁ :
    ⌜a   b⌝
      ↘ ↙    ⇢ X
    ⌞  c  ⌟      := TopCat.ofHom (.const _ x)

/-- info: f₁.{u_1} (X : TopCat) (x : ↑X) : ⌜a → c ← b⌟ ⟶ X -/
#guard_msgs in
#check f₁

example :
                ⌜a⌝
  TopCat.of ℕ ⇠  ↓
                ⌞b⌟ := TopCat.ofHom ⟨fun _ => 0, continuous_const⟩

example :
                ⌜a⌝
  TopCat.of ℕ ⇢  ↓
                ⌞b⌟ := TopCat.ofHom ⟨fun _ => pt(a), continuous_const⟩

example :
    ⌜a⌝
     ↓   ⇢ TopCat.of (ULift Bool)
    ⌞b⌟ := TopCat.ofHom ⟨fun _ => ⟨true⟩, continuous_const⟩

-- after the last box, `⇢` is notation for `⟶`
example : ⌜a  b⌟ ⇢ X := TopCat.ofHom (.const _ x)
example : X ⇢ ⌜a  b⌟ := TopCat.ofHom ⟨fun _ => pt(a), continuous_const⟩
example :
    ⌜a⌝
     ↓
    ⌞b⌟ ⇢ X := TopCat.ofHom (.const _ x)

end

/-! ## Maps by pattern matching -/

def g : ⌜o → c⌟ → ℕ
  | pt(o) => 1
  | pt(c) => 2

example : g pt(o) = 1 := rfl
example : g pt(c) = 2 := rfl

-- glued points can be matched by any of their names
def g₂ : ⌜a=b → c⌟ → Bool
  | pt(b) => true
  | pt(c) => false

-- a continuous map, with continuity (= monotonicity) by `decide`. (With `TopCat.ofHom`, the
-- domain of the function would be `WithUpperSet (Pts …)`, which `Space` unfolds to.)
def collapse₂ : ⌜a → b  c⌟ ⟶ ⌜o → c⌟ :=
  ConcreteCategory.ofHom ⟨fun | pt(a) => pt(o) | pt(b) => pt(c) | pt(c) => pt(c),
    Topology.IsUpperSet.monotone_iff_continuous.1 (by unfold Monotone; gav_decide)⟩

example : collapse₂ pt(b) = pt(c) := rfl

-- `Space.hom` checks continuity automatically
def collapse₃ : ⌜a → b  c⌟ ⟶ ⌜o → c⌟ :=
  Space.hom fun | pt(a) => pt(o) | pt(b) => pt(c) | pt(c) => pt(c)

example : collapse₃ = collapse₂ := rfl
-- values at points are computed by `rfl` or `gav_decide`
example : collapse₃ pt(a) = pt(o) := rfl
example (x) : collapse₃ x = pt(o) ↔ x = pt(a) := by revert x; gav_decide
example (f : ⌜a⌟ → ⌜b⌟) (h) (x) : Space.hom.{0} f h x = f x := by simp

/-! ## Case splits and `simp`

Points are kept in the canonical form `Space.mk ⟨k, _⟩`, printed as `pt(…)`: `fin_cases` and
`pt_cases` produce it and `simp` normalizes `pt(…)` to it, so the equation lemmas of definitions
by pattern matching, and diagram morphisms, evaluate under `simp`. -/

/--
info: def g.{u_1} : ⌜o → c⌟ → ℕ :=
fun x =>
  match x with
  | pt(o) => 1
  | pt(c) => 2
-/
#guard_msgs in
#print g

example : g pt(o) = 1 := by simp [g]

example (x : ⌜o → c⌟) : g x ≤ 2 := by
  fin_cases x <;> simp [g]

example (x : Space.{0} [["c"], ["o"]] [(1, 0)]) (hx : x ∈ Space.all) : g x ≤ 2 := by
  pt_cases hx <;> simp [g]

example (x : ⌜a → b  c⌟) : collapse₃ x = pt(o) ∨ collapse₃ x = pt(c) := by
  pt_cases x <;> simp [collapse₃]

example : q pt(b) = pt(a) := rfl
example : (q pt(c) : ⌜a=b → c⌟) = pt(c) := rfl

example (x : ⌜a  b  c⌟) : x = pt(a) ∨ x = pt(b) ∨ x = pt(c) := by
  pt_cases x <;> simp

-- distinct points are distinct
example : (pt(c) : ⌜o → c⌟) ≠ pt(o) := by simp
example (x : ⌜o → c⌟) (hx : x = pt(o)) : g x = 1 := by
  pt_cases x <;> simp_all [g]

/-! `pt_cases h` on `h : x ≤ y` or `h : x ⤳ y` leaves one goal per specialization. -/

/--
trace: case «0».«0»
P : ⌜o → c⌟ → ⌜o → c⌟ → Prop
⊢ P pt(c) pt(c)

case «1».«0»
P : ⌜o → c⌟ → ⌜o → c⌟ → Prop
⊢ P pt(o) pt(c)

case «1».«1»
P : ⌜o → c⌟ → ⌜o → c⌟ → Prop
⊢ P pt(o) pt(o)
---
warning: declaration uses `sorry`
-/
#guard_msgs in
example (P : ⌜o → c⌟ → ⌜o → c⌟ → Prop) : ∀ x y : ⌜o → c⌟, x ⤳ y → P x y := by
  rintro _ _ h
  pt_cases h
  trace_state
  all_goals sorry

example {X : Type} [TopologicalSpace X] (f : ⌜a → b ← c⌟ → X) (hab : f pt(a) ⤳ f pt(b))
    (hcb : f pt(c) ⤳ f pt(b)) (x y : ⌜a → b ← c⌟) (h : x ⤳ y) : f x ⤳ f y := by
  pt_cases h
  all_goals first | rfl | assumption

-- only the variable side is split on
example (y : ⌜a → b ← c⌟) (h : y ≤ pt(b)) : y = pt(b) := by
  pt_cases h; rfl

-- a false `h` closes the goal
example (h : (pt(o) : ⌜o → c⌟) ≤ pt(c)) : False := by
  pt_cases h

-- hypotheses depending on the points are kept
example (x y : ⌜a → b⌟) (hx : x ≠ pt(b)) (h : x ≤ y) (hy : y = pt(a)) : x = y := by
  pt_cases h <;> simp_all

/-! ## `simp` lemmas about points

As a term, `pt(o)` elaborates to the canonical form `Space.mk k _` of the point, which is what `simp`
works with (and what `pt_cases` produces), so lemmas stated with `pt(o)` are plain `@[simp]`
lemmas, and hypotheses can be used as they are. -/

def swap : ⌜o ↔ c⌟ ⟶ ⌜a ↔ b⌟ := Space.hom fun | pt(o) => pt(b) | pt(c) => pt(a)

@[simp] lemma swap_o : swap pt(o) = pt(b) := rfl
@[simp] lemma swap_c : swap pt(c) = pt(a) := rfl

example : swap pt(o) = pt(b) := by simp only [swap_o]
example (z) : swap z = pt(a) ∨ swap z = pt(b) := by
  pt_cases z <;> simp

-- the equation of a `match` on points has the constructor `⟨⟨k, _⟩⟩` on its right-hand side, which
-- `simp` rewrites to the canonical form (`Space.reducePtsMk`)
set_option linter.unusedSimpArgs false in
example (y₁ : (⌜o → c⌟ : TopCat.{0})) (hy : y₁ = pt(o)) (P : Prop) (hP : P) :
    ∃ z : (⌜o → c⌟ : TopCat.{0}), z ⤳ pt(o) ∧ P := by
  match h₁ : y₁ with
  | pt(c) => simp at hy
  | pt(o) =>
    use y₁
    fail_if_success (simp [h₁, hP, specializes_refl, -Space.reducePtsMk]; done)
    simp [h₁, hP, specializes_refl]

-- hypotheses
example (g : ⌜o → c⌟ → ℕ) (hg : g pt(o) = 3) : g pt(o) + 1 = 4 := by
  simp [hg]
example (g : ⌜o → c⌟ → ℕ) (hg : g pt(o) = 3) (x : ⌜o → c⌟) (hx : x ≠ pt(c)) : g x = 3 := by
  pt_cases x
  · simp at hx
  · rw [hg]
example (g : ℕ → ⌜o → c⌟ → ℕ) (hg : ∀ n, g n pt(o) = n) : g 2 pt(o) + g 3 pt(o) = 5 := by
  simp [hg]

-- the space can be found later in elaboration
example : (pt(o), pt(c)) = ((pt(o) : ⌜o → c⌟), (pt(c) : ⌜o → c⌟)) := rfl
example : ∀ x ∈ [pt(o), pt(c)], (x : ⌜o → c⌟) = pt(o) ∨ x = pt(c) := by simp

/--
error: can't tell which space the point 'o' is in; use a type ascription, e.g. `(pt(o) : ⌜o → c⌟)`
-/
#guard_msgs (error) in #check pt(o)

/-! `simp` also rewrites `Space.pt n _`, written out, to the canonical form, so a lemma about it
should be `@[simp_pt]`, which restates it with the canonical form; `simp_pt% foo` restates `foo`
in the same way. -/

@[simp_pt] lemma swap_o' : swap (Space.pt "o") = Space.pt "b" := rfl

example : swap pt(o) = pt(b) := by simp only [swap_o'_mk]

-- a plain `@[simp]` lemma doesn't fire
@[simp] lemma swap_o'' : swap (Space.pt "o") = Space.pt "b" := rfl

/--
error: unsolved goals
⊢ (ConcreteCategory.hom swap) pt(o) = pt(b)
---
warning: This simp argument is unused:
  swap_o''

Hint: Omit it from the simp argument list.
  [apply] simp only

Note: This linter can be disabled with `set_option linter.unusedSimpArgs false`
-/
#guard_msgs in
example : swap pt(o) = pt(b) := by simp only [swap_o'']

example : swap pt(o) = pt(b) := by simp only [simp_pt% swap_o'']

/--
error: `simp_pt` made no progress on
  (ConcreteCategory.hom swap) pt(c) = pt(a)
Use `@[simp]` instead.
-/
#guard_msgs in
@[simp_pt] lemma swap_c' : swap pt(c) = pt(a) := rfl

/--
error: `simp_pt%` made no progress on
  ∀ (n m : ℕ), n + m = m + n
-/
#guard_msgs in #check simp_pt% Nat.add_comm

/--
error: `simp_pt%` expects a proof, but
  ℕ
is not one
-/
#guard_msgs in #check simp_pt% ℕ

