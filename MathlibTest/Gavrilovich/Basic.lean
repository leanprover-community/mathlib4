/-! ## Morphisms relabelled to their expected type -/

def toSierpinski : ⌜a  b⌟ ⟶ ⌜o → c⌟ := ⌜x(=a)  y(=b)⌟ ⇢ ⌜x(=o) → y(=c)⌟
example : toSierpinski pt(a) = pt(o) := rfl
example : toSierpinski pt(b) = pt(c) := rfl

-- the other choice
def toSierpinski' : ⌜a  b⌟ ⟶ ⌜o → c⌟ := ⌜x(=b)  y(=a)⌟ ⇢ ⌜x → y⌟
example : toSierpinski' pt(b) = pt(o) := rfl

-- spaces can be named
abbrev Sierpinski := ⌜o → c⌟
def Discrete2 := ⌜a  b⌟
def toSierpinski'' : Discrete2 ⟶ Sierpinski := ⌜x(=a)  y(=b)⌟ ⇢ ⌜x → y⌟

/--
error: this morphism can be relabelled to have type
  ⌜a  b⌟ ⟶ ⌜o → c⌟
in more than one way, giving different maps. Choose one by ascribing names in that type to points, e.g. x(=a), y(=b) in the source box
-/
#guard_msgs in
example : ⌜a  b⌟ ⟶ ⌜o → c⌟ := ⌜x  y⌟ ⇢ ⌜x → y⌟

/--
error: this box doesn't have the shape of
  ⌜a → b⌟
so the morphism can't be relabelled to have type
  ⌜a → b⌟ ⟶ ⌜o → c⌟
-/
#guard_msgs in
example : ⌜a → b⌟ ⟶ ⌜o → c⌟ := ⌜x  y⌟ ⇢ ⌜x → y⌟

-- a point goes where any of its names is found
/-- info: (⌜a=x  b⌟ ⇢ ⌜a → b⌟) : ⌜a=x  b⌟ ⟶ ⌜a → b⌟ -/
#guard_msgs in
#check ⌜x=a  b⌟ ⇢ ⌜a → b⌟

/-! ## Printing morphisms -/

/-- info: (⌜o → c⌟ ⇢ ⌜c ↔ o⌟) : ⌜o → c⌟ ⟶ ⌜c ↔ o⌟ -/
#guard_msgs in
#check ⌜o → c⌟ ⇢ ⌜o ↔ c⌟

/-- info: (⌜a → c ← b⌟ ⇢ ⌜a=b → c⌟) : ⌜a → c ← b⌟ ⟶ ⌜a=b → c⌟ -/
#guard_msgs in
#check
    ⌜a   b⌝      ⌜ a=b ⌝
      ↘ ↙    ⇢      ↓
    ⌞  c  ⌟      ⌞  c  ⌟

/-- info: fun f => (⌜o⌟ ⇢ ⌜o → c⌟) ≫ f : (⌜o → c⌟ ⟶ ⌜p⌟) → (⌜o⌟ ⟶ ⌜p⌟) -/
#guard_msgs in
#check fun (f : ⌜o → c⌟ ⟶ ⌜p⌟) => (⌜o⌟ ⇢ ⌜o → c⌟) ≫ f

-- target points are labelled by the source points that go to them, with their own names ascribed
-- where they differ, which elaborates back (without needing the type)
/-- info: (⌜a  b⌟ ⇢ ⌜a(=o) → b(=c)⌟) : ⌜a  b⌟ ⟶ ⌜o → c⌟ -/
#guard_msgs in
#check (⌜x(=a)  y(=b)⌟ ⇢ ⌜x → y⌟ : ⌜a  b⌟ ⟶ ⌜o → c⌟)

example : (⌜a  b⌟ ⇢ ⌜a(=o) → b(=c)⌟) = (⌜x(=a)  y(=b)⌟ ⇢ ⌜x → y⌟ : ⌜a  b⌟ ⟶ ⌜o → c⌟) := rfl

/-- info: (⌜o → c⌟ ⇢ ⌜c=o(=p)⌟) : ⌜o → c⌟ ⟶ ⌜p⌟ -/
#guard_msgs in
#check (⌜x → y⌟ ⇢ ⌜x=y⌟ : ⌜o → c⌟ ⟶ ⌜p⌟)

/-- info: (⌜x⌟ ⇢ ⌜x(=a)  b⌟) : ⌜x⌟ ⟶ ⌜a  b⌟ -/
#guard_msgs in
#check (⌜a⌟ ⇢ ⌜a  b⌟ : ⌜x⌟ ⟶ ⌜a  b⌟)

-- ascriptions `(=…)` give the names in the space, so no expected type is needed
/-- info: (⌜a  b⌟ ⇢ ⌜a(=o) → b(=c)⌟) : ⌜a  b⌟ ⟶ ⌜o → c⌟ -/
#guard_msgs in
#check ⌜a  b⌟ ⇢ ⌜a(=o) → b(=c)⌟

/-- info: (⌜a  b⌟ ⇢ ⌜a(=x) → b(=y)⌟) : ⌜a  b⌟ ⟶ ⌜x → y⌟ -/
#guard_msgs in
#check ⌜x(=a)  y(=b)⌟ ⇢ ⌜x → y⌟

-- the names in ascriptions don't match anything
/-- error: no point named 'a' in the target box -/
#guard_msgs in
#check ⌜a⌟ ⇢ ⌜x(=a)⌟

-- several names, in one ascription or several, and product names
/-- info: (⌜a  b⌟ ⇢ ⌜a=b(=o=p)⌟) : ⌜a  b⌟ ⟶ ⌜o=p⌟ -/
#guard_msgs in
#check ⌜a  b⌟ ⇢ ⌜b=a(=p)(=o)⌟

/-- info: (⌜a⌟ ⇢ ⌜a(=(a,c))⌟) : ⌜a⌟ ⟶ ⌜(a,c)⌟ -/
#guard_msgs in
#check ⌜a⌟ ⇢ ⌜a(=(a,c))⌟

example : (⌜(a,c)⌟ ⇢ ⌜(a,c)(=o)⌟) = (⌜x⌟ ⇢ ⌜x⌟ : ⌜(a,c)⌟ ⟶ ⌜o⌟) := rfl

-- a name can be the name of one point, and match another
/-- info: (⌜a  b⌟ ⇢ ⌜b(=a)  a(=b)⌟) : ⌜a  b⌟ ⟶ ⌜a  b⌟ -/
#guard_msgs in
#check (Space.homOfTable [1, 0] (by decide) (by decide) : ⌜a  b⌟ ⟶ ⌜a  b⌟)

example : (⌜a  b⌟ ⇢ ⌜b(=a)  a(=b)⌟) = Space.homOfTable [1, 0] (by decide) (by decide) := rfl

-- in a box relabelled to the expected type, a plain name can be ascribed to another point
/-- info: (⌜a  b⌟ ⇢ ⌜a(=b) → b(=c)⌟) : ⌜a  b⌟ ⟶ ⌜b → c⌟ -/
#guard_msgs in
#check (⌜a  b⌟ ⇢ ⌜a(=b) → b(=c)⌟ : _ ⟶ ⌜b → c⌟)

/--
info: (⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ ⇢ ⌜o₀(=o₁) → c₀(=c₁) ← o₁(=o₂) → c₁=o₂(=c₂)⌟) : ⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ ⟶ ⌜o₁ → c₁ ← o₂ → c₂⌟
-/
#guard_msgs in
#check (⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ ⇢ ⌜o₀ → c₀ ← o₁(=o₂) → c₁=o₂(=c₂)⌟ : _ ⟶ ⌜o₁ → c₁ ← o₂ → c₂⌟)

-- once there is an ascription, plain names in the target box only match points (whatever their
-- names in the target space), so the ascription `(=c₂)` above can be left out
example : (⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ ⇢ ⌜o₀ → c₀ ← o₁(=o₂) → c₁=o₂⌟ : _ ⟶ ⌜o₁ → c₁ ← o₂ → c₂⌟) =
    ⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ ⇢ ⌜o₀(=o₁) → c₀(=c₁) ← o₁(=o₂) → c₁=o₂(=c₂)⌟ := rfl

-- without ascriptions, names in the target space choose the relabelling as well as they can
example : (⌜a  b⌟ ⇢ ⌜a=o → b=c⌟ : _ ⟶ ⌜o → c⌟) = ⌜a  b⌟ ⇢ ⌜a(=o) → b(=c)⌟ := rfl
example : (⌜a  b⌟ ⇢ ⌜b=x  a=y⌟ : _ ⟶ ⌜x  y⌟) = ⌜a  b⌟ ⇢ ⌜b(=x)  a(=y)⌟ := rfl
example : (⌜x  y⌟ ⇢ ⌜o → c=x=y⌟ : _ ⟶ ⌜o → c⌟) = ⌜x  y⌟ ⇢ ⌜_(=o) → x=y(=c)⌟ := rfl

-- the printer ascribes more names where plain ones would leave a choice
/-- info: (⌜a  b  c  d⌟ ⇢ ⌜a(=a)  b  _(=c)  c=d(=d)⌟) : ⌜a  b  c  d⌟ ⟶ ⌜a  b  c  d⌟ -/
#guard_msgs in
#check (Space.homOfTable [0, 1, 3, 3] (by decide) (by decide) : ⌜a  b  c  d⌟ ⟶ ⌜a  b  c  d⌟)

example : (⌜a  b  c  d⌟ ⇢ ⌜a(=a)  b  _(=c)  c=d(=d)⌟ : _ ⟶ ⌜a  b  c  d⌟) =
    Space.homOfTable [0, 1, 3, 3] (by decide) (by decide) := rfl

-- `_` matches nothing, for a point that nothing goes to
/-- info: (⌜b⌟ ⇢ ⌜b(=a) → _(=b)⌟) : ⌜b⌟ ⟶ ⌜a → b⌟ -/
#guard_msgs in
#check (Space.homOfTable [0] (by decide) (by decide) : ⌜b⌟ ⟶ ⌜a → b⌟)

/-- info: (⌜a  b⌟ ⇢ ⌜_(=a)  _(=b)  a=b(=c)⌟) : ⌜a  b⌟ ⟶ ⌜a  b  c⌟ -/
#guard_msgs in
#check ⌜a  b⌟ ⇢ ⌜a=b(=c)  _(=a)  _(=b)⌟

/-! ## Holes -/

-- a bare `_` matches nothing, and is named by the expected type, so there can be several
example : ⌜a⌟ ⟶ ⌜o₁ → c ← o₂⌟ := ⌜a⌟ ⇢ ⌜_ → a ← _⌟

/-- info: (⌜a⌟ ⇢ ⌜o₁ → a(=c) ← o₂⌟) : ⌜a⌟ ⟶ ⌜o₁ → c ← o₂⌟ -/
#guard_msgs in
#check (⌜a⌟ ⇢ ⌜_ → a ← _⌟ : _ ⟶ ⌜o₁ → c ← o₂⌟)

example : (⌜a⌟ ⇢ ⌜_ → a ← _⌟ : _ ⟶ ⌜o₁ → c ← o₂⌟) = ⌜a⌟ ⇢ ⌜_(=o₁) → a(=c) ← _(=o₂)⌟ := rfl

-- the holes are relabelled with the rest of the box, which ascriptions pin down
example : (⌜o₁ → c ← o₂⌟ ⇢ ⌜o₁(=o₀) → c ← o₂(=o₁) → _ ← _⌟ : _ ⟶ ⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟) =
    ⌜o₁ → c ← o₂⌟ ⇢ ⌜o₁(=o₀) → c(=c₀) ← o₂(=o₁) → _(=c₁) ← _(=o₂)⌟ := rfl

/--
error: this morphism can be relabelled to have type
  ⌜o₁ → c ← o₂⌟ ⟶ ⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟
in more than one way, giving different maps. Choose one by ascribing names in that type to points, e.g. _(=c₀), _(=o₀), c(=c₁), o₁(=o₂), o₂(=o₁) in the target box
-/
#guard_msgs in
example : ⌜o₁ → c ← o₂⌟ ⟶ ⌜o₀ → c₀ ← o₁ → c₁ ← o₂⌟ := ⌜o₁ → c ← o₂⌟ ⇢ ⌜o₁ → c ← o₂ → _ ← _⌟

/-! ## Printing multi-row spaces -/

/-- The diamond, written out. -/
abbrev diamond := Space [["a"], ["b"], ["c"], ["d"]] [(0, 1), (0, 2), (0, 3), (1, 3), (2, 3)]

-- the printed diagram elaborates back
example : diamond =
    ⌜  a  ⌝
      ↙ ↘
     b   c
      ↘ ↙
    ⌞  d  ⌟ := rfl

-- arrows into a narrow label get more room
/--
info: fun x => x : ⏎
      ⌜a  b  c⌝
        ↘ ↓ ↙
      ⏎
      ⌞   d   ⌟ →
      ⌜a  b  c⌝
        ↘ ↓ ↙
      ⏎
      ⌞   d   ⌟
-/
#guard_msgs in
#check fun x : Space [["a"], ["b"], ["c"], ["d"]] [(0, 3), (1, 3), (2, 3)] => x

/--
info: fun x => x : ⏎
      ⌜   a   ⌝
          ↓
        ↙   ↘
      ⌞c  b  d⌟ →
      ⌜   a   ⌝
          ↓
        ↙   ↘
      ⌞c  b  d⌟
-/
#guard_msgs in
#check fun x : Space [["a"], ["b"], ["c"], ["d"]] [(0, 1), (0, 2), (0, 3)] => x

-- morphisms, with multi-row boxes if necessary
/--
info: (
    ⌜  a  ⌝ ⇢ ⌜a → b=c → d⌟
      ↙ ↘
     b   c
      ↘ ↙
    ⌞  d  ⌟) : ⏎
      ⌜  a  ⌝
        ↙ ↘
       b   c
        ↘ ↙
      ⌞  d  ⌟ ⟶
  ⌜a → b=c → d⌟
-/
#guard_msgs in
#check (Space.homOfTable [0, 1, 1, 2] (by decide) (by decide) : diamond ⟶ ⌜a → b=c → d⌟)

/--
info: (
    ⌜  a  ⌝   ⌜  a  ⌝
      ↙ ↘       ↙ ↘
     b   c  ⇢  b   c
      ↘ ↙       ↘ ↙
    ⌞  d  ⌟   ⌞  d  ⌟) : ⏎
      ⌜  a  ⌝
        ↙ ↘
       b   c
        ↘ ↙
      ⌞  d  ⌟ ⟶
      ⌜  a  ⌝
        ↙ ↘
       b   c
        ↘ ↙
      ⌞  d  ⌟
-/
#guard_msgs in
#check (Space.homOfTable [0, 1, 2, 3] (by decide) (by decide) : diamond ⟶ diamond)

-- a label has room for only three arrows down, so this has no diagram
/--
info: fun x =>
  x : ↑(Space [["a"], ["b"], ["c"], ["d"], ["e"]] [(0, 1), (0, 2), (0, 3), (0, 4)]) →
  ↑(Space [["a"], ["b"], ["c"], ["d"], ["e"]] [(0, 1), (0, 2), (0, 3), (0, 4)])
-/
#guard_msgs in
#check fun x : Space [["a"], ["b"], ["c"], ["d"], ["e"]] [(0, 1), (0, 2), (0, 3), (0, 4)] => x

/-! ## Relabelling to an expected type that is only known later -/

-- a side of `=` is elaborated without an expected type at first
example {X : TopCat} (χ : ⌜x  y⌟ ⟶ X) (e : X ⟶ ⌜T → F⌟) (h : χ ≫ e = ⌜x  y⌟ ⇢ ⌜x → y⌟) :
    χ ≫ e = (⌜x  y⌟ ⇢ ⌜x(=T) → y(=F)⌟ : ⌜x  y⌟ ⟶ ⌜T → F⌟) := h
example {X : TopCat} (χ : ⌜x  y⌟ ⟶ X) (e : X ⟶ ⌜T → F⌟) (h : ⌜x  y⌟ ⇢ ⌜x → y⌟ = χ ≫ e) :
    (⌜x  y⌟ ⇢ ⌜x(=T) → y(=F)⌟ : ⌜x  y⌟ ⟶ ⌜T → F⌟) = χ ≫ e := h

-- the target of `d` in `d ≫ f` is fixed by `f`
example {X : TopCat} (f : ⌜T → F⌟ ⟶ X) : ⌜a⌟ ⟶ X := (⌜a⌟ ⇢ ⌜a → b⌟) ≫ f

/-! ## Points whose index isn't a numeral -/

-- printed as points
/-- info: pt(x) : ⌜x  y⌟ -/
#guard_msgs in
#check (Space.mk (Zero.zero : ℕ) (by decide) : ⌜x  y⌟)

/-- info: pt(x) : ⌜x  y⌟ -/
#guard_msgs in
#check (Space.mk Nat.zero (by decide) : ⌜x  y⌟)

-- and normalized by `simp`
example (z : ⌜x  y⌟) (h : (Space.mk (Zero.zero : ℕ) (by decide) : ⌜x  y⌟) = z) :
    pt(x) = z := by
  simpa using h

/-! `simp` unfolds the type of points `↑(Space L E)` in binders to `WithLowerSet (Pts L E)`, which is
still printed as the diagram. -/

/--
trace: P : ⌜o → c⌟ → Prop
h : ∀ (x : ⌜o → c⌟), P x
⊢ P pt(o)
-/
#guard_msgs in
example (P : ⌜o → c⌟ → Prop) (h : ∀ x : ⌜o → c⌟, P x ∧ True) : P pt(o) := by
  simp at h
  trace_state
  exact h _

/-! ## Type ascriptions inside a block

A multi-row diagram takes up whole lines, so `(d : A ⟶ B)` can be written as one block, with
` : ` separating the diagram from its type. -/

/--
info: (⌜o₁ → c ← o₂⌟ ⇢ ⌜o₁ → c ← o₂⌟) : ⌜o₁ → c ← o₂⌟ ⟶ ⌜o₁ → c ← o₂⌟
-/
#guard_msgs in
#check
    (⌜       ⌝     ⌜       ⌝     ⌜       ⌝     ⌜       ⌝
      o₁   o₂   ⇢   o₁   o₂   :   o₁   o₂   ⟶   o₁   o₂
        ↘ ↙           ↘ ↙           ↘ ↙           ↘ ↙
     ⌞   c   ⌟     ⌞   c   ⌟     ⌞   c   ⌟     ⌞   c   ⌟)

/-- info: ⌜o₁ → c ← o₂⌟ : TopCat -/
#guard_msgs in
#check
    (⌜       ⌝
      o₁   o₂   :  TopCat
        ↘ ↙
     ⌞   c   ⌟)


-- `⟶` between boxes is a type of morphisms, also without an ascription
/-- info: ⌜o₁ → c ← o₂⌟ ⟶ ⌜o₁ → c ← o₂⌟ : Type u_1 -/
#guard_msgs in
#check
    (⌜       ⌝     ⌜       ⌝
      o₁   o₂   ⟶   o₁   o₂
        ↘ ↙           ↘ ↙
     ⌞   c   ⌟     ⌞   c   ⌟)

/-! ## Universes

`D.{u}` puts the spaces of the diagram `D` in the universe `u`, for spaces, morphisms and types of
morphisms alike. -/

section Universes
universe u v

example : ⌜a  b⌟.{u} = (⌜a  b⌟ : TopCat.{u}) := rfl

example : ⌜a  b⌟.{u} = Space.{u} [["a"], ["b"]] [] := rfl

-- a morphism, whose elaboration waits for its expected type
set_option pp.universes true in
/-- info: (⌜a  b⌟ ⇢ ⌜a=b=x  y⌟) : Quiver.Hom.{u, u + 1} ⌜a  b⌟ ⌜a=b=x  y⌟ -/
#guard_msgs in
#check (⌜a  b⌟ ⇢ ⌜a=b=x  y⌟.{u})

set_option pp.universes true in
/-- info: fun X => Quiver.Hom.{u, u + 1} ⌜a  b⌟ X : TopCat.{u} → Type u -/
#guard_msgs in
#check fun X ↦ ⌜a  b⌟.{u} ⇢ X

-- the universe that `Equiv.prodComm` can't infer
example : Equiv.Perm (⌜o → c⌟.{u} × ⌜o → c⌟.{u}) := Equiv.prodComm _ _

-- multi-row: after the last `⌟`
example :
    ⌜a   b⌝
      ↘ ↙
    ⌞  c  ⌟.{u} = (⌜a → c ← b⌟ : TopCat.{u}) := rfl

/--
error: Type mismatch
  ⌜a  b⌟
has type
  TopCat.{u}
of sort `Type (u + 1)` but is expected to have type
  TopCat.{v}
of sort `Type (v + 1)`
-/
#guard_msgs in
example : TopCat.{v} := ⌜a  b⌟.{u}

end Universes

/-! ## Box-drawing glyphs

The same diagram, in glyphs that are one column wide in more fonts: box-drawing corners, headless
edges pointing down the page, and drawn connectives (`╌╌→` for morphisms, `──→` for types). -/

namespace BoxDrawing

def cur :=
    (⌜       ⌝     ⌜       T         ⌝     ⌜       ⌝     ⌜   T   ⌝
                          ↙ ↘                               ↙ ↘
      o₁   o₂   ⇢   o₁(=TF)  o₂(=FT)    :   o₁   o₂   ⟶   TF   FT
        ↘ ↙               ↘ ↙                 ↘ ↙           ↘ ↙
     ⌞   c   ⌟     ⌞       c         ⌟     ⌞   c   ⌟     ⌞   F   ⌟)

def box :=
    (┌       ┐     ┌       T         ┐     ┌       ┐     ┌   T   ┐
                          ╱ ╲                               ╱ ╲
      o₁   o₂  ╌╌→  o₁(=TF)  o₂(=FT)    :   o₁   o₂  ──→  TF   FT
        ╲ ╱               ╲ ╱                 ╲ ╱           ╲ ╱
     └   c   ┘     └       c         ┘     └   c   ┘     └   F   ┘)

def rnd :=
    (╭       ╮     ╭       T         ╮     ╭       ╮     ╭   T   ╮
                          ╱ ╲                               ╱ ╲
      o₁   o₂  ╌╌→  o₁(=TF)  o₂(=FT)    :   o₁   o₂  ──→  TF   FT
        ╲ ╱               ╲ ╱                 ╲ ╱           ╲ ╱
     ╰   c   ╯     ╰       c         ╯     ╰   c   ╯     ╰   F   ╯)

example : box = cur := rfl
example : rnd = cur := rfl

-- one-row boxes continue through drawn connectives, in either direction
example : (⌜a → b⌟ ╌╌→ ⌜a=b⌟) = (⌜a → b⌟ ⇢ ⌜a=b⌟) := rfl
example : (⌜a=b⌟ ←╌╌ ⌜a → b⌟) = (⌜a → b⌟ ⇢ ⌜a=b⌟) := rfl
example : (⌜a → b⌟ ──→ ⌜a=b⌟) = (⌜a → b⌟ ⟶ ⌜a=b⌟) := rfl

-- from a quotation, where the diagram's text is all there is to go on
open Lean Elab Command Term in
/-- info: ⌜a ← T → b⌟ -/
#guard_msgs in
run_cmd liftTermElabM do
  let e ← elabTerm (← `(
    ┌   T   ┐
       ╱ ╲
      a   b
    └       ┘)) none
  logInfo m!"{e}"

end BoxDrawing

-- printing with box-drawing glyphs
set_option pp.gavDiagrams.boxDrawing true in
/--
info: fun x => x : ⏎
      ┌  a  ┐
        ╱ ╲
       b   c
        ╲ ╱
      └  d  ┘ →
      ┌  a  ┐
        ╱ ╲
       b   c
        ╲ ╱
      └  d  ┘
-/
#guard_msgs in
#check fun x : Space [["a"], ["b"], ["c"], ["d"]] [(0, 1), (0, 2), (0, 3), (1, 3), (2, 3)] => x

set_option pp.gavDiagrams.boxDrawing true in
/--
info: (
    ┌  a  ┐     ┌  a  ┐
      ╱ ╲         ╱ ╲
     b   c  ╌╌→  b   c
      ╲ ╱         ╲ ╱
    └  d  ┘     └  d  ┘) : ⏎
      ┌  a  ┐
        ╱ ╲
       b   c
        ╲ ╱
      └  d  ┘ ⟶
      ┌  a  ┐
        ╱ ╲
       b   c
        ╲ ╱
      └  d  ┘
-/
#guard_msgs in
#check (Space.homOfTable [0, 1, 2, 3] (by decide) (by decide) : diamond ⟶ diamond)

-- one-row diagrams are printed as before
set_option pp.gavDiagrams.boxDrawing true in
/-- info: (⌜a → b ← c⌟ ⇢ ⌜a → b=c⌟) : ⌜a → b ← c⌟ ⟶ ⌜a → b=c⌟ -/
#guard_msgs in
#check (⌜a → b ← c⌟ ⇢ ⌜a → b=c⌟)

/-! ## `⊓` and `⊔` on two-point spaces with one edge

`simp` evaluates them at points (`Space.reduceInfPt`, `Space.reduceSupPt`). -/

section BoolOps
universe u

instance : BoundedOrder.{u} ⌜T → F⌟ where
  top := pt(T)
  le_top := by intro x; pt_cases x <;> decide
  bot := pt(F)
  bot_le := by intro x; pt_cases x <;> decide

instance : PartialOrder.{u} ⌜T → F⌟ where
  le_antisymm {a b} h₁ h₂ := by pt_cases a <;> pt_cases b <;> simp +decide at h₁ h₂ ⊢

example : (pt(T) ⊓ pt(F) : ⌜T → F⌟) = pt(F) := by simp
example : (pt(T) ⊓ pt(T) : ⌜T → F⌟) = pt(T) := by simp
example : (pt(F) ⊔ pt(T) : ⌜T → F⌟) = pt(T) := by simp
example : (pt(F) ⊔ pt(F) : ⌜T → F⌟) = pt(F) := by dsimp
example (x : ⌜T → F⌟) : (pt(T) ⊓ x) = x := by pt_cases x <;> simp
example (x : ⌜T → F⌟) : (pt(F) ⊔ x) = x := by pt_cases x <;> grind

open MonoidalCategory in
example : (Space.andHom : ⌜T → F⌟ ⊗ ⌜T → F⌟ ⟶ ⌜T → F⌟) (pt(T), pt(F)) = pt(F) := by
  simp

-- either direction of the edge
example [BoundedOrder.{u} ⌜a → b⌟] [IsPartialOrder ⌜a → b⌟ (· ≤ ·)] :
    (pt(a) ⊓ pt(b) : ⌜a → b⌟) = pt(b) ∧ (pt(a) ⊔ pt(b) : ⌜a → b⌟) = pt(a) := by simp
example [BoundedOrder.{u} ⌜a ← b⌟] [IsPartialOrder ⌜a ← b⌟ (· ≤ ·)] :
    (pt(a) ⊓ pt(b) : ⌜a ← b⌟) = pt(a) ∧ (pt(a) ⊔ pt(b) : ⌜a ← b⌟) = pt(b) := by simp

end BoolOps
