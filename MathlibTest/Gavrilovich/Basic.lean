import Mathlib.Tactic.Gavrilovich

open Gavrilovich CategoryTheory

/-! ## Spaces -/

/-- info: ⌜o → c⌟ : TopCat -/
#guard_msgs in
#check ⌜o → c⌟                         -- Sierpiński

example : ⌜o → c⌟ = ⌜c ← o⌟ := rfl     -- drawing direction doesn't matter
example : ⌜a  b⌟ = ⌜b  a⌟ := rfl       -- neither does point order
example : ⌜a ↔ b⌟ = ⌜b ↔ a⌟ := rfl     -- indiscrete 2-point space (non-T₀; needs a preorder)
example : ⌜a → b → c⌟ = Space [["a"], ["b"], ["c"]] [(0, 1), (0, 2), (1, 2)] := rfl

-- sub- and superscripts, and parenthesized names, which `=` glues outside the parentheses
example : ⌜xₐ → xᵢ → x² → Xᴬ → x⁽ⁿ⁾⁺⌟ =
    Space [["Xᴬ"], ["x²"], ["xᵢ"], ["x⁽ⁿ⁾⁺"], ["xₐ"]] [(0, 3), (1, 0), (1, 3), (2, 0), (2, 1),
      (2, 3), (4, 0), (4, 1), (4, 2), (4, 3)] := rfl
example : ⌜(a,c)=(b,c) → ((a,b),())⌟ =
    Space [["((a,b),())"], ["(a,c)", "(b,c)"]] [(1, 0)] := rfl

/-- info: ⌜(a,c)=(b,c) → ((a,b),())⌟ : TopCat -/
#guard_msgs in
#check ⌜(a,c)=(b,c) → ((a,b),())⌟

-- generators vs. closure: drawing the transitive edge or not gives the *same* term
def V :=
    ⌜  t  ⌝
      ↙ ↘
    ⌞l   r⌟

/-- info: V.{u_1} : TopCat -/
#guard_msgs in
#check V

def chain₁ :=
    ⌜a⌝
     ↓
     b
     ↓
    ⌞c⌟
example : chain₁ = ⌜a → b → c⌟ := rfl

/-! ## Orientation: `x → y` is `x ⤳ y`, i.e. `y ≤ x`, and the open sets are the upper sets -/

example : (pt(o) : ⌜o → c⌟) ⤳ pt(c) := by
  rw [Topology.IsUpperSet.specializes_iff_le]; decide
example : ¬ (pt(c) : ⌜o → c⌟) ⤳ pt(o) := by
  rw [Topology.IsUpperSet.specializes_iff_le]; decide
example : (pt(c) : ⌜o → c⌟) ≤ pt(o) := by decide
example : IsOpen ({pt(o)} : Set ⌜o → c⌟) := by decide
example : ¬ IsOpen ({pt(c)} : Set ⌜o → c⌟) := by decide

-- the order is the one generated by the edges, even when they aren't transitively closed
example : (pt(c) : Space [["a"], ["b"], ["c"]] [(0, 1), (1, 2)]) ≤ pt(a) := by
  decide

/-! ## Points -/

/-- info: pt(o) : ⌜o → c⌟ -/
#guard_msgs in
#check (pt(o) : ⌜o → c⌟)

/-- info: pt(0) : ⌜0 → 1⌟ -/
#guard_msgs in
#check (pt(0) : ⌜0 → 1⌟)

-- glued points can be named by any of their names
example : (pt(a) : ⌜a=b⌟) = pt(b) := rfl

/-- info: pt(o) : ⌜o → c⌟ -/
#guard_msgs in
#check (Space.pt "o" : ⌜o → c⌟)

/-! ## Open sets -/

/-- info: {∅, {o}, {c, o}} -/
#guard_msgs in
#eval (Space.opens : Finset (Finset (Space.{0} [["c"], ["o"]] [(1, 0)])))

example : (Space.opens : Finset (Finset ⌜a  b  c⌟)).card = 8 := by decide
example : (Space.opens : Finset (Finset ⌜a ↔ b → c  d ← e⌟)).card = 9 := by decide

-- the Sierpiński space is not T₁
example : ¬ T1Space ⌜o → c⌟ := by
  intro h
  have := t1Space_iff_exists_open.1 h (show (pt(c) : ⌜o → c⌟) ≠ pt(o) by decide)
  beta_reduce at this
  rw [Space.exists_isOpen] at this
  revert this
  decide

/-! ## Closed sets -/

/-- info: {{c, o}, {c}, ∅} -/
#guard_msgs in
#eval (Space.closeds : Finset (Finset (Space.{0} [["c"], ["o"]] [(1, 0)])))

example : IsClosed ({pt(c)} : Set ⌜o → c⌟) := by decide
example : ¬ IsClosed ({pt(o)} : Set ⌜o → c⌟) := by decide
example : (Space.down pt(o) : Finset ⌜o → c⌟) = {pt(o), pt(c)} := by decide
example : (Space.up pt(o) : Finset ⌜o → c⌟) = {pt(o)} := by decide
example : closure {(pt(c) : ⌜o → c⌟)} = {pt(c)} := by
  rw [← Space.coe_down, ← Finset.coe_singleton]
  exact congrArg _ (by decide)

-- no closed set separates `o` from `c`
example : ¬ ∃ U : Set ⌜o → c⌟, IsClosed U ∧ pt(o) ∈ U ∧ pt(c) ∉ U := by
  rw [Space.exists_isClosed]
  decide

example : (Space.closeds : Finset (Finset ⌜a ↔ b → c  d ← e⌟)).card = 9 := by decide

