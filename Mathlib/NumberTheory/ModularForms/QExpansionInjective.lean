module

import Mathlib.Algebra.Polynomial.Laurent.Roots
public import Mathlib.NumberTheory.ModularForms.QExpansion

/-!
# Injectivity of the `q`-expansion on the graded ring of modular forms

## Main results

* `ModularForm.gradedCoe_injective`: modular forms of distinct weights are linearly independent,
  i.e. the map sending `F : ⨁ k, ModularForm Γ k` to the function `∑ k, F k : ℍ → ℂ` is injective.
* `ModularForm.qExpansionAlgHom_injective`: the `q`-expansion map `ModularForm.qExpansionAlgHom` is
  injective on the graded ring `⨁ k, ModularForm Γ k`.

Both are then specialized to the congruence subgroups `Γ(N)`, `Γ₁(N)` and `Γ₀(N)` for `N ≠ 0`, in
`ModularForm.Gamma_gradedCoe_injective` and friends. (Level one is treated in
`Mathlib/NumberTheory/ModularForms/LevelOne/QExpansion.lean`.)

Both require that `Γ` does not fix the cusp `∞`. Some such assumption is needed: for example if
`Γ` is generated by the translation `[1, 1; 0, 1]`, then the slash equation `f ∣[k] γ = f` reads
`f (z + 1) = f z` for every `k`, so `ModularForm Γ k` does not depend on `k` and modular forms of
different weights are certainly not linearly independent.

## Implementation notes

The proof has two steps. The map `gradedCoe` sends `F : ⨁ k, ModularForm Γ k` to the function
`∑ k, F k : ℍ → ℂ`, which is periodic, holomorphic and bounded at infinity, and whose
`q`-expansion is `qExpansionAlgHom F`. Hence `qExpansionAlgHom F = 0` gives `∑ k, F k = 0`.

It remains to see that modular forms of distinct weights are linearly independent, i.e. that
`gradedCoe` is injective. Fixing `z`, the slash equations say that `∑ k, F k` evaluated at
`γ • z` is the Laurent polynomial `∑ k, (F k z) T ^ k` evaluated at the unit `denom γ z`. Taking
`γ = γ₀ * [1, n * h; 0, 1]`, where `γ₀ ∈ Γ` is not upper triangular, exhibits infinitely many
roots of that Laurent polynomial, so all its coefficients `F k z` vanish.
-/

@[expose] public noncomputable section

open CongruenceSubgroup DirectSum Filter Function Matrix.SpecialLinearGroup OnePoint UpperHalfPlane

open scoped LaurentPolynomial Manifold MatrixGroups Topology

namespace ModularForm

variable {Γ : Subgroup (GL (Fin 2) ℝ)} [Γ.HasDetOne] {h : ℝ}

section GradedCoe

variable (Γ) in
/-- The map sending `F : ⨁ k, ModularForm Γ k` to the function `∑ k, F k : ℍ → ℂ`. -/
def gradedCoe : (⨁ k, ModularForm Γ k) →+ (ℍ → ℂ) :=
  toAddMonoid fun _ ↦
    { toFun := fun f ↦ f
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }

@[simp]
theorem gradedCoe_of (k : ℤ) (f : ModularForm Γ k) : gradedCoe Γ (of _ k f) = f := by
  simp [gradedCoe]

theorem gradedCoe_periodic (hΓ : h ∈ Γ.strictPeriods) (F : ⨁ k, ModularForm Γ k) :
    Periodic (gradedCoe Γ F ∘ ofComplex) h := by
  induction F using DirectSum.induction_on with
  | zero => simp [gradedCoe, Periodic]
  | of k f => simpa using SlashInvariantFormClass.periodic_comp_ofComplex f hΓ
  | add F G hF hG =>
      intro z
      simpa using congrArg₂ (· + ·) (hF z) (hG z)

theorem gradedCoe_holo (F : ⨁ k, ModularForm Γ k) : MDiff (gradedCoe Γ F) := by
  induction F using DirectSum.induction_on with
  | zero => exact mdifferentiable_const
  | of k f => simpa using ModularFormClass.holo f
  | add F G hF hG => simpa using hF.add hG

theorem gradedCoe_bdd (hh : 0 < h) (hΓ : h ∈ Γ.strictPeriods) (F : ⨁ k, ModularForm Γ k) :
    IsBoundedAtImInfty (gradedCoe Γ F) := by
  have : Fact (IsCusp (∞ : OnePoint ℝ) Γ) := ⟨Γ.isCusp_of_mem_strictPeriods hh hΓ⟩
  induction F using DirectSum.induction_on with
  | zero => exact Asymptotics.isBigO_zero _ atImInfty
  | of k f => simpa using ModularFormClass.bdd_at_infty f
  | add F G hF hG => exact map_add (gradedCoe Γ) F G ▸ hF.add hG

private theorem gradedCoe_analyticAt (hh : 0 < h) (hΓ : h ∈ Γ.strictPeriods)
    (F : ⨁ k, ModularForm Γ k) : AnalyticAt ℂ (cuspFunction h (gradedCoe Γ F)) 0 :=
  analyticAt_cuspFunction_zero hh (gradedCoe_periodic hΓ F) (gradedCoe_holo F)
    (gradedCoe_bdd hh hΓ F)

/-- The `q`-expansion of `∑ k, F k` is the image of `F` under `ModularForm.qExpansionAlgHom`. -/
theorem qExpansion_gradedCoe (hh : 0 < h) (hΓ : h ∈ Γ.strictPeriods)
    (F : ⨁ k, ModularForm Γ k) :
    qExpansion h (gradedCoe Γ F) = qExpansionAlgHom h hh hΓ F := by
  induction F using DirectSum.induction_on with
  | zero => exact qExpansion_zero h
  | of k f => simp
  | add F G hF hG =>
      rw [map_add, map_add, UpperHalfPlane.qExpansion_add (gradedCoe_analyticAt hh hΓ F)
        (gradedCoe_analyticAt hh hΓ G), hF, hG]

end GradedCoe

section WeightLaurent

/-- `denom γ z`, as a unit of `ℂ`. -/
private def denomUnit (γ : GL (Fin 2) ℝ) (z : ℍ) : ℂˣ := Units.mk0 _ (denom_ne_zero γ z)

@[simp]
private theorem val_denomUnit (γ : GL (Fin 2) ℝ) (z : ℍ) :
    (denomUnit γ z : ℂ) = denom γ z := rfl

variable (Γ) in
/-- The Laurent polynomial `∑ k, (F k z) T ^ k` attached to `F : ⨁ k, ModularForm Γ k` and to a
point `z` of the upper half plane. -/
private def weightLaurent (z : ℍ) : (⨁ k, ModularForm Γ k) →+ ℂ[T;T⁻¹] :=
  toAddMonoid fun k ↦
    { toFun := fun f ↦ LaurentPolynomial.C (f z) * LaurentPolynomial.T k
      map_zero' := by simp
      map_add' := fun _ _ ↦ by simp [add_mul] }

/-- Evaluating the weight Laurent polynomial of `F` at `denom γ z` gives the value at `γ • z` of
the (mixed weight) function attached to `F`: this is just the slash equation, weight by weight. -/
private theorem weightLaurent_eval (z : ℍ) {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γ)
    (F : ⨁ k, ModularForm Γ k) :
    LaurentPolynomial.eval₂ (RingHom.id ℂ) (denomUnit γ z) (weightLaurent Γ z F) =
      gradedCoe Γ F (γ • z) := by
  induction F using DirectSum.induction_on with
  | zero => simp
  | of k f =>
      have hw : weightLaurent Γ z (of _ k f) =
          LaurentPolynomial.C (f z) * LaurentPolynomial.T k := by simp [weightLaurent]
      rw [hw, LaurentPolynomial.eval₂_C_mul_T, gradedCoe_of, RingHom.id_apply,
        Units.val_zpow_eq_zpow_val, val_denomUnit, mul_comm]
      exact (SlashInvariantForm.slash_action_eqn'' f hγ z).symm
  | add F G hF hG => simpa using congrArg₂ (· + ·) hF hG

private theorem weightLaurent_coeff (z : ℍ) (F : ⨁ k, ModularForm Γ k) (k : ℤ) :
    (weightLaurent Γ z F).coeff k = F k z := by
  induction F using DirectSum.induction_on with
  | zero => simp
  | of j f =>
      rcases eq_or_ne j k with rfl | hjk
      · simp [weightLaurent, ← LaurentPolynomial.single_eq_C_mul_T]
      · rw [of_eq_of_ne j k f (fun hkj ↦ hjk hkj.symm)]
        simp [weightLaurent, ← LaurentPolynomial.single_eq_C_mul_T, hjk]
  | add F G hF hG => simpa using congrArg₂ (· + ·) hF hG

end WeightLaurent

section Injective

/-- Multiplying on the right by the translation `[1, t; 0, 1]` shifts the denominator by
`t` times the lower-left entry. -/
private theorem denom_mul_upperRightHom (γ : GL (Fin 2) ℝ) (t : ℝ) (z : ℍ) :
    denom (γ * Matrix.GeneralLinearGroup.upperRightHom t) z = denom γ z + γ 1 0 * t := by
  simp [denom, Matrix.mul_apply, Fin.sum_univ_two]
  ring

/-- **Modular forms of distinct weights are linearly independent**: if `Γ` has a nonzero strict
period `h` and does not fix the cusp `∞`, then `F ↦ ∑ k, F k` is injective on the graded ring
of modular forms of level `Γ`. -/
theorem gradedCoe_injective (hh : 0 < h) (hΓ : h ∈ Γ.strictPeriods)
    (hΓinf : ∃ γ ∈ Γ, γ • (∞ : OnePoint ℝ) ≠ ∞) : Injective (gradedCoe Γ) := by
  obtain ⟨γ₀, hγ₀, hγ₀inf⟩ := hΓinf
  rw [Ne, smul_infty_eq_self_iff] at hγ₀inf
  rw [injective_iff_map_eq_zero]
  intro F hF
  refine DirectSum.ext fun k ↦ ext fun z ↦ ?_
  have hmem (n : ℕ) : γ₀ * Matrix.GeneralLinearGroup.upperRightHom (n * h) ∈ Γ :=
    Γ.mul_mem hγ₀ (Γ.mem_strictPeriods_iff.mp (by simpa [nsmul_eq_mul] using nsmul_mem hΓ n))
  have hlaurent : weightLaurent Γ z F = 0 := by
    refine LaurentPolynomial.eq_zero_of_infinite_eval₂_eq_zero _ <|
      Set.infinite_of_injective_forall_mem
        (f := fun n : ℕ ↦ denomUnit (γ₀ * Matrix.GeneralLinearGroup.upperRightHom (n * h)) z)
        (fun n m hnm ↦ ?_) fun n ↦ ?_
    · have h0 : (γ₀ 1 0 : ℂ) ≠ 0 := by exact_mod_cast hγ₀inf
      have hval := congrArg Units.val hnm
      simp only [val_denomUnit, denom_mul_upperRightHom, add_right_inj, mul_eq_mul_left_iff,
        h0, or_false] at hval
      have : (n : ℝ) * h = m * h := by exact_mod_cast hval
      exact_mod_cast mul_right_cancel₀ hh.ne' this
    · simp only [Set.mem_ofPred_eq]
      rw [weightLaurent_eval z (hmem n) F, hF, Pi.zero_apply]
  simpa [hlaurent] using (weightLaurent_coeff z F k).symm

/-- **The `q`-expansion homomorphism on the graded ring of modular forms is injective**, provided
`Γ` has a nonzero strict period `h` and does not fix the cusp `∞`. -/
theorem qExpansionAlgHom_injective (hh : 0 < h) (hΓ : h ∈ Γ.strictPeriods)
    (hΓinf : ∃ γ ∈ Γ, γ • (∞ : OnePoint ℝ) ≠ ∞) :
    Injective (qExpansionAlgHom h hh hΓ) := by
  rw [injective_iff_map_eq_zero]
  intro F hF
  refine gradedCoe_injective hh hΓ hΓinf (map_zero (gradedCoe Γ) ▸ ?_)
  refine (UpperHalfPlane.qExpansion_eq_zero_iff hh (gradedCoe_periodic hΓ F) (gradedCoe_holo F)
    (gradedCoe_bdd hh hΓ F)).mp ?_
  rw [qExpansion_gradedCoe hh hΓ, hF]

end Injective

section CongruenceSubgroup

variable {G : Subgroup SL(2, ℤ)}

/-- If a subgroup `G` of `SL(2, ℤ)` contains a matrix with nonzero lower-left entry, then its
image in `GL(2, ℝ)` does not fix the cusp `∞`. -/
theorem exists_mem_smul_infty_ne_infty {g : SL(2, ℤ)} (hg : g ∈ G) (hg0 : g 1 0 ≠ 0) :
    ∃ γ ∈ (G : Subgroup (GL (Fin 2) ℝ)), γ • (∞ : OnePoint ℝ) ≠ ∞ :=
  ⟨mapGL ℝ g, Subgroup.mem_map_of_mem _ hg, by simpa [smul_infty_eq_self_iff] using hg0⟩

/-- The matrix `!![1, 0; N, 1]`, an element of `Γ(N)` with lower-left entry `N`. -/
private def lowerShift (N : ℕ) : SL(2, ℤ) := ⟨!![1, 0; (N : ℤ), 1], by simp [Matrix.det_fin_two]⟩

private theorem lowerShift_apply_one_zero (N : ℕ) : lowerShift N 1 0 = N := rfl

private theorem lowerShift_mem_Gamma (N : ℕ) : lowerShift N ∈ Gamma N := by
  rw [Gamma_mem]; simp [lowerShift]

private theorem exists_mem_smul_infty_ne_infty_of_Gamma_le (N : ℕ) [NeZero N]
    (hG : Gamma N ≤ G) : ∃ γ ∈ (G : Subgroup (GL (Fin 2) ℝ)), γ • (∞ : OnePoint ℝ) ≠ ∞ :=
  exists_mem_smul_infty_ne_infty (hG (lowerShift_mem_Gamma N)) <| by
    simpa [lowerShift_apply_one_zero] using NeZero.ne N

/-- `N` is a strict period of `Γ(N)`. -/
theorem cast_mem_strictPeriods_Gamma (N : ℕ) :
    (N : ℝ) ∈ (Gamma N : Subgroup (GL (Fin 2) ℝ)).strictPeriods := by simp

/-- `1` is a strict period of `Γ₁(N)`. -/
theorem one_mem_strictPeriods_Gamma1 (N : ℕ) :
    (1 : ℝ) ∈ (Gamma1 N : Subgroup (GL (Fin 2) ℝ)).strictPeriods := by simp

/-- `1` is a strict period of `Γ₀(N)`. -/
theorem one_mem_strictPeriods_Gamma0 (N : ℕ) :
    (1 : ℝ) ∈ (Gamma0 N : Subgroup (GL (Fin 2) ℝ)).strictPeriods := by simp

/-- **Modular forms of distinct weights for `Γ(N)` are linearly independent**, for `N ≠ 0`. -/
theorem Gamma_gradedCoe_injective (N : ℕ) [NeZero N] :
    Injective (gradedCoe (Gamma N : Subgroup (GL (Fin 2) ℝ))) :=
  gradedCoe_injective (Nat.cast_pos.mpr (NeZero.pos N)) (cast_mem_strictPeriods_Gamma N)
    (exists_mem_smul_infty_ne_infty_of_Gamma_le N le_rfl)

/-- **Modular forms of distinct weights for `Γ₁(N)` are linearly independent**, for `N ≠ 0`. -/
theorem Gamma1_gradedCoe_injective (N : ℕ) [NeZero N] :
    Injective (gradedCoe (Gamma1 N : Subgroup (GL (Fin 2) ℝ))) :=
  gradedCoe_injective one_pos (one_mem_strictPeriods_Gamma1 N)
    (exists_mem_smul_infty_ne_infty_of_Gamma_le N (Gamma_in_Gamma1 N))

/-- **Modular forms of distinct weights for `Γ₀(N)` are linearly independent**, for `N ≠ 0`. -/
theorem Gamma0_gradedCoe_injective (N : ℕ) [NeZero N] :
    Injective (gradedCoe (Gamma0 N : Subgroup (GL (Fin 2) ℝ))) :=
  gradedCoe_injective one_pos (one_mem_strictPeriods_Gamma0 N)
    (exists_mem_smul_infty_ne_infty_of_Gamma_le N (Gamma_in_Gamma0 N))

/-- **The `q`-expansion homomorphism on the graded ring of modular forms of level `Γ(N)` is
injective**, for `N ≠ 0`. -/
theorem Gamma_qExpansionAlgHom_injective (N : ℕ) [NeZero N] :
    Injective (qExpansionAlgHom (Γ := (Gamma N : Subgroup (GL (Fin 2) ℝ))) N
      (Nat.cast_pos.mpr (NeZero.pos N)) (cast_mem_strictPeriods_Gamma N)) :=
  qExpansionAlgHom_injective _ _ (exists_mem_smul_infty_ne_infty_of_Gamma_le N le_rfl)

/-- **The `q`-expansion homomorphism on the graded ring of modular forms of level `Γ₁(N)` is
injective**, for `N ≠ 0`. -/
theorem Gamma1_qExpansionAlgHom_injective (N : ℕ) [NeZero N] :
    Injective (qExpansionAlgHom (Γ := (Gamma1 N : Subgroup (GL (Fin 2) ℝ))) 1 one_pos
      (one_mem_strictPeriods_Gamma1 N)) :=
  qExpansionAlgHom_injective _ _ (exists_mem_smul_infty_ne_infty_of_Gamma_le N (Gamma_in_Gamma1 N))

/-- **The `q`-expansion homomorphism on the graded ring of modular forms of level `Γ₀(N)` is
injective**, for `N ≠ 0`. -/
theorem Gamma0_qExpansionAlgHom_injective (N : ℕ) [NeZero N] :
    Injective (qExpansionAlgHom (Γ := (Gamma0 N : Subgroup (GL (Fin 2) ℝ))) 1 one_pos
      (one_mem_strictPeriods_Gamma0 N)) :=
  qExpansionAlgHom_injective _ _ (exists_mem_smul_infty_ne_infty_of_Gamma_le N (Gamma_in_Gamma0 N))

end CongruenceSubgroup

end ModularForm
