/-!
# The `orbit_cases` tactic

`orbit_cases x using G` proves a goal about `x : α` from the same goal at one representative of
each orbit of an action of a finite group `G` on a finite type `α`, together with the invariance of
the goal under `G`.

`fin_cases` on a quotient by the orbit relation evaluates the enumeration with `whnfD`, which shares
nothing, so any search for representatives goes (at least) quadratic. `orbit_cases` instead
separates three jobs:

* *search*: the representatives are found by compiled code (`OrbitCases.repPositions`, run through
  `evalExpr`), so the instances involved must be computable;
* *display*: the representatives are taken, as terms, from `α`'s own `Fintype` enumeration, so they
  read as nicely as `fin_cases` on `α` would;
* *certificate*: that every element is in the orbit of a representative is checked by the kernel
  (`decide +kernel`), so the search needs no proof of correctness.
-/

@[expose] public section

namespace Mathlib.Tactic.OrbitCases

variable {G α : Type*} [SMul G α]

/-- Every element of `α` is `g • r` for some `g : G` and `r ∈ reps`. -/
def Covers (G : Type*) [SMul G α] (reps : List α) : Prop :=
  ∀ x : α, ∃ r ∈ reps, ∃ g : G, g • r = x

/-- `hints` gives, for each element `x` of `xs`, the index in `reps` of an `r` with `g • r = x` for
some `g : G`. Checking this by evaluation costs `|xs| * |G|` comparisons, rather than the
`|xs| * |reps| * |G|` of deciding `Covers` directly. -/
def CoverHints (G : Type*) [SMul G α] [Fintype G] [DecidableEq α] (reps : List α) :
    List α → List ℕ → Bool
  | [], _ => true
  | _ :: _, [] => false
  | x :: xs, i :: is =>
    (match reps[i]? with
      | some r => decide (∃ g : G, g • r = x)
      | none => false) && CoverHints G reps xs is

theorem forall_of_coverHints [Fintype G] [DecidableEq α] {reps xs : List α} {hints : List ℕ}
    (h : CoverHints G reps xs hints = true) : ∀ x ∈ xs, ∃ r ∈ reps, ∃ g : G, g • r = x := by
  induction xs generalizing hints with
  | nil => simp
  | cons x xs ih =>
    cases hints with
    | nil => simp [CoverHints] at h
    | cons i is =>
      simp only [CoverHints, Bool.and_eq_true] at h
      obtain ⟨h₁, h₂⟩ := h
      intro y hy
      rcases List.mem_cons.1 hy with rfl | hy
      · split at h₁
        · next r hr => exact ⟨r, List.mem_of_getElem? hr, of_decide_eq_true h₁⟩
        · simp at h₁
      · exact ih h₂ y hy

theorem covers_of_coverHints [Fintype α] [Fintype G] [DecidableEq α] {reps xs : List α}
    {hints : List ℕ} (hxs : (Finset.univ : Finset α).val = xs)
    (h : CoverHints G reps xs hints = true) : Covers G reps := fun x =>
  forall_of_coverHints h x (by rw [← Multiset.mem_coe, ← hxs]; exact Finset.mem_univ x)

theorem orbit_cases_aux {P : α → Prop} (reps : List α) (cover : Covers G reps)
    (inv : ∀ (g : G) (x : α), P x → P (g • x)) (h : ∀ r ∈ reps, P r) (x : α) : P x := by
  obtain ⟨r, hr, g, rfl⟩ := cover x
  exact inv g r (h r hr)

theorem forall_mem_nil_of (P : α → Prop) : ∀ x ∈ ([] : List α), P x := by simp

theorem forall_mem_cons_of {P : α → Prop} {a : α} {l : List α} (ha : P a) (hl : ∀ x ∈ l, P x) :
    ∀ x ∈ a :: l, P x := by
  simpa using ⟨ha, hl⟩

/-- The positions in `xs` of the first element of each orbit, and for each element of `xs` the
index (among those) of the representative of its orbit, for `CoverHints`. For compiled evaluation by
`orbit_cases` only: the elements of `G` are read off its `Fintype` instance with `Quot.unquot`. -/
unsafe def repPositions [Fintype G] [DecidableEq α] (xs : List α) : List ℕ × List ℕ := Id.run do
  let gs := (Finset.univ : Finset G).val.unquot
  let xs := xs.toArray
  let mut covered := Array.replicate xs.size false
  let mut hints := Array.replicate xs.size 0
  let mut reps := #[]
  for (x, i) in xs.zipIdx do
    unless covered[i]! do
      let r := reps.size
      reps := reps.push i
      covered := covered.set! i true
      hints := hints.set! i r
      for g in gs do
        if let some j := xs.findIdx? (· == g • x) then
          unless covered[j]! do
            covered := covered.set! j true
            hints := hints.set! j r
  return (reps.toList, hints.toList)

/-! ### Generators -/

/-- `b = s • a` for some `s ∈ gens`. The classes of the equivalence generated by `GenStep gens` are
the orbits of the subgroup generated by `gens`. -/
def GenStep (gens : List G) (a b : α) : Prop :=
  ∃ s ∈ gens, s • a = b

/-- The certificate of `orbit_cases … generated_by`: each step `(j, i, p)` says that the `j`-th
element of `xs` is the `p`-th representative (if `i = 0`), or is `gens[i - 1] • xs[p]` for an
earlier `xs[p]`. `done` is the bitmask of the elements of `xs` reached so far, and must be full at
the end. Checking this costs one action per element of `xs`, and needs no enumeration of `G`. -/
def GenHints [DecidableEq α] (gens : List G) (reps xs : List α) (done : ℕ) :
    List (ℕ × ℕ × ℕ) → Bool
  | [] => done == 2 ^ xs.length - 1
  | (j, i, p) :: steps =>
    (match xs[j]? with
      | some x =>
        if i = 0 then decide (reps[p]? = some x)
        else done.testBit p && match gens[i - 1]?, xs[p]? with
          | some s, some y => decide (s • y = x)
          | _, _ => false
      | none => false) && GenHints gens reps xs (done ||| 1 <<< j) steps

theorem forall_of_genHints [DecidableEq α] {gens : List G} {reps xs : List α} :
    ∀ {done : ℕ} {steps : List (ℕ × ℕ × ℕ)}, GenHints gens reps xs done steps = true →
      (∀ p x, done.testBit p = true → xs[p]? = some x →
        ∃ r ∈ reps, Relation.ReflTransGen (GenStep gens) r x) →
      ∀ x ∈ xs, ∃ r ∈ reps, Relation.ReflTransGen (GenStep gens) r x
  | done, [], h, hd => by
    intro x hx
    obtain ⟨p, hp, rfl⟩ := List.getElem_of_mem hx
    simp only [GenHints, beq_iff_eq] at h
    exact hd p _ (by simp [h, Nat.testBit_two_pow_sub_one, hp]) (List.getElem?_eq_getElem hp)
  | done, (j, i, p) :: steps, h, hd => by
    simp only [GenHints, Bool.and_eq_true] at h
    obtain ⟨h₁, h₂⟩ := h
    refine forall_of_genHints h₂ fun q y hq hy ↦ ?_
    rw [Nat.testBit_or, Bool.or_eq_true, Nat.one_shiftLeft, Nat.testBit_two_pow,
      decide_eq_true_eq] at hq
    rcases hq with hq | rfl
    · exact hd q y hq hy
    rw [hy] at h₁
    dsimp only at h₁
    split_ifs at h₁ with hi
    · exact ⟨y, List.mem_of_getElem? (of_decide_eq_true h₁), .refl⟩
    · cases hs : gens[i - 1]? <;> cases hy' : xs[p]? <;> simp only [hs, hy'] at h₁ <;>
        simp only [Bool.and_false, Bool.false_eq_true, Bool.and_eq_true,
          decide_eq_true_eq] at h₁
      obtain ⟨r, hr, hry⟩ := hd p _ h₁.1 hy'
      exact ⟨r, hr, hry.tail ⟨_, List.mem_of_getElem? hs, h₁.2⟩⟩

theorem covers_of_genHints [Fintype α] [DecidableEq α] {gens : List G} {reps xs : List α}
    {steps : List (ℕ × ℕ × ℕ)} (hxs : (Finset.univ : Finset α).val = xs)
    (h : GenHints gens reps xs 0 steps = true) (x : α) :
    ∃ r ∈ reps, Relation.ReflTransGen (GenStep gens) r x :=
  forall_of_genHints h (by simp) x (by rw [← Multiset.mem_coe, ← hxs]; exact Finset.mem_univ x)

theorem orbit_cases_gen_aux {P : α → Prop} (gens : List G) (reps : List α)
    (cover : ∀ x : α, ∃ r ∈ reps, Relation.ReflTransGen (GenStep gens) r x)
    (inv : ∀ g ∈ gens, ∀ x : α, P x → P (g • x)) (h : ∀ r ∈ reps, P r) (x : α) : P x := by
  obtain ⟨r, hr, hx⟩ := cover x
  induction hx with
  | refl => exact h r hr
  | tail _ hs ih =>
    obtain ⟨s, hs, rfl⟩ := hs
    exact inv s hs _ ih

/-- The positions in `xs` of the representatives for `orbit_cases … generated_by`, the first
element of each class of the equivalence generated by `gens`, and the steps of `GenHints`, found
by breadth-first search from each representative. For compiled evaluation by `orbit_cases`
only. -/
unsafe def genSteps [DecidableEq α] (gens : List G) (xs : List α) :
    List ℕ × List (ℕ × ℕ × ℕ) := Id.run do
  let xs := xs.toArray
  let mut done := Array.replicate xs.size false
  let mut reps := #[]
  let mut steps := #[]
  for j in [0:xs.size] do
    unless done[j]! do
      steps := steps.push (j, 0, reps.size)
      reps := reps.push j
      done := done.set! j true
      let mut queue := #[j]
      -- the queue holds at most `xs.size` elements
      for k in [0:xs.size] do
        let some p := queue[k]? | break
        let some y := xs[p]? | break
        for (s, i) in gens.zipIdx do
          if let some q := xs.findIdx? (· == s • y) then
            unless done[q]! do
              done := done.set! q true
              steps := steps.push (q, i + 1, p)
              queue := queue.push q
  return (reps.toList, steps.toList)

/-- The root of `i` in the union-find forest `parent`. -/
partial def ufRoot (parent : Array ℕ) (i : ℕ) : ℕ :=
  let p := parent[i]!
  if p == i then i else ufRoot parent p

/-- For `orbit_cases … generated_by?`: the positions, in `G`'s `Fintype` enumeration, of elements
generating a subgroup with the same orbits on `xs` as `G`, chosen greedily (each merging some
orbits of those before it). For compiled evaluation by `orbit_cases` only. -/
unsafe def greedyGens [Fintype G] [DecidableEq α] (xs : List α) : List ℕ := Id.run do
  let gs := (Finset.univ : Finset G).val.unquot
  let target := (repPositions (G := G) xs).1.length
  let xs := xs.toArray
  let mut parent := Array.range xs.size
  let mut classes := xs.size
  let mut chosen := #[]
  for (g, gi) in gs.zipIdx do
    if classes ≤ target then break
    let mut useful := false
    for (x, j) in xs.zipIdx do
      if let some k := xs.findIdx? (· == g • x) then
        let a := ufRoot parent j
        let b := ufRoot parent k
        if a != b then
          parent := parent.set! a b
          classes := classes - 1
          useful := true
    if useful then chosen := chosen.push gi
  return chosen.toList

/-- The index in `ts` of `get g`, where `g` is the `i`-th element of `G`'s `Fintype` enumeration.
For compiled evaluation by `orbit_cases … generated_by?` only. -/
unsafe def leafIndex {T : Type*} [Fintype G] [DecidableEq T] (get : G → T) (i : ℕ)
    (ts : List T) : ℕ :=
  match (Finset.univ : Finset G).val.unquot[i]? with
  | some g => ts.idxOf (get g)
  | none => ts.length

end Mathlib.Tactic.OrbitCases

end

public meta section

namespace Mathlib.Tactic.OrbitCases

open Lean Meta Elab Tactic

/-- The elements of a list (or multiset) whose spine reduces to `cons`es under `whnfD`, as
`fin_cases` sees them. -/
partial def elemsOf (e : Expr) (acc : Array Expr := #[]) : MetaM (Array Expr) := do
  let e ← whnfD e
  match_expr e with
  | List.cons _ a t => elemsOf t (acc.push a)
  | List.nil _ => return acc
  | Quot.mk _ _ l => elemsOf l acc
  | _ => throwError "orbit_cases: could not enumerate the elements of{indentExpr e}"

/-- `e` after `dsimp only` (with no lemmas, but the default simprocs), or `e` itself if that fails:
`Fintype` instances often list their elements as unreduced terms, such as
`(fun i => f ↑i) ((fun i => i) ⟨0, ⋯⟩)` for a product or an image, which this makes `f 0`. -/
def reduceElem (e : Expr) : MetaM Expr := do
  try
    let ctx ← Simp.mkContext (congrTheorems := ← getSimpCongrTheorems)
    return (← Meta.dsimp e ctx #[← Simp.getSimprocs]).1
  catch _ => return e

/-- What `orbit_cases` computes for an action: the representatives, the enumeration of `α` they
come from, and the hints for `CoverHints`. -/
structure Cover where
  /-- The representatives, as `α`'s `Fintype` lists them (after `reduceElem`). -/
  reps : Array Expr
  /-- `reps`, as a list literal. -/
  repsLit : Expr
  /-- The elements of `α`, as a list literal. -/
  xsLit : Expr
  /-- The hints for `CoverHints`, as a list literal. -/
  hintsLit : Expr

/-- The `Cover`s computed so far in this process, keyed by the action's types and instances and a
`stamp` of the constants they depend on. Elaboration reruns tactic blocks often (on every edit,
when no incremental reuse applies), so this saves recomputing them. -/
private initialize coverCache : IO.Ref (Std.HashMap (Array Expr × UInt64) Cover) ← IO.mkRef {}

/-- A hash of the values of the constants of the current module that `es` depends on (imported
constants cannot change), so that editing, say, an instance invalidates the cache. -/
def stamp (es : Array Expr) : MetaM UInt64 := do
  let env ← getEnv
  let mut todo := es.flatMap (·.getUsedConstants)
  let mut seen : NameSet := {}
  let mut h : UInt64 := 7
  while h' : todo.size > 0 do
    let c := todo[todo.size - 1]
    todo := todo.pop
    if seen.contains c || env.isImportedConst c then continue
    seen := seen.insert c
    let some ci := env.find? c | continue
    h := mixHash h (mixHash (hash c) (hash ci.type))
    if let some v := ci.value? then
      h := mixHash h (hash v)
      todo := todo ++ v.getUsedConstants
  return h

/-- The `Cover` for the action of `G` on `α`, from the cache or computed. Returns also whether it
was computed, in which case the covering has not yet been checked. -/
def getCover (G α smul finG finα decEq : Expr) : MetaM (Cover × Bool) := do
  let key := #[G, α, smul, finG, finα, decEq]
  if key.any (·.hasFVar) || key.any (·.hasMVar) then
    throwError "orbit_cases: the action of{indentExpr G}\non{indentExpr α}\nmust not depend on \
      local hypotheses (other than `let` variables) or metavariables"
  let key := (key, ← stamp key)
  if let some c := (← coverCache.get)[key]? then return (c, false)
  let univ ← mkAppOptM ``Finset.univ #[α, finα]
  let xs ← elemsOf (← mkAppM ``Finset.val #[univ])
  let xsLit ← mkListLit α xs.toList
  let listNat := mkApp (mkConst ``List [0]) (mkConst ``Nat)
  let (pos, hints) ← unsafe evalExpr (List Nat × List Nat)
    (mkApp2 (mkConst ``Prod [0, 0]) listNat listNat)
    (← mkAppOptM ``repPositions #[G, α, smul, finG, decEq, xsLit]) (safety := .unsafe)
  let reps ← pos.toArray.mapM (reduceElem xs[·]!)
  let c := { reps, repsLit := ← mkListLit α reps.toList, xsLit, hintsLit := toExpr hints }
  coverCache.modify (·.insert key c)
  return (c, true)

/-- What `orbit_cases … generated_by` computes for an action and generators: the representatives,
the enumeration of `α` they come from, and the steps for `GenHints`. -/
structure GenCover where
  /-- The representatives, as `α`'s `Fintype` lists them (after `reduceElem`). -/
  reps : Array Expr
  /-- `reps`, as a list literal. -/
  repsLit : Expr
  /-- The elements of `α`, as a list literal. -/
  xsLit : Expr
  /-- The steps for `GenHints`, as a list literal. -/
  stepsLit : Expr

/-- The `GenCover`s computed so far in this process, keyed as for `coverCache` (with the
generators). -/
private initialize genCoverCache : IO.Ref (Std.HashMap (Array Expr × UInt64) GenCover) ←
  IO.mkRef {}

/-- The `GenCover` for the action of `G` on `α` and the list literal `gens`, from the cache or
computed. Returns also whether it was computed, in which case the covering has not yet been
checked. -/
def getGenCover (G α smul finα decEq gens : Expr) : MetaM (GenCover × Bool) := do
  let key := #[G, α, smul, finα, decEq, gens]
  if key.any (·.hasFVar) || key.any (·.hasMVar) then
    throwError "orbit_cases: the action of{indentExpr G}\non{indentExpr α}\nand the generators \
      {gens}\nmust not depend on local hypotheses (other than `let` variables) or metavariables"
  let key := (key, ← stamp key)
  if let some c := (← genCoverCache.get)[key]? then return (c, false)
  let univ ← mkAppOptM ``Finset.univ #[α, finα]
  let xs ← elemsOf (← mkAppM ``Finset.val #[univ])
  let xsLit ← mkListLit α xs.toList
  let nat := mkConst ``Nat
  let prod (a b : Expr) := mkApp2 (mkConst ``Prod [0, 0]) a b
  let list (a : Expr) := mkApp (mkConst ``List [0]) a
  let (pos, steps) ← unsafe evalExpr (List Nat × List (Nat × Nat × Nat))
    (prod (list nat) (list (prod nat (prod nat nat))))
    (← mkAppOptM ``genSteps #[G, α, smul, decEq, gens, xsLit]) (safety := .unsafe)
  let reps ← pos.toArray.mapM (reduceElem xs[·]!)
  let c := { reps, repsLit := ← mkListLit α reps.toList, xsLit, stepsLit := toExpr steps }
  genCoverCache.modify (·.insert key c)
  return (c, true)

/-- A proof of `(Finset.univ : Finset α).val = xsLit`, by `rfl`. -/
def univValEq (α finα xsLit : Expr) : MetaM Expr := do
  let univ ← mkAppM ``Finset.val #[← mkAppOptM ``Finset.univ #[α, finα]]
  mkExpectedTypeHint (← mkEqRefl univ) (← mkEq univ (← mkAppM ``Multiset.ofList #[xsLit]))

/-- A proof that `hintsTy` (a `Bool` computation `= true`) holds: checked by the kernel now if
`check`, and otherwise only when the declaration is added. -/
def checkHints (hintsTy : Expr) (check : Bool) : TacticM Expr := do
  if check then
    let m ← mkFreshExprMVar hintsTy
    let [] ← Tactic.run m.mvarId! (evalTactic (← `(tactic| decide +kernel)))
      | throwError "orbit_cases: the covering check failed; are the `SMul` and `DecidableEq` \
          instances' compiled code and definitions in agreement?"
    instantiateMVars m
  else mkExpectedTypeHint (← mkEqRefl (toExpr true)) hintsTy

/-- A proof of `∀ x, ∃ r ∈ c.reps, ReflTransGen (GenStep gens) r x`, checked as for
`coverProof`. -/
def genCoverProof (α finα gens : Expr) (c : GenCover) (check : Bool) : TacticM Expr := do
  let hxs ← univValEq α finα c.xsLit
  let hintsTy ← mkEq (← mkAppM ``GenHints #[gens, c.repsLit, c.xsLit, toExpr (0 : ℕ), c.stepsLit])
    (toExpr true)
  mkAppM ``covers_of_genHints #[hxs, ← checkHints hintsTy check]

/-- A proof of `Covers G c.reps`. The `CoverHints` computation is checked by the kernel now if
`check`, and otherwise only when the declaration is added (in the background, in the editor). -/
def coverProof (G α finα : Expr) (c : Cover) (check : Bool) : TacticM Expr := do
  let hxs ← univValEq α finα c.xsLit
  let hintsTy ← mkEq (← mkAppM ``CoverHints #[G, c.repsLit, c.xsLit, c.hintsLit]) (toExpr true)
  mkAppM ``covers_of_coverHints #[hxs, ← checkHints hintsTy check]

/-- `generated_by [g₁, …, gₙ]`: the generators of the subgroup acting, for `orbit_cases`. -/
syntax orbitGens := " generated_by " "[" term,* "]"

/-- `generated_by?`: `orbit_cases` suggests generators, for `generated_by [g₁, …, gₙ]`. -/
syntax orbitGensQ := " generated_by?"

/-- A goal named by an alternative of `orbit_cases … with`: `inv`, `rep_i`, `rep t` or `_`. -/
syntax orbitAltLhs := (ident <|> hole) (ppSpace term)?

/--
`orbit_cases x using G` proves the goal for `x : α` from the goal at one representative of each
orbit of the action of `G` on `α`, and the invariance of the goal under `G`. It leaves the goals

* `inv : ∀ (g : G) (x : α), P x → P (g • x)`, where `P x` is the goal (with the hypotheses
  depending on `x`, and those named by `generalizing`, reverted into it);
* `rep_0`, `rep_1`, …: `P r` for each representative `r`, with those hypotheses introduced again.

`orbit_cases h : x using G` instead keeps a variable `x` in each `rep_i`, with `h : x = r`. If `x`
is not a local hypothesis, it is generalized first.

`orbit_cases x using G with | inv => tac | rep_0 => tac | _ => tac` closes the named goals with the
given tactics (`_` stands for all the goals not yet named); goals without an alternative remain.
An alternative can also name a representative by its value rather than its number, as in
`| rep (true, false) => tac`: the term is elaborated as an element of `α`, and names
the goals of all the representatives it unifies with, as a pattern: `| rep (true, _) => tac`
runs `tac` on the goal of each representative whose first component is `true`. As in `match`,
representatives taken by an earlier alternative are left out, and it is an error if that leaves
none. An alternative can name several goals, as in `| rep_0 | rep (true, false) => tac`, running
`tac` on each of them.

The representatives are the first element of each orbit in the order of `α`'s `Fintype` instance,
and appear as that instance lists them, after `dsimp only` (which beta-reduces them, say). `G` and
`α` need computable `Fintype` instances, and
`α` a computable `DecidableEq`. The covering of `α` by the orbits is checked by the kernel. What is
computed for an action is cached, so rerunning `orbit_cases` (as elaboration often does) is cheap.

`orbit_cases x using G generated_by [g₁, …, gₙ]` uses the orbits of the subgroup generated by the
`gᵢ` instead, and leaves `inv : ∀ g ∈ [g₁, …, gₙ], ∀ x : α, P x → P (g • x)`. `G` then needs no
`Fintype` instance (nor even a group structure: just the `SMul`), and the kernel never enumerates
it, checking one action per element of `α`; this is much faster when `G`'s enumeration is costly to
evaluate (`Aut X`, say). The representatives are as before when the `gᵢ` generate `G`.

`G`, `α` and the `gᵢ` must not depend on local hypotheses, except `let` variables, which are
unfolded for the computation (but not in the goals): after `let π : Equiv.Perm α := …`, one can
write `orbit_cases x using Equiv.Perm α generated_by [π]`.

`orbit_cases x using G generated_by?` runs `orbit_cases x using G`, and suggests replacing
`generated_by?` with `generated_by [g₁, …, gₙ]`, for generators chosen from `G` (greedily, in the
order of `G`'s `Fintype` instance) with the same orbits on `α` as `G`. Products and opposites are
written as such, other structures by their fields (proofs as `by decide`), and other types as their
`Fintype` instance lists them.
-/
syntax (name := orbitCases) "orbit_cases " (atomic(ident " : "))? term " using " term
  (orbitGens <|> orbitGensQ)?
  (" generalizing" (ppSpace colGt ident)+)?
  (" with"
    (ppDedent(ppLine) ("| " orbitAltLhs)+ " => " tacticSeq)+)? : tactic

/-- The variables of a pattern for `orbit_cases`, each with its projection out of a term matching
the pattern: a pattern is a local hypothesis (not a `let`), or a structure constructor applied to
patterns, as in `(y₁, y₂)`. The variables of a pattern must be distinct; this is not checked
here. -/
partial def patternVars? (e : Expr) : MetaM (Option (Array (FVarId × (Expr → MetaM Expr)))) := do
  if let .fvar y := e then
    if (← y.getDecl).isLet then return none
    return some #[(y, pure)]
  let .const c _ := e.getAppFn | return none
  let env ← getEnv
  let some (.ctorInfo ci) := env.find? c | return none
  unless isStructure env ci.induct && e.getAppNumArgs == ci.numParams + ci.numFields do
    return none
  let mut vars := #[]
  for f in getStructureFields env ci.induct, a in e.getAppArgs[ci.numParams:] do
    let some vs ← patternVars? a | return none
    vars := vars ++ vs.map fun (y, proj) => (y, fun x => do proj (← mkProjection x f))
  return some vars

/-- Runs `orbit_cases` on the goal for the term `x`, a pattern (see `patternVars?`) in the
variables `pats`, each given with its projection out of `x`: the variables are replaced by those
projections of a variable of `x`'s type, everything depending on them being reverted into the
motive. Returns the `inv` goal, the `rep_i` goals, and the representatives. With `gensLit?`, a list
literal of elements of `G`, it uses the subgroup they generate. -/
def orbitCasesCore (goal : MVarId) (x : Expr) (pats : Array (FVarId × (Expr → MetaM Expr)))
    (G : Expr) (gens : Array FVarId) (hName? : Option Name) (gensLit? : Option Expr := none) :
    TacticM (MVarId × List MVarId × Array Expr) := goal.withContext do
    let patIds := pats.map (·.1)
    let patVars := patIds.map mkFVar
    let xName ← match x with
      | .fvar y => y.getUserName
      | _ => pure `x
    let α ← instantiateMVars (← inferType x)
    -- revert what depends on the variables, and what was asked for, so that the motive can
    -- abstract them
    let deps := (← collectForwardDeps patVars true).filter (!patVars.contains ·)
      |>.map Expr.fvarId!
    let (reverted, goal) ← goal.revert (gens ++ deps) (preserveOrder := true)
    goal.withContext do
    let tgt ← instantiateMVars (← goal.getType)
    let P ← withLocalDeclD xName α fun x' => do
      mkLambdaFVars #[x'] (tgt.replaceFVars patVars (← pats.mapM (·.2 x')))
    -- the representatives and the covering, computed and checked with the `let` variables in `G`,
    -- `α` and the generators unfolded (the goals keep them)
    let G' ← zetaReduce G
    let α' ← zetaReduce α
    let smul ← zetaReduce (← synthInstance (← mkAppM ``SMul #[G', α']))
    let finα ← zetaReduce (← synthInstance (← mkAppM ``Fintype #[α']))
    let decEq ← zetaReduce (← synthInstance (← mkAppM ``DecidableEq #[α']))
    let (reps, repsLit, cover) ← match gensLit? with
      | none => do
        let finG ← zetaReduce (← synthInstance (← mkAppM ``Fintype #[G']))
        let (c, fresh) ← getCover G' α' smul finG finα decEq
        pure (c.reps, c.repsLit, ← coverProof G' α' finα c (check := fresh))
      | some gensLit => do
        let gensLit' ← zetaReduce gensLit
        let (c, fresh) ← getGenCover G' α' smul finα decEq gensLit'
        pure (c.reps, c.repsLit, ← genCoverProof α' finα gensLit' c (check := fresh))
    -- the remaining goals
    let invType ← withLocalDeclD `g G fun g => withLocalDeclD `x α fun x' => do
      let gx ← mkAppM ``HSMul.hSMul #[g, x']
      let body ← mkForallFVars #[x'] (← mkArrow (P.beta #[x']) (P.beta #[gx]))
      match gensLit? with
      | none => mkForallFVars #[g] body
      | some gensLit =>
        withLocalDeclD `hg (← mkAppM ``Membership.mem #[gensLit, g]) fun hg =>
          mkForallFVars #[g, hg] body
    let inv ← mkFreshExprSyntheticOpaqueMVar invType `inv
    let mut repGoals := #[]
    let mut h ← mkAppOptM ``forall_mem_nil_of #[α, P]
    let mut tail ← mkListLit α []
    for i in (List.range reps.size).reverse do
      let r := reps[i]!
      let tag := Name.mkSimple s!"rep_{i}"
      -- the values of the variables at `r`: its components, as `r` is written if possible
      let vals ← do
        let ms ← patVars.mapM fun y => do mkFreshExprMVar (← inferType y)
        if ← isDefEq (x.replaceFVars patVars ms) r then ms.mapM instantiateMVars
        else pats.mapM fun p => do reduceElem (← p.2 r)
      -- with a hypothesis name, the goal is `∀ ys, x = r → P x` (in the variables `ys` of `x`),
      -- applied to the values and `rfl`
      let (m, pf) ← match hName? with
        | none => do
          let m ← mkFreshExprSyntheticOpaqueMVar (tgt.replaceFVars patVars vals) tag
          pure (m, m)
        | some hName => do
          let ty ← withLocalDeclD hName (← mkEq x r) fun hy =>
            mkForallFVars (patVars.push hy) tgt
          let m ← mkFreshExprSyntheticOpaqueMVar ty tag
          pure (m, mkApp (mkAppN m vals) (← mkEqRefl r))
      repGoals := repGoals.push m.mvarId!
      h ← mkAppOptM ``forall_mem_cons_of #[α, P, r, tail, pf, h]
      tail ← mkAppOptM ``List.cons #[α, r, tail]
    goal.assign <| ← match gensLit? with
      | none => mkAppOptM ``orbit_cases_aux #[G, α, none, P, repsLit, cover, inv, h, x]
      | some gensLit =>
        mkAppOptM ``orbit_cases_gen_aux #[G, α, none, P, gensLit, repsLit, cover, inv, h, x]
    let repGoals' ← repGoals.reverse.toList.mapM fun m => do
      let m ← m.tryClearMany patIds
      let n := reverted.size + if hName?.isSome then patIds.size + 1 else 0
      return (← m.introNP n).2
    let invGoal ← inv.mvarId!.tryClearMany patIds
    return (invGoal, repGoals', reps)

/-! ### Suggesting generators -/

/-- Syntax for the element `get g` of `T`, where `g` is the `i`-th element of `G`'s (compiled)
`Fintype` enumeration and `get : G → T`. Products and opposites are written as such, and other
structures by their fields (proofs as `by decide`), unless a field's type depends on another. Other
types are looked up in their own `Fintype` enumeration, and the element delaborated as `fin_cases`
would show it. -/
partial def reifyElem (G finG : Expr) (i : ℕ) (T get : Expr) : TermElabM Term := do
  let T ← instantiateMVars T
  -- the type of `f (get g)`, and `fun g ↦ f (get g)`; `none` if the type depends on `g`
  let along (f : Expr → MetaM Expr) : MetaM (Option (Expr × Expr)) :=
    withLocalDeclD `g G fun g => do
      let v ← f (get.beta #[g])
      let F ← instantiateMVars (← inferType v)
      if F.containsFVar g.fvarId! then return none
      return some (F, ← mkLambdaFVars #[g] v)
  let leaf : TermElabM Term := do
    let finT ← synthInstance (← mkAppM ``Fintype #[T])
    let ts ← elemsOf (← mkAppM ``Finset.val #[← mkAppOptM ``Finset.univ #[T, finT]])
    let decT ← synthInstance (← mkAppM ``DecidableEq #[T])
    let idx ← unsafe evalExpr ℕ (mkConst ``Nat) (safety := .unsafe) <| ←
      mkAppOptM ``leafIndex #[G, T, finG, decT, get, toExpr i, ← mkListLit T ts.toList]
    let some t := ts[idx]? | throwError "orbit_cases: could not find an element of{indentExpr T}"
    -- proofs are omitted (`⋯`) when delaborating; `by decide` makes the term elaborate again
    let t ← PrettyPrinter.delab (← Core.betaReduce t)
    let byDecide ← `(by decide)
    return ⟨← t.raw.replaceM fun s ↦
      pure <| if s.isOfKind ``Lean.Parser.Term.omission then some byDecide else none⟩
  match T.getAppFn.constName? with
  | some ``Prod =>
    let some (A, a) ← along (mkAppM ``Prod.fst #[·]) | leaf
    let some (B, b) ← along (mkAppM ``Prod.snd #[·]) | leaf
    `(($(← reifyElem G finG i A a), $(← reifyElem G finG i B b)))
  | some ``MulOpposite =>
    let some (A, a) ← along (mkAppM ``MulOpposite.unop #[·]) | leaf
    `($(mkIdent ``MulOpposite.op) $(← reifyElem G finG i A a))
  | some n =>
    let env ← getEnv
    unless isStructure env n do return ← leaf
    let mut args := #[]
    for f in getStructureFields env n do
      let isProof ← withLocalDeclD `g G fun g => do
        isProof (← mkProjection (get.beta #[g]) f)
      if isProof then
        args := args.push (← `(by decide))
      else
        let some (F, v) ← along (mkProjection · f) | return ← leaf
        args := args.push (← reifyElem G finG i F v)
    `(⟨$args,*⟩)
  | none => leaf

/-- Generators of `G` with the same orbits on `α` as `G` (see `greedyGens`), as syntax (see
`reifyElem`). -/
def suggestGens (G α : Expr) : TermElabM (Array Term) := do
  let smul ← synthInstance (← mkAppM ``SMul #[G, α])
  let finG ← synthInstance (← mkAppM ``Fintype #[G])
  let finα ← synthInstance (← mkAppM ``Fintype #[α])
  let decEq ← synthInstance (← mkAppM ``DecidableEq #[α])
  let xs ← elemsOf (← mkAppM ``Finset.val #[← mkAppOptM ``Finset.univ #[α, finα]])
  let idxs ← unsafe evalExpr (List ℕ) (mkApp (mkConst ``List [0]) (mkConst ``Nat))
    (safety := .unsafe) (← mkAppOptM ``greedyGens #[G, α, smul, finG, decEq,
      ← mkListLit α xs.toList])
  let id ← withLocalDeclD `g G fun g => mkLambdaFVars #[g] g
  idxs.toArray.mapM (reifyElem G finG · G id)

elab_rules : tactic
  | `(tactic| orbit_cases $[$h :]? $x using $G $[$gensStx]? $[generalizing $gens*]?
      $[with $[$[| $lhss]* => $tacs]*]?) => do
    let goal ← getMainGoal
    let rest := (← getGoals).tail
    let (x, pats, goal) ← goal.withContext do
      let x ← instantiateMVars (← elabTerm x none)
      if let some pats ← patternVars? x then
        if (pats.foldl (·.insert ·.1) ({} : FVarIdSet)).size == pats.size then
          return (x, pats, goal)
      -- generalize a term first
      let (#[y], goal) ← goal.generalize #[{ expr := x, xName? := `x }]
        | throwError "orbit_cases: could not generalize{indentExpr x}"
      return (.fvar y, #[(y, pure)], goal)
    -- `goal` may be new, and `generalizing` resolves its variables in the main goal
    setGoals (goal :: rest)
    let (inv, reps, repVals) ← goal.withContext do
      let G ← Term.elabType G
      Term.synthesizeSyntheticMVarsNoPostponing
      let G ← instantiateMVars G
      let gensLit? ← gensStx.bind (fun stx => match (⟨stx.raw⟩ : TSyntax ``orbitGens) with
          | `(orbitGens| generated_by [$ts,*]) => some ts.getElems
          | _ => none) |>.mapM fun ts => do
        let ts ← ts.mapM (Term.elabTermEnsuringType · G)
        Term.synthesizeSyntheticMVarsNoPostponing
        mkListLit G (← ts.toList.mapM instantiateMVars)
      -- as for `induction`: the variables of `x` cannot be generalized, and what depends on them
      -- is generalized anyway
      let patVars := pats.map (mkFVar ·.1)
      let deps ← collectForwardDeps patVars true
      let gens ← (gens.getD #[]).filterMapM fun g => withRef g do
        let y ← getFVarId g
        if patVars.contains (mkFVar y) then
          throwError "Variable `{mkFVar y}` cannot be generalized because the `orbit_cases` \
            target depends on it"
        if deps.contains (mkFVar y) then
          logError m!"Unnecessary `generalizing` argument: Variable `{mkFVar y}` is generalized \
            automatically"
          return none
        return some y
      let r ← orbitCasesCore goal x pats G gens (h.map (·.getId)) gensLit?
      if let some stx := gensStx.filter (·.raw.isOfKind ``orbitGensQ) then
        let α ← instantiateMVars (← inferType x)
        let ts ← suggestGens G α
        -- the elements are printed on a best-effort basis: check that they elaborate again
        let ok ← withoutModifyingState <| try
            for t in ts do
              discard <| Term.elabTermEnsuringType t G
            Term.synthesizeSyntheticMVarsNoPostponing
            pure true
          catch _ => pure false
        let ts ← ts.mapM fun t => return toString (← PrettyPrinter.ppTerm t)
        Meta.Tactic.TryThis.addSuggestion stx
          s!"generated_by [{", ".intercalate ts.toList}]" (origSpan? := stx)
          (header := if ok then "Try this:" else
            "Try this (but these generators do not elaborate as printed; adjust them by hand):")
      pure r
    let mut goals := inv :: reps
    let (some lhss, some tacs) := (lhss, tacs) | replaceMainGoal goals
    for lhss in lhss, tac in tacs do
      let mut targets := #[]
      for lhs in lhss do
        let name := lhs.raw[0]
        let repTm? := lhs.raw[1].getOptional?
        if name.isOfKind ``Lean.Parser.Term.hole && repTm?.isNone then
          targets := targets ++ goals
          continue
        let n := name.getId
        -- `rep t`: the goals of all the representatives that `t` unifies with (its blanks taking
        -- a value for each), except those already taken by earlier alternatives
        if let some t := repTm? then
          unless n == `rep do throwErrorAt name "orbit_cases: expected `rep` before a term"
          let some r := repVals[0]? | throwErrorAt t "orbit_cases: there are no representatives"
          let is ← goal.withContext <| withRef t <| withoutModifyingState do
            -- errors are thrown rather than logged, which `withoutModifyingState` would lose
            let e ← Term.withoutErrToSorry <| Term.elabTermEnsuringType t (← inferType r)
            Term.synthesizeSyntheticMVarsNoPostponing
            let e ← instantiateMVars e
            (List.range repVals.size).filterM fun i ↦ withoutModifyingState (isDefEq e repVals[i]!)
          if is.isEmpty then
            throwErrorAt t "orbit_cases: matches none of the representatives"
          let tags := is.map fun i ↦ Name.mkSimple s!"rep_{i}"
          let gs ← goals.filterM fun g ↦ return tags.contains (← g.getTag)
          if gs.isEmpty then
            throwErrorAt t "orbit_cases: redundant alternative (earlier alternatives take all \
              that it matches)"
          targets := targets ++ gs
          continue
        let some g ← goals.findM? fun g => return (← g.getTag) == n
          | throwErrorAt (repTm?.getD name) "orbit_cases: no goal named `{n}`"
        targets := targets.push g
      -- in the order of the goals, each once
      let named := goals.filter targets.contains
      for g in named do
        setGoals [g]
        withRef tac <| closeUsingOrAdmit (evalTactic tac)
      goals := goals.filter (!named.contains ·)
    setGoals (goals ++ rest)

end Mathlib.Tactic.OrbitCases
