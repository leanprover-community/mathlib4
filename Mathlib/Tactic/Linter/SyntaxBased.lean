public import Mathlib.Tactic.Linter.Header  -- shake: keep

import Batteries.Util.ExtendedBinder

/-!
# Syntax based linters

This file defines a linter that combines many different linters that each operate directly on
the `Syntax`. This approach of combining the linters into a single loop is more efficient than
having each linter do this by itself.
-/

meta section

namespace Mathlib.Linter

open Lean Linter Elab.Command

/-! ### The `cdot` linter -/

/--
The `cdot` linter flags uses of a dot (`.`) that could instead be a "cdot" (`·`).
It also flags "isolated cdots", i.e. when the `·` is on its own line.
-/
public register_option linter.style.cdot : Bool := {
  defValue := false
  descr := "enable the `cdot` linter"
}

/-- Run the cdot linter, given that `stx` has kind `cdotTk` or `Lean.Parser.Term.cdot`. -/
def cdotLinter (stx : Syntax) : CommandElabM Unit := do
  -- Both `cdotTk` and `cdot` have `.atom ..` at `stx[0]`
  if let .atom _ dot := stx[0] then
    if dot != "·" then
      logLintIf linter.style.cdot stx
        m!"Please, use `·` (typed as `\\.`) instead of `.` as `cdot`."
  -- We also check for isolated cdot's, i.e. when the cdot is on its own line.
  -- Apply this only to cdot tactics
  if stx.isOfKind ``cdotTk then
    if let some trailingWhitespace := stx.getTrailing? then
      if (trailingWhitespace.takeWhile (·.isWhitespace)).contains '\n' then
        Linter.logLintIf linter.style.cdot stx
          m!"This central dot `·` is isolated; please merge it with the next line."


/-! ### The `dollarSyntax` linter -/

/--
The `dollarSyntax` linter flags uses of `$` that could instead be `<|`.
These are disallowed by the mathlib style guide, as using `<|` pairs better with `|>`.
-/
public register_option linter.style.dollarSyntax : Bool := {
  defValue := false
  descr := "enable the `dollarSyntax` linter"
}

/-- Run the dollar syntax linter, given that `stx` has kind `term_$__`. -/
def dollarLinter (stx : Syntax) : CommandElabM Unit := do
  Linter.logLintIf linter.style.dollarSyntax stx
    m!"Please use `<|` instead of `$` for the pipe operator."


/-! ### The `lambdaSyntax` linter -/

/--
The `lambdaSyntax` linter flags uses of the symbol `λ` to define anonymous functions.
This is syntactically equivalent to the `fun` keyword; mathlib style prefers using the latter.
-/
public register_option linter.style.lambdaSyntax : Bool := {
  defValue := false
  descr := "enable the `lambdaSyntax` linter"
}

/-- Run the lambda syntax linter, given that `stx` has kind `Lean.Parser.Term.fun`. -/
def lambdaLinter (stx : Syntax) : CommandElabM Unit := do
  if let .atom _ "λ" := stx[0] then
    Linter.logLintIf linter.style.lambdaSyntax stx[0] m!"\
      Please use `fun` and not `λ` to define anonymous functions.\n\
      The `λ` syntax is deprecated in mathlib4."


/-! ### The auxiliary declaration linter -/

/--
The `auxLemma` linter flags explicit references to auto-generated "auxiliary" declarations
such as `_proof_1`, `match_1`, or `_sizeOf_1`.

These names are internal implementation details generated by the Lean elaborator.
They are not stable across refactors (e.g. reordering fields in a structure can renumber
`_proof_` indices), so depending on them makes code fragile.
-/
public register_option linter.auxLemma : Bool := {
  defValue := true
  descr := "enable the `auxLemma` linter"
}

/-- Returns `true` if `s` has the form `pfx ++ digits`, e.g. `"_proof_17"`. -/
@[inline] def matchesAuxPattern (pfx : String) (s : String) : Bool :=
  s.startsWith pfx && (s.drop pfx.length).all (·.isDigit) && s.rawEndPos > pfx.rawEndPos

/-- Returns `true` if `s` is an auto-generated auxiliary name component,
such as `_proof_1`, `match_2`, or `_sizeOf_3`. -/
def isAuxName (s : String) : Bool :=
  matchesAuxPattern "_proof_" s ||
  matchesAuxPattern "match_" s ||
  matchesAuxPattern "_sizeOf_" s ||
  matchesAuxPattern "_simp_" s ||
  matchesAuxPattern "_aux_" s

/-- Returns `true` if any component of the name is an auto-generated auxiliary name. -/
def nameRefersToAuxLemma : Name → Bool
  | .str p s => isAuxName s || nameRefersToAuxLemma p
  | .num p _ => nameRefersToAuxLemma p
  | .anonymous => false

/-- Run the aux lemma linter, given that `stx` is an `ident`. -/
def auxLemmaLinter (stx : Syntax) : CommandElabM Unit := do
  if nameRefersToAuxLemma stx.getId then
    logLintIf linter.auxLemma stx
      m!"`{stx.getId}` refers to an auto-generated auxiliary declaration. \
        These are not stable across refactors; consider using a different approach."


/-!
### The `oldObtain` linter, against stream-of-consciousness `obtain`

The `oldObtain` linter flags any occurrences of "stream-of-consciousness" `obtain`,
i.e. uses of the `obtain` tactic which do not immediately provide a proof.

#### Example

There are six different kinds of `obtain` uses. In one example, they look like this.
```
theorem foo : True := by
  -- These cases are fine.
  obtain := trivial
  obtain h := trivial
  obtain : True := trivial
  obtain h : True := trivial
  -- These are linted against.
  obtain : True
  · trivial
  obtain h : True
  · trivial
```
We allow the first four (since an explicit proof is provided), but lint against the last two.

#### Why is this bad?

This is similar to removing all uses of `Tactic.Replace` and `Tactic.Have`
from mathlib: in summary,
- this version is a Lean3-ism, which can be unlearned now
- the syntax `obtain foo : type := proof` is slightly shorter;
  particularly so when the first tactic of the proof is `exact`
- when using the old syntax as `obtain foo : type; · proof`, there is an intermediate state with
  multiple goals right before the focusing dot. This can be confusing.
- the old syntax *could* be slightly nicer when deferring goals: however, this is rare.
  In the 30 replacements of the last PR, this occurred twice. In both cases, the `suffices` tactic
  could also be used, as was in fact clearer.
-/

/--
The `oldObtain` linter flags uses of the "stream-of-consciousness" variants of the `obtain`
tactic, i.e. with the proof postponed.
-/
public register_option linter.oldObtain : Bool := {
  defValue := false
  descr := "enable the `oldObtain` linter"
}

/-- Run the `oldObtain` linter, given that `stx` has kind `Lean.Parser.Tactic.obtain`. -/
def obtainLinter (stx : Syntax) : CommandElabM Unit := do
  if stx[3].isNone then
    Linter.logLintIf linter.oldObtain stx m!"Please remove stream-of-consciousness `obtain` syntax"

/-!
### The extended binder linter

In mathlib we prefer writing the basic `∀`/`∃` binders over `∀ᵉ`/`∃ᵉ`. This is because the latter
was used quite infrequently, so the cost of needing to learn this notation was greater
than the benefit.
-/

/--
The `extendedBinder` linter flags uses of the `∀ᵉ`/`∃ᵉ` notation for combining universal and
existential binders. Mathlib prefers basic `∀`/`∃` notation.
-/
public register_option linter.style.extendedBinder : Bool := {
  defValue := false
  descr := "enable the `extendedBinder` linter"
}

open Batteries.ExtendedBinder in
/-- Run the `extendedBinder` linter, given that `stx` has kind `«term∃ᵉ_,_»` or `«term∀ᵉ_,_»`. -/
partial def extendedBinderLinter (stx : Syntax) (symbol : String) : CommandElabM Unit := do
  if stx[1].isAntiquot then return -- `∃ᵉ` can be used to define other notation, like `{_ | _}`.
  let binders := match stx[1] with
    | `(extBinders| $[($binders)]*) => binders.toList
    | `(extBinder| $b) => [b]
  let source := (← getFileMap).source
  let suggestion := String.intercalate ", " <| binders.map fun b ↦
    match b.raw.getRange? with
    | none => s!"{symbol} {b.raw.reprint}"
    | some { start, stop } => s!"{symbol} {start.extract source stop}"
  if let some start := stx[0].getPos? then
    if let some stop := stx[2].getPos? then
      let ref := .ofRange { start, stop }
      let sugg ← Elab.Command.liftCoreM <| Meta.Hint.mkSuggestionsMessage
        #[{ toTryThisSuggestion := suggestion, diffGranularity := .char }] ref none false
      logWarningAt ref m!"Try this:{sugg}\n\n\
        The basic `{symbol}` syntax is preferred over `{symbol}ᵉ`."

/-! ### The `set_option` linter -/

/--
The `setOption` linter flags a `set_option` command, term or tactic if the used option
is only meant for use during development (such as `debug`, `pp`, `profiler` or `trace`).

It also flags options that introduce technical debt.
These may be flagged when set globally (such as `maxHeartbeats`) or
when set at all (such as `backward.inferInstanceAs.wrap.reuseSubInstances`).
-/
public register_option linter.style.setOption : Bool := {
  defValue := false
  descr := "enable the `setOption` linter"
}

/--
Run the `set_option` linter on the entire command syntax,
warning against global `maxHeartbeats` or `linter.flexible` options.
-/
def SetOptionCommandLinter (stx : Syntax) : CommandElabM Unit := do
  if stx.isOfKind ``Lean.Parser.Command.set_option then
    let name := stx[1].getId
    if name.components.contains `maxHeartbeats || name == `linter.flexible then
      Linter.logLintIf linter.style.setOption stx
        m!"Unscoped option {name} is not allowed:\n\
          Please scope this to individual declarations, as in\n```\nset_option {name} in\n\
          -- comment explaining why this is necessary\n\
          example : ... := ...\n```"

/--
Run the `set_option` linter, given that `stx` has kind `Lean.Parser.Term.set_option`,
`Lean.Parser.Tactic.set_option`, or `Lean.Parser.Command.set_option`.

For a command level `set_option ... in`, this function will run on the `set_option ...` part.
-/
def setOptionLinter (stx : Syntax) : CommandElabM Unit := do
  -- In all 3 cases, `stx[1]` is the identifier of the option.
  let opt := stx[1]
  let name := opt.getId
  let forbidden := [`debug, `pp, `profiler, `trace]
  if forbidden.contains name.getRoot then
    Linter.logLintIf linter.style.setOption opt
      m!"Setting options starting with `{"`, `".intercalate (forbidden.map (·.toString))}` \
        is only intended for development and not for final code. \
        If you intend to submit this contribution to the Mathlib project, \
        please remove `set_option {name}`."
  else if name == `backward.inferInstanceAs.wrap.reuseSubInstances then
    Linter.logLintIf linter.style.setOption opt
      m!"The `{name}` option marks the introduction of technical debt, so please don't use it."

/-! ### The combined syntax linter -/

/-- Run a selection of linters on `stx`. -/
def lintCommandSyntax (stx : Syntax) : CommandElabM Unit := do
  SetOptionCommandLinter stx

/-- Run a selection of linters on all syntax in `stx`. -/
partial def lintSyntax (stx : Syntax) : CommandElabM Unit := do
  match stx with
  | .ident .. => auxLemmaLinter stx
  | .node _ kind args =>
    args.forM lintSyntax
    match kind with
    | ``cdotTk | ``Lean.Parser.Term.cdot => cdotLinter stx
    | ``«term_$__» => dollarLinter stx
    | ``Lean.Parser.Term.fun => lambdaLinter stx
    | ``Lean.Parser.Tactic.obtain => obtainLinter stx
    | ``Batteries.ExtendedBinder.«term∃ᵉ_,_» => extendedBinderLinter stx "∃"
    | ``Batteries.ExtendedBinder.«term∀ᵉ_,_» => extendedBinderLinter stx "∀"
    | ``Lean.Parser.Term.set_option | ``Lean.Parser.Tactic.set_option
    | ``Lean.Parser.Command.set_option => setOptionLinter stx
    | _ => pure ()
  | _ => pure ()

/--
Peel off and evaluate `set_option ... in` syntax.
Run `lintSyntax` on each nested command, and `lintCommandSyntax` on the final nested command.
This is like `Lean.withSetOptionIn`, but it also lints the leading `set_option ... in` syntax.
-/
partial def withSetOptionInLintSyntax (stx : Syntax) : CommandElabM Unit := do
  if stx.isOfKind ``Lean.Parser.Command.in
      && stx[0].isOfKind ``Lean.Parser.Command.set_option then
    lintSyntax stx[0]
    -- Do not modify the infotrees when elaborating, and silently ignore errors.
    let opts ← Elab.withEnableInfoTree false try
        (·.1) <$> Elab.elabSetOption stx[0][1] stx[0][3]
      catch _ => getOptions
    withScope ({ · with opts }) do withSetOptionInLintSyntax stx[2]
  else
    lintCommandSyntax stx
    lintSyntax stx

def syntaxBasedLinter : Linter where
  run stx := do
    if ← MonadLog.hasErrors then
      return
    withSetOptionInLintSyntax stx

initialize addLinter syntaxBasedLinter

end Mathlib.Linter
