module

public import Mathlib.FieldTheory.PrimitiveElement

import Mathlib.FieldTheory.Minpoly.Finite
import Mathlib.FieldTheory.SeparableDegree

/-!
# Bounds on degrees of minimal polynomials

This file relates degrees of minimal polynomials to linear independence of powers and gives a
bound for elements of a field generated by two integral elements. It also proves that an algebraic
extension into a perfect field is finite-dimensional if the degrees of minimal polynomials are
bounded.

## Main results

* `linearIndependent_pow_iff`: initial powers of an integral element are linearly independent
  exactly up to the degree of its minimal polynomial.
* `minpoly.natDegree_le_mul_of_mem_adjoin_pair`: a degree bound in a field generated by two
  elements.
* `FiniteDimensional.of_bddAbove_natDegree_minpoly`: a separable extension with bounded element
  degrees is finite-dimensional.
* `PerfectField.finiteDimensional_of_bddAbove_natDegree_minpoly`: an algebraic extension into a
  perfect field with bounded element degrees is finite-dimensional.

## Tags

minimal polynomial, degree, finite-dimensional, perfect field, separable extension
-/

public section

open Polynomial IntermediateField Set

variable {K E : Type*} [Field K] [Field E] [Algebra K E]

/-- The first `n` powers of an integral element are linearly independent if and only if `n` is
at most the degree of its minimal polynomial. -/
theorem linearIndependent_pow_iff {x : E} (hx : IsIntegral K x) (n : ℕ) :
    LinearIndependent K (fun i : Fin n ↦ x ^ (i : ℕ)) ↔ n ≤ (minpoly K x).natDegree := by
  constructor
  · intro h
    have := adjoin.finiteDimensional hx
    have h' : LinearIndependent K (fun i : Fin n ↦ (AdjoinSimple.gen K x) ^ (i : ℕ)) :=
      LinearIndependent.of_comp K⟮x⟯.val.toLinearMap h
    simpa [adjoin.finrank hx] using h'.fintype_card_le_finrank
  · intro h
    exact (linearIndependent_pow x).comp (Fin.castLE h) (Fin.castLE_injective h)

/-- The degree of an element in `K(x, y)` is at most the product of the degrees of the integral
elements `x` and `y`. -/
theorem minpoly.natDegree_le_mul_of_mem_adjoin_pair {x y z : E}
    (hx : IsIntegral K x) (hy : IsIntegral K y) (hz : z ∈ K⟮x, y⟯) :
    (minpoly K z).natDegree ≤ (minpoly K x).natDegree * (minpoly K y).natDegree := by
  have := finiteDimensional_adjoin_pair hx hy
  calc
    (minpoly K z).natDegree = (minpoly K (⟨z, hz⟩ : K⟮x, y⟯)).natDegree :=
      congrArg natDegree (minpoly.algHom_eq K⟮x, y⟯.val Subtype.val_injective ⟨z, hz⟩)
    _ ≤ Module.finrank K K⟮x, y⟯ := minpoly.natDegree_le _
    _ ≤ (minpoly K x).natDegree * (minpoly K y).natDegree := by
      rw [← Set.singleton_union, adjoin_union, ← adjoin.finrank hx, ← adjoin.finrank hy]
      exact finrank_sup_le _ _

/-- A subfield of a perfect field is perfect if the degrees of minimal polynomials are bounded.
No algebraicity assumption on the extension is needed. -/
theorem PerfectField.of_bddAbove_natDegree_minpoly (K E : Type*)
    [Field K] [Field E] [Algebra K E] [PerfectField E]
    (h : BddAbove (Set.range fun x : E ↦ (minpoly K x).natDegree)) : PerfectField K := by
  obtain ⟨n, hn⟩ := h
  obtain ⟨p, hp⟩ := ExpChar.exists K
  rcases hp with hzero | hp
  · infer_instance
  have : ExpChar K p := .prime hp
  have : ExpChar E p := expChar_of_injective_algebraMap (algebraMap K E).injective p
  suffices PerfectRing K p from PerfectRing.toPerfectField K p
  apply PerfectRing.ofSurjective K p
  intro a
  -- Taking sufficiently high iterated roots shows that Frobenius on the base field is surjective.
  obtain ⟨b, hb⟩ := (PerfectRing.bijective_frobenius (R := E) (p := p ^ (n + 1))).surjective
    (algebraMap K E a)
  obtain ⟨m, c, hc⟩ := (minpoly.natSepDegree_eq_one_iff_eq_X_pow_sub_C p).1
    ((minpoly.natSepDegree_eq_one_iff_pow_mem p).2 ⟨n + 1, a, hb.symm⟩)
  have hm : m ≤ n := (Nat.lt_pow_self hp.one_lt).le.trans <| by
    simpa [hc] using hn (mem_range_self b)
  have hc' : b ^ p ^ m = algebraMap K E c := by
    simpa [hc, sub_eq_zero] using minpoly.aeval K b
  refine ⟨c ^ p ^ (n - m), (algebraMap K E).injective ?_⟩
  change algebraMap K E ((c ^ p ^ (n - m)) ^ p) = algebraMap K E a
  rw [map_pow, map_pow, ← hc', ← pow_mul, ← pow_mul, ← mul_assoc, ← pow_add,
    Nat.add_sub_of_le hm, ← pow_succ]
  exact hb

/-- A separable field extension with bounded degrees of minimal polynomials is
finite-dimensional. -/
theorem FiniteDimensional.of_bddAbove_natDegree_minpoly (K E : Type*)
    [Field K] [Field E] [Algebra K E] [Algebra.IsSeparable K E]
    (h : BddAbove (Set.range fun x : E ↦ (minpoly K x).natDegree)) : FiniteDimensional K E := by
  obtain ⟨n, hn⟩ := h
  by_contra hfin
  obtain ⟨F, hF, hdim⟩ := exists_lt_finrank_of_infinite_dimensional hfin n
  let b := Field.powerBasisOfFiniteOfSeparable K F
  apply hdim.not_ge
  simpa [← IntermediateField.minpoly_eq, b.natDegree_minpoly, b.finrank] using
    hn (mem_range_self (b.gen : E))

/-- An algebraic extension into a perfect field is finite-dimensional if the degrees of minimal
polynomials are bounded. -/
theorem PerfectField.finiteDimensional_of_bddAbove_natDegree_minpoly (K E : Type*)
    [Field K] [Field E] [Algebra K E] [Algebra.IsAlgebraic K E] [PerfectField E]
    (h : BddAbove (Set.range fun x : E ↦ (minpoly K x).natDegree)) : FiniteDimensional K E := by
  have := PerfectField.of_bddAbove_natDegree_minpoly K E h
  exact FiniteDimensional.of_bddAbove_natDegree_minpoly K E h
