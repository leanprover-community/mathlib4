module

public import Mathlib.Algebra.GradedMonoid
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.TensorProduct.Basic

import Mathlib.Algebra.DirectSum.Internal
import Mathlib.RingTheory.FiniteStability
import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# Rees algebra

Given an algebra `A` and a filtration `F` on `A` parametrized by an additive monoid `ι`, the Rees
algebra is the subalgebra of `R[ι]` whose degree `ι` part is contained in `F i`. When the filtration
is given by natural-number powers of a two-sided ideal `I`, the Rees algebra is the subalgebra
`R[It]` of `R[t]` defined as `R[It] = ⨁ₙ Iⁿ tⁿ`.
This is used to prove the Artin-Rees lemma, and will potentially enable us to calculate some
blowup in the future.

## Main definition

- `reesAlgebra` : The Rees algebra of a filtration `F`, defined as a subalgebra of `A[ι]`.
- `adjoin_monomial_eq_reesAlgebra` : The Rees algebra of an ideal in a commutative ring is
  generated by the degree one elements.
- `reesAlgebra.fg` : The Rees algebra of a finitely generated ideal in a commutative ring is of
  finite type. In particular, this implies that the Rees algebra over a Noetherian ring is still
  Noetherian.
-/

@[expose] public section

variable {ι R A N}

section

variable [CommSemiring R] [Semiring A] [Algebra R A] (F : ι → Submodule R A)

/-- The Rees Algebra of a filtration on a ring. -/
def reesAlgebra [AddMonoid ι] [SetLike.GradedMonoid F] :
    Subalgebra R (AddMonoidAlgebra A ι) where
  carrier := {f : AddMonoidAlgebra A ι | ∀ i, f.coeff i ∈ F i}
  mul_mem' {a b} ha hb i := by
    classical
    rw [AddMonoidAlgebra.coeff_mul]
    refine Submodule.finsuppSum_mem R (F i) a.coeff _ fun j _ ↦
      Submodule.finsuppSum_mem R (F i) b.coeff _ fun k _ ↦ ?_
    by_cases h : j + k = i
    · simp_all only [Set.mem_ofPred_eq, ↓reduceIte]
      rw [← h]
      exact SetLike.GradedMul.mul_mem (ha j) (hb k)
    · simp [h]
  add_mem' ha hb i := by
    simp_all only [Set.mem_ofPred_eq, AddMonoidAlgebra.coeff_add, Finsupp.coe_add, Pi.add_apply]
    exact Submodule.add_mem (F i) (ha i) (hb i)
  algebraMap_mem' r i := by
    by_cases h : i = 0
    · simp only [h, AddMonoidAlgebra.coe_algebraMap, Function.comp_apply,
      AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same]
      exact SetLike.algebraMap_mem_graded F r
    · simp [h]

lemma mem_reesAlgebra_iff [AddMonoid ι] [SetLike.GradedMonoid F] (a : AddMonoidAlgebra A ι) :
    a ∈ reesAlgebra F ↔ ∀ i, a.coeff i ∈ F i := Iff.of_eq rfl

lemma mem_reesAlgebra_iff_support [AddMonoid ι] [SetLike.GradedMonoid F]
    (a : AddMonoidAlgebra A ι) :
    a ∈ reesAlgebra F ↔ ∀ i ∈ a.coeff.support, a.coeff i ∈ F i := by
  rw [mem_reesAlgebra_iff]
  refine ⟨fun h i hi ↦ h i, fun h i ↦ ?_⟩
  by_cases hi : i ∈ a.coeff.support; · exact h i hi
  rw [Finsupp.notMem_support_iff.mp hi]
  exact Submodule.zero_mem (F i)

theorem reesAlgebra.single_mem [AddMonoid ι] [SetLike.GradedMonoid F] (i : ι) (r : A) :
    AddMonoidAlgebra.single i r ∈ reesAlgebra F ↔ r ∈ F i := by
  rw [mem_reesAlgebra_iff]
  constructor
  · intro h
    contrapose! h
    use i
    simpa
  · intro h j
    by_cases hij : i = j
    · simpa [← hij]
    · simp [hij]

end

namespace Ideal

variable [Semiring R] {I : Ideal R} [I.IsTwoSided]

/-- The graded monoid given by powers of an ideal -/
def toGradedMonoid : ℕ → Ideal R := fun i ↦ I ^ i

instance : SetLike.GradedMonoid I.toGradedMonoid where
  one_mem := Submodule.one_le.mp fun _ a ↦ a
  mul_mem i j ri rj hi hj := by
    simp_all only [Ideal.toGradedMonoid]
    by_cases hj0 : j ≠ 0
    · rw [Submodule.pow_add I hj0]
      exact Submodule.mul_mem_mul hi hj
    · simp only [ne_eq, Decidable.not_not] at hj0
      simp only [hj0, add_zero]
      exact IsTwoSided.mul_mem_of_left rj hi

end Ideal

variable [CommRing R] (I : Ideal R)

open Polynomial

theorem reesAlgebra.monomial_mem {I : Ideal R} {i : ℕ} {r : R} :
    monomial i r ∈ reesAlgebra I.toGradedMonoid ↔ r ∈ I ^ i := by
  simp [monomial, reesAlgebra.single_mem, Ideal.toGradedMonoid]

lemma reesAlgebra.monomial_coeff_mem {I : Ideal R} (f : reesAlgebra I.toGradedMonoid) (i : ℕ) :
    (monomial i) (f.val.coeff i) ∈ reesAlgebra I.toGradedMonoid :=
  reesAlgebra.monomial_mem.mpr ((mem_reesAlgebra_iff I.toGradedMonoid _).mp f.property i)

lemma reesAlgebra.as_sum_support {I : Ideal R} (f : reesAlgebra I.toGradedMonoid) :
    f = ∑ i ∈ f.val.coeff.support,
      ⟨monomial i (f.val.coeff i), reesAlgebra.monomial_coeff_mem f i⟩ := by
  refine SetCoe.ext ?_
  have : f.val.coeff.support = support f.val := Finset.eq_of_veq rfl
  simpa [this] using Polynomial.as_sum_support f.val

theorem monomial_mem_adjoin_monomial {I : Ideal R} {n : ℕ} {r : R} (hr : r ∈ I ^ n) :
    monomial n r ∈ Algebra.adjoin R (Submodule.map (monomial 1 : R →ₗ[R] R[X]) I : Set R[X]) := by
  induction n generalizing r with
  | zero => exact Subalgebra.algebraMap_mem _ _
  | succ n hn =>
    rw [pow_succ'] at hr
    refine Submodule.smul_induction_on hr ?_ ?_
    · intro r hr s hs
      rw [add_comm n 1, smul_eq_mul, ← monomial_mul_monomial]
      exact Subalgebra.mul_mem _ (Algebra.subset_adjoin (Set.mem_image_of_mem _ hr)) (hn hs)
    · intro x y hx hy
      rw [map_add]
      exact Subalgebra.add_mem _ hx hy

theorem adjoin_monomial_eq_reesAlgebra :
    Algebra.adjoin R (Submodule.map (monomial 1 : R →ₗ[R] R[X]) I : Set R[X]) =
      reesAlgebra I.toGradedMonoid := by
  apply le_antisymm
  · apply Algebra.adjoin_le _
    rintro _ ⟨r, hr, rfl⟩
    exact reesAlgebra.monomial_mem.mpr (by rwa [pow_one])
  · intro p hp
    rw [p.as_sum_support]
    apply Subalgebra.sum_mem _ _
    rintro i -
    exact monomial_mem_adjoin_monomial (hp i)

variable {I}

theorem reesAlgebra.fg (hI : I.FG) : (reesAlgebra I.toGradedMonoid).FG := by
  classical
    obtain ⟨s, hs⟩ := hI
    rw [← adjoin_monomial_eq_reesAlgebra, ← hs]
    use s.image (monomial 1)
    rw [Finset.coe_image]
    change
      _ =
        Algebra.adjoin R
          (Submodule.map (monomial 1 : R →ₗ[R] R[X]) (Submodule.span R ↑s) : Set R[X])
    rw [Submodule.map_span, Algebra.adjoin_span]

instance [IsNoetherianRing R] : Algebra.FiniteType R (reesAlgebra I.toGradedMonoid) :=
  ⟨(reesAlgebra I.toGradedMonoid).fg_top.mpr (reesAlgebra.fg <| IsNoetherian.noetherian I)⟩

instance [IsNoetherianRing R] : IsNoetherianRing (reesAlgebra I.toGradedMonoid) :=
  Algebra.FiniteType.isNoetherianRing R _

open TensorProduct in
lemma tensorProduct_reesAlgebra_isNoetherian_of_fg [IsNoetherianRing (R ⧸ I)] (fg : I.FG) :
    IsNoetherianRing ((R ⧸ I) ⊗[R] (reesAlgebra I.toGradedMonoid)) := by
  have : Algebra.FiniteType R (reesAlgebra I.toGradedMonoid) :=
    ⟨(reesAlgebra I.toGradedMonoid).fg_top.mpr (reesAlgebra.fg fg)⟩
  have := this.baseChange (R ⧸ I)
  exact Algebra.FiniteType.isNoetherianRing (R ⧸ I) _

lemma isNoetherianRing_reesAlgebra_quotient [IsNoetherianRing (R ⧸ I)] (fg : I.FG) :
    IsNoetherianRing ((reesAlgebra I.toGradedMonoid) ⧸
      I.map (algebraMap R (reesAlgebra I.toGradedMonoid))) := by
  have := tensorProduct_reesAlgebra_isNoetherian_of_fg fg
  exact isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.quotIdealMapEquivQuotTensor
    (reesAlgebra I.toGradedMonoid) I).symm.toRingEquiv

lemma mem_map_algebraMap_reesAlgebra_iff (f : reesAlgebra I.toGradedMonoid) :
    f ∈ I.map (algebraMap R (reesAlgebra I.toGradedMonoid)) ↔ ∀ n, f.val.coeff n ∈ I ^ (n + 1) := by
  refine ⟨fun h n ↦ ?_, fun h ↦ ?_⟩
  · rw [← Submodule.restrictScalars_mem R, ← Ideal.smul_top_eq_map] at h
    induction h using Submodule.smul_induction_on' with
    | smul r hr m hm =>
      simpa [pow_succ', Ideal.toGradedMonoid] using
        Ideal.mul_mem_mul hr ((mem_reesAlgebra_iff I.toGradedMonoid _).mp m.property n)
    | add x hx y hy memx memy => simpa using add_mem memx memy
  · rw [reesAlgebra.as_sum_support f]
    apply sum_mem (fun i hi ↦ ?_)
    have {r : R} (h' : r ∈ I * I ^ i) :
      ⟨monomial i r, reesAlgebra.monomial_mem.mpr (Ideal.mul_le_right h')⟩
        ∈ I.map (algebraMap R (reesAlgebra I.toGradedMonoid)) := by
      induction h' using Submodule.mul_induction_on' with
      | mem_mul_mem s hs t ht =>
        simp_rw [← smul_eq_mul s t, ← smul_monomial,
          ← SetLike.mk_smul_mk (hx := reesAlgebra.monomial_mem.mpr ht), Algebra.smul_def]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hs)
      | add s1 hs1 s2 hs2 mem1 mem2 => simpa using add_mem mem1 mem2
    apply this
    simpa [pow_succ'] using h i
