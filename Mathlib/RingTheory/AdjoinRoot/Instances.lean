public section

open _root_.Polynomial Ideal

variable {r n : ℕ} {R : Type*}

namespace IsRadical

/-- Over a field, `X ^ r - 1` is a radical element as soon as `(r : K)` is a unit.
    TODO: Find space and correct generalization. -/
private lemma X_pow_sub_one_field {K : Type*} (r : ℕ) [Field K] (hr : IsUnit (r : K)) :
    _root_.IsRadical ((X : K[X]) ^ r - 1) :=
  (X_pow_sub_one_separable_iff.mpr hr.ne_zero).squarefree.isRadical

variable [CommRing R] {f g : R[X]}

lemma _root_.isReduced_iff_spanRadical : IsReduced (AdjoinRoot f) ↔ (span {f}).IsRadical :=
  (isRadical_iff_quotient_reduced (Ideal.span {f})).symm

variable [IsReduced R]

/-- A monic polynomial `f` over a reduced ring divides `g` as soon as it does so modulo every
    prime ideal. -/
lemma _root_.Polynomial.Monic.dvd_of_forall_prime_map_dvd (hf : f.Monic) (h : ∀ P : PrimeSpectrum R,
    f.map (Ideal.Quotient.mk P.asIdeal) ∣ g.map (Ideal.Quotient.mk P.asIdeal)) : f ∣ g := by
  rw [← modByMonic_eq_zero_iff_dvd hf]
  ext i
  convert! IsReduced.eq_zero _ (mem_nilradical.mp ?_)
  · infer_instance
  · rw [nilradical_eq_sInf]
    refine Ideal.mem_sInf.mpr ?_
    intro p hp
    have hz : (g %ₘ f).map (Ideal.Quotient.mk p) = 0 := by
      rw [map_modByMonic _ hf, modByMonic_eq_zero_iff_dvd (hf.map _)]
      exact h ⟨p, hp⟩
    have hc := (congrArg (coeff · i) hz)
    simp only [coeff_map, coeff_zero] at hc
    grind [Ideal.Quotient.eq_zero_iff_mem]

/-- Over a reduced commutative ring in which `(r : R)` is a unit, `X ^ r - 1` is a radical
    element of `R[X]`. -/
lemma X_pow_sub_one_of_isUnit (r : ℕ) (hru : IsUnit (r : R)) :
    _root_.IsRadical ((X : R[X]) ^ r - 1) := by
  rcases eq_or_ne r 0 with rfl | hr0
  · simp [zero_of_reduced]
  · intro k y hy
    apply (monic_X_pow_sub_one hr0).dvd_of_forall_prime_map_dvd
    intro ⟨p, hp⟩
    set D := R ⧸ p
    set K := FractionRing D
    set f := ((algebraMap D K).comp (Ideal.Quotient.mk p))
    simp only [Polynomial.map_sub, Polynomial.map_pow, map_X, Polynomial.map_one]
    rw [← map_dvd_map _ (IsFractionRing.injective D K) (monic_X_pow_sub_one hr0)]
    simp only [Polynomial.map_sub, Polynomial.map_pow, map_X, Polynomial.map_one]
    apply X_pow_sub_one_field r (by simpa using hru.map f)
    simpa [Polynomial.map_pow, Polynomial.map_map] using map_dvd f hy

/-- If `R` is a reduced commutative ring in which `(r : R)` is a regular element (a
    non-zero-divisor), then the ideal generated by `X ^ r - 1` in `R[X]` is radical. -/
lemma span_X_pow_sub_one_of_regular (h : IsRegular (r : R)) :
    (span {(X : R[X]) ^ r - 1}).IsRadical := by
  rw [← isRadical_iff_span_singleton]
  rcases eq_or_ne r 0 with rfl | hr0
  · simp [zero_of_reduced]
  · set S := (Localization.Away (r : R))
    intro k y hy
    refine (map_dvd_map (algebraMap R S) ?_ ?_).mp ?_
    · apply IsLocalization.injective (M := Submonoid.powers (r : R))
      rintro x ⟨m, rfl⟩
      exact pow_mem h.mem_nonZeroDivisors m
    · simpa using monic_X_pow_sub_C (1 : R) hr0
    · have : ((X : S[X]) ^ r - 1) ∣ y.map (algebraMap R S) := by
        refine X_pow_sub_one_of_isUnit r ?_ k _ ?_
        · have := IsLocalization.Away.algebraMap_isUnit (S := S) (r : R)
          simpa using this
        · simpa [Polynomial.map_pow] using map_dvd (algebraMap R S) hy
      simpa using this

end IsRadical

namespace AdjoinRoot

variable [CommRing R] {f : R[X]} [CharP R n]

lemma IsReduced.X_pow_sub_one_of_coprime (h : n.Coprime r) [IsReduced R] :
    IsReduced (AdjoinRoot ((X : R[X]) ^ r - 1)) := by
  simp only [isReduced_iff_spanRadical]
  apply IsRadical.span_X_pow_sub_one_of_regular
  simpa using (((ZMod.unitOfCoprime r h.symm).isUnit).map (ZMod.castHom (dvd_refl n) R)).isRegular

lemma charP_of_monic_of_degree_pos (monic : f.Monic) (deg : 0 < f.degree) :
    CharP (AdjoinRoot f) n  := by
  refine _root_.charP_of_injective_algebraMap (R := R) ?_ _
  rw [← faithfulSMul_iff_algebraMap_injective]
  exact faithfulSMul_of_monic_of_degree_pos monic deg

lemma charP_of_X_pow_sub_C {a : R} (h : 0 < r) [Nontrivial R] :
    CharP (AdjoinRoot ((X : R[X]) ^ r - C a)) n := by
  have monic := monic_X_pow_sub_C (a : R) h.ne.symm
  apply charP_of_monic_of_degree_pos monic
  apply natDegree_pos_iff_degree_pos.mp
  grind [natDegree_X_pow_sub_C]

lemma charP_of_X_pow_sub_one (h : 0 < r) [Nontrivial R] :
    CharP (AdjoinRoot (X ^ r - 1 : R[X])) n := by
  rw [← C_1]
  exact charP_of_X_pow_sub_C h

instance [Nontrivial R] [NeZero r] : CharP (AdjoinRoot (X ^ r - 1 : R[X])) n :=
  have : r ≠ 0 := NeZero.out
  charP_of_X_pow_sub_one (by lia)

end AdjoinRoot
