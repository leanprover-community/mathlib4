/-!
# Lemmas about ideals of `MvPolynomial`

Notably this contains results about monomial ideals.

## Main results

* `MvPolynomial.mem_ideal_span_monomial_image`
* `MvPolynomial.mem_ideal_span_X_image`
* `MvPolynomial.mem_pow_idealOfVars_iff`
* `MvPolynomial.span_X_image_isPrime`: The ideal generated by a set of indeterminates of a
  polynomial ring is prime over a nontrivial semiring with no zero divisors.
-/

public section


variable {σ R : Type*}

namespace MvPolynomial

variable [CommSemiring R]

/-- `x` is in a monomial ideal generated by `s` iff every element of its support dominates one of
the generators. Note that `si ≤ xi` is analogous to saying that the monomial corresponding to `si`
divides the monomial corresponding to `xi`. -/
theorem mem_ideal_span_monomial_image {x : MvPolynomial σ R} {s : Set (σ →₀ ℕ)} :
    x ∈ Ideal.span ((fun s => monomial s (1 : R)) '' s) ↔ ∀ xi ∈ x.support, ∃ si ∈ s, si ≤ xi := by
  refine AddMonoidAlgebra.mem_ideal_span_of'_image.trans ?_
  simp_rw [le_iff_exists_add, add_comm]
  rfl

theorem mem_ideal_span_monomial_image' {ι}
    {x : MvPolynomial σ R} {s : Set ι} {fm : ι → σ →₀ ℕ} {fc : ι → R} :
    x ∈ Ideal.span ((fun i => monomial (fm i) (fc i)) '' s) ↔
      ∀ xi ∈ x.support, x.coeff xi ∈ Ideal.span (fc '' {i ∈ s | fm i ≤ xi}) := by
  simpa [le_iff_exists_add', monomial] using x.mem_ideal_span_single_image (fm := fm) (fc := fc)

theorem mem_ideal_span_monomial_image_iff_dvd {x : MvPolynomial σ R} {s : Set (σ →₀ ℕ)} :
    x ∈ Ideal.span ((fun s => monomial s (1 : R)) '' s) ↔
      ∀ xi ∈ x.support, ∃ si ∈ s, monomial si 1 ∣ monomial xi (x.coeff xi) := by
  refine mem_ideal_span_monomial_image.trans (forall₂_congr fun xi hxi => ?_)
  simp_rw [monomial_dvd_monomial, one_dvd, and_true, mem_support_iff.mp hxi, false_or]

/-- `x` is in a monomial ideal generated by variables `X` iff every element of its support
has a component in `s`. -/
theorem mem_ideal_span_X_image {x : MvPolynomial σ R} {s : Set σ} :
    x ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) ↔
      ∀ m ∈ x.support, ∃ i ∈ s, (m : σ →₀ ℕ) i ≠ 0 := by
  have := @mem_ideal_span_monomial_image σ R _ x ((fun i => Finsupp.single i 1) '' s)
  rw [Set.image_image] at this
  refine this.trans ?_
  simp [Nat.one_le_iff_ne_zero]

theorem span_X_image_eq_ker_aeval_ite_mem (s : Set σ) [DecidablePred (· ∈ s)] :
    Ideal.span (X '' s : Set (MvPolynomial σ R)) =
      RingHom.ker (aeval (fun x ↦ if x ∈ sᶜ then X (R := R) x else 0)) := by
  classical
  refine Submodule.span_eq_of_le _ (fun _ ⟨_, hx⟩ ↦ by simp [← hx.2, hx.1]) (fun _ hx ↦ ?_)
  refine mem_ideal_span_X_image.mpr fun y _ ↦ ?_
  rw [RingHom.mem_ker, aeval_ite_mem_eq, eq_zero_iff] at hx
  specialize hx y
  rw [coeff_sum, Finset.sum_eq_single y] at hx
  all_goals grind [AddMonoidAlgebra.coeff_eq_zero, coeff_monomial]

theorem span_X_image_isPrime [Nontrivial R] [NoZeroDivisors R] (s : Set σ) :
    (Ideal.span (X '' s : Set (MvPolynomial σ R))).IsPrime := by
  classical
  rw [span_X_image_eq_ker_aeval_ite_mem]
  exact RingHom.ker_isPrime _

section idealOfVars

open Finset Finsupp

variable (σ R) in
/-- The ideal spanned by all variables. -/
noncomputable abbrev idealOfVars : Ideal (MvPolynomial σ R) := .span (.range X)

variable (σ R) in
lemma isPrime_idealOfVars [Nontrivial R] [NoZeroDivisors R] : (idealOfVars σ R).IsPrime := by
  rw [idealOfVars, ← Set.image_univ]
  exact span_X_image_isPrime ..

variable (σ R) in
lemma fg_idealOfVars [Finite σ] : (idealOfVars σ R).FG :=
  Submodule.fg_span <| Set.finite_range _

@[deprecated (since := "2026-10-18")]
alias idealOfVars_fg := fg_idealOfVars

set_option backward.isDefEq.respectTransparency false in
lemma idealOfVars_eq_restrictSupportIdeal :
    idealOfVars σ R = restrictSupportIdeal _ _ ((IsUpperSet.Ici 1).preimage degree_mono) := by
  apply le_antisymm
  · simp [idealOfVars, Ideal.span_le, Set.range_subset_iff, restrictSupportIdeal, X]
  · simp only [IsConcreteLE.le_iff, restrictSupportIdeal, Submodule.mem_mk,
      Submodule.mem_toAddSubmonoid, ← Submodule.restrictScalars_mem R (idealOfVars σ R)]
    rw [← IsConcreteLE.le_iff, restrictSupport_eq_span, Submodule.span_le, Set.image_subset_iff]
    intro x hx
    obtain ⟨i, hi⟩ : x.support.Nonempty := by aesop
    obtain ⟨c, rfl⟩ := le_iff_exists_add'.mp (show single i 1 ≤ x by simp_all; lia)
    simpa [monomial_add_single] using Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))

open scoped Pointwise in
theorem pow_idealOfVars (n : ℕ) :
    idealOfVars σ R ^ n = restrictSupportIdeal _ _ ((IsUpperSet.Ici n).preimage degree_mono) := by
  rw [idealOfVars_eq_restrictSupportIdeal]
  apply Submodule.restrictScalars_injective R
  by_cases hn : n = 0
  · simp [hn, Set.Ici_zero_eq_univ]
  rw [Submodule.restrictScalars_pow hn]
  simp [← restrictSupport_nsmul, ← degree_preimage_nsmul, hn, Set.Ici_nsmul_eq]

/-- The `n`th power of `idealOfVars` is spanned by all monic monomials of total degree `n`. -/
theorem pow_idealOfVars_eq_span (n) : idealOfVars σ R ^ n =
    .span ((monomial · 1) '' degree ⁻¹' {n}) := by
  rw [idealOfVars, Ideal.span, Submodule.span_pow, ← Set.image_univ,
    image_pow_eq_finsuppProd_image]
  simp [monomial_eq, Set.preimage, degree]

set_option backward.isDefEq.respectTransparency.types false in
theorem mem_pow_idealOfVars_iff (n : ℕ) (p : MvPolynomial σ R) :
    p ∈ idealOfVars σ R ^ n ↔ ∀ x ∈ p.support, n ≤ degree x := by
  rw [pow_idealOfVars]
  simp [restrictSupportIdeal, mem_restrictSupport_iff, Set.subset_def]

theorem mem_pow_idealOfVars_iff' (n : ℕ) (p : MvPolynomial σ R) :
    p ∈ idealOfVars σ R ^ n ↔ ∀ x, degree x < n → p.coeff x = 0 := by
  grind only [mem_pow_idealOfVars_iff, mem_support_iff]

theorem monomial_mem_pow_idealOfVars_iff (n : ℕ) (x : σ →₀ ℕ) {r : R} (h : r ≠ 0) :
    monomial x r ∈ idealOfVars σ R ^ n ↔ n ≤ degree x := by
  classical
  grind only [mem_pow_idealOfVars_iff, mem_support_iff, coeff_monomial]

theorem C_mem_pow_idealOfVars_iff (n r) : C r ∈ idealOfVars σ R ^ n ↔ r = 0 ∨ n = 0 := by
  by_cases h : r = 0
  · simp [h]
  simpa [h] using monomial_mem_pow_idealOfVars_iff (σ := σ) n 0 h

end idealOfVars

section Quotient

variable {A σ : Type*} [CommRing A] (I : Ideal (MvPolynomial σ A))

theorem mkₐ_eq_aeval :
    Ideal.Quotient.mkₐ A I = aeval fun d : σ => Ideal.Quotient.mk I (X d) := by
  ext d
  simp

set_option backward.isDefEq.respectTransparency.types false in
theorem mk_eq_eval₂ : (Ideal.Quotient.mk I).toFun =
      eval₂ (algebraMap A (MvPolynomial σ A ⧸ I)) fun d : σ => Ideal.Quotient.mk I (X d) := by
  ext d
  simp_rw [RingHom.toFun_eq_coe, ← Ideal.Quotient.mkₐ_eq_mk A, mkₐ_eq_aeval, aeval_X, aeval,
    AlgHom.coe_mk, coe_eval₂Hom]

end Quotient

end MvPolynomial

namespace MonomialOrder

variable [CommSemiring R] {m : MonomialOrder σ}
open Ideal

lemma span_leadingTerm_sdiff_singleton_zero (B : Set (MvPolynomial σ R)) :
    span (m.leadingTerm '' (B \ {0})) = span (m.leadingTerm '' B) :=
  m.image_leadingTerm_sdiff_singleton_zero B ▸ Ideal.span_sdiff_singleton_zero

lemma span_leadingTerm_insert_zero (B : Set (MvPolynomial σ R)) :
    span (m.leadingTerm '' (insert 0 B)) = span (m.leadingTerm '' B) := by
  by_cases h : 0 ∈ B
  · rw [Set.insert_eq_of_mem h]
  · simp

lemma span_leadingTerm_eq_span_monomial {B : Set (MvPolynomial σ R)}
    (hB : ∀ p ∈ B, IsUnit (m.leadingCoeff p)) :
    span (m.leadingTerm '' B) =
      span ((fun p ↦ MvPolynomial.monomial (m.degree p) (1 : R)) '' B) := by
  apply le_antisymm
  all_goals
    rw [Ideal.span_le, Set.image_subset_iff]
    intro p hp
  · rw [Set.mem_preimage, SetLike.mem_coe, ← C_mul_leadingCoeff_monomial_degree]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, hp, rfl⟩)
  · rw [Set.mem_preimage, SetLike.mem_coe]
    convert
      (span <| m.leadingTerm '' B).mul_mem_left (MvPolynomial.C (hB p hp).unit⁻¹.val) <|
        subset_span ⟨p, hp, rfl⟩
    rw [← C_mul_leadingCoeff_monomial_degree, ← mul_assoc, ← map_mul,
      IsUnit.val_inv_mul, MvPolynomial.C_1, one_mul]

lemma span_leadingTerm_eq_span_monomial₀ {B : Set (MvPolynomial σ R)}
    (hB : ∀ p ∈ B, IsUnit (m.leadingCoeff p) ∨ p = 0) :
    span (m.leadingTerm '' B) =
      span ((fun p ↦ MvPolynomial.monomial (m.degree p) 1) '' (B \ {0})) := by
  rw [← m.span_leadingTerm_sdiff_singleton_zero]
  apply span_leadingTerm_eq_span_monomial
  simp_intro .. [or_iff_not_imp_right.mp (hB _ _)]

lemma span_leadingTerm_eq_span_monomial' {k : Type*} [Field k] {B : Set (MvPolynomial σ k)} :
    span (m.leadingTerm '' B) =
      span ((fun p ↦ MvPolynomial.monomial (m.degree p) 1) '' (B \ {0})) := by
  apply span_leadingTerm_eq_span_monomial₀
  simp [em']

lemma sPolynomial_mem_sup_ideal {R : Type*} [CommRing R]
    {I J : Ideal <| MvPolynomial σ R} {p q : MvPolynomial σ R}
    (hp : p ∈ I) (hq : q ∈ J) : m.sPolynomial p q ∈ I ⊔ J :=
  sub_mem (mul_mem_left _ _ (mem_sup_left hp)) (mul_mem_left _ _ (mem_sup_right hq))

lemma sPolynomial_mem_ideal {R : Type*} [CommRing R]
    {I : Ideal <| MvPolynomial σ R} {p q : MvPolynomial σ R}
    (hp : p ∈ I) (hq : q ∈ I) : m.sPolynomial p q ∈ I :=
  sub_mem (mul_mem_left I _ hp) (mul_mem_left I _ hq)

open MvPolynomial in
lemma monomial_mem_span_range_leadingTerm_tfae {R ι} [CommSemiring R] {e : σ →₀ ℕ} {c : R}
    {b : ι → MvPolynomial σ R} :
    List.TFAE [
      monomial e c ∈ Ideal.span (Set.range (m.leadingTerm ∘ b)),
      c ≠ 0 → c ∈ Ideal.span (m.leadingCoeff '' b '' {i | m.degree (b i) ≤ e}),
      c ≠ 0 → ∃ cs : ι →₀ R,
        (∀ i ∈ cs.support, m.degree (b i) ≤ e) ∧ c = cs.linearCombination _ (m.leadingCoeff ∘ b),
      ∃ g : ι →₀ MvPolynomial σ R,
        (∀ i, m.withBotDegree (b i) + m.withBotDegree (g i) ≼'[m] e) ∧
        monomial e c = Finsupp.linearCombination _ (m.leadingTerm ∘ b) g,
      ∃ g : ι →₀ MvPolynomial σ R,
        (∀ i, m.withBotDegree (b i) + m.withBotDegree (g i) ≼'[m] e) ∧
        monomial e c = m.leadingTerm (Finsupp.linearCombination _ b g)]
      := by
  classical
  tfae_have 1 ↔ 2 := by
    by_cases hc0 : c = 0
    · simp [hc0]
    simp_rw [Set.range_comp, leadingTerm.eq_1, MvPolynomial.mem_ideal_span_monomial_image',
      Set.ofPred_mem_range, ← Set.image_comp, support_monomial, ne_eq, hc0, ite_false,
      not_false_iff, true_imp_iff, Finset.mem_singleton, forall_eq, coeff_monomial, ite_true]
  tfae_have 2 ↔ 3 := by
    simp_rw [← Set.image_comp, Finsupp.mem_span_image_iff_linearCombination, eq_comm]
    exact Iff.rfl
  tfae_have 3 → 4 := by
    by_cases hc0 : c = 0
    · simpa [hc0] using ⟨0, by simp⟩
    intro h
    rcases h hc0 with ⟨cs, h⟩
    use Finsupp.onFinset cs.support (fun i ↦ monomial (e - m.degree (b i)) (cs i)) (by simp)
    split_ands
    · intro i
      by_cases! h0 : cs i = 0 ∨ b i = 0
      · rcases h0 with h0 | h0 <;> simp [h0]
      simp [m.withBotDegree_monomial, h0, m.withBotDegree_eq_coe_degree_iff .. |>.mpr,
        ← WithBot.coe_add, add_tsub_cancel_of_le <| h.1 _ <| cs.mem_support_iff.mpr h0.1]
    · simp only [Finsupp.linearCombination_apply, Function.comp_apply, smul_eq_mul, zero_mul,
        implies_true, Finsupp.sum_onFinset] at h ⊢
      simp_rw [h.2, Finsupp.sum, map_sum]
      apply Finset.sum_congr rfl
      intro _ hd
      simp_rw [leadingTerm, monomial_mul_monomial, tsub_add_cancel_of_le <| h.1 _ hd]
  tfae_have 4 → 5 := by
    by_cases hc0 : c = 0
    · exact fun _ ↦ ⟨0, by simp [hc0]⟩
    rintro ⟨g, ⟨hdeg, hg⟩⟩
    use g, hdeg
    suffices c = ((Finsupp.linearCombination (MvPolynomial σ R) b) g).coeff e by
      subst this
      rw [leadingTerm, monomial_eq_monomial_iff]
      apply show ∀ a b, a ∧ (a → b) → a ∧ b ∨ _ by tauto
      nth_rw 1 [← m.toSyn.apply_eq_iff_eq, le_antisymm_iff]
      refine ⟨⟨m.le_degree_of_mem_support <| by simpa using hc0, ?_⟩, (by rw [leadingCoeff, ·])⟩
      apply m.degree_le_of_withBotDegree_le_coe
      rw [Finsupp.linearCombination_apply, Finsupp.sum]
      refine le_trans m.withBotDegree_sum_le <| Finset.sup_le_iff.mpr fun i _ ↦ ?_
      exact le_trans (mul_comm (b i) (g i) ▸ m.withBotDegree_mul_le ..) <| by simpa using hdeg i
    apply_fun (AddMonoidAlgebra.coeff · e) at hg
    simp only [coeff_monomial, ↓reduceIte, Finsupp.linearCombination_apply, Function.comp_apply,
      smul_eq_mul, AddMonoidAlgebra.coeff_finsuppSum, Finsupp.sum_apply] at hg ⊢
    rw [hg]
    apply Finsupp.sum_congr
    intro i hi
    rw [mul_comm, mul_comm (g i), m.coeff_mul_of_withBotDegree_add_withBotDegree_le (hdeg _),
      m.coeff_mul_of_withBotDegree_add_withBotDegree_le (by simpa using hdeg _)]
    simp
  tfae_have 5 → 3 := by
    rintro ⟨g, hdeg, hg⟩ hc
    simp only [leadingTerm, leadingCoeff, monomial_eq_monomial_iff, hc, coeff_degree_eq_zero_iff,
      false_and, or_false] at hg
    rcases hg with ⟨hdeg', hg⟩
    simp_rw [← hdeg', Finsupp.linearCombination_apply, Finsupp.sum, coeff_sum, smul_eq_mul,
      mul_comm (g _), m.coeff_mul_of_withBotDegree_add_withBotDegree_le (hdeg _)] at hg
    use g.mapRange m.leadingCoeff (by simp) |>.filter
      fun i ↦ m.withBotDegree (b i) + m.withBotDegree (g i) = e
    split_ands
    · simp only [Finsupp.support_filter, Finset.mem_filter, Finsupp.mem_support_iff,
        Finsupp.mapRange_apply, ne_eq, leadingCoeff_eq_zero_iff, and_imp]
      intro i hgi0
      by_cases hbi0 : b i = 0
      · simp [hbi0]
      rw [m.withBotDegree_eq_coe_degree_iff _ |>.mpr hbi0,
        m.withBotDegree_eq_coe_degree_iff _ |>.mpr hgi0, ← WithBot.coe_add, WithBot.coe_eq_coe]
      exact le_of_add_le_left ∘ le_of_eq
    simp [Finsupp.linearCombination_apply, Finsupp.sum, Finsupp.filter_apply,
      Finsupp.support_mapRange' fun _ ↦ m.leadingCoeff_eq_zero_iff.mp, Finset.sum_filter, ← ite_and,
      mul_comm (m.leadingCoeff <| g _), hg]
  tfae_finish

end MonomialOrder
