module

public import Mathlib.RingTheory.Bialgebra.Primitive
public import Mathlib.RingTheory.HopfAlgebra.Convolution

/-!
# Primitive elements in a Hopf algebra

Facts about primitive elements in a Hopf algebra, and the Hopf algebra structure on a bialgebra
generated by primitive elements.

## Main declarations

* `Bialgebra.IsPrimitiveElem.antipode_eq_neg`: the antipode sends primitive elements to their
  negation.
* `Bialgebra.IsPrimitiveElem.antipode`: the antipode preserves primitivity.
* `HopfAlgebra.ofPrimitives`: upgrade a bialgebra generated by primitive elements to a Hopf
  algebra, given an anti-algebra hom negating each generator.
* `HopfAlgebra.eq_antipodeAlgHomOp_of_primitives`: an anti-algebra hom negating each element of a
  primitive generating set is the antipode.

## References

* [D. Grinberg, V. Reiner, *Hopf algebras in combinatorics*][GrinbergReiner2020]
-/

public section

open Algebra Bialgebra HopfAlgebra MulOpposite

variable {R A : Type*} [CommSemiring R] [Ring A]

namespace Bialgebra.IsPrimitiveElem

variable [HopfAlgebra R A] {a : A}

/-- See Proposition 1.4.17 in [GrinbergReiner2020]. -/
@[simp] theorem antipode_eq_neg (ha : IsPrimitiveElem R a) : antipode R a = -a :=
  eq_neg_of_add_eq_zero_right <| by
    simpa [ha.comul_eq_tmul_add_tmul, ha.counit_eq_zero]
      using mul_antipode_rTensor_comul_apply (R := R) a

protected lemma antipode (ha : IsPrimitiveElem R a) : IsPrimitiveElem R (antipode R a) :=
  ha.antipode_eq_neg ▸ ha.neg

lemma antipode_antipode (ha : IsPrimitiveElem R a) : antipode R (antipode R a) = a := by
  simp [ha]

end Bialgebra.IsPrimitiveElem

namespace HopfAlgebra

variable {s : Set A}

/-- Upgrade a bialgebra generated by primitive elements to a Hopf algebra, given an anti-algebra
hom `S` negating each generator: the antipode identities only need checking on generators. -/
noncomputable abbrev ofPrimitives [Bialgebra R A] (S : A →ₐ[R] Aᵐᵒᵖ) (hs : adjoin R s = ⊤)
    (prim : ∀ p ∈ s, IsPrimitiveElem R p) (hS : ∀ p ∈ s, S p = op (-p)) : HopfAlgebra R A := by
  refine ofAntipodeOfAdjoin S hs ?_ ?_ <;> intro p hp <;>
    simp [(prim p hp).comul_eq_tmul_add_tmul, (prim p hp).counit_eq_zero, hS p hp]

/-- An anti-algebra hom negating each element of a primitive generating set is the antipode.
See the remark following Proposition 1.4.17 in [GrinbergReiner2020]. -/
theorem eq_antipodeAlgHomOp_of_primitives [HopfAlgebra R A] (S : A →ₐ[R] Aᵐᵒᵖ)
    (hs : adjoin R s = ⊤) (prim : ∀ p ∈ s, IsPrimitiveElem R p)
    (hS : ∀ p ∈ s, S p = op (-p)) : S = antipodeAlgHomOp R A :=
  AlgHom.ext_of_adjoin_eq_top hs fun p hp ↦ by simp [hS p hp, (prim p hp).antipode_eq_neg]

end HopfAlgebra
