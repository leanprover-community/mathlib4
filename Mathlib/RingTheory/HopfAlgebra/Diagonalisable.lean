module

public import Mathlib.RingTheory.Bialgebra.MonoidAlgebra
public import Mathlib.RingTheory.HopfAlgebra.GroupLike
public import Mathlib.RingTheory.HopfAlgebra.MonoidAlgebra

/-!
# Diagonalisable Hopf algebras

We define diagonalisable Hopf algebras (over a commutative ring `R`) as those that are
isomorphic to a group algebra over `R`.

We then prove that any diagonalisable Hopf algebra is spanned by its group-like elements.

If the base ring is a domain, we prove the converse: any bialgebra spanned by its group-like
elements is diagonalisable. The idea is that, if `A` is a bialgebra over `R` and
`G` is its set of group-like elements, then `G` is a group (for the multiplication of `A`),
so we get a morphism of algebras from `R[G]` to `A`, which is actually a morphism of bialgebras.
This morphism is surjective by assumption, and, if `R` is a domain, it is also injective
because group-like elements are linearly independent.

Note that the last result is false in general.
-/

public section

open Function MonoidAlgebra

universe u

namespace HopfAlgebra
variable {R A B G : Type*} [CommRing R]

section Bialgebra
variable [Semiring A] [Semiring B] [Bialgebra R A] [Bialgebra R B]

/-- A Hopf algebra is called diagonalisable if it is isomorphic to a group algebra.

We define this predicate for bialgebras instead of just Hopf algebras out of convenience, but note
that all "diagonalisable bialgebras" are in fact Hopf algebras.
See `HopfAlgebra.ofIsDiagonalisable`. -/
@[mk_iff]
class IsDiagonalisable (R : Type*) (A : Type u) [CommRing R] [Semiring A] [Bialgebra R A] :
    Prop where
  /-- A `R`-Hopf algebra `A : Type u` is diagonalisable iff to the group algebra `R[G]` for some
  `G : Type u`. This is equivalent to the same predicate for arbitrary `G`, since `G` is never
  bigger than `R[G]`. See `IsDiagonalisable.monoidAlgebra` and `IsDiagonalisable.of_bialgEquiv`. -/
  exists_iso (R A) : ∃ (G : Type u) (_ : Group G), Nonempty (A ≃ₐc[R] R[G])

/-- A "diagonalisable bialgebra" is in fact a Hopf algebra. -/
@[implicit_reducible]
noncomputable def ofIsDiagonalisable [IsDiagonalisable R A] : HopfAlgebra R A :=
  letI := (IsDiagonalisable.exists_iso R A).choose_spec.choose
  (IsDiagonalisable.exists_iso R A).choose_spec.choose_spec.some.hopfAlgebra

/-- A group algebra is diagonalisable. -/
instance IsDiagonalisable.monoidAlgebra [Group G] : IsDiagonalisable R R[G] :=
  ⟨⟨ULift G, _, ⟨domCongrBialgEquiv R R MulEquiv.ulift.symm⟩⟩⟩

instance [Subsingleton R] : IsDiagonalisable R A := by
  have : Subsingleton A := (algebraMap R A).codomain_trivial
  have := BialgEquiv.ofBijective (f := Bialgebra.counitBialgHom R A)
    (⟨Function.injective_of_subsingleton _, Function.surjective_to_subsingleton _⟩)
  exact ⟨_, _, ⟨this.trans (bialgEquivOfSubsingleton PUnit).symm⟩⟩

lemma IsDiagonalisable.of_bialgEquiv [IsDiagonalisable R A] (e : A ≃ₐc[R] B) :
    IsDiagonalisable R B := by
  nontriviality R
  obtain ⟨G, _, ⟨e'⟩⟩ := ‹IsDiagonalisable R A›
  replace e := e'.symm.trans e
  have eG := Equiv.ofInjective _ (e.injective.comp of_injective)
  let := eG.symm.group
  exact ⟨_, _, ⟨((domCongrBialgEquiv R R eG.symm.mulEquiv).trans e).symm⟩⟩

lemma isDiagonalisable_congr (e : A ≃ₐc[R] B) : IsDiagonalisable R A ↔ IsDiagonalisable R B where
  mp _ := .of_bialgEquiv e
  mpr _ := .of_bialgEquiv e.symm

instance : IsDiagonalisable R R := .of_bialgEquiv <| bialgEquivOfSubsingleton Unit

/-- A diagonalisable bialgebra is generated by its group-like elements. -/
lemma span_isGroupLikeElem_eq_top_of_isDiagonalisable [IsDiagonalisable R A] :
    Submodule.span R {a : A | IsGroupLikeElem R a} = ⊤ := by
  obtain ⟨⟨G, _, ⟨e⟩⟩⟩ := ‹IsDiagonalisable R A›
  rw [← Submodule.comap_top (e : A ≃ₗ[R] R[G]).toLinearMap,
    ← span_isGroupLikeElem (R := R), Submodule.comap_equiv_eq_map_symm, Submodule.map_span]
  simp [AlgEquiv.image_symm_eq_preimage]

end Bialgebra

variable [IsDomain R] [Ring A] [HopfAlgebra R A] [NoZeroSMulDivisors R A]

/-- A Hopf algebra over a domain that is generated by its group-like elements is isomorphic
to the group algebra on its group-like elements. -/
lemma liftGroupLikeBialgHom_bijective_of_span_isGroupLikeElem_eq_top
    (h : Submodule.span R {a : A | IsGroupLikeElem R a} = ⊤) :
    Bijective (liftGroupLikeBialgHom (R := R) (A := A)) := by
  have : Nontrivial A := Bialgebra.nontrivial R
  refine ⟨?_, fun b ↦ ?_⟩
  · rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
    refine fun x hx ↦ coeff_eq_zero.1 <|
      linearIndep_groupLikeVal.eq_zero_of_finsuppLinearCombination ?_
    simpa [Algebra.smul_def, Finsupp.linearCombination_apply, MonoidAlgebra.lift_apply, liftNC,
      Finsupp.liftAddHom, Function.comp_def] using hx
  · obtain ⟨x, hx⟩ := (Finsupp.mem_span_setOfPred_iff_exists_linearCombination (x := b)).mp <| by
      rw [h]; exact Submodule.mem_top
    use .ofCoeff (x.equivMapDomain GroupLike.valEquiv.symm)
    simpa [liftNC, Finsupp.liftAddHom, Algebra.smul_def, Finsupp.linearCombination_apply,
      MonoidAlgebra.lift_apply] using hx

/-- A Hopf algebra over a domain that is generated by its group-like elements is diagonalisable.

This is also true over an arbitrary commutative ring, but with a more complicated proof. -/
lemma IsDiagonalisable.of_span_isGroupLikeElem_eq_top
    (h : Submodule.span R {a : A | IsGroupLikeElem R a} = ⊤) : IsDiagonalisable R A where
  exists_iso := ⟨GroupLike R A, inferInstance, ⟨.symm <| .ofBijective _ <|
    liftGroupLikeBialgHom_bijective_of_span_isGroupLikeElem_eq_top h⟩⟩

/-- A Hopf algebra over a domain is diagonalisable if and only if it is generated by its group-like
elements.

This is also true over an arbitrary commutative ring, but with a more complicated proof. -/
lemma isDiagonalisable_iff_span_isGroupLikeElem_eq_top :
    IsDiagonalisable R A ↔ Submodule.span R {a : A | IsGroupLikeElem R a} = ⊤ where
  mp _ := span_isGroupLikeElem_eq_top_of_isDiagonalisable
  mpr := .of_span_isGroupLikeElem_eq_top

end HopfAlgebra
