/-!
# Conjugacy of Coxeter Elements for Acyclic Coxeter Graphs

This file defines the underlying Coxeter graph `CoxeterMatrix.graph M : SimpleGraph B`
(adjacent iff `i ≠ j ∧ M i j ≠ 2`) and proves the classical theorem (Bourbaki, Ch. V §6;
Humphreys, §3.16) that when `M.graph` is acyclic (a forest, and in particular a tree), all
orderings of the same finite set of simple reflections yield conjugate products in the
Coxeter group. In particular, for a finite acyclic Coxeter system, all Coxeter elements
lie in a single conjugacy class.

More generally, we prove the underlying combinatorial word-move theorem for any acyclic
`SimpleGraph B`: any two duplicate-free permutations of the same finite subset of vertices
are related by swaps of adjacent non-adjacent vertices and cyclic rotations. Consequently,
conjugacy holds in any monoid generated by involutions `s : B → W` whose non-adjacent
generators commute (including arbitrary reflection systems).

## Main definitions
* `CoxeterMatrix.graph`: The underlying simple graph of a Coxeter matrix (`i ≠ j ∧ M i j ≠ 2`).
* `CoxeterSystem.WordMoveStep`: Elementary word move (commuting swap of non-adjacent letters or
  cyclic rotation of the first letter to the end).
* `CoxeterSystem.WordMoves`: The equivalence relation generated by `WordMoveStep`.

## Main results
* `CoxeterSystem.simple_mul_simple_comm_of_not_adj`: Non-adjacent simple reflections commute.
* `CoxeterSystem.wordMoves_of_isAcyclic`: On an acyclic graph, any two duplicate-free words
  that are permutations of each other are related by `WordMoves`.
* `CoxeterSystem.isConj_prod_map_of_isAcyclic`: Conjugacy in any monoid generated by involutions
  commuting along non-edges of an acyclic graph.
* `CoxeterSystem.isConj_wordProd_of_isAcyclic` / `CoxeterSystem.isConj_wordProd_of_isTree`:
  In an acyclic (resp. tree) Coxeter system, any two duplicate-free permutations of the same
  vertices produce conjugate elements of `W`.
* `CoxeterSystem.isConj_coxeterElement_of_isAcyclic`: All Coxeter elements of a finite acyclic
  Coxeter system are conjugate in `W`.
-/

@[expose] public section

namespace CoxeterMatrix

/-- The underlying Coxeter graph of a `CoxeterMatrix B`: two distinct vertices `i ≠ j` are
adjacent if and only if `M i j ≠ 2`. -/
def graph {B : Type*} (M : CoxeterMatrix B) : SimpleGraph B where
  Adj i j := i ≠ j ∧ M i j ≠ 2
  symm := ⟨fun _ _ h ↦ ⟨h.1.symm, M.symmetric _ _ ▸ h.2⟩⟩
  loopless := ⟨fun _ h ↦ h.1 rfl⟩

@[simp]
theorem graph_adj {B : Type*} (M : CoxeterMatrix B) (i j : B) :
    M.graph.Adj i j ↔ i ≠ j ∧ M i j ≠ 2 := Iff.rfl

end CoxeterMatrix

namespace CoxeterSystem

/-! ### Elementary word moves along a simple graph -/

section WordMoves

variable {B : Type*}

/-- One elementary move on words over a graph `G`: swap two adjacent non-adjacent letters, or
rotate the first letter to the end. -/
inductive WordMoveStep (G : SimpleGraph B) : List B → List B → Prop
  | swap (p q : List B) (x y : B) (h : ¬ G.Adj x y) :
      WordMoveStep G (p ++ x :: y :: q) (p ++ y :: x :: q)
  | rotate (x : B) (r : List B) : WordMoveStep G (x :: r) (r ++ [x])

/-- The equivalence relation on words generated by `WordMoveStep G`. -/
def WordMoves (G : SimpleGraph B) : List B → List B → Prop :=
  Relation.EqvGen (WordMoveStep G)

lemma WordMoves.single {G : SimpleGraph B} {a b : List B} (h : WordMoveStep G a b) :
    WordMoves G a b := Relation.EqvGen.rel _ _ h

lemma WordMoves.refl (G : SimpleGraph B) (a : List B) : WordMoves G a a :=
  Relation.EqvGen.refl a

lemma WordMoves.symm {G : SimpleGraph B} {a b : List B} (h : WordMoves G a b) :
    WordMoves G b a := Relation.EqvGen.symm _ _ h

lemma WordMoves.trans {G : SimpleGraph B} {a b c : List B} (h₁ : WordMoves G a b)
    (h₂ : WordMoves G b c) : WordMoves G a c := Relation.EqvGen.trans _ _ _ h₁ h₂

lemma WordMoveStep.perm {G : SimpleGraph B} {a b : List B} (h : WordMoveStep G a b) :
    a.Perm b := by
  cases h with
  | swap p q x y _ => exact List.Perm.append_left p (List.Perm.swap y x q)
  | rotate x r => exact (List.perm_append_singleton x r).symm

lemma WordMoves.perm {G : SimpleGraph B} {a b : List B} (h : WordMoves G a b) :
    a.Perm b := by
  induction h with
  | rel _ _ h => exact h.perm
  | refl => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

private lemma wordMoves_commute_front (G : SimpleGraph B) (t : B) (v : List B) :
    ∀ (u p : List B), (∀ x ∈ u, ¬ G.Adj t x) →
      WordMoves G (p ++ u ++ t :: v) (p ++ t :: (u ++ v))
  | [], p, _ => by simpa using WordMoves.refl G (p ++ t :: v)
  | x :: u, p, hu => by
    have ih := wordMoves_commute_front G t v u (p ++ [x]) (fun y hy ↦ hu y (by simp [hy]))
    have hxt : ¬ G.Adj x t := fun h ↦ hu x (by simp) h.symm
    refine WordMoves.trans (b := p ++ [x] ++ t :: (u ++ v)) ?_ ?_
    · simpa using ih
    · simpa using WordMoves.single (WordMoveStep.swap (G := G) p (u ++ v) x t hxt)

private lemma wordMoves_commute_back (G : SimpleGraph B) (t : B) :
    ∀ (v u : List B), (∀ x ∈ v, ¬ G.Adj t x) →
      WordMoves G (u ++ t :: v) (u ++ v ++ [t])
  | [], u, _ => by simpa using WordMoves.refl G (u ++ [t])
  | x :: v, u, hv => by
    have ih := wordMoves_commute_back G t v (u ++ [x]) (fun y hy ↦ hv y (by simp [hy]))
    refine WordMoves.trans (b := u ++ [x] ++ t :: v) ?_ ?_
    · simpa using WordMoves.single (WordMoveStep.swap (G := G) u v t x (hv x (by simp)))
    · simpa using ih

private lemma wordMoves_leaf_to_end (G : SimpleGraph B) (t i : B) (l : List B)
    (hnd : l.Nodup) (ht : t ∈ l) (hleaf : ∀ x ∈ l, x ≠ t → x ≠ i → ¬ G.Adj t x) :
    ∃ u v : List B, l = u ++ t :: v ∧ WordMoves G l (u ++ v ++ [t]) := by
  obtain ⟨u, v, rfl⟩ := List.append_of_mem ht
  refine ⟨u, v, rfl, ?_⟩
  have hnd' := List.nodup_append.mp hnd
  obtain ⟨_, hndtv, hdisj⟩ := hnd'
  have htv : t ∉ v := (List.nodup_cons.mp hndtv).1
  have htu : t ∉ u := fun h ↦ hdisj t h t (by simp) rfl
  by_cases hiv : i ∈ v
  · have hiu : i ∉ u := fun h ↦ hdisj i h i (by simp [hiv]) rfl
    have hu : ∀ x ∈ u, ¬ G.Adj t x := fun x hx ↦
      hleaf x (by simp [hx]) (fun h ↦ htu (h ▸ hx)) (fun h ↦ hiu (h ▸ hx))
    have h1 := wordMoves_commute_front G t v u [] hu
    have h2 := WordMoves.single (WordMoveStep.rotate (G := G) t (u ++ v))
    simp only [List.nil_append] at h1
    exact h1.trans h2
  · have hv : ∀ x ∈ v, ¬ G.Adj t x := fun x hx ↦
      hleaf x (by simp [hx]) (fun h ↦ htv (h ▸ hx)) (fun h ↦ hiv (h ▸ hx))
    exact wordMoves_commute_back G t v u hv

private def LeafInv (G : SimpleGraph B) (t i : B) (a : List B) : Prop :=
  a.Nodup ∧ t ∉ a ∧ ∀ x ∈ a, x ≠ i → ¬ G.Adj t x

private lemma LeafInv.of_perm {G : SimpleGraph B} {t i : B} {a b : List B}
    (hp : a.Perm b) (h : LeafInv G t i a) : LeafInv G t i b :=
  ⟨hp.nodup_iff.mp h.1, fun hb ↦ h.2.1 (hp.mem_iff.mpr hb),
    fun x hx hxi ↦ h.2.2 x (hp.mem_iff.mpr hx) hxi⟩

private lemma wordMoveStep_lift {G : SimpleGraph B} {t i : B} {a b : List B}
    (h : WordMoveStep G a b) (hinv : LeafInv G t i a) : WordMoves G (a ++ [t]) (b ++ [t]) := by
  cases h with
  | swap p q x y hxy =>
    simpa using WordMoves.single (WordMoveStep.swap (G := G) p (q ++ [t]) x y hxy)
  | rotate x r =>
    obtain ⟨hnd, _, hG⟩ := hinv
    have hrot := WordMoves.single (WordMoveStep.rotate (G := G) x (r ++ [t]))
    by_cases hxi : x = i
    · subst hxi
      have hxr : x ∉ r := (List.nodup_cons.mp hnd).1
      have hr : ∀ y ∈ r, ¬ G.Adj t y := fun y hy ↦
        hG y (by simp [hy]) (fun h ↦ hxr (h ▸ hy))
      have h1 := wordMoves_commute_front G t [x] r [] hr
      have h2 := WordMoves.single (WordMoveStep.rotate (G := G) t (r ++ [x]))
      simp only [List.nil_append] at h1
      refine WordMoves.trans (b := r ++ [t] ++ [x]) ?_ ?_
      · simpa using hrot
      · simpa using h1.trans h2
    · have htx : ¬ G.Adj t x := hG x (by simp) hxi
      have hsw := WordMoves.single (WordMoveStep.swap (G := G) r [] t x htx)
      refine WordMoves.trans (b := r ++ [t] ++ [x]) ?_ ?_
      · simpa using hrot
      · simpa using hsw

private lemma wordMoves_lift {G : SimpleGraph B} {t i : B} {a b : List B}
    (h : WordMoves G a b) : LeafInv G t i a → WordMoves G (a ++ [t]) (b ++ [t]) := by
  induction h with
  | rel _ _ h => exact fun hinv ↦ wordMoveStep_lift h hinv
  | refl => exact fun _ ↦ WordMoves.refl G _
  | symm _ _ hxy ih =>
    intro hy
    exact (ih (LeafInv.of_perm (WordMoves.perm hxy).symm hy)).symm
  | trans _ _ _ hxy _ ih₁ ih₂ =>
    intro hx
    exact (ih₁ hx).trans (ih₂ (LeafInv.of_perm (WordMoves.perm hxy) hx))

/-- Every nonempty finite set `s` of vertices in an acyclic graph contains a vertex `t ∈ s` with
at most one neighbor inside `s`. -/
private lemma exists_leaf_of_isAcyclic {G : SimpleGraph B} (hG : G.IsAcyclic)
    (s : Finset B) (hs : s.Nonempty) :
    ∃ t ∈ s, ∃ i : B, ∀ x ∈ s, x ≠ t → x ≠ i → ¬ G.Adj t x := by
  let H : SimpleGraph s := G.induce (s : Set B)
  have hH : H.IsAcyclic := fun _ c hc ↦
    hG _ (hc.map (f := (SimpleGraph.Embedding.induce (G := G) (s : Set B)).toHom)
      Subtype.val_injective)
  have : Nonempty s := hs.to_subtype
  obtain ⟨u, v, p, hp, hmax⟩ := SimpleGraph.Walk.exists_isPath_forall_isPath_length_le_length H
  by_cases hnil : p.Nil
  · refine ⟨u.val, u.property, u.val, fun x hx _ _ hadj ↦ ?_⟩
    have hedge : H.Adj u ⟨x, hx⟩ := hadj
    have hlen := hmax u ⟨x, hx⟩ (SimpleGraph.Walk.cons hedge SimpleGraph.Walk.nil)
      (by simp [SimpleGraph.Walk.isPath_def, hedge.ne])
    rw [SimpleGraph.Walk.length_eq_zero_iff.mpr hnil] at hlen
    simp at hlen
  · refine ⟨u.val, u.property, p.snd.val, fun x hx _ hxs hadj ↦ ?_⟩
    have hux : H.Adj u ⟨x, hx⟩ := hadj
    by_cases hsupp : (⟨x, hx⟩ : s) ∈ p.support
    · exact hxs (congrArg Subtype.val (hH.eq_snd_of_adj_start hp hux hsupp))
    · have hp' : (SimpleGraph.Walk.cons hux.symm p).IsPath := hp.cons hsupp
      have hlen := hmax ⟨x, hx⟩ v _ hp'
      simp at hlen

private lemma wordMoves_of_isAcyclic_aux {G : SimpleGraph B} (hG : G.IsAcyclic) :
    ∀ (k : ℕ) (s : Finset B), s.card = k →
      ∀ l₁ l₂ : List B, l₁.Nodup → l₂.Nodup →
        (∀ x, x ∈ l₁ ↔ x ∈ s) → (∀ x, x ∈ l₂ ↔ x ∈ s) → WordMoves G l₁ l₂ := by
  classical
  intro k
  induction k with
  | zero =>
    intro s hs l₁ l₂ _ _ h₁ h₂
    have hs0 : s = ∅ := Finset.card_eq_zero.mp hs
    subst hs0
    have e₁ : l₁ = [] := List.eq_nil_iff_forall_not_mem.mpr fun x hx ↦ by
      simpa using (h₁ x).mp hx
    have e₂ : l₂ = [] := List.eq_nil_iff_forall_not_mem.mpr fun x hx ↦ by
      simpa using (h₂ x).mp hx
    subst e₁; subst e₂
    exact WordMoves.refl G []
  | succ k ih =>
    intro s hs l₁ l₂ hnd₁ hnd₂ h₁ h₂
    have hne : s.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨t, hts, i, hleaf⟩ := exists_leaf_of_isAcyclic hG s hne
    have hleaf₁ : ∀ x ∈ l₁, x ≠ t → x ≠ i → ¬ G.Adj t x := fun x hx ↦ hleaf x ((h₁ x).mp hx)
    have hleaf₂ : ∀ x ∈ l₂, x ≠ t → x ≠ i → ¬ G.Adj t x := fun x hx ↦ hleaf x ((h₂ x).mp hx)
    obtain ⟨u₁, v₁, e₁, m₁⟩ := wordMoves_leaf_to_end G t i l₁ hnd₁ ((h₁ t).mpr hts) hleaf₁
    obtain ⟨u₂, v₂, e₂, m₂⟩ := wordMoves_leaf_to_end G t i l₂ hnd₂ ((h₂ t).mpr hts) hleaf₂
    have key : ∀ (l u v : List B), l = u ++ t :: v → l.Nodup →
        (∀ x, x ∈ l ↔ x ∈ s) →
        (u ++ v).Nodup ∧ t ∉ u ++ v ∧ (∀ x, x ∈ u ++ v ↔ x ∈ s.erase t) := by
      intro l u v e hnd hmem
      subst e
      have hperm : (u ++ t :: v).Perm (t :: (u ++ v)) := List.perm_middle
      have hnd' := hperm.nodup_iff.mp hnd
      refine ⟨(List.nodup_cons.mp hnd').2, (List.nodup_cons.mp hnd').1, fun x ↦ ?_⟩
      rw [Finset.mem_erase, ← hmem x, hperm.mem_iff, List.mem_cons]
      constructor
      · intro hx
        exact ⟨fun h ↦ (List.nodup_cons.mp hnd').1 (h ▸ hx), Or.inr hx⟩
      · rintro ⟨hxt, hx | hx⟩
        · exact absurd hx hxt
        · exact hx
    obtain ⟨hnda₁, hta₁, hma₁⟩ := key l₁ u₁ v₁ e₁ hnd₁ h₁
    obtain ⟨hnda₂, _, hma₂⟩ := key l₂ u₂ v₂ e₂ hnd₂ h₂
    have hcard : (s.erase t).card = k := by rw [Finset.card_erase_of_mem hts]; omega
    have hmid := ih (s.erase t) hcard (u₁ ++ v₁) (u₂ ++ v₂) hnda₁ hnda₂ hma₁ hma₂
    have hinv : LeafInv G t i (u₁ ++ v₁) :=
      ⟨hnda₁, hta₁, fun x hx hxi ↦
        hleaf x (Finset.mem_of_mem_erase ((hma₁ x).mp hx))
          (Finset.ne_of_mem_erase ((hma₁ x).mp hx)) hxi⟩
    exact m₁.trans ((wordMoves_lift hmid hinv).trans m₂.symm)

/-- In an acyclic simple graph `G`, any two duplicate-free words that are permutations of each
other are related by commuting swaps along non-edges and cyclic rotations. -/
theorem wordMoves_of_isAcyclic {G : SimpleGraph B} (hG : G.IsAcyclic)
    {l₁ l₂ : List B} (hnd₁ : l₁.Nodup) (hperm : l₁.Perm l₂) :
    WordMoves G l₁ l₂ := by
  classical
  exact wordMoves_of_isAcyclic_aux hG l₁.toFinset.card l₁.toFinset rfl l₁ l₂
    hnd₁ (hperm.nodup_iff.mp hnd₁)
    (fun x ↦ by simp) (fun x ↦ by simp [hperm.mem_iff])

end WordMoves

/-! ### Conjugacy in monoids generated by involutions and in Coxeter systems -/

section MonoidConjugacy

variable {B W : Type*} [Monoid W] {G : SimpleGraph B} {s : B → W}

private lemma wordMoveStep_isConj (hs_inv : ∀ i, s i * s i = 1)
    (hs_comm : ∀ i j, ¬ G.Adj i j → s i * s j = s j * s i)
    {a b : List B} (h : WordMoveStep G a b) :
    IsConj ((a.map s).prod) ((b.map s).prod) := by
  cases h with
  | swap p q x y hxy =>
    have heq : ((p ++ x :: y :: q).map s).prod = ((p ++ y :: x :: q).map s).prod := by
      simp only [List.map_append, List.map_cons, List.prod_append, List.prod_cons]
      rw [← mul_assoc (s x), hs_comm x y hxy, mul_assoc]
    rw [heq]
  | rotate x r =>
    refine ⟨⟨s x, s x, hs_inv x, hs_inv x⟩, ?_⟩
    simp only [SemiconjBy, List.map_cons, List.prod_cons, List.map_append,
      List.prod_append, List.map_nil, List.prod_nil, mul_one]
    rw [← mul_assoc, hs_inv x, one_mul, mul_assoc, hs_inv x, mul_one]

/-- If `s : B → W` maps vertices to involutions that commute along non-edges of `G`, then
`WordMoves G a b` implies `(a.map s).prod` and `(b.map s).prod` are conjugate in `W`. -/
theorem WordMoves.isConj (hs_inv : ∀ i, s i * s i = 1)
    (hs_comm : ∀ i j, ¬ G.Adj i j → s i * s j = s j * s i)
    {a b : List B} (h : WordMoves G a b) :
    IsConj ((a.map s).prod) ((b.map s).prod) := by
  induction h with
  | rel _ _ h => exact wordMoveStep_isConj hs_inv hs_comm h
  | refl => exact IsConj.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- In any monoid `W` with involutions `s : B → W` commuting along non-edges of an acyclic graph
`G`, any two duplicate-free permutations of the same vertices have conjugate products. -/
theorem isConj_prod_map_of_isAcyclic (hG : G.IsAcyclic)
    (hs_inv : ∀ i, s i * s i = 1)
    (hs_comm : ∀ i j, ¬ G.Adj i j → s i * s j = s j * s i)
    {l₁ l₂ : List B} (hnd₁ : l₁.Nodup) (hperm : l₁.Perm l₂) :
    IsConj ((l₁.map s).prod) ((l₂.map s).prod) :=
  (wordMoves_of_isAcyclic hG hnd₁ hperm).isConj hs_inv hs_comm

end MonoidConjugacy

section CoxeterConjugacy

variable {B W : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

/-- Simple reflections corresponding to non-adjacent vertices of `M.graph` commute. -/
theorem simple_mul_simple_comm_of_not_adj {i j : B} (h : ¬ M.graph.Adj i j) :
    cs.simple i * cs.simple j = cs.simple j * cs.simple i := by
  by_cases hij : i = j
  · subst hij; rfl
  · have hM : M i j = 2 := by
      by_contra hne
      exact h ⟨hij, hne⟩
    have h2 : (cs.simple i * cs.simple j) * (cs.simple i * cs.simple j) = 1 := by
      simpa [sq, hM] using cs.simple_mul_simple_pow i j
    calc cs.simple i * cs.simple j
        = (cs.simple i * cs.simple j)⁻¹ := eq_inv_of_mul_eq_one_left h2
      _ = cs.simple j * cs.simple i := by rw [mul_inv_rev, cs.inv_simple, cs.inv_simple]

/-- In a Coxeter system whose Coxeter graph `M.graph` is acyclic (a forest), any two
duplicate-free permutations of the same set of generators yield conjugate elements of `W`. -/
theorem isConj_wordProd_of_isAcyclic (hG : M.graph.IsAcyclic)
    {l₁ l₂ : List B} (hnd₁ : l₁.Nodup) (hperm : l₁.Perm l₂) :
    IsConj (cs.wordProd l₁) (cs.wordProd l₂) :=
  isConj_prod_map_of_isAcyclic hG cs.simple_mul_simple_self
    (fun _ _ h ↦ cs.simple_mul_simple_comm_of_not_adj h) hnd₁ hperm

/-- In a Coxeter system whose Coxeter graph `M.graph` is a tree, any two duplicate-free
permutations of the same set of generators yield conjugate elements of `W`. -/
theorem isConj_wordProd_of_isTree (hG : M.graph.IsTree)
    {l₁ l₂ : List B} (hnd₁ : l₁.Nodup) (hperm : l₁.Perm l₂) :
    IsConj (cs.wordProd l₁) (cs.wordProd l₂) :=
  cs.isConj_wordProd_of_isAcyclic hG.isAcyclic hnd₁ hperm

/-- In a finite Coxeter system whose Coxeter graph `M.graph` is acyclic (a forest), any two
Coxeter elements (products listing every simple reflection exactly once) are conjugate in `W`. -/
theorem isConj_coxeterElement_of_isAcyclic (hG : M.graph.IsAcyclic)
    {l₁ l₂ : List B} (hnd₁ : l₁.Nodup) (hmem₁ : ∀ i : B, i ∈ l₁)
    (hnd₂ : l₂.Nodup) (hmem₂ : ∀ i : B, i ∈ l₂) :
    IsConj (cs.wordProd l₁) (cs.wordProd l₂) :=
  cs.isConj_wordProd_of_isAcyclic hG hnd₁
    ((List.perm_ext_iff_of_nodup hnd₁ hnd₂).mpr fun i ↦ by simp [hmem₁ i, hmem₂ i])

end CoxeterConjugacy

end CoxeterSystem
