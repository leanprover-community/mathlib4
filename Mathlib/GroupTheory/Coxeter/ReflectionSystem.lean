module

public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Data.Matrix.Basic
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs

import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# Reflection Systems over Symmetric Bilinear Forms

This file defines `ReflectionSystem ι K`, a coordinate-based reflection system over a field `K`
indexed by a finite type `ι`, given by a symmetric matrix `B : Matrix ι ι K` with nonzero
diagonal entries `B i i ≠ 0`.

This generalizes classical Coxeter geometric representations (where `B i i = 2`) to arbitrary
nondegenerate-diagonal symmetric bilinear forms, including mixed-sign Coxeter systems.

## Main definitions
* `ReflectionSystem ι K`: A symmetric matrix `B : Matrix ι ι K` with `∀ i, B i i ≠ 0`.
* `ReflectionSystem.reflectionMatrix`: The generating reflection `s_i` across the hyperplane
  orthogonal to `e_i`, given by `(s_i)_{r, c} = δ_{r, c} - δ_{r, i} * (2 * B i c / B i i)`.
* `ReflectionSystem.group`: The submonoid of `Matrix ι ι K` generated by the `reflectionMatrix`.
* `ReflectionSystem.toGL`: The faithful embedding `S.group →* Matrix.GeneralLinearGroup ι K`.

## Main results
* `ReflectionSystem.reflectionMatrix_mul_self`: `s_i * s_i = 1`.
* `ReflectionSystem.reflectionMatrix_preserves_form`: `s_iᵀ * B * s_i = B`.
* `ReflectionSystem.reflectionMatrix_comm_of_orthogonal`: `B i j = 0 → s_i * s_j = s_j * s_i`.
* `ReflectionSystem.reflectionMatrix_neg`: `reflectionMatrix (-B) i = reflectionMatrix B i`.
* `ReflectionSystem.group_preserves_form`: Every `w ∈ S.group` satisfies `wᵀ * B * w = B`.
* `ReflectionSystem.toGL_injective`: The natural map `S.group →* GL ι K` is injective.
-/

open Matrix

@[expose] public section

/-- A reflection system indexed by `ι` over a field `K`, determined by a symmetric matrix `B`
with nonzero diagonal entries. -/
structure ReflectionSystem (ι : Type*) (K : Type*) [Field K] where
  /-- The underlying symmetric bilinear form matrix. -/
  B : Matrix ι ι K
  /-- Symmetry of `B`. -/
  B_symm : B.IsSymm
  /-- Nondegeneracy of `B` on each basis vector `e_i`. -/
  B_diag_ne_zero : ∀ i : ι, B i i ≠ 0

namespace ReflectionSystem

variable {ι K : Type*} [DecidableEq ι] [Field K]

/-- The `i`-th generating reflection matrix `s_i` associated to a matrix `B`:
`(s_i)_{r, c} = δ_{r, c} - δ_{r, i} * (2 * B i c / B i i)`. -/
def reflectionMatrix (B : Matrix ι ι K) (i : ι) : Matrix ι ι K :=
  of fun r c => (if r = c then 1 else 0) - (if r = i then 2 * B i c / B i i else 0)

@[simp]
lemma reflectionMatrix_apply (B : Matrix ι ι K) (i r c : ι) :
    reflectionMatrix B i r c =
      (if r = c then 1 else 0) - (if r = i then 2 * B i c / B i i else 0) := rfl

lemma reflectionMatrix_apply_self (B : Matrix ι ι K) {i : ι} (h : B i i ≠ 0) :
    reflectionMatrix B i i i = -1 := by
  simp [h]
  field_simp
  ring

/-- Negating the bilinear form `B` yields the exact same generating reflections. -/
theorem reflectionMatrix_neg (B : Matrix ι ι K) (i : ι) :
    reflectionMatrix (-B) i = reflectionMatrix B i := by
  ext r c
  simp [neg_div, div_neg]

variable [Fintype ι]

/-- Every generating reflection `s_i` is an involution (`s_i * s_i = 1`). -/
theorem reflectionMatrix_mul_self (S : ReflectionSystem ι K) (i : ι) :
    reflectionMatrix S.B i * reflectionMatrix S.B i = 1 := by
  have hB : S.B i i ≠ 0 := S.B_diag_ne_zero i
  ext r c
  simp only [Matrix.mul_apply, Matrix.one_apply, reflectionMatrix_apply]
  have hsum : ∀ k : ι,
      ((if r = k then (1 : K) else 0) - (if r = i then 2 * S.B i k / S.B i i else 0)) *
        ((if k = c then (1 : K) else 0) - (if k = i then 2 * S.B i c / S.B i i else 0)) =
      (if k = r then if r = c then (1 : K) else 0 else 0)
        - (if k = r then if r = i then 2 * S.B i c / S.B i i else 0 else 0)
        - (if k = c then if r = i then 2 * S.B i k / S.B i i else 0 else 0)
        + (if k = i then if r = i then
            (2 * S.B i k / S.B i i) * (2 * S.B i c / S.B i i) else 0 else 0) := by
    intro k
    split_ifs <;> simp_all <;> ring
  simp_rw [hsum, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_ite_eq', Finset.mem_univ]
  simp only [ite_true]
  by_cases hri : r = i <;> simp [hri]
  field_simp
  ring

/-- Each generating reflection `s_i` preserves `B`: `s_iᵀ * B * s_i = B`. -/
theorem reflectionMatrix_preserves_form (S : ReflectionSystem ι K) (i : ι) :
    (reflectionMatrix S.B i)ᵀ * S.B * reflectionMatrix S.B i = S.B := by
  have hB : S.B i i ≠ 0 := S.B_diag_ne_zero i
  have hsymm : ∀ a b : ι, S.B a b = S.B b a := fun a b => by
    have := congrFun (congrFun S.B_symm b) a
    simpa using this
  ext r c
  simp only [Matrix.mul_apply, transpose_apply, reflectionMatrix_apply]
  have hleft : ∀ k : ι,
      (∑ x : ι, ((if x = r then (1 : K) else 0) -
          (if x = i then 2 * S.B i r / S.B i i else 0)) * S.B x k) =
      S.B r k - (2 * S.B i r / S.B i i) * S.B i k := by
    intro k
    have hsplit : ∀ x : ι,
        ((if x = r then (1 : K) else 0) -
            (if x = i then 2 * S.B i r / S.B i i else 0)) * S.B x k =
        (if x = r then S.B x k else 0) -
          (if x = i then (2 * S.B i r / S.B i i) * S.B x k else 0) := by
      intro x; split_ifs <;> ring
    simp_rw [hsplit, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ]
    simp only [ite_true]
  simp_rw [hleft]
  have hright : ∀ k : ι,
      (S.B r k - 2 * S.B i r / S.B i i * S.B i k) *
        ((if k = c then (1 : K) else 0) -
          (if k = i then 2 * S.B i c / S.B i i else 0)) =
      (if k = c then S.B r k - 2 * S.B i r / S.B i i * S.B i k else 0) -
        (if k = i then (S.B r k - 2 * S.B i r / S.B i i * S.B i k) *
          (2 * S.B i c / S.B i i) else 0) := by
    intro k; split_ifs <;> ring
  simp_rw [hright, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ]
  simp only [ite_true]
  rw [hsymm r i]
  field_simp
  ring

/-- Orthogonal reflections commute: if `B i j = 0`, then `s_i * s_j = s_j * s_i`. -/
theorem reflectionMatrix_comm_of_orthogonal (S : ReflectionSystem ι K) {i j : ι}
    (hij : S.B i j = 0) :
    reflectionMatrix S.B i * reflectionMatrix S.B j =
      reflectionMatrix S.B j * reflectionMatrix S.B i := by
  have hji : S.B j i = 0 := by
    have := congrFun (congrFun S.B_symm i) j
    simpa [hij] using this
  ext r c
  simp only [Matrix.mul_apply, reflectionMatrix_apply]
  have h1 : ∀ k : ι,
      ((if r = k then (1 : K) else 0) - (if r = i then 2 * S.B i k / S.B i i else 0)) *
        ((if k = c then (1 : K) else 0) - (if k = j then 2 * S.B j c / S.B j j else 0)) =
      (if k = r then if r = c then (1 : K) else 0 else 0)
        - (if k = r then if r = j then 2 * S.B j c / S.B j j else 0 else 0)
        - (if k = c then if r = i then 2 * S.B i k / S.B i i else 0 else 0)
        + (if k = j then if r = i then
            (2 * S.B i j / S.B i i) * (2 * S.B j c / S.B j j) else 0 else 0) := by
    intro k; split_ifs <;> simp_all
  have h2 : ∀ k : ι,
      ((if r = k then (1 : K) else 0) - (if r = j then 2 * S.B j k / S.B j j else 0)) *
        ((if k = c then (1 : K) else 0) - (if k = i then 2 * S.B i c / S.B i i else 0)) =
      (if k = r then if r = c then (1 : K) else 0 else 0)
        - (if k = r then if r = i then 2 * S.B i c / S.B i i else 0 else 0)
        - (if k = c then if r = j then 2 * S.B j k / S.B j j else 0 else 0)
        + (if k = i then if r = j then
            (2 * S.B j i / S.B j j) * (2 * S.B i c / S.B i i) else 0 else 0) := by
    clear h1
    intro k; split_ifs <;> simp_all
  simp_rw [h1]
  simp_rw [h2]
  simp_rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ]
  simp only [ite_true, hij, hji, zero_mul, mul_zero, zero_div, ite_self]
  ring

/-- The reflection group `S.group` as the matrix submonoid generated by `reflectionMatrix S.B`. -/
def group (S : ReflectionSystem ι K) : Submonoid (Matrix ι ι K) :=
  Submonoid.closure (Set.range (reflectionMatrix S.B))

/-- Every element `w ∈ S.group` preserves `S.B`: `wᵀ * B * w = B`. -/
theorem group_preserves_form (S : ReflectionSystem ι K) {w : Matrix ι ι K} (hw : w ∈ S.group) :
    wᵀ * S.B * w = S.B := by
  induction hw using Submonoid.closure_induction with
  | mem _ hx =>
    obtain ⟨i, rfl⟩ := hx
    exact S.reflectionMatrix_preserves_form i
  | one => simp
  | mul x y _ _ ihx ihy =>
    calc (x * y)ᵀ * S.B * (x * y)
        = yᵀ * (xᵀ * S.B * x) * y := by rw [Matrix.transpose_mul]; simp only [mul_assoc]
      _ = yᵀ * S.B * y := by rw [ihx]
      _ = S.B := ihy

/-- Every element `w ∈ S.group` is invertible, with inverse also in `S.group`. -/
theorem group_has_inv (S : ReflectionSystem ι K) {w : Matrix ι ι K} (hw : w ∈ S.group) :
    ∃ v ∈ S.group, w * v = 1 ∧ v * w = 1 := by
  induction hw using Submonoid.closure_induction with
  | mem _ hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨reflectionMatrix S.B i, Submonoid.subset_closure ⟨i, rfl⟩,
      S.reflectionMatrix_mul_self i, S.reflectionMatrix_mul_self i⟩
  | one => exact ⟨1, S.group.one_mem, one_mul 1, one_mul 1⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨vx, hvx, hx1, hx2⟩ := ihx
    obtain ⟨vy, hvy, hy1, hy2⟩ := ihy
    refine ⟨vy * vx, S.group.mul_mem hvy hvx, ?_, ?_⟩
    · calc (x * y) * (vy * vx) = x * ((y * vy) * vx) := by simp only [mul_assoc]
        _ = x * vx := by rw [hy1, one_mul]
        _ = 1 := hx1
    · calc (vy * vx) * (x * y) = vy * ((vx * x) * y) := by simp only [mul_assoc]
        _ = vy * y := by rw [hx2, one_mul]
        _ = 1 := hy2

/-- The faithful embedding of `S.group` into `Matrix.GeneralLinearGroup ι K`. -/
noncomputable def toGL (S : ReflectionSystem ι K) :
    S.group →* Matrix.GeneralLinearGroup ι K where
  toFun w :=
    let v := Classical.choose (S.group_has_inv w.property)
    have hv := Classical.choose_spec (S.group_has_inv w.property)
    ⟨w.val, v, hv.2.1, hv.2.2⟩
  map_one' := by ext1; rfl
  map_mul' _ _ := by ext1; rfl

theorem toGL_injective (S : ReflectionSystem ι K) :
    Function.Injective S.toGL := by
  intro w₁ w₂ h
  ext1
  exact congrArg Units.val h

end ReflectionSystem
