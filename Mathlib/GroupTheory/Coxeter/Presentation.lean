module

public import Mathlib.GroupTheory.Coxeter.Deletion
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Coxeter Presentation from the Deletion and Exchange Properties

This file proves the converse to `CoxeterSystem.deletion` and `CoxeterSystem.exchange`:
a group `W` generated by a family of distinct involutions `s : B → W` satisfying the Deletion
Property (equivalently, the Exchange Property) is a Coxeter group with Coxeter matrix
`M i j = orderOf (s i * s j)`.

Together with `Mathlib/GroupTheory/Coxeter/Deletion.lean`, this establishes the classical
equivalence between Coxeter systems, the Deletion Property, and the Exchange Property.

## Main definitions
* `CoxeterSystem.IsReducedWord`: A word `ω : List B` has minimal length among words with the same
  product `(ω.map s).prod`.
* `CoxeterSystem.HasDeletionProperty`: Every non-reduced word admits two indices `i < j` whose
  removal preserves the product.
* `CoxeterSystem.HasExchangeProperty`: Left exchange property for reduced words.
* `CoxeterSystem.orderCoxeterMatrix`: The Coxeter matrix `M i j = orderOf (s i * s j)`.
* `CoxeterSystem.orderCoxeterLift`: The canonical homomorphism `M.Group →* W`.
* `CoxeterSystem.ofDeletion` / `CoxeterSystem.ofExchange`: The `CoxeterSystem` constructed from
  a generating family of distinct involutions satisfying Deletion / Exchange.

## Main results
* `CoxeterSystem.hasDeletionProperty`: Every `CoxeterSystem` satisfies `HasDeletionProperty`.
* `CoxeterSystem.hasDeletionProperty_iff_hasExchangeProperty`: Equivalence of Deletion and
  Exchange for any family of involutions.
* `CoxeterSystem.wordProd_eq_of_isReducedWord_of_length_eq`: Matsumoto-type lemma for reduced
  words of the same length.
* `CoxeterSystem.orderCoxeterMatrix_isLiftable`: `CoxeterMatrix.IsLiftable` for the order matrix.
* `CoxeterSystem.orderCoxeterLift_injective_of_deletion`: Injectivity of `M.Group →* W`.
* `CoxeterSystem.exists_coxeterSystem_iff_hasDeletionProperty`: Full `CoxeterSystem ↔ Deletion`
  equivalence.
* `CoxeterSystem.exists_coxeterSystem_iff_hasExchangeProperty`: Full `CoxeterSystem ↔ Exchange`
  equivalence.
-/

@[expose] public section

namespace CoxeterSystem

/-! ### Reduced words, Deletion, and Exchange for arbitrary families of involutions -/

section Predicates

variable {B W : Type*} [Monoid W]

/-- A word `ω : List B` is reduced with respect to `s : B → W` if no strictly shorter word has
the same product `(ω.map s).prod`. -/
def IsReducedWord (s : B → W) (ω : List B) : Prop :=
  ∀ u : List B, u.length < ω.length → (ω.map s).prod ≠ (u.map s).prod

/-- A family `s : B → W` satisfies the **Deletion Property** if every non-reduced word `ω` admits
two indices `i < j < ω.length` whose removal preserves `(ω.map s).prod`. -/
def HasDeletionProperty (s : B → W) : Prop :=
  ∀ ω : List B, (∃ u : List B, u.length < ω.length ∧ (ω.map s).prod = (u.map s).prod) →
    ∃ i j : ℕ, i < j ∧ j < ω.length ∧
      (((ω.eraseIdx j).eraseIdx i).map s).prod = (ω.map s).prod

/-- A family `s : B → W` satisfies the **(Left) Exchange Property** if whenever `ω` is reduced
and `i :: ω` is not reduced, there exists `j < ω.length` such that
`((i :: ω).map s).prod = ((ω.eraseIdx j).map s).prod`. -/
def HasExchangeProperty (s : B → W) : Prop :=
  ∀ (i : B) (ω : List B), IsReducedWord s ω →
    (∃ u : List B, u.length < (i :: ω).length ∧ ((i :: ω).map s).prod = (u.map s).prod) →
    ∃ j : ℕ, j < ω.length ∧ ((i :: ω).map s).prod = ((ω.eraseIdx j).map s).prod

/-- Deletion implies Exchange for any family of involutions. -/
theorem hasExchangeProperty_of_hasDeletionProperty {s : B → W} (hs : ∀ i, s i * s i = 1)
    (hdel : HasDeletionProperty s) : HasExchangeProperty s := by
  intro c ω hred hshort
  obtain ⟨i, j, hij, hj, heq⟩ := hdel (c :: ω) hshort
  cases i with
  | zero =>
    cases j with
    | zero => exact absurd hij (Nat.lt_irrefl 0)
    | succ k =>
      refine ⟨k, by simp only [List.length_cons] at hj; omega, ?_⟩
      simpa only [List.eraseIdx_cons_succ, List.eraseIdx_cons_zero] using heq.symm
  | succ i' =>
    cases j with
    | zero => exact absurd hij (Nat.not_lt_zero _)
    | succ j' =>
      exfalso
      have hj' : j' < ω.length := by simp only [List.length_cons] at hj; omega
      have hi' : i' < (ω.eraseIdx j').length := by
        rw [List.length_eraseIdx_of_lt hj']
        omega
      have hlen : ((ω.eraseIdx j').eraseIdx i').length < ω.length := by
        rw [List.length_eraseIdx_of_lt hi', List.length_eraseIdx_of_lt hj']
        omega
      simp only [List.eraseIdx_cons_succ, List.map_cons, List.prod_cons] at heq
      have hprod : (((ω.eraseIdx j').eraseIdx i').map s).prod = (ω.map s).prod := by
        have h1 := congrArg (s c * ·) heq
        simpa only [← mul_assoc, hs c, one_mul] using h1
      exact hred ((ω.eraseIdx j').eraseIdx i') hlen hprod.symm

/-- Exchange implies Deletion. -/
theorem hasDeletionProperty_of_hasExchangeProperty {s : B → W}
    (hex : HasExchangeProperty s) : HasDeletionProperty s := by
  intro ω
  induction ω with
  | nil =>
    rintro ⟨u, hu, _⟩
    simp at hu
  | cons c t ih =>
    intro hshort
    by_cases ht : IsReducedWord s t
    · obtain ⟨k, hk, heq⟩ := hex c t ht hshort
      refine ⟨0, k + 1, Nat.zero_lt_succ k, by simp only [List.length_cons]; omega, ?_⟩
      simpa only [List.eraseIdx_cons_succ, List.eraseIdx_cons_zero] using heq.symm
    · have ht' : ∃ u : List B, u.length < t.length ∧ (t.map s).prod = (u.map s).prod := by
        by_contra h
        apply ht
        intro u hu heq
        exact h ⟨u, hu, heq⟩
      obtain ⟨i, j, hij, hj, hdel⟩ := ih ht'
      refine ⟨i + 1, j + 1, Nat.succ_lt_succ hij, by simp only [List.length_cons]; omega, ?_⟩
      simp only [List.eraseIdx_cons_succ, List.map_cons, List.prod_cons]
      exact congrArg (s c * ·) hdel

/-- For any family of involutions, the Deletion Property and the Exchange Property are
equivalent. -/
theorem hasDeletionProperty_iff_hasExchangeProperty {s : B → W} (hs : ∀ i, s i * s i = 1) :
    HasDeletionProperty s ↔ HasExchangeProperty s :=
  ⟨hasExchangeProperty_of_hasDeletionProperty hs, hasDeletionProperty_of_hasExchangeProperty⟩

end Predicates

section FromCoxeterSystem

variable {B W : Type*} [Group W] {M : CoxeterMatrix B}

/-- For a `CoxeterSystem`, `IsReducedWord cs.simple ω` agrees with `cs.IsReduced ω`. -/
theorem isReducedWord_simple_iff (cs : CoxeterSystem M W) (ω : List B) :
    IsReducedWord cs.simple ω ↔ cs.IsReduced ω := by
  constructor
  · intro hred
    apply le_antisymm (cs.length_wordProd_le ω)
    by_contra hlt
    obtain ⟨u, hu_red, hu_eq⟩ := cs.exists_isReduced (cs.wordProd ω)
    have hulen : u.length < ω.length := by
      have : cs.length (cs.wordProd ω) < ω.length := Nat.lt_of_not_le hlt
      rw [hu_eq, hu_red] at this
      exact this
    exact hred u hulen hu_eq
  · intro hred u hu heq
    have hle : cs.length (cs.wordProd u) ≤ u.length := cs.length_wordProd_le u
    change cs.wordProd ω = cs.wordProd u at heq
    rw [← heq, hred] at hle
    exact Nat.not_lt_of_ge hle hu

/-- Every `CoxeterSystem` satisfies `HasDeletionProperty`. -/
theorem hasDeletionProperty (cs : CoxeterSystem M W) : HasDeletionProperty cs.simple :=
  fun _ hω => cs.deletion hω

/-- Every `CoxeterSystem` satisfies `HasExchangeProperty`. -/
theorem hasExchangeProperty (cs : CoxeterSystem M W) : HasExchangeProperty cs.simple :=
  hasExchangeProperty_of_hasDeletionProperty cs.simple_mul_simple_self cs.hasDeletionProperty

end FromCoxeterSystem

/-! ### Alternating words and word helpers -/

section AlternatingWords

/-- The alternating word `a, b, a, b, ...` of length `k`, built by consing on the left. -/
private def altWord {α : Type*} (a b : α) : ℕ → List α
  | 0 => []
  | k + 1 => a :: altWord b a k

private lemma length_altWord {α : Type*} (a b : α) (k : ℕ) : (altWord a b k).length = k := by
  induction k generalizing a b with
  | zero => rfl
  | succ k ih => simp [altWord, ih]

private lemma altWord_eq_alternatingWord {α : Type*} (a b : α) (k : ℕ) :
    altWord a b k = if Even k then alternatingWord a b k else alternatingWord b a k := by
  induction k generalizing a b with
  | zero => simp [altWord, alternatingWord]
  | succ k ih =>
    rw [altWord, ih b a]
    by_cases hk : Even k
    · have hodd : ¬ Even (k + 1) := by simpa [Nat.even_add_one] using hk
      simp [hk, hodd, alternatingWord_succ']
    · have heven : Even (k + 1) := by simpa [Nat.even_add_one] using hk
      simp [hk, heven, alternatingWord_succ']

private lemma cons_dropLast_altWord {α : Type*} (a b : α) (k : ℕ) :
    b :: (altWord a b (k + 1)).dropLast = altWord b a (k + 1) := by
  induction k generalizing a b with
  | zero => rfl
  | succ k ih =>
    have hne : altWord b a (k + 1) ≠ [] := by simp [altWord]
    rw [altWord, List.dropLast_cons_of_ne_nil hne, ih b a]
    rfl

private lemma dropLast_eq_eraseIdx' {α : Type*} {l : List α} {j : ℕ} (hj : j + 1 = l.length) :
    l.dropLast = l.eraseIdx j := by
  rw [List.eraseIdx_eq_take_drop_succ, List.drop_eq_nil_of_le (by omega), List.append_nil,
    List.dropLast_eq_take]
  congr 1
  omega

private lemma exists_split {α : Type*} (V : List α) (j : ℕ) (hj : j < V.length) :
    ∃ P x R, V = P ++ x :: R ∧ P.length = j ∧ V.eraseIdx j = P ++ R := by
  refine ⟨V.take j, V[j], V.drop (j + 1), ?_, ?_, ?_⟩
  · rw [← List.drop_eq_getElem_cons hj, List.take_append_drop]
  · simp only [List.length_take]; omega
  · exact List.eraseIdx_eq_take_drop_succ V j

variable {G α : Type*} [Monoid G] (f : α → G)

private lemma prod_map_mul_prod_map_reverse (hf : ∀ i, f i * f i = 1) (w : List α) :
    (w.map f).prod * (w.reverse.map f).prod = 1 := by
  induction w with
  | nil => simp
  | cons a t ih =>
    simp only [List.map_cons, List.prod_cons, List.reverse_cons, List.map_append,
      List.prod_append, List.map_nil, List.prod_nil, mul_one]
    calc f a * (t.map f).prod * ((t.reverse.map f).prod * f a)
        = f a * ((t.map f).prod * (t.reverse.map f).prod) * f a := by simp only [mul_assoc]
      _ = 1 := by rw [ih, mul_one, hf]

private lemma prod_altWord (hf : ∀ i, f i * f i = 1) (a b : α) (k : ℕ) :
    ((altWord a b k).map f).prod = (f a * f b) ^ k * ((altWord b a k).map f).prod := by
  induction k generalizing a b with
  | zero => simp [altWord]
  | succ k ih =>
    simp only [altWord, List.map_cons, List.prod_cons]
    rw [ih b a]
    set X := ((altWord a b k).map f).prod
    have hsc : f a * (f b * f a) ^ k = (f a * f b) ^ k * f a :=
      (SemiconjBy.pow_right (show SemiconjBy (f a) (f b * f a) (f a * f b) by
        unfold SemiconjBy; simp only [mul_assoc]) k).eq
    calc f a * ((f b * f a) ^ k * X) = (f a * (f b * f a) ^ k) * X := by rw [mul_assoc]
      _ = (f a * f b) ^ k * f a * X := by rw [hsc]
      _ = (f a * f b) ^ k * (f a * f b) * (f b * X) := by
        simp only [mul_assoc, ← mul_assoc (f b) (f b), hf, one_mul]
      _ = (f a * f b) ^ (k + 1) * (f b * X) := by rw [pow_succ]

private lemma prod_altWord_eq_iff (hf : ∀ i, f i * f i = 1) (a b : α) (k : ℕ) :
    ((altWord a b k).map f).prod = ((altWord b a k).map f).prod ↔ (f a * f b) ^ k = 1 := by
  constructor
  · intro h
    have h1 := prod_altWord f hf a b k
    rw [h] at h1
    have h2 := congrArg (· * ((altWord b a k).reverse.map f).prod) h1
    simp only [mul_assoc, prod_map_mul_prod_map_reverse f hf, mul_one] at h2
    exact h2.symm
  · intro h
    rw [prod_altWord f hf a b k, h, one_mul]

private lemma wp_cancel_right {s : α → G} (hs : ∀ i, s i * s i = 1)
    {u v : List α} (c : List α)
    (h : ((u ++ c).map s).prod = ((v ++ c).map s).prod) :
    (u.map s).prod = (v.map s).prod := by
  have h2 := congrArg (· * (c.reverse.map s).prod) h
  simpa only [List.map_append, List.prod_append, mul_assoc,
    prod_map_mul_prod_map_reverse s hs, mul_one] using h2

private lemma wp_cons_cons {s : α → G} (hs : ∀ i, s i * s i = 1) (c : α) (u : List α) :
    ((c :: c :: u).map s).prod = (u.map s).prod := by
  simp only [List.map_cons, List.prod_cons, ← mul_assoc, hs c, one_mul]

private lemma wp_swap {s : α → G} (hs : ∀ i, s i * s i = 1) {u v : List α} (c : α)
    (h : ((c :: u).map s).prod = (v.map s).prod) :
    (u.map s).prod = ((c :: v).map s).prod := by
  rw [List.map_cons, List.prod_cons, ← h, ← List.prod_cons, ← List.map_cons, wp_cons_cons hs]

private lemma wp_shift {s : α → G} (hs : ∀ i, s i * s i = 1) {P R : List α} {c x : α}
    (h : ((c :: (P ++ x :: R)).map s).prod = ((P ++ R).map s).prod) :
    ((P ++ [x]).map s).prod = ((c :: P).map s).prod := by
  have h1 : (((c :: P ++ [x]) ++ R).map s).prod = ((P ++ R).map s).prod := by simpa using h
  have h2 := wp_cancel_right hs R h1
  simp only [List.cons_append, List.map_cons, List.prod_cons, List.map_append,
    List.prod_append, List.map_nil, List.prod_nil, mul_one] at h2 ⊢
  calc (P.map s).prod * s x
      = s c * (s c * ((P.map s).prod * s x)) := by simp only [← mul_assoc, hs c, one_mul]
    _ = s c * (P.map s).prod := by rw [h2]

private lemma isReducedWord_append_left {s : α → G} {u v : List α}
    (h : IsReducedWord s (u ++ v)) : IsReducedWord s u := by
  intro u' hu' heq
  apply h (u' ++ v) (by simp only [List.length_append]; omega)
  simp only [List.map_append, List.prod_append, heq]

private lemma isReducedWord_append_right {s : α → G} {u v : List α}
    (h : IsReducedWord s (u ++ v)) : IsReducedWord s v := by
  intro v' hv' heq
  apply h (u ++ v') (by simp only [List.length_append]; omega)
  simp only [List.map_append, List.prod_append, heq]

private lemma isReducedWord_tail {s : α → G} {c : α} {u : List α}
    (h : IsReducedWord s (c :: u)) : IsReducedWord s u :=
  isReducedWord_append_right (u := [c]) h

private lemma isReducedWord_of_eq {s : α → G} {u v : List α} (hu : IsReducedWord s u)
    (heq : (u.map s).prod = (v.map s).prod) (hlen : v.length ≤ u.length) :
    IsReducedWord s v := by
  intro v' hv' h'
  exact hu v' (by omega) (heq.trans h')

private lemma length_le_of_isReducedWord {s : α → G} {u v : List α} (hu : IsReducedWord s u)
    (heq : (u.map s).prod = (v.map s).prod) : u.length ≤ v.length := by
  by_contra h
  exact hu v (by omega) heq

private lemma exists_isReducedWord (s : α → G) (w : List α) :
    ∃ v, IsReducedWord s v ∧ (v.map s).prod = (w.map s).prod := by
  classical
  have hex : ∃ k, ∃ v : List α, v.length = k ∧ (v.map s).prod = (w.map s).prod :=
    ⟨_, w, rfl, rfl⟩
  obtain ⟨v, hvlen, hv⟩ := Nat.find_spec hex
  refine ⟨v, ?_, hv⟩
  intro u hu heq
  exact Nat.find_min hex (by omega) ⟨u, rfl, heq.symm.trans hv⟩

private lemma gamma_swap {B : Type*} (M : CoxeterMatrix B) {u v : List B} (c : B)
    (h : M.toCoxeterSystem.wordProd (c :: u) = M.toCoxeterSystem.wordProd v) :
    M.toCoxeterSystem.wordProd u = M.toCoxeterSystem.wordProd (c :: v) := by
  rw [M.toCoxeterSystem.wordProd_cons, ← h, M.toCoxeterSystem.wordProd_cons,
    M.toCoxeterSystem.simple_mul_simple_cancel_left]

private lemma gamma_shift {B : Type*} (M : CoxeterMatrix B) {P R : List B} {c x : B}
    (h : M.toCoxeterSystem.wordProd (P ++ [x]) = M.toCoxeterSystem.wordProd (c :: P)) :
    M.toCoxeterSystem.wordProd (c :: (P ++ x :: R)) = M.toCoxeterSystem.wordProd (P ++ R) := by
  have : c :: (P ++ x :: R) = (c :: P) ++ [x] ++ R := by simp
  rw [this, M.toCoxeterSystem.wordProd_append, M.toCoxeterSystem.wordProd_append, ← h,
    M.toCoxeterSystem.wordProd_append, M.toCoxeterSystem.wordProd_append]
  simp only [CoxeterSystem.wordProd, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil, mul_one, mul_assoc, M.toCoxeterSystem.simple_mul_simple_cancel_left]

end AlternatingWords

/-! ### Matsumoto-type lemma and Coxeter presentation -/

section Matsumoto

variable {B W : Type*} [Monoid W] {s : B → W} {M : CoxeterMatrix B}

/-- If `M i j = orderOf (s i * s j)` for all `i, j`, then every braid relation holding under `s`
also holds in `M.Group`. -/
theorem wordProd_alternatingWord_eq_of_orderOf (hs : ∀ i, s i * s i = 1)
    (hM : ∀ i j, orderOf (s i * s j) = M i j) (a b : B) (k : ℕ)
    (h : ((alternatingWord a b k).map s).prod = ((alternatingWord b a k).map s).prod) :
    M.toCoxeterSystem.wordProd (alternatingWord a b k) =
      M.toCoxeterSystem.wordProd (alternatingWord b a k) := by
  have halt : ((altWord a b k).map s).prod = ((altWord b a k).map s).prod := by
    rw [altWord_eq_alternatingWord a b k, altWord_eq_alternatingWord b a k]
    split_ifs
    · exact h
    · exact h.symm
  have h1 := (prod_altWord_eq_iff s hs a b k).1 halt
  have hdvd : M a b ∣ k := hM a b ▸ orderOf_dvd_of_pow_eq_one h1
  obtain ⟨c, rfl⟩ := hdvd
  have h2 : M.toCoxeterSystem.wordProd (altWord a b (M a b * c)) =
      M.toCoxeterSystem.wordProd (altWord b a (M a b * c)) :=
    (prod_altWord_eq_iff M.toCoxeterSystem.simple M.toCoxeterSystem.simple_mul_simple_self
      a b _).2 (by rw [pow_mul, M.toCoxeterSystem.simple_mul_simple_pow, one_pow])
  rw [altWord_eq_alternatingWord a b _, altWord_eq_alternatingWord b a _] at h2
  split_ifs at h2
  · exact h2
  · exact h2.symm

/-- **Matsumoto-type lemma**: if `s : B → W` is a family of involutions satisfying the Exchange
Property and every braid relation of `s` holds in `M.Group`, then any two reduced words of the
same length with the same product under `s` have the same product in `M.Group`. -/
theorem wordProd_eq_of_isReducedWord_of_length_eq (hs : ∀ i, s i * s i = 1)
    (hex : HasExchangeProperty s)
    (hbraid : ∀ a b k,
      ((alternatingWord a b k).map s).prod = ((alternatingWord b a k).map s).prod →
      M.toCoxeterSystem.wordProd (alternatingWord a b k) =
        M.toCoxeterSystem.wordProd (alternatingWord b a k)) :
    ∀ (q : ℕ) (u v : List B), u.length = q → v.length = q → IsReducedWord s u →
      (u.map s).prod = (v.map s).prod →
      M.toCoxeterSystem.wordProd u = M.toCoxeterSystem.wordProd v := by
  have hbraid' : ∀ a b k,
      ((altWord a b k).map s).prod = ((altWord b a k).map s).prod →
      M.toCoxeterSystem.wordProd (altWord a b k) = M.toCoxeterSystem.wordProd (altWord b a k) := by
    intro a b k h
    rw [altWord_eq_alternatingWord a b k, altWord_eq_alternatingWord b a k] at h ⊢
    split_ifs at h ⊢
    · exact hbraid a b k h
    · exact (hbraid a b k h.symm).symm
  intro q
  induction q using Nat.strong_induction_on with
  | _ q ihq =>
  have shift : ∀ (V : List B) (c : B) (j : ℕ), V.length = q → IsReducedWord s V →
      j + 1 < q → ((c :: V).map s).prod = ((V.eraseIdx j).map s).prod →
      M.toCoxeterSystem.wordProd (c :: V) = M.toCoxeterSystem.wordProd (V.eraseIdx j) := by
    intro V c j hV hred hj h
    obtain ⟨P, x, R, rfl, hP, herase⟩ := exists_split V j (by omega)
    rw [herase] at h ⊢
    apply gamma_shift
    have hred' : IsReducedWord s (P ++ [x]) :=
      isReducedWord_append_left (v := R) (by simpa using hred)
    exact ihq (j + 1) (by omega) (P ++ [x]) (c :: P) (by simp [hP]) (by simp [hP]) hred'
      (wp_shift hs h)
  have claim : ∀ (m : ℕ) (a b : B) (k : ℕ) (z : List B), z.length = m →
      k + m = q → 1 ≤ k → IsReducedWord s (altWord a b k ++ z) →
      ((altWord a b k ++ z).map s).prod = ((b :: (altWord a b k ++ z).dropLast).map s).prod →
      M.toCoxeterSystem.wordProd (altWord a b k ++ z) =
        M.toCoxeterSystem.wordProd (b :: (altWord a b k ++ z).dropLast) := by
    intro m
    induction m with
    | zero =>
      intro a b k z hz hkq hk _ h
      obtain rfl : z = [] := List.eq_nil_of_length_eq_zero hz
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [List.append_nil, cons_dropLast_altWord] at h ⊢
      exact hbraid' a b _ h
    | succ m ihm =>
      intro a b k z hz hkq hk hred h
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      have hzne : z ≠ [] := by rintro rfl; simp at hz
      set U := altWord a b (k' + 1) ++ z with hU
      set T := altWord b a k' ++ z with hT
      have hUT : U = a :: T := rfl
      have hUlen : U.length = q := by simp [hU, length_altWord, hz]; omega
      set V := b :: U.dropLast with hV
      have hVlen : V.length = q := by simp [hV, hUlen]; omega
      have hVred : IsReducedWord s V := isReducedWord_of_eq hred h (by omega)
      have hTred : IsReducedWord s T := isReducedWord_tail (hUT ▸ hred)
      have haV : ((a :: V).map s).prod = (T.map s).prod := by
        rw [List.map_cons, List.prod_cons, ← h, hUT, ← List.prod_cons, ← List.map_cons,
          wp_cons_cons hs]
      obtain ⟨j, hj, hjeq⟩ := hex a V hVred ⟨T, by simp [hT, length_altWord, hVlen, hz]; omega, haV⟩
      have hTlen : T.length = q - 1 := by simp [hT, length_altWord, hz]; omega
      by_cases hjq : j + 1 < q
      · have h1 := shift V a j hVlen hVred hjq hjeq
        have h2 : M.toCoxeterSystem.wordProd T = M.toCoxeterSystem.wordProd (V.eraseIdx j) :=
          ihq (q - 1) (by omega) T _ hTlen (by rw [List.length_eraseIdx_of_lt hj]; omega)
            hTred (haV.symm.trans hjeq)
        rw [hUT, M.toCoxeterSystem.wordProd_cons, h2, ← M.toCoxeterSystem.wordProd_cons]
        exact (gamma_swap M a h1).symm
      · rw [← dropLast_eq_eraseIdx' (by omega : j + 1 = V.length)] at hjeq
        have hVdrop : V = altWord b a (k' + 2) ++ z.dropLast := by
          rw [hV, hU, List.dropLast_append_of_ne_nil hzne]; rfl
        have hnext := ihm b a (k' + 2) z.dropLast (by simp [hz]) (by omega) (by omega)
          (hVdrop ▸ hVred) (hVdrop ▸ wp_swap hs a hjeq)
        rw [← hVdrop] at hnext
        have h2 : M.toCoxeterSystem.wordProd T = M.toCoxeterSystem.wordProd V.dropLast :=
          ihq (q - 1) (by omega) T _ hTlen (by simp only [List.length_dropLast, hVlen]) hTred
            (haV.symm.trans hjeq)
        rw [hnext, hUT, M.toCoxeterSystem.wordProd_cons, h2, ← M.toCoxeterSystem.wordProd_cons]
  intro u v hu hv hred heq
  rcases v with _ | ⟨c, v'⟩
  · simp only [List.length_nil] at hv
    subst hv
    rw [List.eq_nil_of_length_eq_zero hu]
  · have hvred : IsReducedWord s (c :: v') := isReducedWord_of_eq hred heq (by omega)
    have hv'red : IsReducedWord s v' := isReducedWord_tail hvred
    have hcu : ((c :: u).map s).prod = (v'.map s).prod := by
      rw [List.map_cons, List.prod_cons, heq, ← List.prod_cons, ← List.map_cons, wp_cons_cons hs]
    obtain ⟨j, hj, hjeq⟩ := hex c u hred ⟨v', by simp only [List.length_cons] at hv ⊢; omega, hcu⟩
    have hv'len : v'.length = q - 1 := by simp only [List.length_cons] at hv; omega
    have h2 : M.toCoxeterSystem.wordProd v' = M.toCoxeterSystem.wordProd (u.eraseIdx j) :=
      ihq (q - 1) (by omega) v' _ hv'len (by rw [List.length_eraseIdx_of_lt hj]; omega)
        hv'red (hcu.symm.trans hjeq)
    by_cases hjq : j + 1 < q
    · have h1 := shift u c j hu hred hjq hjeq
      rw [M.toCoxeterSystem.wordProd_cons, h2]
      exact gamma_swap M c h1
    · rw [← dropLast_eq_eraseIdx' (by omega : j + 1 = u.length)] at hjeq h2
      rcases u with _ | ⟨t, u'⟩
      · simp at hj
      · have hc := claim (q - 1) t c 1 u' (by simp only [List.length_cons] at hu; omega)
          (by simp only [List.length_cons] at hu; omega) le_rfl
          (by simpa [altWord] using hred) (by simpa [altWord] using wp_swap hs c hjeq)
        simp only [altWord, List.singleton_append] at hc
        rw [hc, M.toCoxeterSystem.wordProd_cons c v', h2, M.toCoxeterSystem.wordProd_cons]

/-- Under the Exchange Property and the braid hypothesis, any word `ω` with the same product
under `s` as a reduced word `u` has the same product in `M.Group` as `u`. -/
theorem wordProd_eq_of_isReducedWord (hs : ∀ i, s i * s i = 1) (hex : HasExchangeProperty s)
    (hbraid : ∀ a b k,
      ((alternatingWord a b k).map s).prod = ((alternatingWord b a k).map s).prod →
      M.toCoxeterSystem.wordProd (alternatingWord a b k) =
        M.toCoxeterSystem.wordProd (alternatingWord b a k))
    (ω u : List B) (hu : IsReducedWord s u) (h : (ω.map s).prod = (u.map s).prod) :
    M.toCoxeterSystem.wordProd ω = M.toCoxeterSystem.wordProd u := by
  have hML := wordProd_eq_of_isReducedWord_of_length_eq hs hex hbraid
  have hsame : ∀ u₁ u₂ : List B, IsReducedWord s u₁ → IsReducedWord s u₂ →
      (u₁.map s).prod = (u₂.map s).prod →
      M.toCoxeterSystem.wordProd u₁ = M.toCoxeterSystem.wordProd u₂ := by
    intro u₁ u₂ hu₁ hu₂ heq
    have h1 := length_le_of_isReducedWord hu₁ heq
    have h2 := length_le_of_isReducedWord hu₂ heq.symm
    exact hML u₁.length u₁ u₂ rfl (by omega) hu₁ heq
  induction ω generalizing u with
  | nil =>
    have hlen := length_le_of_isReducedWord hu h.symm
    simp only [List.length_nil, Nat.le_zero, List.length_eq_zero_iff] at hlen
    rw [hlen]
  | cons c t ih =>
    obtain ⟨v, hvred, hv⟩ := exists_isReducedWord s t
    have hγt := ih v hvred hv.symm
    have hcv : ((c :: v).map s).prod = ((c :: t).map s).prod := by
      simp only [List.map_cons, List.prod_cons, hv]
    rw [M.toCoxeterSystem.wordProd_cons, hγt, ← M.toCoxeterSystem.wordProd_cons]
    by_cases hr : IsReducedWord s (c :: v)
    · exact hsame _ _ hr hu (hcv.trans h)
    · have hr' : ∃ y : List B, y.length < (c :: v).length ∧
          ((c :: v).map s).prod = (y.map s).prod := by
        by_contra hno
        apply hr
        intro y hy heq
        exact hno ⟨y, hy, heq⟩
      obtain ⟨k, hk, hkeq⟩ := hex c v hvred hr'
      have hered : IsReducedWord s (v.eraseIdx k) := by
        intro y hy hyeq
        apply hvred (c :: y) (by rw [List.length_eraseIdx_of_lt hk] at hy; simp; omega)
        calc (v.map s).prod = ((c :: c :: v).map s).prod := (wp_cons_cons hs c v).symm
          _ = s c * ((c :: v).map s).prod := by simp only [List.map_cons, List.prod_cons]
          _ = s c * ((v.eraseIdx k).map s).prod := by rw [hkeq]
          _ = s c * (y.map s).prod := by rw [hyeq]
          _ = ((c :: y).map s).prod := by simp only [List.map_cons, List.prod_cons]
      obtain ⟨P, x, R, hPR, hP, herase⟩ := exists_split v k hk
      have hγ : M.toCoxeterSystem.wordProd (c :: v) =
          M.toCoxeterSystem.wordProd (v.eraseIdx k) := by
        rw [herase, hPR]
        apply gamma_shift
        rw [herase, hPR] at hkeq
        rw [hPR] at hvred
        exact hsame _ _ (isReducedWord_append_left (v := R) (by simpa using hvred))
          (isReducedWord_of_eq (isReducedWord_append_left (v := R) (by simpa using hvred))
            (wp_shift hs hkeq) (by simp))
          (wp_shift hs hkeq)
      rw [hγ]
      exact hsame _ _ hered hu (hkeq.symm.trans (hcv.trans h))

end Matsumoto

/-! ### Order Coxeter matrix and construction of a `CoxeterSystem` -/

section OrderMatrix

private lemma pow_mul_comm_eq_one {G : Type*} [Monoid G] {x y : G}
    (hy : y * y = 1) (k : ℕ) (h : (x * y) ^ k = 1) : (y * x) ^ k = 1 := by
  have hsc : y * (x * y) ^ k = (y * x) ^ k * y :=
    (SemiconjBy.pow_right (show SemiconjBy y (x * y) (y * x) by
      unfold SemiconjBy; simp only [mul_assoc]) k).eq
  rw [h, mul_one] at hsc
  calc (y * x) ^ k = (y * x) ^ k * y * y := by rw [mul_assoc, hy, mul_one]
    _ = 1 := by rw [← hsc, hy]

variable {B W : Type*} [Monoid W] (s : B → W)
  (hs_inv : ∀ i, s i * s i = 1) (hs_inj : Function.Injective s)

/-- The Coxeter matrix associated to a family of distinct involutions `s : B → W`, with entries
`M i j = orderOf (s i * s j)` (`0` standing for infinite order). -/
noncomputable def orderCoxeterMatrix : CoxeterMatrix B where
  M := Matrix.of fun i j => orderOf (s i * s j)
  isSymm := by
    ext i j
    simp only [Matrix.transpose_apply, Matrix.of_apply]
    exact orderOf_eq_orderOf_iff.2 fun k =>
      ⟨pow_mul_comm_eq_one (hs_inv i) k, pow_mul_comm_eq_one (hs_inv j) k⟩
  diagonal i := by
    simp [hs_inv i]
  off_diagonal i j hij := by
    simp only [Matrix.of_apply, ne_eq, orderOf_eq_one_iff]
    intro h
    apply hij
    apply hs_inj
    calc s i = s i * s j * s j := by rw [mul_assoc, hs_inv j, mul_one]
      _ = s j := by rw [h, one_mul]

@[simp]
theorem orderCoxeterMatrix_apply (i j : B) :
    orderCoxeterMatrix s hs_inv hs_inj i j = orderOf (s i * s j) := rfl

/-- The family `s` satisfies the Coxeter relations of `orderCoxeterMatrix s`. -/
theorem orderCoxeterMatrix_isLiftable :
    (orderCoxeterMatrix s hs_inv hs_inj).IsLiftable s :=
  fun i j => pow_orderOf_eq_one (s i * s j)

/-- The canonical monoid homomorphism `(orderCoxeterMatrix s).Group →* W` sending each simple
reflection `i` to `s i`. -/
noncomputable def orderCoxeterLift :
    (orderCoxeterMatrix s hs_inv hs_inj).Group →* W :=
  (orderCoxeterMatrix s hs_inv hs_inj).toCoxeterSystem.lift
    ⟨s, orderCoxeterMatrix_isLiftable s hs_inv hs_inj⟩

@[simp]
theorem orderCoxeterLift_simple (i : B) :
    orderCoxeterLift s hs_inv hs_inj ((orderCoxeterMatrix s hs_inv hs_inj).simple i) = s i :=
  (orderCoxeterMatrix s hs_inv hs_inj).toCoxeterSystem.lift_apply_simple
    (orderCoxeterMatrix_isLiftable s hs_inv hs_inj) i

theorem orderCoxeterLift_wordProd (ω : List B) :
    orderCoxeterLift s hs_inv hs_inj
      ((orderCoxeterMatrix s hs_inv hs_inj).toCoxeterSystem.wordProd ω) = (ω.map s).prod := by
  induction ω with
  | nil => simp [CoxeterSystem.wordProd]
  | cons a t ih =>
    rw [CoxeterSystem.wordProd_cons, map_mul, ih, List.map_cons, List.prod_cons]
    exact congrArg (· * (t.map s).prod) (orderCoxeterLift_simple s hs_inv hs_inj a)

/-- Under the Exchange Property, every relation `(ω.map s).prod = 1` holds in
`(orderCoxeterMatrix s).Group`. -/
theorem wordProd_eq_one_of_exchange (hex : HasExchangeProperty s) (ω : List B)
    (h : (ω.map s).prod = 1) :
    (orderCoxeterMatrix s hs_inv hs_inj).toCoxeterSystem.wordProd ω = 1 := by
  have hbraid := wordProd_alternatingWord_eq_of_orderOf (M := orderCoxeterMatrix s hs_inv hs_inj)
    hs_inv (fun _ _ => rfl)
  have hnil : IsReducedWord s [] := fun _ hu => absurd hu (by simp)
  have := wordProd_eq_of_isReducedWord hs_inv hex hbraid ω [] hnil (by simpa using h)
  simpa [CoxeterSystem.wordProd] using this

/-- **Exchange implies injective Coxeter presentation**: the canonical lift
`(orderCoxeterMatrix s).Group →* W` is injective. -/
theorem orderCoxeterLift_injective_of_exchange (hex : HasExchangeProperty s) :
    Function.Injective (orderCoxeterLift s hs_inv hs_inj) := by
  set cs := (orderCoxeterMatrix s hs_inv hs_inj).toCoxeterSystem
  intro x y hxy
  obtain ⟨ω, hω⟩ := cs.wordProd_surjective (x⁻¹ * y)
  have h1 : (ω.map s).prod = 1 := by
    rw [← orderCoxeterLift_wordProd s hs_inv hs_inj, hω, map_mul, ← hxy, ← map_mul,
      inv_mul_cancel, map_one]
  have h2 := wordProd_eq_one_of_exchange s hs_inv hs_inj hex ω h1
  rw [hω] at h2
  exact inv_mul_eq_one.1 h2

/-- **Deletion implies injective Coxeter presentation**: the canonical lift
`(orderCoxeterMatrix s).Group →* W` is injective. -/
theorem orderCoxeterLift_injective_of_deletion (hdel : HasDeletionProperty s) :
    Function.Injective (orderCoxeterLift s hs_inv hs_inj) :=
  orderCoxeterLift_injective_of_exchange s hs_inv hs_inj
    (hasExchangeProperty_of_hasDeletionProperty hs_inv hdel)

end OrderMatrix

section OfDeletion

variable {B W : Type*} [Group W] (s : B → W)

/-- When `s` generates `W`, the canonical lift `(orderCoxeterMatrix s).Group →* W` is
surjective. -/
theorem orderCoxeterLift_surjective (hs_inv : ∀ i, s i * s i = 1)
    (hs_inj : Function.Injective s) (hs_gen : Subgroup.closure (Set.range s) = ⊤) :
    Function.Surjective (orderCoxeterLift s hs_inv hs_inj) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← hs_gen, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  exact ⟨(orderCoxeterMatrix s hs_inv hs_inj).simple i, orderCoxeterLift_simple s hs_inv hs_inj i⟩

/-- Construct a `CoxeterSystem` on a group `W` generated by a family of distinct involutions
`s : B → W` satisfying the Exchange Property. -/
noncomputable def ofExchange (hs_inv : ∀ i, s i * s i = 1) (hs_inj : Function.Injective s)
    (hs_gen : Subgroup.closure (Set.range s) = ⊤) (hex : HasExchangeProperty s) :
    CoxeterSystem (orderCoxeterMatrix s hs_inv hs_inj) W :=
  ⟨(MulEquiv.ofBijective (orderCoxeterLift s hs_inv hs_inj)
    ⟨orderCoxeterLift_injective_of_exchange s hs_inv hs_inj hex,
      orderCoxeterLift_surjective s hs_inv hs_inj hs_gen⟩).symm⟩

@[simp]
theorem ofExchange_simple (hs_inv : ∀ i, s i * s i = 1) (hs_inj : Function.Injective s)
    (hs_gen : Subgroup.closure (Set.range s) = ⊤) (hex : HasExchangeProperty s) :
    (ofExchange s hs_inv hs_inj hs_gen hex).simple = s := by
  funext i
  exact orderCoxeterLift_simple s hs_inv hs_inj i

/-- Construct a `CoxeterSystem` on a group `W` generated by a family of distinct involutions
`s : B → W` satisfying the Deletion Property. -/
noncomputable def ofDeletion (hs_inv : ∀ i, s i * s i = 1) (hs_inj : Function.Injective s)
    (hs_gen : Subgroup.closure (Set.range s) = ⊤) (hdel : HasDeletionProperty s) :
    CoxeterSystem (orderCoxeterMatrix s hs_inv hs_inj) W :=
  ofExchange s hs_inv hs_inj hs_gen (hasExchangeProperty_of_hasDeletionProperty hs_inv hdel)

@[simp]
theorem ofDeletion_simple (hs_inv : ∀ i, s i * s i = 1) (hs_inj : Function.Injective s)
    (hs_gen : Subgroup.closure (Set.range s) = ⊤) (hdel : HasDeletionProperty s) :
    (ofDeletion s hs_inv hs_inj hs_gen hdel).simple = s :=
  ofExchange_simple s hs_inv hs_inj hs_gen (hasExchangeProperty_of_hasDeletionProperty hs_inv hdel)

/-- **Characterization of Coxeter systems via the Deletion Property**: a group `W` generated by a
family of distinct involutions `s : B → W` admits a `CoxeterSystem` with simple reflections `s`
if and only if `s` satisfies the Deletion Property. -/
theorem exists_coxeterSystem_iff_hasDeletionProperty (hs_inv : ∀ i, s i * s i = 1)
    (hs_inj : Function.Injective s) (hs_gen : Subgroup.closure (Set.range s) = ⊤) :
    (∃ (M : CoxeterMatrix B) (cs : CoxeterSystem M W), cs.simple = s) ↔
      HasDeletionProperty s := by
  constructor
  · rintro ⟨M, cs, rfl⟩
    exact cs.hasDeletionProperty
  · intro hdel
    exact ⟨orderCoxeterMatrix s hs_inv hs_inj, ofDeletion s hs_inv hs_inj hs_gen hdel,
      ofDeletion_simple s hs_inv hs_inj hs_gen hdel⟩

/-- **Characterization of Coxeter systems via the Exchange Property**: a group `W` generated by a
family of distinct involutions `s : B → W` admits a `CoxeterSystem` with simple reflections `s`
if and only if `s` satisfies the Exchange Property. -/
theorem exists_coxeterSystem_iff_hasExchangeProperty (hs_inv : ∀ i, s i * s i = 1)
    (hs_inj : Function.Injective s) (hs_gen : Subgroup.closure (Set.range s) = ⊤) :
    (∃ (M : CoxeterMatrix B) (cs : CoxeterSystem M W), cs.simple = s) ↔
      HasExchangeProperty s := by
  rw [exists_coxeterSystem_iff_hasDeletionProperty s hs_inv hs_inj hs_gen,
    hasDeletionProperty_iff_hasExchangeProperty hs_inv]

end OfDeletion

end CoxeterSystem
