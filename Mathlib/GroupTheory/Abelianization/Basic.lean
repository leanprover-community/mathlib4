module

public import Mathlib.GroupTheory.Abelianization.Defs
public import Mathlib.GroupTheory.PresentedGroup
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Abelianization of quotients and presented groups

## Main definitions

* `Group.Abelianization.quotientMulEquivQuotientSupCommutator`: the abelianization of `G ⧸ N`
  is `G ⧸ (N ⊔ commutator G)`.
* `Group.Abelianization.quotientNormalClosureMulEquiv`: the abelianization of
  `G ⧸ normalClosure s` is the abelianization of `G` and the subgroup generated by the image of `s`.
* `Group.Abelianization.presentedGroupMulEquiv`: the abelianization of a presented group is the
  abelianization of the free group modulo the subgroup generated by the relators.

## Main results

* `Group.Abelianization.subsingleton_presentedGroup_iff`: the abelianization of a presented group
  is trivial if and only if the images of the relators generate the abelianization of the free
  group.

## TODO

* State `presentedGroupMulEquiv` in terms of the multiplicative free abelian group instead of the
  abelianization of the free group, once available.
-/

@[expose] public section

assert_not_exists Cardinal Field

namespace Group.Abelianization

section Quotient

variable (G : Type*) [Group G] (N : Subgroup G) [N.Normal]

/-- The abelianization of `G ⧸ N` is isomorphic to `G ⧸ (N ⊔ commutator G)`. -/
@[to_additive
/-- The additive abelianization of `G ⧸ N` is isomorphic to `G ⧸ (N ⊔ addCommutator G)`. -/]
def quotientMulEquivQuotientSupCommutator : Abelianization (G ⧸ N) ≃* G ⧸ (N ⊔ commutator G) :=
  (quotientMulEquiv N).trans <|
    (QuotientGroup.quotientMulEquivOfEq (M := N.map of) (N := (N ⊔ commutator G).map of)
      (by rw [Subgroup.map_sup, (Subgroup.map_eq_bot_iff _).mpr (ker_of _).ge,
        sup_bot_eq])).trans <|
    QuotientGroup.quotientQuotientEquivQuotient _ _ le_sup_right

@[to_additive (attr := simp)]
theorem quotientMulEquivQuotientSupCommutator_of_mk (x : G) :
    quotientMulEquivQuotientSupCommutator G N (of (x : G ⧸ N)) = (x : G ⧸ (N ⊔ commutator G)) :=
  rfl

@[to_additive (attr := simp)]
theorem quotientMulEquivQuotientSupCommutator_symm_mk (x : G) :
    (quotientMulEquivQuotientSupCommutator G N).symm (x : G ⧸ (N ⊔ commutator G)) =
      of (x : G ⧸ N) :=
  rfl

/-- Abelianizing `G ⧸ normalClosure s` is the same as abelianizing `G` and then
quotienting by the subgroup generated by the image of `s`. -/
@[to_additive
/-- Additively abelianizing `G ⧸ normalClosure s` is the same as additively abelianizing `G` and
then quotienting by the additive subgroup generated by the image of `s`. -/]
def quotientNormalClosureMulEquiv (s : Set G) : Abelianization (G ⧸ Subgroup.normalClosure s) ≃*
    Abelianization G ⧸ Subgroup.closure (of '' s) :=
  (quotientMulEquiv (N := Subgroup.normalClosure s)).trans <|
    QuotientGroup.quotientMulEquivOfEq <|
      (Subgroup.map_normalClosure s of (surjective_of _)).trans
        (Subgroup.normalClosure_eq_closure _)

@[to_additive (attr := simp)]
theorem quotientNormalClosureMulEquiv_of_mk (s : Set G) (x : G) :
    quotientNormalClosureMulEquiv G s (of (x : G ⧸ Subgroup.normalClosure s)) =
      ((of x : Abelianization G) : Abelianization G ⧸ Subgroup.closure (of '' s)) :=
  rfl

@[to_additive (attr := simp)]
theorem quotientNormalClosureMulEquiv_symm_mk (s : Set G) (x : G) :
    (quotientNormalClosureMulEquiv G s).symm
        ((of x : Abelianization G) : Abelianization G ⧸ Subgroup.closure (of '' s)) =
      of (x : G ⧸ Subgroup.normalClosure s) :=
  rfl

end Quotient

section PresentedGroup

variable {α : Type*} (rels : Set (FreeGroup α))

/-- The abelianization of a presented group `⟨α | rels⟩` is the same as abelianizing the free group
on `α` and then quotienting by the subgroup generated by the images of the relators. -/
@[to_additive
/-- The additive abelianization of a presented additive group `⟨α | rels⟩` is the same as
abelianizing the  additive free group on `α` and then quotienting by the additive subgroup
generated by the images of the relators. -/]
def presentedGroupMulEquiv : Abelianization (PresentedGroup rels) ≃*
    Abelianization (FreeGroup α) ⧸ Subgroup.closure (of '' rels) :=
  quotientNormalClosureMulEquiv (FreeGroup α) rels

@[to_additive (attr := simp)]
theorem presentedGroupMulEquiv_of_mk (w : FreeGroup α) :
  presentedGroupMulEquiv rels (of (PresentedGroup.mk rels w)) =
    ((of w : Abelianization (FreeGroup α)) :
        Abelianization (FreeGroup α) ⧸ Subgroup.closure (of '' rels)) :=
  rfl

@[to_additive (attr := simp)]
theorem presentedGroupMulEquiv_symm_mk (w : FreeGroup α) :
    (presentedGroupMulEquiv rels).symm ((of w : Abelianization (FreeGroup α)) :
        Abelianization (FreeGroup α) ⧸ Subgroup.closure (of '' rels)) =
          of (PresentedGroup.mk rels w) :=
  rfl

@[to_additive (attr := simp)]
theorem presentedGroupMulEquiv_of_of (x : α) :
    presentedGroupMulEquiv rels (of (PresentedGroup.of x)) =
      ((of (FreeGroup.of x) : Abelianization (FreeGroup α)) :
        Abelianization (FreeGroup α) ⧸ Subgroup.closure (of '' rels)) :=
  rfl

/-- The abelianization of a presented group is trivial if and only if the images of the relators
generate the abelianization of the free group. -/
@[to_additive
/-- The additive abelianization of a presented additive group is trivial if and
only if the images of the relators generate the additive abelianization of the free additive
group. -/]
theorem subsingleton_presentedGroup_iff :
    Subsingleton (Abelianization (PresentedGroup rels)) ↔ Subgroup.closure (of '' rels) = ⊤ := by
  rw [(presentedGroupMulEquiv rels).toEquiv.subsingleton_congr]
  exact QuotientGroup.subsingleton_iff

end PresentedGroup

end Group.Abelianization
