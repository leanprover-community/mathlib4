/-!
# Free abelian groups

The free abelian group on a type `α`, defined as the abelianisation of
the free group on `α`.

The free abelian group on `α` can be abstractly defined as the left adjoint of the
forgetful functor from abelian groups to types. Alternatively, one could define
it as the functions `α → ℤ` which send all but finitely many `(a : α)` to `0`,
under pointwise addition. In this file, it is defined as the abelianisation
of the free group on `α`. All the constructions and theorems required to show
the adjointness of the construction and the forgetful functor are proved in this
file, but the category-theoretic adjunction statement is in
`Mathlib/Algebra/Category/Grp/Adjunctions.lean`.

## Main definitions

Here we use the following variables: `(α β : Type*) (A : Type*) [AddCommGroup A]`

* `FreeAddCommGroup α` : the free abelian group on a type `α`. As an abelian
  group it is `α →₀ ℤ`, the functions from `α` to `ℤ` such that all but finitely
  many elements get mapped to zero, however this is not how it is implemented.

* `lift f : FreeAddCommGroup α →+ A` : the group homomorphism induced
  by the map `f : α → A`.

* `map (f : α → β) : FreeAddCommGroup α →+ FreeAddCommGroup β` : functoriality
    of `FreeAddCommGroup`.

* `instance [Monoid α] : Semigroup (FreeAddCommGroup α)`

* `instance [CommMonoid α] : CommRing (FreeAddCommGroup α)`

It has been suggested that we would be better off refactoring this file
and using `Finsupp` instead.

## Implementation issues

The definition is
`def FreeAddCommGroup : Type u := Additive <| Group.Abelianization <| FreeGroup α`.

Chris Hughes has suggested that this all be rewritten in terms of `Finsupp`.
Johan Commelin has written all the API relating the definition to `Finsupp`
in the lean-liquid repo.

The lemmas `map_pure`, `map_of`, `map_zero`, `map_add`, `map_neg` and `map_sub`
are proved about the `Functor.map` `<$>` construction, and need `α` and `β` to
be in the same universe. But
`FreeAddCommGroup.map (f : α → β)` is defined to be the `AddGroup`
homomorphism `FreeAddCommGroup α →+ FreeAddCommGroup β` (with `α` and `β` now
allowed to be in different universes), so `(map f).map_add`
etc. can be used to prove that `FreeAddCommGroup.map` preserves addition. The
functions `map_id`, `map_id_apply`, `map_comp`, `map_comp_apply` and `map_of_apply`
are about `FreeAddCommGroup.map`.
-/

@[expose] public section

assert_not_exists Cardinal Multiset

universe u v

variable (α : Type u) {G : Type*}

/--
If `α` is a type, then `FreeAddCommGroup α` is the free abelian group generated by `α`.
This is an abelian group equipped with a function
`FreeAddCommGroup.of : α → FreeAddCommGroup α` which has the following universal property:
if `G` is any abelian group, and `f : α → G` is any function, then this function is
the composite of `FreeAddCommGroup.of` and a unique group homomorphism
`FreeAddCommGroup.lift f : FreeAddCommGroup α →+ G`.

A typical element of `FreeAddCommGroup α` is a formal sum of
elements of `α` and their formal inverses.
For example if `x` and `y` are terms of type `α` then `x + x + x - y` is a
"typical" element of `FreeAddCommGroup α`. In particular if `α` is empty
then `FreeAddCommGroup α` is isomorphic to the trivial group, and if `α` has one term
then `FreeAddCommGroup α` is isomorphic to `ℤ`.
One can think of `FreeAddCommGroup α` as the functions `α →₀ ℤ` with finite support,
and addition given pointwise.

TODO: introduce a multiplicative version
-/
def FreeAddCommGroup : Type u :=
  Additive <| Group.Abelianization <| FreeGroup α
deriving Inhabited, AddCommGroup

instance [IsEmpty α] : Unique (FreeAddCommGroup α) :=
  inferInstanceAs <| Unique (delta% FreeAddCommGroup α)

variable {α}

namespace FreeAddCommGroup

/-- The canonical map from `α` to `FreeAddCommGroup α`. -/
def of (x : α) : FreeAddCommGroup α :=
  Additive.ofMul <| Group.Abelianization.of <| FreeGroup.of x

/-- The map `FreeAddCommGroup α →+ A` induced by a map of types `α → A`. -/
def lift {β : Type v} [AddCommGroup β] : (α → β) ≃ (FreeAddCommGroup α →+ β) :=
  (@FreeGroup.lift _ (Multiplicative β) _).trans <|
    (@Group.Abelianization.lift _ _ (Multiplicative β) _).trans MonoidHom.toAdditive

section lift

variable {β : Type v} [AddCommGroup β] (f : α → β)

open FreeAddCommGroup

-- Porting note: needed to add `(β := Multiplicative β)`
@[simp]
theorem lift_apply_of (x : α) : lift f (of x) = f x := by
  convert! Group.Abelianization.lift_apply_of
    (FreeGroup.lift f (β := Multiplicative β)) (FreeGroup.of x)
  exact (FreeGroup.lift_apply_of (β := Multiplicative β)).symm

theorem lift_unique (g : FreeAddCommGroup α →+ β) (hg : ∀ x, g (of x) = f x) {x} :
    g x = lift f x :=
  congr($(lift.symm_apply_eq.mp (funext hg : g ∘ of = f)) _)

/-- See note [partially-applied ext lemmas]. -/
@[ext high]
theorem lift_ext (g h : FreeAddCommGroup α →+ β) (H : ∀ x, g (of x) = h (of x)) : g = h :=
  lift.symm.injective <| funext H

theorem lift_comp_apply {α β γ} [AddCommGroup β] [AddCommGroup γ]
    (a : FreeAddCommGroup α) (f : α → β) (g : β →+ γ) : lift (g ∘ f) a = g (lift f a) := by
  rw [← AddMonoidHom.comp_apply g (lift f)]
  refine (lift_unique _ _ ?_).symm
  intro a
  change g ((lift f) (of a)) = g (f a)
  simp only [lift_apply_of]

end lift

section

theorem of_injective : Function.Injective (of : α → FreeAddCommGroup α) := by
  classical
  exact fun x y hoxy ↦ Classical.by_contradiction fun hxy : x ≠ y ↦
    let f : FreeAddCommGroup α →+ ℤ := lift fun z ↦ if x = z then (1 : ℤ) else 0
    have hfx1 : f (of x) = 1 := (lift_apply_of _ _).trans <| ite_eq_left rfl
    have hfy1 : f (of y) = 1 := hoxy ▸ hfx1
    have hfy0 : f (of y) = 0 := (lift_apply_of _ _).trans <| ite_eq_right hxy
    one_ne_zero <| hfy1.symm.trans hfy0

@[simp]
theorem of_ne_zero (x : α) : of x ≠ 0 := by
  intro h
  let f : FreeAddCommGroup α →+ ℤ := lift 1
  have hfx : f (of x) = 1 := lift_apply_of _ _
  have hf0 : f (of x) = 0 := by rw [h, map_zero]
  exact one_ne_zero <| hfx.symm.trans hf0

@[simp]
theorem zero_ne_of (x : α) : 0 ≠ of x := of_ne_zero _ |>.symm

instance [Nonempty α] : Nontrivial (FreeAddCommGroup α) where
  exists_pair_ne := let ⟨x⟩ := ‹Nonempty α›; ⟨0, of x, zero_ne_of _⟩

end

@[elab_as_elim]
protected theorem induction_on
    {motive : FreeAddCommGroup α → Prop} (z : FreeAddCommGroup α) (zero : motive 0)
    (of : ∀ x, motive (of x)) (neg : ∀ x, motive (.of x) → motive (-.of x))
    (add : ∀ x y, motive x → motive y → motive (x + y)) : motive z :=
  Quotient.inductionOn' z fun x ↦ Quot.inductionOn x fun L ↦
    List.recOn L zero fun ⟨x, b⟩ _ ih ↦ Bool.recOn b (add _ _ (neg _ (of x)) ih) (add _ _ (of x) ih)

theorem lift_add_apply [AddCommGroup G] (f g : α → G) (a : FreeAddCommGroup α) :
    lift (f + g) a = lift f a + lift g a := by
  induction a using FreeAddCommGroup.induction_on with
  | zero => simp only [(lift _).map_zero, zero_add]
  | of x => simp only [lift_apply_of, Pi.add_apply]
  | neg x => simp only [map_neg, lift_apply_of, Pi.add_apply, neg_add]
  | add x y hx hy => simp only [(lift _).map_add, hx, hy, add_add_add_comm]

@[simp] lemma lift_add [AddCommGroup G] (f g : α → G) : lift (f + g) = lift f + lift g :=
  AddMonoidHom.ext <| lift_add_apply _ _

#adaptation_note
/-- `respectTransparency.types true` changes the auto-generated lemmas' signature -/
set_option backward.isDefEq.respectTransparency.types false in
/-- `FreeAddCommGroup.lift` as an equivalence of groups. -/
@[simps!]
def liftAddEquiv [AddCommGroup G] : (α → G) ≃+ (FreeAddCommGroup α →+ G) := ⟨lift, lift_add⟩

/-- If `g : FreeAddCommGroup X` and `A` is an abelian group then `liftAddGroupHom g`
is the additive group homomorphism sending a function `X → A` to the term of type `A`
corresponding to the evaluation of the induced map `FreeAddCommGroup X → A` at `g`. -/
@[simps!]
def liftAddMonoidHom {α} (β) [AddCommGroup β] (a : FreeAddCommGroup α) : (α → β) →+ β :=
  AddMonoidHom.mk' (fun f ↦ lift f a) (lift_add_apply · · _)

@[simp] lemma lift_neg [AddCommGroup G] (f : α → G) : lift (-f) = -lift f := liftAddEquiv.map_neg f

lemma lift_neg_apply [AddCommGroup G] (f : α → G) (a : FreeAddCommGroup α) :
    lift (-f) a = -lift f a := congr($(lift_neg f) a)

section Monad

variable {β : Type u}

instance : Monad FreeAddCommGroup.{u} where
  pure α := of α
  bind x f := lift f x

@[elab_as_elim]
protected theorem induction_on'
    {motive : FreeAddCommGroup α → Prop} (z : FreeAddCommGroup α) (zero : motive 0)
    (pure : ∀ x, motive <| pure x) (neg : ∀ x, motive (Pure.pure x) → motive (-Pure.pure x))
    (add : ∀ x y, motive x → motive y → motive (x + y)) : motive z :=
  FreeAddCommGroup.induction_on z zero pure neg add

@[simp]
theorem map_pure (f : α → β) (x : α) : f <$> (pure x : FreeAddCommGroup α) = pure (f x) :=
  rfl

@[simp]
protected theorem map_zero (f : α → β) : f <$> (0 : FreeAddCommGroup α) = 0 :=
  (lift (of ∘ f)).map_zero

@[simp]
protected theorem map_add (f : α → β) (x y : FreeAddCommGroup α) :
    f <$> (x + y) = f <$> x + f <$> y :=
  (lift _).map_add _ _

@[simp]
protected theorem map_neg (f : α → β) (x : FreeAddCommGroup α) : f <$> (-x) = -f <$> x :=
  map_neg (lift <| of ∘ f) _

@[simp]
protected theorem map_sub (f : α → β) (x y : FreeAddCommGroup α) :
    f <$> (x - y) = f <$> x - f <$> y :=
  map_sub (lift <| of ∘ f) _ _

@[simp]
theorem map_of (f : α → β) (y : α) : f <$> of y = of (f y) :=
  rfl

theorem pure_bind (f : α → FreeAddCommGroup β) (x) : pure x >>= f = f x :=
  lift_apply_of _ _

@[simp]
theorem zero_bind (f : α → FreeAddCommGroup β) : 0 >>= f = 0 :=
  (lift f).map_zero

@[simp]
theorem add_bind (f : α → FreeAddCommGroup β) (x y : FreeAddCommGroup α) :
    x + y >>= f = (x >>= f) + (y >>= f) :=
  (lift _).map_add _ _

@[simp]
theorem neg_bind (f : α → FreeAddCommGroup β) (x : FreeAddCommGroup α) : -x >>= f = -(x >>= f) :=
  map_neg (lift f) _

@[simp]
theorem sub_bind (f : α → FreeAddCommGroup β) (x y : FreeAddCommGroup α) :
    x - y >>= f = (x >>= f) - (y >>= f) :=
  map_sub (lift f) _ _

@[simp]
theorem pure_seq (f : α → β) (x : FreeAddCommGroup α) : pure f <*> x = f <$> x :=
  pure_bind _ _

@[simp]
theorem zero_seq (x : FreeAddCommGroup α) : (0 : FreeAddCommGroup (α → β)) <*> x = 0 :=
  zero_bind _

@[simp]
theorem add_seq (f g : FreeAddCommGroup (α → β)) (x : FreeAddCommGroup α) :
    f + g <*> x = (f <*> x) + (g <*> x) :=
  add_bind _ _ _

@[simp]
theorem neg_seq (f : FreeAddCommGroup (α → β)) (x : FreeAddCommGroup α) : -f <*> x = -(f <*> x) :=
  neg_bind _ _

@[simp]
theorem sub_seq (f g : FreeAddCommGroup (α → β)) (x : FreeAddCommGroup α) :
    f - g <*> x = (f <*> x) - (g <*> x) :=
  sub_bind _ _ _

/-- If `f : FreeAddCommGroup (α → β)`, then `f <*>` is an additive morphism
`FreeAddCommGroup α →+ FreeAddCommGroup β`. -/
def seqAddGroupHom (f : FreeAddCommGroup (α → β)) : FreeAddCommGroup α →+ FreeAddCommGroup β := by
  refine .mk' (f <*> ·) fun x y ↦ ?_
  change lift (· <$> (x + y)) _ = lift (· <$> x) _ + lift (· <$> y) _
  simp [← Pi.add_def]

@[simp]
theorem seq_zero (f : FreeAddCommGroup (α → β)) : f <*> 0 = 0 :=
  (seqAddGroupHom f).map_zero

@[simp]
theorem seq_add (f : FreeAddCommGroup (α → β)) (x y : FreeAddCommGroup α) :
    f <*> x + y = (f <*> x) + (f <*> y) :=
  (seqAddGroupHom f).map_add x y

@[simp]
theorem seq_neg (f : FreeAddCommGroup (α → β)) (x : FreeAddCommGroup α) : f <*> -x = -(f <*> x) :=
  (seqAddGroupHom f).map_neg x

@[simp]
theorem seq_sub (f : FreeAddCommGroup (α → β)) (x y : FreeAddCommGroup α) :
    f <*> x - y = (f <*> x) - (f <*> y) :=
  (seqAddGroupHom f).map_sub x y

instance : LawfulMonad FreeAddCommGroup.{u} := LawfulMonad.mk'
  (id_map := fun x ↦ FreeAddCommGroup.induction_on' x (FreeAddCommGroup.map_zero id) (map_pure id)
    (fun x ih ↦ by rw [FreeAddCommGroup.map_neg, ih])
    fun x y ihx ihy ↦ by rw [FreeAddCommGroup.map_add, ihx, ihy])
  (pure_bind := fun x f ↦ pure_bind f x)
  (bind_assoc := fun x f g ↦ FreeAddCommGroup.induction_on' x (by iterate 3 rw [zero_bind])
    (fun x ↦ by iterate 2 rw [pure_bind]) (fun x ih ↦ by simp_rw [neg_bind]; rw [ih])
    fun x y ihx ihy ↦ by simp_rw [add_bind]; rw [ihx, ihy])

instance : CommApplicative FreeAddCommGroup.{u} where
  commutative_prod x y := by
    induction x using FreeAddCommGroup.induction_on' with
    | zero => rw [FreeAddCommGroup.map_zero, zero_seq, seq_zero]
    | pure p =>
      rw [map_pure, pure_seq]
      induction y using FreeAddCommGroup.induction_on' with
      | zero => rw [FreeAddCommGroup.map_zero, FreeAddCommGroup.map_zero, zero_seq]
      | pure q => rw [map_pure, map_pure, pure_seq, map_pure]
      | neg q ih => rw [FreeAddCommGroup.map_neg, FreeAddCommGroup.map_neg, neg_seq, ih]
      | add y₁ y₂ ih1 ih2 =>
        rw [FreeAddCommGroup.map_add, FreeAddCommGroup.map_add, add_seq, ih1, ih2]
    | neg p ih => rw [FreeAddCommGroup.map_neg, neg_seq, seq_neg, ih]
    | add x₁ x₂ ih1 ih2 => rw [FreeAddCommGroup.map_add, add_seq, seq_add, ih1, ih2]

end Monad

universe w

variable {β : Type v} {γ : Type w}

/-- The additive group homomorphism `FreeAddCommGroup α →+ FreeAddCommGroup β` induced from a
  map `α → β`. -/
def map (f : α → β) : FreeAddCommGroup α →+ FreeAddCommGroup β :=
  lift (of ∘ f)

theorem lift_comp {α} {β} {γ} [AddCommGroup γ] (f : α → β) (g : β → γ) (x : FreeAddCommGroup α) :
    lift (g ∘ f) x = lift g (map f x) := by
  induction x using FreeAddCommGroup.induction_on with
  | zero => simp only [map_zero]
  | of => simp only [lift_apply_of, map, Function.comp]
  | neg _ h => simp only [h, map_neg]
  | add _ _ h₁ h₂ => simp only [h₁, h₂, map_add]

theorem map_id : map id = AddMonoidHom.id (FreeAddCommGroup α) :=
  Eq.symm <|
    lift_ext _ _ fun _ ↦ lift_unique of (AddMonoidHom.id _) fun _ ↦ AddMonoidHom.id_apply _ _

theorem map_id_apply (x : FreeAddCommGroup α) : map id x = x := by
  rw [map_id]
  rfl

theorem map_comp {f : α → β} {g : β → γ} : map (g ∘ f) = (map g).comp (map f) :=
  Eq.symm <| lift_ext _ _ fun _ ↦ by simp [map]

theorem map_comp_apply {f : α → β} {g : β → γ} (x : FreeAddCommGroup α) :
    map (g ∘ f) x = (map g) ((map f) x) := by
  rw [map_comp]
  rfl

-- version of map_of which uses `map`
@[simp]
theorem map_of_apply {f : α → β} (a : α) : map f (of a) = of (f a) :=
  rfl

/-- The free abelian group on a type with one term is isomorphic to `ℤ`. -/
def uniqueEquiv (T : Type*) [Unique T] : FreeAddCommGroup T ≃+ ℤ where
  toFun := FreeAddCommGroup.lift fun _ ↦ (1 : ℤ)
  invFun n := n • of Inhabited.default
  left_inv z := FreeAddCommGroup.induction_on z
    (by simp only [zero_smul, map_zero])
    (Unique.forall_iff.2 <| by simp only [one_smul, lift_apply_of]) (Unique.forall_iff.2 <| by simp)
    fun x y hx hy ↦ by
      simp only [map_add, add_smul] at *
      rw [hx, hy]
  right_inv n := by
    rw [map_zsmul, lift_apply_of]
    exact zsmul_one n
  map_add' := map_add _

/-- Isomorphic types have isomorphic free abelian groups. -/
def equivOfEquiv {α β : Type*} (f : α ≃ β) : FreeAddCommGroup α ≃+ FreeAddCommGroup β where
  toFun := map f
  invFun := map f.symm
  left_inv x := by rw [← map_comp_apply, Equiv.symm_comp_self, map_id, AddMonoidHom.id_apply]
  right_inv x := by rw [← map_comp_apply, Equiv.self_comp_symm, map_id, AddMonoidHom.id_apply]
  map_add' := map_add _

end FreeAddCommGroup

