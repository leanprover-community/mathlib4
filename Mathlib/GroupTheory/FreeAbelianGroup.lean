theorem mul_def (x y : FreeAddCommGroup α) :
    x * y = lift (fun x₂ ↦ lift (fun x₁ ↦ of (x₁ * x₂)) x) y :=
  rfl

@[simp, deprecated "use `MonoidAlgebra ℤ` instead" (since := "2026-07-29")]
