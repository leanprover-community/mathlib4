  ⟨FreeAddCommGroup.of 1⟩

@[deprecated "use `MonoidAlgebra ℤ` instead" (since := "2026-07-29")]
theorem one_def : (1 : FreeAddCommGroup α) = FreeAddCommGroup.of 1 :=
  rfl

@[deprecated "use `MonoidAlgebra ℤ` instead" (since := "2026-07-29")]
