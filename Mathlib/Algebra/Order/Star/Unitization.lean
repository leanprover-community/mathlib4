module

public import Mathlib.Algebra.Algebra.Unitization
public import Mathlib.Algebra.Order.Group.Cone
public import Mathlib.Algebra.Order.Star.Basic

/-! # The star order on `Unitization R A`

Suppose `A` is a non-unital star-ordered star-`R`-algebra and that `R` is also star-ordered with
`star r * r = 0 → r = 0`, then `Unitization R A` is star-ordered. In particular, the additive
submonoid generated by elements of the form `star x * x` in `Unitization R A` is pointed.
Therefore, the relation defined by `x ≤ y` if and only if `y - x` lies in this additive submonoid,
while always reflexive and transitive, is in fact antisymmetric and hence a partial order on
`Unitization R A`.

The key result is that if `s` lies in the additive submonoid generated by elements of the form
`star x * x` in `Unitization R A`, then `0 ≤ x.fst` and, moreover, if `x.fst = 0`, then `0 ≤ x.snd`.
-/

@[expose] public section

namespace AddSubmonoid

/-- The additive submonoid of a star ring generated by elements of the form `star x * x`.
A partially ordered star ring is star-ordered precisely when this coincides
with`AddSubmonoid.nonneg`. -/
def starOrder (R : Type*) [NonUnitalSemiring R] [StarRing R] : AddSubmonoid R :=
  closure (Set.range fun x ↦ star x * x)

lemma mem_starOrder_iff {R : Type*} [NonUnitalSemiring R] [StarRing R] {x : R} :
    x ∈ starOrder R ↔ x ∈ closure (Set.range fun x ↦ star x * x) :=
  Iff.rfl

end AddSubmonoid

namespace Unitization

open AddSubmonoid Unitization

variable {R A : Type*} [CommRing R] [StarRing R] [PartialOrder R] [StarOrderedRing R]
  [IsProperStar R] [NonUnitalRing A] [StarRing A] [PartialOrder A] [StarOrderedRing A]
  [Module R A] [IsScalarTower R A A] [SMulCommClass R A A] [StarModule R A]

lemma of_mem_starOrder {x : Unitization R A} (hx : x ∈ starOrder (Unitization R A)) :
    0 ≤ x.fst ∧ (x.fst = 0 → 0 ≤ x.snd) := by
  induction hx using closure_induction with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    simp_all
  | zero => simp
  | add x y _ _ hx hy =>
    refine ⟨by simpa using add_nonneg hx.1 hy.1, fun h ↦ ?_⟩
    rw [fst_add, add_eq_zero_iff_of_nonneg hx.1 hy.1] at h
    simpa using add_nonneg (hx.2 h.1) (hy.2 h.2)

lemma isPointed_cone : (starOrder (Unitization R A)).IsPointed := by
  intro x hx hx'
  obtain ⟨h₁, h₂⟩ := of_mem_starOrder hx
  obtain ⟨h₁', h₂'⟩ := of_mem_starOrder hx'
  have hfst : x.fst = 0 := le_antisymm (by simpa using h₁') h₁
  exact Unitization.ext hfst <| le_antisymm (by simpa using h₂' (by simp [hfst])) (h₂ hfst)

instance instPartialOrder : PartialOrder (Unitization R A) :=
  .ofAddSubmonoid isPointed_cone

instance instIsOrderedAddMonoid : IsOrderedAddMonoid (Unitization R A) :=
  .ofAddSubmonoid isPointed_cone

instance instStarOrderedRing : StarOrderedRing (Unitization R A) :=
  .of_nonneg_iff (by simp) (by simp [mem_starOrder_iff])

@[simp, norm_cast, grind =]
lemma inr_nonneg_iff {a : A} : 0 ≤ (a : Unitization R A) ↔ 0 ≤ a := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · have := of_mem_starOrder h
    simp_all
  · let φ := (inrNonUnitalAlgHom R A).toAddMonoidHom
    rw [StarOrderedRing.nonneg_iff] at h ⊢
    suffices (a : Unitization R A) ∈ closure (.range ((fun x ↦ star x * x) ∘ inr)) from
      closure_mono (Set.range_comp_subset_range ..) this
    have := AddMonoidHom.map_mclosure φ (.range fun x ↦ star x * x) ▸ mem_map_of_mem φ h
    simpa [φ, ← Set.range_comp', Function.comp_def]

@[simp, norm_cast, grind =]
lemma inr_le_inr_iff {a b : A} : (a : Unitization R A) ≤ (b : Unitization R A) ↔ a ≤ b := by
  rw [← sub_nonneg, ← sub_nonneg (a := b), ← inr_sub R b a, inr_nonneg_iff]

alias ⟨LE.le.of_inr, LE.le.inr⟩ := inr_nonneg_iff

lemma inr_nonneg (a : A) (ha : 0 ≤ a := by cfc_tac) : 0 ≤ (a : Unitization R A) := ha.inr

lemma nonneg_of_inr (a : A) (ha : 0 ≤ (a : Unitization R A) := by cfc_tac) :
    0 ≤ a :=
  inr_nonneg_iff.mp ha

@[deprecated (since := "2026-08-06")] alias inr_le_iff := inr_le_inr_iff

alias ⟨le_of_inr, inr_mono⟩ := inr_le_inr_iff

end Unitization
