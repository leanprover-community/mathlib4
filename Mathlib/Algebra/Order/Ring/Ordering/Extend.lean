module

public import Mathlib.Algebra.Order.Ring.Ordering.Defs

import Mathlib.Algebra.Field.Basic
import Mathlib.Algebra.Order.Ring.Ordering.Basic
import Mathlib.Order.Zorn

/-!
# Extending ring preorderings to orderings

Let `R` be a commutative ring, and let `P` be a preordering on `R`. We prove that every preordering
on `R` extends to an ordering on `R`, and characterise maximal orderings.

## Main results

* `Subsemiring.IsPreordering.exists_le_isOrdering`: every preordering extends to an ordering.
* `Subsemiring.maximal_isPreordering_iff_maximal_isOrdering`:
an ordering is maximal as an ordering if and only if it is maximal as a preordering.
* `Subsemiring.maximal_isPreordering_iff_isOrdering`: over a field,
orderings are precisely maximal preorderings.

## References

- [*An introduction to real algebra*, T.Y. Lam][lam_1984]
-/

public section

variable {R : Type*} [CommRing R] {F : Type*} [Field F]

namespace Subsemiring.IsPreordering

variable {P : Subsemiring R} {a : R}

theorem closure_insert (hP : P.IsPreordering) (hx : -1 ∉ closure (insert a P)) :
    (closure (insert a P)).IsPreordering := hP.mono (fun _ ↦ by membership) hx

theorem mem_closure_insert (hP : P.IsPreordering) {x : R} :
    x ∈ closure (insert a P) ↔ ∃ y ∈ P, ∃ z ∈ P, x = y + a * z where
  mp hx := by
    induction hx using Subsemiring.closure_induction with
    | mem _ hx =>
      rcases hx with rfl | hx
      · exact ⟨0, by membership, 1, by membership, by simp⟩
      · exact ⟨_, hx, 0, by membership, by simp⟩
    | zero => exact ⟨0, by membership, 0, by membership, by simp⟩
    | one => exact ⟨1, by membership, 0, by membership, by simp⟩
    | add _ _ _ _ ha hb =>
      rcases ha, hb with ⟨⟨x₁, _, y₁, _, rfl⟩, ⟨x₂, _, y₂, _, rfl⟩⟩
      exact ⟨x₁ + x₂, by membership, y₁ + y₂, by membership, by grind⟩
    | mul _ _ _ _ ha hb =>
      rcases ha, hb with ⟨⟨x₁, _, y₁, _, rfl⟩, ⟨x₂, _, y₂, _, rfl⟩⟩
      exact ⟨x₁ * x₂ + (a * a) * (y₁ * y₂), by membership, x₁ * y₂ + y₁ * x₂, by membership,
        by grind⟩
  mpr := by membership

variable (a) in
theorem neg_one_notMem_closure_insert (hP : P.IsPreordering)
    (h : ∀ x y, x ∈ P → y ∈ P → x + (1 + y) * a + 1 ≠ 0) :
    -1 ∉ closure (insert a P) := by
  contrapose! h
  rcases hP.mem_closure_insert.mp (show -1 * (1 + a) ∈ closure (insert a P) by membership)
    with ⟨_, hx, _, hy, _⟩
  exact ⟨_, _, hx, hy, by grind⟩

theorem neg_one_notMem_closure_insert_or_of_neg_mul_mem (hP : P.IsPreordering)
    {x y : R} (h : -(x * y) ∈ P) :
    -1 ∉ closure (insert x P) ∨ -1 ∉ closure (insert y P) := by
  simp_rw [hP.mem_closure_insert]
  by_contra! hc
  rcases hc with ⟨⟨s₁, _, s₂, _, _⟩, ⟨t₁, _, t₂, _, _⟩⟩
  suffices (-(x * y)) * s₂ * t₂ + s₁ + t₁ + (s₁ * t₁) ∈ P by membership
  membership

/--
If `F` is a field, `P` is a preordering on `F`, and `-a ∉ P`, then
`-1` is not in the semiring generated by `P` and `a`.
-/
theorem neg_one_notMem_closure_insert_of_neg_notMem
    {P : Subsemiring F} {a : F} (hP : P.IsPreordering) (ha : -a ∉ P) :
    -1 ∉ Subsemiring.closure (insert a P) := by
  rw [hP.mem_closure_insert]
  contrapose ha
  rcases ha with ⟨x, _, y, _, _⟩
  suffices x * y⁻¹ + y⁻¹ ∈ P by membership
  membership

theorem exists_ge_and_mem_or_mem (hP : P.IsPreordering) (x y : R) (h : -(x * y) ∈ P) :
    ∃ Q ≥ P, Q.IsPreordering ∧ (x ∈ Q ∨ y ∈ Q) := by
  rcases hP.neg_one_notMem_closure_insert_or_of_neg_mul_mem h with hcl | hcl <;>
    exact ⟨_, fun _ ↦ by membership, hP.closure_insert hcl, by membership⟩

/- A maximal preordering on `R` is an ordering. -/
theorem _root_.Subsemiring.IsOrdering.of_maximal_isPreordering
    (max : Maximal IsPreordering P) : P.IsOrdering :=
  max.prop.isOrdering_iff.mpr <| fun _ _ h ↦ by
  rcases max.prop.exists_ge_and_mem_or_mem _ _ h with ⟨_, hO'₁, hO'₂, _⟩
  grind [max.le_of_ge hO'₂ hO'₁]

/- Every preordering on `R` extends to an ordering. -/
theorem exists_ge_isOrdering (hP : P.IsPreordering) : ∃ O ≥ P, O.IsOrdering :=
  have ⟨_, O_ge, O_max⟩ : ∃ O, P ≤ O ∧ Maximal IsPreordering O :=
    zorn_le_nonempty₀ {P : Subsemiring R | IsPreordering P} (fun _ hS hc _ hQ ↦
      ⟨_, IsPreordering.sSup (Set.nonempty_of_mem hQ) hc.directedOn hS, fun _ ↦ le_sSup⟩) _ hP
  ⟨_, O_ge, .of_maximal_isPreordering O_max⟩

theorem exists_ge_isOrdering_and_mem (hP : P.IsPreordering) (h : -1 ∉ closure (insert a P)) :
    ∃ O ≥ P, O.IsOrdering ∧ a ∈ O := by
  rcases (hP.closure_insert h).exists_ge_isOrdering with ⟨_, _, hO⟩
  exact ⟨_, fun _ ↦ by membership, hO, by membership⟩

variable (a) in
theorem exists_ge_isOrdering_and_mem_or_neg_mem (hP : P.IsPreordering) :
    ∃ Q ≥ P, Q.IsOrdering ∧ (a ∈ Q ∨ -a ∈ Q) := by
  rcases hP.exists_ge_and_mem_or_mem a (-a) (by simp [hP]) with ⟨_, _, hP', _⟩
  rcases hP'.exists_ge_isOrdering with ⟨_, _, hO⟩
  exact ⟨_, by grind, hO, by membership⟩

theorem exists_gt_isOrdering (hP : P.IsPreordering) (hp : a ∉ P) (hn : -a ∉ P) :
    ∃ Q > P, Q.IsOrdering := by
  rcases hP.exists_ge_isOrdering_and_mem_or_neg_mem a with ⟨_, _, hQ, _ | _⟩ <;>
    exact ⟨_, by grind [lt_iff_le_and_ne], hQ⟩

end IsPreordering

/- A maximal ordering on `R` is precisely a maximal preordering on `R`. -/
theorem maximal_isOrdering_iff_maximal_isPreordering {O : Subsemiring R} :
    Maximal IsOrdering O ↔ Maximal IsPreordering O where
  mp hO := ⟨hO.prop.isPreordering, fun _ hP _ ↦ by
    rcases hP.exists_ge_isOrdering with ⟨_, hO', hO'₂⟩
    simpa [hO.eq_of_ge hO'₂ (by grind)] using hO'⟩
  mpr hO := .mono hO (fun _ hO ↦ hO.isPreordering) (.of_maximal_isPreordering hO)

/- A preordering on a field `F` is maximal iff it is an ordering. -/
theorem maximal_isPreordering_iff_isOrdering {O : Subsemiring F} :
    Maximal IsPreordering O ↔ O.IsOrdering where
  mp := .of_maximal_isPreordering
  mpr hO := ⟨hO.isPreordering, fun _ hO' ↦
    (hO.isSpanning.maximal_isPointed hO.isPreordering.isPointed).le_of_ge hO'.isPointed⟩

end Subsemiring
