/-!
# Lemmas about ideals of `MonoidAlgebra` and `AddMonoidAlgebra`
-/

public section


variable {k A G ι : Type*}

theorem MonoidAlgebra.mem_ideal_span_single_image' [Monoid G] [Semiring k] {s : Set ι}
    {fm : ι → G} {fc : ι → k} {x : MonoidAlgebra k G} :
    x ∈ Ideal.span ((fun i ↦ MonoidAlgebra.single (fm i) (fc i)) '' s) ↔
      ∀ m, x.coeff m ∈ Ideal.span (fc '' {i ∈ s | ∃ d, m = d * (fm i)}) := by
  classical
  let RHS : Ideal (MonoidAlgebra k G) := {
    carrier := {x | ∀ m, x.coeff m ∈ Ideal.span (fc '' {i ∈ s | ∃ d, m = d * (fm i)})},
    add_mem' ha hb m := Ideal.add_mem _ (ha m) (hb m),
    zero_mem' := by simp
    smul_mem' a b hb m := by
      simp only [smul_eq_mul, coeff_mul]
      refine Ideal.sum_mem _ fun m' hm' ↦ Ideal.sum_mem _ fun m'' hm'' ↦ ?_
      simp only [apply_ite, zero_mem, ite_true_right]
      rintro rfl
      refine Ideal.mul_mem_left _ _ <| Ideal.span_mono ?_ <| hb m''
      apply Set.image_mono
      rintro i ⟨his, ⟨d, rfl⟩⟩
      exact ⟨his, ⟨m' * d, (mul_assoc ..).symm⟩⟩
  }
  change _ ↔ x ∈ RHS
  constructor
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, ⟨hi, rfl⟩⟩
    simpa [Finsupp.single_apply, apply_ite, RHS, ← Submodule.carrier_eq_coe] using
      Ideal.subset_span <| Set.mem_image_of_mem _ <| by exact ⟨hi, ⟨1, by simp⟩⟩
  · intro h
    rw [← x.sum_coeff_single]
    apply Ideal.sum_mem
    rintro m -
    specialize h m
    apply Submodule.mem_map_of_mem (f := MonoidAlgebra.lsingle (R := k) m) at h
    rw [Submodule.map_span] at h
    refine Ideal.span_le.mpr ?_ (Submodule.span_subset_span k _ (M := MonoidAlgebra k G) _ h)
    rintro _ ⟨_, ⟨i, ⟨hi, ⟨d, rfl⟩⟩, rfl⟩, rfl⟩
    rw [lsingle_apply, ← one_mul (fc i), ← single_mul_single d (fm i) 1 (fc i)]
    exact Ideal.mul_mem_left _ _ <| Ideal.subset_span <| Set.mem_image_of_mem _ hi

theorem MonoidAlgebra.mem_ideal_span_single_image [Monoid G] [Semiring k] {s : Set ι}
    {fm : ι → G} {fc : ι → k} {x : MonoidAlgebra k G} :
    x ∈ Ideal.span ((fun i ↦ MonoidAlgebra.single (fm i) (fc i)) '' s) ↔
      ∀ m ∈ x.coeff.support,
        x.coeff m ∈ Ideal.span (fc '' {i ∈ s | ∃ d, m = d * (fm i)}) := by
  convert x.mem_ideal_span_single_image' with m
  by_cases h : x.coeff m = 0 <;> simp [h]

open Multiplicative in
theorem AddMonoidAlgebra.mem_ideal_span_single_image' [AddMonoid G] [Semiring k] {s : Set ι}
    {fm : ι → G} {fc : ι → k} {x : AddMonoidAlgebra k G} :
    x ∈ Ideal.span ((fun i ↦ AddMonoidAlgebra.single (fm i) (fc i)) '' s) ↔
      ∀ m, x.coeff m ∈ Ideal.span (fc '' {i ∈ s | ∃ d, m = d + (fm i)}) := by
  convert
    (toMultiplicative _ _ x).mem_ideal_span_single_image' (s := s) (fm := ofAdd ∘ fm) (fc := fc)
  · simp [← AddMonoidAlgebra.toMultiplicative_single, ← Set.image_image, ← Ideal.map_span]
  · simp [← ofAdd_add]

theorem AddMonoidAlgebra.mem_ideal_span_single_image [AddMonoid G] [Semiring k] {s : Set ι}
    {fm : ι → G} {fc : ι → k} {x : AddMonoidAlgebra k G} :
    x ∈ Ideal.span ((fun i ↦ AddMonoidAlgebra.single (fm i) (fc i)) '' s) ↔
      ∀ m ∈ x.coeff.support,
        x.coeff m ∈ Ideal.span (fc '' {i ∈ s | ∃ d, m = d + (fm i)}) := by
  convert x.mem_ideal_span_single_image' with m
  by_cases h : x.coeff m = 0 <;> simp [h]

/-- If `x` belongs to the ideal generated by generators in `s`, then every element of the support of
`x` factors through an element of `s`.

We could spell `∃ d, m = d * m` as `MulOpposite.op m' ∣ MulOpposite.op m` but this would be worse.
-/
theorem MonoidAlgebra.mem_ideal_span_of_image [Monoid G] [Semiring k] {s : Set G}
    {x : MonoidAlgebra k G} :
    x ∈ Ideal.span (MonoidAlgebra.of k G '' s) ↔
      ∀ m ∈ x.coeff.support, ∃ m' ∈ s, ∃ d, m = d * m' := by
  convert! x.mem_ideal_span_single_image (s := s) (fm := id) (fc := 1) with _ _ m hm
  by_cases! hm' : ¬ ∃ m' ∈ s, ∃ d, m = d * m'
  · grind [Ideal.mem_bot, Submodule.span_eq_bot]
  simp [Set.Nonempty.image_const (s := {m' ∈ s | ∃ d, m = d * m'}) hm', hm']

/-- If `x` belongs to the ideal generated by generators in `s`, then every element of the support of
`x` factors additively through an element of `s`.
-/
theorem AddMonoidAlgebra.mem_ideal_span_of'_image [AddMonoid A] [Semiring k] {s : Set A}
    {x : AddMonoidAlgebra k A} :
    x ∈ Ideal.span (AddMonoidAlgebra.of' k A '' s) ↔
      ∀ m ∈ x.coeff.support, ∃ m' ∈ s, ∃ d, m = d + m' := by
  -- TODO: this proof is a direct copy of MonoidAlgebra.mem_ideal_span_of_image.
  -- Alternatively, we could prove it via the equiv between `MonoidAlgebra` and `AddMonoidAlgebra`,
  -- but that would require a lot more API.
  classical
  let RHS : Ideal (AddMonoidAlgebra k A) := {
    carrier := { p | ∀ m : A, m ∈ p.coeff.support → ∃ m' ∈ s, ∃ d, m = d + m' }
    add_mem' {x y} hx hy m hm := (Finset.mem_union.1 <| Finsupp.support_add hm).elim (hx m) (hy m)
    zero_mem' := by simp
    smul_mem' x y hy m hm := by
      simp only [smul_eq_mul, mul_def, coeff_finsuppSum] at hm
      obtain ⟨xm, -, hm⟩ := Finset.mem_biUnion.mp <| Finsupp.support_sum hm
      obtain ⟨ym, hym, hm⟩ := Finset.mem_biUnion.mp <| Finsupp.support_sum hm
      obtain rfl := Finset.mem_singleton.mp <| Finsupp.support_single_subset hm
      refine (hy _ hym).imp fun sm ↦ .imp_right ?_
      rintro ⟨d, rfl⟩
      exact ⟨xm + d, (add_assoc ..).symm⟩
  }
  change _ ↔ x ∈ RHS
  constructor
  · suffices Ideal.span (of' k A '' s) ≤ RHS from @this x
    rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩ m hm
    refine ⟨_, hi, 0, ?_⟩
    simpa using Finsupp.support_single_subset hm
  · intro hx
    rw [← x.sum_coeff_single]
    apply Ideal.sum_mem _ fun i hi ↦ ?_
    obtain ⟨d, hd, d2, rfl⟩ := hx _ hi
    simpa using Ideal.mul_mem_left _ (.single d2 <| x.coeff (d2 + d))
      (b := of' k A d) (Ideal.subset_span <| Set.mem_image_of_mem _ hd)
