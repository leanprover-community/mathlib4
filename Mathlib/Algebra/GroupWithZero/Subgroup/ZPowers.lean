module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Algebra.GroupWithZero.Subgroup.Units

/-!
# The subgroup with zero generated by an element

## Main definitions

* `SubgroupWithZero.zpowers₀ g`: the subgroup with zero generated by `g`.

## Implementation notes

Unlike `Subgroup.zpowers`, `zpowers₀` is defined as a closure rather than by an explicit carrier.
In a group with zero the set of integer powers of `g` is only multiplicatively closed after
adjoining `0`, and `zpow_add` is genuinely false at `g = 0` — only `zpow_add₀` is available. The
carrier description survives as `SubgroupWithZero.coe_zpowers₀`, valid for *every* `g`.

## Tags
subgroup with zero, zpowers
-/

@[expose] public section

assert_not_exists Ring

variable {G₀ H₀ : Type*} [GroupWithZero G₀] [GroupWithZero H₀]

namespace SubgroupWithZero

variable {g x : G₀} {s : SubgroupWithZero G₀}

/-- The subgroup with zero generated by a single element. -/
def zpowers₀ (g : G₀) : SubgroupWithZero G₀ := closure {g}

lemma zpowers₀_eq_closure (g : G₀) : zpowers₀ g = closure {g} := rfl

@[simp]
lemma zpowers₀_le : zpowers₀ g ≤ s ↔ g ∈ s := by
  rw [zpowers₀, closure_le, Set.singleton_subset_iff, SetLike.mem_coe]

alias ⟨_, zpowers₀_le_of_mem⟩ := zpowers₀_le

@[simp] lemma mem_zpowers₀ (g : G₀) : g ∈ zpowers₀ g := subset_closure rfl

@[simp]
lemma zpow_mem_zpowers₀ (g : G₀) (n : ℤ) : g ^ n ∈ zpowers₀ g := zpow_mem (mem_zpowers₀ g) n

@[simp]
lemma zpowers₀_inv (g : G₀) : zpowers₀ g⁻¹ = zpowers₀ g :=
  le_antisymm (zpowers₀_le.2 (inv_mem (mem_zpowers₀ g)))
    (zpowers₀_le.2 (by simpa using inv_mem (mem_zpowers₀ g⁻¹)))

/-- The bottom subgroup with zero is `{0, 1}`, so `zpowers₀ g` is trivial exactly when `g` is
`0` or `1`. -/
@[simp]
lemma zpowers₀_eq_bot : zpowers₀ g = ⊥ ↔ g = 0 ∨ g = 1 := by
  rw [_root_.eq_bot_iff, zpowers₀_le, mem_bot]

@[simp] lemma zpowers₀_zero : zpowers₀ (0 : G₀) = ⊥ := zpowers₀_eq_bot.2 (.inl rfl)
@[simp] lemma zpowers₀_one : zpowers₀ (1 : G₀) = ⊥ := zpowers₀_eq_bot.2 (.inr rfl)

/-- Taking units turns `zpowers₀` into `Subgroup.zpowers`. Every `Subgroup.zpowers` fact
transfers through this. The `simp`-normal form has the generator as a unit; see
`units_zpowers₀_of_ne_zero` for a nonzero element of `G₀`. -/
@[simp]
lemma units_zpowers₀ (u : G₀ˣ) : (zpowers₀ (u : G₀)).units = Subgroup.zpowers u := by
  rw [zpowers₀, units_closure, Subgroup.zpowers_eq_closure]
  congr 1
  ext v
  simp [Units.ext_iff]

lemma units_zpowers₀_of_ne_zero (hg : g ≠ 0) :
    (zpowers₀ g).units = Subgroup.zpowers (Units.mk0 g hg) := by
  rw [← units_zpowers₀ (Units.mk0 g hg), Units.val_mk0]

/-- `zpowers₀ g` is `0` together with the integer powers of `g`. Compare `mem_closure_iff`: for
`g ≠ 0` the units of `zpowers₀ g` are `Subgroup.zpowers (Units.mk0 g hg)`. -/
lemma mem_zpowers₀_iff : x ∈ zpowers₀ g ↔ x = 0 ∨ ∃ n : ℤ, g ^ n = x := by
  rcases eq_or_ne g 0 with rfl | hg
  · rw [zpowers₀_zero, mem_bot]
    refine ⟨fun h ↦ h.imp_right fun h ↦ ⟨0, by simp [h]⟩, fun h ↦ h.elim .inl fun ⟨n, hn⟩ ↦ ?_⟩
    rw [← hn, zero_zpow_eq]; split_ifs <;> simp
  · rw [← withZero_units (zpowers₀ g), units_zpowers₀_of_ne_zero hg, Subgroup.mem_withZero]
    simp only [Subgroup.mem_zpowers_iff, exists_exists_eq_and, Units.val_zpow_eq_zpow_val,
      Units.val_mk0]

lemma mem_zpowers₀_iff_of_ne_zero (hx : x ≠ 0) :
    x ∈ zpowers₀ g ↔ ∃ n : ℤ, g ^ n = x := by simp [mem_zpowers₀_iff, hx]

@[norm_cast]
lemma coe_zpowers₀ (g : G₀) :
    (zpowers₀ g : Set G₀) = insert 0 (Set.range (g ^ · : ℤ → G₀)) := by
  ext x
  simp [mem_zpowers₀_iff, eq_comm]

/-- If `x : s` generates `s` in the ambient group, its powers exhaust `s`. -/
lemma zpowers₀_coe_eq_top {s : SubgroupWithZero G₀} (x : s) (h : zpowers₀ (x : G₀) = s) :
    zpowers₀ x = ⊤ := by
  ext y
  simp only [mem_top, iff_true]
  have hy : (y : G₀) ∈ zpowers₀ (x : G₀) := by rw [h]; exact y.2
  rw [mem_zpowers₀_iff] at hy ⊢
  rcases hy with hy | ⟨n, hn⟩
  · exact .inl (Subtype.ext (by simpa using hy))
  · exact .inr ⟨n, Subtype.ext hn⟩

end SubgroupWithZero
