module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.GroupWithZero.Subgroup.Defs

/-!
# The complete lattice of subgroups with zero

We prove that the subgroups with zero of a group with zero form a complete lattice, and define
the subgroup with zero generated by a set.

## Main definitions

* `CompleteLattice (SubgroupWithZero G₀)`: subgroups with zero form a complete lattice;
* `SubgroupWithZero.closure k`: the smallest subgroup with zero containing the set `k`;
* `SubgroupWithZero.gi`: `closure` forms a Galois insertion with the coercion to `Set`.

## Implementation notes

Unlike `Subgroup`, the bottom element here is `{0, 1}` rather than `{1}`: every subgroup with
zero contains both `0` and `1`. Two consequences are worth keeping in mind.

* `SubgroupWithZero.mem_bot` reads `x ∈ ⊥ ↔ x = 0 ∨ x = 1`, and there is no analogue of
  `Subgroup.nontrivial_iff_ne_bot`: `Nontrivial ↥s` holds for *every* `s`. Use `Nontrivial (↥s)ˣ`,
  or `s ≠ ⊥`, as a non-degeneracy hypothesis.
* `SubgroupWithZero.closure_induction` carries an extra `zero` case: unlike `1`, the element `0`
  is not generated multiplicatively from `k`.

## Tags
subgroup with zero, lattice
-/

@[expose] public section

assert_not_exists Ring

open Set

namespace SubgroupWithZero

variable {G₀ : Type*} [GroupWithZero G₀] {s t : SubgroupWithZero G₀} {k : Set G₀} {x : G₀}

instance : Top (SubgroupWithZero G₀) :=
  ⟨{ carrier := Set.univ
     zero_mem' := Set.mem_univ _
     one_mem' := Set.mem_univ _
     mul_mem' _ _ := Set.mem_univ _
     inv_mem' _ := Set.mem_univ _ }⟩

/-- The bottom subgroup with zero is `{0, 1}`, **not** `{1}`. -/
instance : Bot (SubgroupWithZero G₀) :=
  ⟨{ carrier := {0, 1}
     zero_mem' := Set.mem_insert _ _
     one_mem' := Set.mem_insert_of_mem _ rfl
     mul_mem' := by rintro a b (rfl | rfl) (rfl | rfl) <;> simp
     inv_mem' := by rintro a (rfl | rfl) <;> simp }⟩

instance : Inhabited (SubgroupWithZero G₀) := ⟨⊥⟩

@[simp] theorem mem_top (x : G₀) : x ∈ (⊤ : SubgroupWithZero G₀) := Set.mem_univ x

@[simp, norm_cast]
theorem coe_top : ((⊤ : SubgroupWithZero G₀) : Set G₀) = Set.univ := rfl

@[simp] theorem mem_bot : x ∈ (⊥ : SubgroupWithZero G₀) ↔ x = 0 ∨ x = 1 := Iff.rfl

@[simp, norm_cast]
theorem coe_bot : ((⊥ : SubgroupWithZero G₀) : Set G₀) = {0, 1} := rfl

instance : Min (SubgroupWithZero G₀) :=
  ⟨fun s t ↦
    { carrier := (s : Set G₀) ∩ t
      zero_mem' := ⟨zero_mem s, zero_mem t⟩
      one_mem' := ⟨one_mem s, one_mem t⟩
      mul_mem' hx hy := ⟨mul_mem hx.1 hy.1, mul_mem hx.2 hy.2⟩
      inv_mem' hx := ⟨inv_mem hx.1, inv_mem hx.2⟩ }⟩

@[simp, norm_cast]
theorem coe_inf (s t : SubgroupWithZero G₀) : ((s ⊓ t : SubgroupWithZero G₀) : Set G₀) = ↑s ∩ ↑t :=
  rfl

@[simp] theorem mem_inf : x ∈ s ⊓ t ↔ x ∈ s ∧ x ∈ t := Iff.rfl

instance : InfSet (SubgroupWithZero G₀) :=
  ⟨fun S ↦
    { carrier := ⋂ s ∈ S, (s : Set G₀)
      zero_mem' := Set.mem_biInter fun s _ ↦ zero_mem s
      one_mem' := Set.mem_biInter fun s _ ↦ one_mem s
      mul_mem' hx hy := Set.mem_biInter fun s hs ↦
        mul_mem (Set.mem_iInter₂.1 hx s hs) (Set.mem_iInter₂.1 hy s hs)
      inv_mem' hx := Set.mem_biInter fun s hs ↦ inv_mem (Set.mem_iInter₂.1 hx s hs) }⟩

@[simp, norm_cast]
theorem coe_sInf (S : Set (SubgroupWithZero G₀)) :
    ((sInf S : SubgroupWithZero G₀) : Set G₀) = ⋂ s ∈ S, ↑s := rfl

@[simp]
theorem mem_sInf {S : Set (SubgroupWithZero G₀)} : x ∈ sInf S ↔ ∀ s ∈ S, x ∈ s :=
  Set.mem_iInter₂

instance : CompleteLattice (SubgroupWithZero G₀) :=
  { completeLatticeOfInf (SubgroupWithZero G₀) fun _s ↦
      IsGLB.of_image SetLike.coe_subset_coe isGLB_biInf with
    bot := ⊥
    bot_le := fun S _x hx ↦ by rcases mem_bot.1 hx with rfl | rfl; exacts [zero_mem S, one_mem S]
    top := ⊤
    le_top := fun _S x _hx ↦ mem_top x
    inf := (· ⊓ ·)
    le_inf := fun _a _b _c ha hb _x hx ↦ ⟨ha hx, hb hx⟩
    inf_le_left := fun _a _b _x ↦ And.left
    inf_le_right := fun _a _b _x ↦ And.right }

/-- The subgroup with zero generated by a set. -/
def closure (k : Set G₀) : SubgroupWithZero G₀ := sInf { S | k ⊆ S }

theorem mem_closure : x ∈ closure k ↔ ∀ S : SubgroupWithZero G₀, k ⊆ S → x ∈ S := mem_sInf

/-- The subgroup with zero generated by a set includes the set. -/
@[simp, aesop safe 20 (rule_sets := [SetLike])]
theorem subset_closure : k ⊆ closure k := fun _ hx ↦ mem_closure.2 fun _ hK ↦ hK hx

@[aesop 80% (rule_sets := [SetLike])]
theorem mem_closure_of_mem (hx : x ∈ k) : x ∈ closure k := subset_closure hx

theorem notMem_of_notMem_closure (hx : x ∉ closure k) : x ∉ k := fun h ↦ hx (subset_closure h)

/-- A subgroup with zero `S` includes `closure k` if and only if it includes `k`. -/
@[simp]
theorem closure_le : closure k ≤ s ↔ k ⊆ s := ⟨Subset.trans subset_closure, fun h ↦ sInf_le h⟩

theorem closure_eq_of_le (h₁ : k ⊆ s) (h₂ : s ≤ closure k) : closure k = s :=
  le_antisymm (closure_le.2 h₁) h₂

@[gcongr]
theorem closure_mono ⦃h k : Set G₀⦄ (h' : h ⊆ k) : closure h ≤ closure k :=
  closure_le.2 <| Subset.trans h' subset_closure

@[simp]
theorem closure_eq (s : SubgroupWithZero G₀) : closure (s : Set G₀) = s :=
  le_antisymm (closure_le.2 le_rfl) subset_closure

@[simp] theorem closure_eq_bot_iff : closure k = ⊥ ↔ k ⊆ {0, 1} := by
  rw [eq_bot_iff, closure_le, coe_bot]

@[simp] theorem closure_empty : closure (∅ : Set G₀) = ⊥ :=
  le_antisymm (closure_le.2 <| Set.empty_subset _) bot_le

@[simp] theorem closure_univ : closure (Set.univ : Set G₀) = ⊤ := by
  simpa using closure_eq (⊤ : SubgroupWithZero G₀)

/-- An induction principle for closure membership.

Note the extra `zero` case compared with `Subgroup.closure_induction`: `0` belongs to every
subgroup with zero and is not generated multiplicatively from `k`. -/
@[elab_as_elim]
theorem closure_induction {motive : ∀ x, x ∈ closure k → Prop}
    (mem : ∀ x (hx : x ∈ k), motive x (subset_closure hx))
    (zero : motive 0 (zero_mem _)) (one : motive 1 (one_mem _))
    (mul : ∀ x y hx hy, motive x hx → motive y hy → motive (x * y) (mul_mem hx hy))
    (inv : ∀ x hx, motive x hx → motive x⁻¹ (inv_mem hx))
    {x} (hx : x ∈ closure k) : motive x hx :=
  let S : SubgroupWithZero G₀ :=
    { carrier := { x | ∃ hx, motive x hx }
      zero_mem' := ⟨_, zero⟩
      one_mem' := ⟨_, one⟩
      mul_mem' := fun ⟨_, hpx⟩ ⟨_, hpy⟩ ↦ ⟨_, mul _ _ _ _ hpx hpy⟩
      inv_mem' := fun ⟨_, hpx⟩ ↦ ⟨_, inv _ _ hpx⟩ }
  closure_le (s := S) |>.mpr (fun y hy ↦ ⟨subset_closure hy, mem y hy⟩) hx |>.elim fun _ ↦ id

variable (G₀) in
/-- `closure` forms a Galois insertion with the coercion to `Set`. -/
protected def gi : GaloisInsertion (@closure G₀ _) SetLike.coe where
  choice k _ := closure k
  gc _ _ := closure_le
  le_l_u _ := subset_closure
  choice_eq _ _ := rfl

end SubgroupWithZero
