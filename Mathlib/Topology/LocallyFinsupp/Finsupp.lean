module

public import Mathlib.Algebra.Group.Finsupp
public import Mathlib.Algebra.Group.Subgroup.Finsupp
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Topology.LocallyFinsupp

/-!
# Functions with locally finite support and finitely supported functions

In this file we provide a bridge between the API for `Finsupp` and `locallyFinsuppWithin` in the
case where the set on which the function has locally finite support is compact, where these notions
coincide.

## Main definitions

* `Function.locallyFinsuppWithin.toFinsupp`: a function with locally finite support that in fact
  has finite support, as a `Finsupp`.
* `Function.locallyFinsupp.ofFinsupp`, `Function.locallyFinsupp.ofFinsuppAddHom`: a finitely
  supported function as a function with locally finite support.
* `Function.locallyFinsupp.equivFinsupp`, `Function.locallyFinsupp.addEquivFinsupp`: on a compact
  space the two notions agree.
* `Function.locallyFinsupp.singleSet`: the indicator functions `single p g` with `p ∈ s`
  and `g ∈ G`.

## Main results

* `Function.locallyFinsupp.induction`: `Finsupp.induction₂` for functions with locally finite
  support on a compact space.
* `Function.locallyFinsupp.mem_closure_singleSet_iff` and
  `Function.locallyFinsupp.closure_singleSet`: on a compact space, the functions supported in `s`
  are exactly the additive subgroup generated by `singleSet s G`, for `G` a generating set of the
  target group. These transport `Finsupp.mem_addSubgroup_closure_setOf_single_iff` along
  `addEquivFinsupp`. Combined with `AddSubgroup.closure_induction_left` and
  `AddSubgroup.closure_induction_right`
  they give induction principles whose steps change the value at a single point of `s` by a
  generator.
* `Function.locallyFinsupp.induction_add_sub_single_one`: the resulting induction principle for
  `ℤ`-valued functions, where the steps add or subtract `single p 1` for a point `p ∈ s`.
-/

@[expose] public section

open Filter Function Set

variable {X Y : Type*} [TopologicalSpace X] {U s : Set X}

namespace Function.locallyFinsuppWithin

/-- A function with locally finite support that in fact has finite support, as a `Finsupp`.

The hypothesis is automatic when `U` is compact, see
`Function.locallyFinsuppWithin.finiteSupport`. -/
noncomputable def toFinsupp [Zero Y] (D : locallyFinsuppWithin U Y) (h : D.support.Finite) :
    X →₀ Y where
  support := h.toFinset
  toFun := D
  mem_support_toFun _ := by simp [mem_support]

@[simp] lemma coe_toFinsupp [Zero Y] (D : locallyFinsuppWithin U Y) (h : D.support.Finite) :
    ⇑(D.toFinsupp h) = D := rfl

@[simp] lemma support_toFinsupp [Zero Y] (D : locallyFinsuppWithin U Y) (h : D.support.Finite) :
    (D.toFinsupp h).support = h.toFinset := rfl


end Function.locallyFinsuppWithin

namespace Function.locallyFinsupp

open Function.locallyFinsuppWithin

/-!
## Comparison with `Finsupp`
-/

section OfFinsupp

variable [Zero Y]

/-- A finitely supported function is a function with locally finite support. -/
def ofFinsupp (f : X →₀ Y) : locallyFinsupp X Y where
  toFun := f
  supportWithinDomain' := subset_univ _
  supportLocallyFiniteWithinDomain' _ _ :=
    ⟨univ, univ_mem, f.hasFiniteSupport.subset inter_subset_right⟩

@[simp] lemma coe_ofFinsupp (f : X →₀ Y) : ⇑(ofFinsupp f) = f := rfl

@[simp] lemma ofFinsupp_single [DecidableEq X] (p : X) (y : Y) :
    ofFinsupp (Finsupp.single p y) = single p y := by
  ext x
  simp [Finsupp.single_apply, single_apply, eq_comm]

@[simp] lemma ofFinsupp_toFinsupp (D : locallyFinsupp X Y) (h : D.support.Finite) :
    ofFinsupp (D.toFinsupp h) = D := rfl

@[simp] lemma toFinsupp_ofFinsupp (f : X →₀ Y) (h : (ofFinsupp f).support.Finite) :
    (ofFinsupp f).toFinsupp h = f := by ext; rfl

variable [CompactSpace X]

/-- On a compact space, functions with locally finite support are exactly the finitely supported
functions. -/
@[simps] noncomputable def equivFinsupp : locallyFinsupp X Y ≃ (X →₀ Y) where
  toFun D := D.toFinsupp (D.finiteSupport isCompact_univ)
  invFun := ofFinsupp
  left_inv D := ofFinsupp_toFinsupp D _
  right_inv f := toFinsupp_ofFinsupp f _

end OfFinsupp

section OfFinsuppAdd

variable [AddMonoid Y]

@[simp] lemma ofFinsupp_zero : ofFinsupp (0 : X →₀ Y) = 0 := rfl

@[simp] lemma ofFinsupp_add (f g : X →₀ Y) : ofFinsupp (f + g) = ofFinsupp f + ofFinsupp g := rfl

variable (X Y) in
/-- `Function.locallyFinsupp.ofFinsupp` as an additive monoid homomorphism. Unlike
`Function.locallyFinsupp.addEquivFinsupp` this needs no compactness assumption, so it can be used
to transport identities such as `Finsupp.sum_single` to functions with locally finite support. -/
@[simps] def ofFinsuppAddHom : (X →₀ Y) →+ locallyFinsupp X Y where
  toFun := ofFinsupp
  map_zero' := ofFinsupp_zero
  map_add' := ofFinsupp_add

/-- On a compact space, functions with locally finite support are additively equivalent to the
finitely supported functions. -/
noncomputable def addEquivFinsupp [CompactSpace X] :
    locallyFinsupp X Y ≃+ (X →₀ Y) where
  __ := equivFinsupp
  map_add' _ _ := by ext; rfl

@[simp] lemma addEquivFinsupp_apply [CompactSpace X] (D : locallyFinsupp X Y) :
    addEquivFinsupp D = D.toFinsupp (D.finiteSupport isCompact_univ) := rfl

@[simp] lemma coe_addEquivFinsupp_symm [CompactSpace X] :
    ⇑(addEquivFinsupp : locallyFinsupp X Y ≃+ (X →₀ Y)).symm = ofFinsupp := rfl

@[simp] lemma addEquivFinsupp_symm_apply [CompactSpace X] (f : X →₀ Y) :
    addEquivFinsupp.symm f = ofFinsupp f := rfl

end OfFinsuppAdd

/-- Induction principle for functions with locally finite support on a compact space: this is
`Finsupp.induction₂` transported along `Function.locallyFinsupp.addEquivFinsupp`. -/
@[elab_as_elim]
protected theorem induction [DecidableEq X] [CompactSpace X] [AddMonoid Y]
    {motive : locallyFinsupp X Y → Prop} (D : locallyFinsupp X Y) (zero : motive 0)
    (add_single : ∀ (p : X) (y : Y) (E : locallyFinsupp X Y), p ∉ E.support → y ≠ 0 →
      motive E → motive (E + single p y)) :
    motive D := by
  suffices h : ∀ f : X →₀ Y, motive (ofFinsupp f) by
    simpa using h (D.toFinsupp (D.finiteSupport isCompact_univ))
  intro f
  induction f using Finsupp.induction₂ with
  | zero => simpa using zero
  | add_single p y f hp hy ih =>
    simpa using add_single p y (ofFinsupp f)
      (by simpa [mem_support] using Finsupp.notMem_support_iff.mp hp) hy ih

variable (s) in
/-- The set of indicator functions `single p g` with `p ∈ s` and `g ∈ G`. On a compact space the
additive subgroup it generates is the set of functions supported in `s`, see
`Function.locallyFinsupp.closure_singleSet`. -/
noncomputable def singleSet [DecidableEq X] [Zero Y] (G : Set Y) : Set (locallyFinsupp X Y) :=
  {E | ∃ p ∈ s, ∃ g ∈ G, E = single p g}

@[simp] lemma mem_singleSet [DecidableEq X] [Zero Y] {G : Set Y} {E : locallyFinsupp X Y} :
    E ∈ singleSet s G ↔ ∃ p ∈ s, ∃ g ∈ G, E = single p g := Iff.rfl

variable (s) in
/-- `singleSet s G` is the image of the corresponding set of `Finsupp.single`s under
`Function.locallyFinsupp.ofFinsupp`. -/
lemma image_ofFinsupp_setOf_single [DecidableEq X] [Zero Y] {G : Set Y} :
    ofFinsupp '' {g : X →₀ Y | ∃ p ∈ s, ∃ y ∈ G, g = Finsupp.single p y} = singleSet s G := by
  ext E
  constructor
  · rintro ⟨g, ⟨p, hp, y, hy, rfl⟩, rfl⟩
    exact ⟨p, hp, y, hy, by simp⟩
  · rintro ⟨p, hp, y, hy, rfl⟩
    exact ⟨Finsupp.single p y, ⟨p, hp, y, hy, rfl⟩, by simp⟩

variable (s) in
/-- On a compact space, a function lies in the additive subgroup generated by the indicator
functions `single p g` (`p ∈ s`, `g` in a generating set `G` of the target group) exactly when it
is supported in `s`. -/
lemma mem_closure_singleSet_iff [DecidableEq X] [CompactSpace X] [AddGroup Y] {G : Set Y}
    (hG : AddSubgroup.closure G = ⊤) {D : locallyFinsupp X Y} :
    D ∈ AddSubgroup.closure (singleSet s G) ↔ D.support ⊆ s := by
  have himg : AddSubgroup.closure (singleSet s G) =
      (AddSubgroup.closure {g : X →₀ Y | ∃ p ∈ s, ∃ y ∈ G, g = Finsupp.single p y}).map
        (addEquivFinsupp.symm : (X →₀ Y) ≃+ locallyFinsupp X Y).toAddMonoidHom := by
    rw [AddMonoidHom.map_closure, ← image_ofFinsupp_setOf_single s]
    simp
  rw [himg, AddSubgroup.mem_map_equiv, AddEquiv.symm_symm,
    Finsupp.mem_addSubgroup_closure_setOf_single_iff hG, addEquivFinsupp_apply,
    support_toFinsupp, Set.Finite.coe_toFinset]

variable (s) in
/-- On a compact space, the functions supported in `s` are exactly the additive subgroup generated
by the indicator functions `single p g` with `p ∈ s` and `g` in a generating set `G` of the target
group. -/
theorem closure_singleSet [DecidableEq X] [CompactSpace X] [AddGroup Y] {G : Set Y}
    (hG : AddSubgroup.closure G = ⊤) :
    AddSubgroup.closure (singleSet s G) = supported Y univ s :=
  AddSubgroup.ext fun _ ↦ (mem_closure_singleSet_iff s hG).trans mem_supported.symm

/-- Induction principle for `ℤ`-valued functions with locally finite support on a compact space
whose support is contained in a set `s`, where the induction steps add or subtract `single p 1`
for a point `p ∈ s`. -/
@[elab_as_elim]
theorem induction_add_sub_single_one [DecidableEq X] [CompactSpace X]
    {motive : (D : locallyFinsupp X ℤ) → D.support ⊆ s → Prop}
    (zero : motive 0 (by simp))
    (add_single : ∀ (E : locallyFinsupp X ℤ) (hE : E.support ⊆ s), motive E hE →
      ∀ (p : X) (hp : p ∈ s), motive (E + single p 1) (support_add_single_subset hE hp))
    (sub_single : ∀ (E : locallyFinsupp X ℤ) (hE : E.support ⊆ s), motive E hE →
      ∀ (p : X) (hp : p ∈ s), motive (E - single p 1) (support_sub_single_subset hE hp))
    (D : locallyFinsupp X ℤ) (hD : D.support ⊆ s) : motive D hD := by
  have hG : AddSubgroup.closure ({1} : Set ℤ) = ⊤ :=
    (AddSubgroup.eq_top_iff' _).2 fun x ↦ AddSubgroup.mem_closure_singleton.2 ⟨x, by simp⟩
  have hmem {E : locallyFinsupp X ℤ} :
      E ∈ AddSubgroup.closure (singleSet s ({1} : Set ℤ)) ↔ E.support ⊆ s :=
    mem_closure_singleSet_iff s hG
  refine AddSubgroup.closure_induction_right
    (p := fun E _ ↦ ∀ h : E.support ⊆ s, motive E h) (fun _ ↦ zero) ?_ ?_ (hmem.2 hD) hD
  · rintro E hE _ ⟨p, hp, g, rfl : g = 1, rfl⟩ ih
    exact fun _ ↦ add_single E (hmem.1 hE) (ih _) p hp
  · -- `to_additive` renders the third premise of `AddSubgroup.closure_induction_right` as
    -- `E + -single p 1`, so the goal has to be turned back into a subtraction.
    rintro E hE _ ⟨p, hp, g, rfl : g = 1, rfl⟩ ih
    rw [← sub_eq_add_neg]
    exact fun _ ↦ sub_single E (hmem.1 hE) (ih _) p hp

end Function.locallyFinsupp
