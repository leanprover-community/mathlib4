/-! ### Reachability -/

/-- `reach k E S` saturates `S` under the edges `E`, using at most `k` rounds. Each round that
changes anything uses up at least one edge, so `k = E.length + 1` rounds are always enough
(`mem_reach_iff`). Recursion is structural in the fuel, so `decide` can evaluate it. -/
def reach : ℕ → List (ℕ × ℕ) → List ℕ → List ℕ
  | 0, _, S => S
  | k + 1, E, S =>
    let U := E.filter (·.1 ∈ S)
    if U.isEmpty then S else reach k (E.filter (·.1 ∉ S)) (S ++ U.map (·.2))

lemma subset_reach (k : ℕ) (E : List (ℕ × ℕ)) (S : List ℕ) : S ⊆ reach k E S := by
  induction k generalizing E S with
  | zero => exact fun _ h => h
  | succ k ih =>
    simp only [reach]
    split
    · exact fun _ h => h
    · exact fun x hx => ih _ _ (List.mem_append_left _ hx)

lemma exists_of_mem_reach {E₀ : List (ℕ × ℕ)} :
    ∀ (k : ℕ) (E : List (ℕ × ℕ)) (S : List ℕ), E ⊆ E₀ → ∀ t ∈ reach k E S,
      ∃ s ∈ S, ReflTransGen (fun a b => (a, b) ∈ E₀) s t := by
  intro k
  induction k with
  | zero => exact fun _ _ _ t ht => ⟨t, ht, .refl⟩
  | succ k ih =>
    intro E S hE t ht
    simp only [reach] at ht
    split at ht
    · exact ⟨t, ht, .refl⟩
    obtain ⟨s, hs, hst⟩ := ih _ _ (fun e he => hE (List.mem_of_mem_filter he)) t ht
    rcases List.mem_append.1 hs with hs | hs
    · exact ⟨s, hs, hst⟩
    obtain ⟨e, he, rfl⟩ := List.mem_map.1 hs
    obtain ⟨he, he₁⟩ := List.mem_filter.1 he
    exact ⟨e.1, of_decide_eq_true he₁, .head (hE he) hst⟩

lemma mem_reach_of_mem_reach :
    ∀ (k : ℕ) (E : List (ℕ × ℕ)) (S : List ℕ), E.length < k → ∀ e ∈ E,
      e.1 ∈ reach k E S → e.2 ∈ reach k E S := by
  intro k
  induction k with
  | zero => intro _ _ h; omega
  | succ k ih =>
    intro E S hk e he h₁
    simp only [reach] at h₁ ⊢
    split at h₁ <;> rename_i hU
    · rw [List.isEmpty_iff, List.filter_eq_nil_iff] at hU
      exact absurd (decide_eq_true h₁) (hU e he)
    simp only [hU]
    by_cases hs : e.1 ∈ S
    · apply subset_reach
      exact List.mem_append_right _ (List.mem_map_of_mem (List.mem_filter.2 ⟨he, by simpa⟩))
    · refine ih _ _ ?_ e (List.mem_filter.2 ⟨he, by simpa⟩) h₁
      have := List.length_eq_length_filter_add (·.1 ∈ S) (l := E)
      have : 0 < (E.filter (·.1 ∈ S)).length := by
        rw [List.length_pos_iff]; simpa [List.isEmpty_iff] using hU
      simp only [decide_not] at *
      omega

/-- `reach` decides reachability along `E`. -/
theorem mem_reach_iff {E : List (ℕ × ℕ)} {x y : ℕ} :
    y ∈ reach (E.length + 1) E [x] ↔ ReflTransGen (fun a b => (a, b) ∈ E) x y := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · obtain ⟨s, hs, h⟩ := exists_of_mem_reach _ E [x] (fun _ h => h) y h
    rwa [List.mem_singleton.1 hs] at h
  · induction h with
    | refl => exact subset_reach _ _ _ (List.mem_singleton_self x)
    | tail _ hbc ih => exact mem_reach_of_mem_reach _ _ _ (Nat.lt_succ_self _) _ hbc ih

/-! ### Points -/

/-- Points of a finite space: `L` lists the points (each a list of glued names) and `E` lists
specialization edges as index pairs (`(i, j) ∈ E` means that `j` is in the closure of `i`). -/
structure Pts {α : Type} (L : List (List α)) (E : List (ℕ × ℕ)) : Type u where
  /-- The index of the point in `L`. -/
  idx : Fin L.length

namespace Pts
variable {α : Type} {L : List (List α)} {E : List (ℕ × ℕ)}

/-- `x ≤ y` iff there is a path of edges in `E` from `y` to `x`. -/
instance : Preorder (Pts L E) where
  le x y := ReflTransGen (fun a b => (a, b) ∈ E) y.idx.val x.idx.val
  le_refl _ := .refl
  le_trans _ _ _ h₁ h₂ := h₂.trans h₁

lemma le_iff {x y : Pts L E} :
    x ≤ y ↔ ReflTransGen (fun a b => (a, b) ∈ E) y.idx.val x.idx.val := .rfl

instance : DecidableLE (Pts L E) := fun x y =>
  decidable_of_iff (x.idx.val ∈ reach (E.length + 1) E [y.idx.val]) mem_reach_iff

/-- `Pts L E` is equivalent to `Fin L.length`. -/
def equivFin : Pts L E ≃ Fin L.length where
  toFun := idx
  invFun := mk

instance : DecidableEq (Pts L E) := equivFin.decidableEq

instance : DecidableLT (Pts L E) := fun _ _ =>
  decidable_of_iff _ (lt_iff_le_not_ge.symm)

/-- The points are enumerated as bare constructors, so that `fin_cases` produces `⟨⟨0, _⟩⟩`,
`⟨⟨1, _⟩⟩`, … (printed as `pt(…)`) rather than images under an equivalence. -/
instance : Fintype (Pts L E) where
  elems := ⟨_, Multiset.coe_nodup.2 <|
    (List.nodup_finRange L.length).map (f := Pts.mk) fun _ _ => Pts.mk.inj⟩
  complete x := Multiset.mem_coe.2 <| List.mem_map.2 ⟨x.idx, List.mem_finRange _, rfl⟩
instance : FinEnum (Pts L E) := .ofEquiv _ equivFin

instance [ToString α] : ToString (Pts L E) := ⟨fun x => "=".intercalate (L[x.idx].map toString)⟩
instance [ToString α] : Repr (Pts L E) := ⟨fun x _ => toString x⟩


/-- Index-to-point, total via `%` so that the elaborator can emit it without a bound proof. -/
def ofNat (h : 0 < L.length) (n : ℕ) : Pts L E := ⟨⟨n % L.length, Nat.mod_lt _ h⟩⟩

end Pts

/-! ### Spaces -/

/-- The finite space with points `L` and specialization edges `E`, with the upper-set
(Alexandrov) topology of the preorder generated by `E`. -/
def Space {α : Type} (L : List (List α)) (E : List (ℕ × ℕ)) : TopCat :=
  TopCat.of (WithUpperSet (Pts.{u} L E))

namespace Space
variable {α β : Type} {L : List (List α)} {L' : List (List β)} {E E' : List (ℕ × ℕ)}

/-- The `k`-th point. This is the canonical form of a point: `pt(n)` elaborates to it as a term,
`simp` rewrites `Space.pt n h` to `Space.mk k h` with `k` a numeral, `fin_cases` produces it, and
it is printed as `pt(n)`.

* Unlike the constructor `Pts.mk`, it has type `Space L E`, so that `simp` (which unifies at
  reducible transparency) sees both sides of `pt(o) = pt(o)` at the same type.
* The index is a natural number rather than a `Fin L.length`, so that `simp` has nothing to
  rewrite in it (it would rewrite `⟨0, h⟩ : Fin [a, b].length` to `(0 : Fin ([].length + 1 + 1))`,
  say).
* It is reducible, so that it unfolds to the constructor `⟨⟨k, h⟩⟩` that pattern matching (and so
  the equation lemmas of definitions by pattern matching) is about. -/
@[reducible, match_pattern]
def mk (k : ℕ) (h : k < L.length) : Space L E := (⟨⟨k, h⟩⟩ : Pts L E)

@[simp] lemma idx_mk (k : ℕ) (h : k < L.length) : (mk k h : Space L E).idx = ⟨k, h⟩ := rfl

/-- Distinct points are distinct. -/
@[simp] lemma mk_inj {k k' : ℕ} {h : k < L.length} {h' : k' < L.length} :
    (mk k h : Space L E) = mk k' h' ↔ k = k' :=
  ⟨fun e => congrArg (Fin.val ∘ Pts.idx) e, fun e => by subst e; rfl⟩

instance : Preorder (Space L E) := inferInstanceAs (Preorder (WithUpperSet (Pts L E)))
instance : Topology.IsUpperSet (Space L E) := ⟨rfl⟩
instance : DecidableEq (Space L E) := inferInstanceAs (DecidableEq (Pts L E))
instance : DecidableLE (Space L E) := inferInstanceAs (DecidableLE (Pts L E))
instance : DecidableLT (Space L E) := inferInstanceAs (DecidableLT (Pts L E))
instance : DecidableRel (@Specializes (Space L E) _) := fun x y ↦
  decidable_of_iff (y ≤ x) WithUpperSet.toUpperSet_specializes_toUpperSet.symm

@[simps! -isSimp] instance : Min (Space.{u} L E) := minOfLe
@[simps! -isSimp] instance : Max (Space.{u} L E) := maxOfLe


/-- The points are enumerated as `Space.mk i`, so that `fin_cases` produces them in the
canonical form (printed as `pt(…)`). -/
instance : Fintype (Space L E) where
  elems := ⟨_, Multiset.coe_nodup.2 <|
    (List.nodup_finRange L.length).map (f := fun i => mk i.val i.isLt) fun _ _ e =>
      Fin.ext (congrArg (Fin.val ∘ Pts.idx) e)⟩
  complete x := Multiset.mem_coe.2 <| List.mem_map.2 ⟨x.idx, List.mem_finRange _, rfl⟩
instance : FinEnum (Space L E) := inferInstanceAs (FinEnum (Pts L E))

/-- `simp` can compute the number of points. -/
@[simp] lemma card : Fintype.card (Space.{u} L E) = L.length :=
  (Fintype.card_congr (α := Space.{u} L E) Pts.equivFin).trans (Fintype.card_fin _)

instance [ToString α] : Repr (Space L E) := inferInstanceAs (Repr (Pts L E))

instance : DiscreteTopology (Space L []) := by
  have {x y : Space L []} : x ≤ y ↔ x = y :=
  { mp h := by
      rcases x with ⟨⟨i, hi⟩⟩; rcases y with ⟨⟨j, hj⟩⟩
      erw [Pts.le_iff] at h; simp only [List.not_mem_nil] at h
      induction h with
      | refl => rfl
      | tail => contradiction
    mpr h := by simp [h] }
  fapply DiscreteTopology.of_finite_of_isClosed_singleton
  simp_rw [IsUpperSet.isClosed_iff_isLower]
  intro x y z; rw [this]; rintro rfl rfl; rfl

section two

variable {x y : List α}

/-!
  * A two-point space in canonical form (which is also the form generated by the notation) has
type exactly `Space [x, y] E` for some lists of labels `x`, `y`.
  * We can define an inversion on two-point spaces unconditionally, which swaps the two points.
-/

instance : HNot (Space [x, y] E) where
  hnot x := mk (1 - x.idx.val) (by grind)

@[simp, grind =] lemma hnot_mk (k : ℕ) (h : k < [x, y].length) :
  ￢(mk k h : Space.{u} [x, y] E) = mk (1 - k) (by grind) := rfl

@[simp, grind =] lemma hnot_hnot (z : Space.{u} [x, y] E) : ￢￢z = z := by
  cases z; simp [mk, hnot]; congr; grind

@[simp, grind =] lemma hnot_inj {r s : Space.{u} [x, y] E} : ￢r = ￢s ↔ r = s := by
  rcases r with ⟨r, hr⟩; rcases s with ⟨s, hs⟩
  simp [mk, hnot] at hr hs ⊢; grind

lemma ne_hnot (z : Space.{u} [x, y] E) : z ≠ ￢z := by
  cases z; simp [mk, hnot]; grind

@[simp, grind .] lemma hnot_ne (z : Space.{u} [x, y] E) : ￢z ≠ z := by
  cases z; simp [mk, hnot]; grind

lemma hnot_total (r s : Space.{u} [x, y] E) : s = r ∨ s = ￢r := by
  rcases r with ⟨r, hr⟩; rcases s with ⟨s, hs⟩
  simp [mk, hnot] at hr hs ⊢; grind

lemma hnot_total' (r s : Space.{u} [x, y] E) : r = s ∨ ￢r = s := by
  conv => congr <;> rw [eq_comm]
  exact hnot_total ..

lemma ne_iff_eq_hnot {r s : Space.{u} [x, y] E} : r ≠ s ↔ r = ￢s where
  mp h := (hnot_total s r).resolve_left h
  mpr := by rintro h rfl; exact ne_hnot _ h

lemma not_eq_iff_eq_hnot {r s : Space.{u} [x, y] E} : ¬(r = s) ↔ r = ￢s :=
  ne_iff_eq_hnot

/-!
  * The space `⌜T -> F⌟` (and all isomorphic spaces) is the Sierpinski space and is homeomorphic
  to `Prop`. Balancing generality and convenience, we define its `BooleanAlgebra` instance
  parameterized on a pair of instances `BoundedOrder` and `PartialOrder`.
-/

instance : Nontrivial (Space.{u} [x, y] E) :=
  ⟨Space.mk 0 (by simp), Space.mk 1 (by simp), by simp⟩

variable [BoundedOrder (Space.{u} [x, y] E)]

instance : Std.Total (· ≤ · : Space.{u} [x, y] E → _ → Prop) where
  total a b := by
    rcases (Space.hnot_total ⊤ a) with (rfl | rfl) <;>
    rcases (Space.hnot_total ⊤ b) with (rfl | rfl) <;> simp

variable [IsPartialOrder (Space.{u} [x, y] E) (· ≤ ·)]

lemma hnot_top : ￢ (⊤ : Space.{u} [x, y] E) = ⊥ := by
  let : PartialOrder (Space.{u} [x, y] E) := { le_antisymm _ _ := antisymm }
  have := top_ne_bot (α := Space.{u} [x, y] E) |>.symm
  symm; rwa [Space.ne_iff_eq_hnot] at this

instance : LinearOrder (Space.{u} [x, y] E) where
  le_antisymm _ _ := antisymm
  le_total := Std.Total.total
  toDecidableLE := by infer_instance

@[grind <=]
lemma eq_top_of_le_hnot_le {a b : Space.{u} [x, y] E} (h : b ≤ a) (h' : ￢b ≤ a) : a = ⊤ := by
  have := Space.hnot_ne b
  rcases (Space.hnot_total ⊤ b) with (rfl | rfl) <;> grind

instance : BooleanAlgebra (Space.{u} [x, y] E) where
  compl := hnot
  inf_compl_le_bot x := by simp [Space.hnot_total' x ⊥]
  top_le_sup_compl x := by simp [Space.hnot_total' x ⊤]
  le_top a := le_top
  bot_le a := bot_le

@[fun_prop]
lemma continuous_inf_uncurry :
    Continuous (fun (a b : Space.{u} [x, y] E) ↦ a ⊓ b).uncurry := by
  fconstructor;
  simp_rw [isOpen_iff_forall_specializes]
  intro s hs (a₁, a₂) (b₁, b₂) h hb
  simp [IsUpperSet.specializes_iff_le] at hs h hb ⊢; grind

@[fun_prop]
lemma continuous_sup_uncurry :
    Continuous (fun (a b : Space.{u} [x, y] E) ↦ a ⊔ b).uncurry := by
  fconstructor;
  simp_rw [isOpen_iff_forall_specializes]
  intro s hs (a₁, a₂) (b₁, b₂) h hb
  simp [IsUpperSet.specializes_iff_le] at hs h hb ⊢; grind

variable (ab : ↥(Space.{u} [x, y] E ⊗ Space.{u} [x, y] E)) (a b : Space.{u} [x, y] E)

/-- For `S ≅ ⌜T → F⌟` the Sierpinski space, the bundled hom `S ⊗ S` to `S` given by `⊓`.
We state this in terms of the tensor product of the cartesian monoidal structure on `TopCat`, so
that creating computable lift homs from open sets to `S ⊗ S`  and thence to `⌜o₁ → c ← o₂⌟`
(see `O2C1.isPullback`) is as painless as possible. -/
def andHom : Space.{u} [x, y] E ⊗ Space.{u}  [x, y] E ⟶ Space.{u} [x, y] E :=
  ofHom ⟨(· ⊓ · : Space.{u} [x, y] E → Space.{u} [x, y] E → Space.{u} [x, y] E).uncurry,
    Space.continuous_inf_uncurry⟩

@[simp] lemma andHom_apply : andHom ab = ab.1 ⊓ ab.2 := by rfl
@[simp] lemma andHom_apply_prod : andHom (a, b) = a ⊓ b := by rfl

/-- For `S ≅ ⌜T → F⌟` the Sierpinski space, the bundled hom `S ⊗ S` to `S` given by `⊔`. We state
this in terms of the tensor product of the cartesian monoidal structure on `TopCat`, so that
creating computable lift homs from closed sets to `S ⊗ S` and thence to `⌜c₁ ← o → c₂⌟`
(see `O1C2.isPullback`) is as painless as possible. -/
def orHom : Space.{u} [x, y] E ⊗ Space.{u} [x, y] E ⟶ Space.{u} [x, y] E :=
  ofHom ⟨(· ⊔ · : Space.{u} [x, y] E → Space.{u} [x, y] E → Space.{u} [x, y] E).uncurry,
    Space.continuous_sup_uncurry⟩

@[simp] lemma orHom_apply (xy : ↥(Space.{u} [x, y] E ⊗ Space.{u} [x, y] E)) :
  orHom xy = xy.1 ⊔ xy.2 := by rfl
@[simp] lemma orHom_apply_prod : orHom (a, b) = a ⊔ b := by rfl

instance : TopologicalLattice (Space.{u} [x, y] E) where
  continuous_inf := continuous_inf_uncurry
  continuous_sup := continuous_sup_uncurry

end two

/-- All points, in index order. -/
def all : List (Space L E) := (List.finRange L.length).map fun i => mk i.val i.isLt

lemma mem_all (x : Space L E) : x ∈ all :=
  List.mem_map.2 ⟨x.idx, List.mem_finRange _, rfl⟩

lemma length_all : (all : List (Space L E)).length = L.length := by
  simp [all]


/-- The point having `n` among its names, e.g. `(Space.pt "o" : ⌜o → c⌟)`. The notation `pt(o)`
is this in patterns (but the canonical form `Space.mk k _` as a term).

This is a `match_pattern`: in patterns, `Space.pt n h` unfolds to the constructor `⟨⟨i, h⟩⟩`,
where the index `i` reduces to a numeral. (`pt(o)` passes `h` as an inaccessible term, so that it
is still checked in patterns.) -/
@[match_pattern]
def pt [DecidableEq α] (n : α) (h : L.findIdx (n ∈ ·) < L.length := by decide) : Space L E :=
  (⟨⟨_, h⟩⟩ : Pts L E)


/-- Prove or generate data on two foldr results on the same list. -/
def _root_.List.foldrRec₂ {β₁ β₂ α : Type*} {motive : β₁ → β₂ → Sort*}
    (l : List α) (op₁ : α → β₁ → β₁) (op₂ : α → β₂ → β₂) {b₁ : β₁} {b₂ : β₂} (init : motive b₁ b₂)
    (cons_cons : (b₁ : β₁) → (b₂ : β₂) → motive b₁ b₂ →
      (a : α) → a ∈ l → motive (op₁ a b₁) (op₂ a b₂)) :
    motive (List.foldr op₁ b₁ l) (List.foldr op₂ b₂ l) :=
  match l with
  | [] => init
  | hd :: tl => cons_cons (List.foldr op₁ b₁ tl) (List.foldr op₂ b₂ tl)
      (foldrRec₂ tl op₁ op₂ init fun b₁ b₂ i a ha ↦
        cons_cons b₁ b₂ i a (List.mem_cons_of_mem hd ha)) hd List.mem_cons_self


lemma forall_pts_iff_foldr (p : Space L E → Prop) :
    (∀ x : Space L E, p x) ↔ ((all : List (Space L E)).map p).foldr And True where
  mp h := by
    fapply List.foldrRecOn (motive := id)
    · trivial
    · intro q₁ (h₁ : q₁) q₂ h₂
      obtain ⟨x, _, hx⟩ := by simpa using h₂
      exact ⟨hx.mp <| h x, h₁⟩
  mpr h := by
    let := Prop.linearOrder
    contrapose! h
    obtain ⟨x, hx⟩ := h
    rw [← List.foldr_map, show And = min by rfl, show True = ⊤ by rfl]
    apply of_eq_false
    rw [show False = ⊥ by rfl, ← le_bot_iff]
    fapply List.min_le_of_le ?_ (show False ≤ ⊥ by rfl)
    simpa using ⟨x, mem_all x, hx⟩

lemma exists_pts_iff_foldr (p : Space L E → Prop) :
    (∃ x : Space L E, p x) ↔ ((all : List (Space L E)).map p).foldr Or False := by
  let := Prop.linearOrder
  rw [← List.foldr_map, show Or = max by rfl, show False = ⊥ by rfl]
  fconstructor
  · rintro ⟨x, hx⟩
    apply of_eq_true; rw [show True = ⊤ by rfl, ← top_le_iff]
    fapply List.le_max_of_le ?_ (show ⊤ ≤ True by rfl)
    simpa using ⟨x, mem_all x, hx⟩
  · intro h; contrapose! h
    apply of_eq_false; rw [show False = ⊥ by rfl, ← le_bot_iff]
    apply List.max_le_of_forall_le
    simp [h]

lemma iUnion_pts_eq_foldr {β : Type*} (f : Space L E → Set β) :
    (⋃ x : Space L E, f x) = ((all : List (Space L E)).map f).foldr (· ∪ ·) ∅ := by
  ext b; simp only [Set.mem_iUnion, exists_pts_iff_foldr]
  conv in List.map _ all =>
    change List.map ((b ∈ ·) ∘ f) all; rw [← List.map_comp_map, Function.comp_apply]
  rw [← List.foldr_map_hom (g := (b ∈ ·)) (a := ∅) (f' := Or)]
  · congr!
  · simp

lemma iInter_pts_eq_foldr {β : Type*} (f : Space L E → Set β) :
    (⋂ x : Space L E, f x) = ((all : List (Space L E)).map f).foldr (· ∩ ·) Set.univ := by
  ext b; simp only [Set.mem_iInter, forall_pts_iff_foldr]
  conv in List.map _ all =>
    change List.map ((b ∈ ·) ∘ f) all; rw [← List.map_comp_map, Function.comp_apply]
  rw [← List.foldr_map_hom (g := (b ∈ ·)) (a := Set.univ) (f' := And)]
  · congr!
  · simp

lemma iUnion_pts_eq_foldl {β : Type*} (f : Space L E → Set β) :
    (⋃ x : Space L E, f x) = ((all : List (Space L E)).map f).foldl (· ∪ ·) ∅ := by
  rw [iUnion_pts_eq_foldr, List.foldl_eq_foldr]

lemma iInter_pts_eq_foldl {β : Type*} (f : Space L E → Set β) :
    (⋂ x : Space L E, f x) = ((all : List (Space L E)).map f).foldl (· ∩ ·) Set.univ := by
  rw [iInter_pts_eq_foldr, List.foldl_eq_foldr]


open Qq Lean Meta in
/-- 'Lifts' a Forall into `Q(List α)` -/
meta partial def _root_.Expr.List.ForallQ {u : Level} {α : Q(Type u)} (e : Q(List $α))
    (p : Q($α) → Q(Prop)) : MetaM Q(Prop) := do
  match e with
  | ~q([]) => pure q(True)
  | ~q([$x]) => let e := p x; pure q($e)
  | ~q($x :: $xs) => do
    let nxt := p x
    let acc ← Expr.List.ForallQ xs p
    pure q($nxt ∧ $acc)
  | _ => throwError "Expression is not a explicit List literal: {e}"

open Qq in
open Qq Lean Meta in
meta def _root_.Qq.whnfDQ {u : Level} {α : Q(Type u)} (e : Q($α)) :
    MetaM {e' : Q($α) // «$e» =Q «$e'» } := do
  let out ← whnf e
  pure ⟨out, ⟨⟩⟩


variable {α : Sort*} in
open Qq Lean Meta Simp in
/-- The elements of `l`, if it is a list literal or reduces to one (by `whnf`, cell by cell). -/
meta partial def listElems? (l : Expr) : MetaM (Option (List Expr)) :=
  withAtLeastTransparency .default do
    let l ← whnf l
    match_expr l with
    | List.nil _ => return some []
    | List.cons _ a t => return (a :: ·) <$> (← listElems? t)
    | _ => return none

open Qq Lean Meta Simp in
meta def bigToBinOpR
    {u v : Level} {α : Q(Type u)} {β : Q(Type v)} (all : Q(List $α)) (zero : Q($β))
    (bigOp : Q(($α → $β) → $β)) (binOp : Q($β → $β → $β))
    (h : Q(∀ f, $bigOp f = (List.map f $all).foldr $binOp $zero)) (f : Q($α → $β))
    : SimpM (StepQ q($bigOp $f)) := do
  let some pts ← listElems? all | return .continue
  let pts ← (pts.mapM (assertTypeQ α) : MetaM (List (Q($α))))
  let l := pts.foldr (fun x acc => q($binOp ($f $x) $acc)) zero
  return .visit { expr := l, proof? := q($h $f) }

open Qq Lean Meta Simp in
/-- As `bigToBinOpR`, but folding from the left, for left-associative `binOp` such as `∪`:
`bigOp f` becomes `binOp (binOp zero (f x₀)) (f x₁) …`, i.e. `zero ∪ f x₀ ∪ f x₁ ∪ …`. -/
meta def bigToBinOpL
    {u v : Level} {α : Q(Type u)} {β : Q(Type v)} (all : Q(List $α)) (zero : Q($β))
    (bigOp : Q(($α → $β) → $β)) (binOp : Q($β → $β → $β))
    (h : Q(∀ f, $bigOp f = (List.map f $all).foldl $binOp $zero)) (f : Q($α → $β))
    : SimpM (StepQ q($bigOp $f)) := do
  let some pts ← listElems? all | return .continue
  let pts ← (pts.mapM (assertTypeQ α) : MetaM (List (Q($α))))
  let l := pts.foldl (fun acc x => q($binOp $acc ($f $x))) zero
  return .visit { expr := l, proof? := q($h $f) }

section
open Qq Lean Meta Simp

simproc_decl forallPts (∀ _ : ↑(Space _ _), _) := .ofQ fun
| .succ .zero, ~q(Prop), ~q(∀ x : ↑(@Space $α $L $E), $p x) => do
    bigToBinOpR q(all : List (Space $L $E)) q(True)
      q((∀ x : Space $L $E, · x)) q(And)
      q((iff_iff_eq.mp <| forall_pts_iff_foldr ·)) p

simproc_decl existsPts (∃ _ : ↑(Space _ _), _) := .ofQ fun
| .succ .zero, ~q(Prop), ~q(∃ x : ↑(@Space $α $L $E), $p x) => do
    bigToBinOpR q(all : List (Space $L $E)) q(False)
      q((∃ x : Space $L $E, · x)) q(Or)
      q((iff_iff_eq.mp <| exists_pts_iff_foldr ·)) p

simproc_decl iUnionPts (⋃ _ : ↑(Space _ _), _) := .ofQ fun
| .succ u, ~q(Set $β), ~q(⋃ x : ↑(@Space $α $L $E), $f x) => do
  bigToBinOpL q(all : List (Space $L $E)) q(∅)
    q((⋃ x : Space $L $E, · x)) q((· ∪ ·))
    q((iUnion_pts_eq_foldl ·)) f

simproc_decl iInterPts (⋂ _ : ↑(Space _ _), _) := .ofQ fun
| .succ u, ~q(Set $β), ~q(⋂ x : ↑(@Space $α $L $E), $f x) => do
  bigToBinOpL q(all : List (Space $L $E)) q(Set.univ)
    q((⋂ x : Space $L $E, · x)) q((· ∩ ·))
    q((iInter_pts_eq_foldl ·)) f

end


example {p : Space [["F"], ["T"]] [(1, 0)] → Prop} :
    (∀ x : Space [["F"], ["T"]] [(1, 0)], p x) ↔ p (mk 0 (by simp)) ∧ p (mk 1 (by simp)) := by
  simp [forallPts]

example {p : Space [["F"], ["T"]] [(1, 0)] → Prop} :
    (∃ x : Space [["F"], ["T"]] [(1, 0)], p x) ↔ p (mk 0 (by simp)) ∨ p (mk 1 (by simp)) := by
  simp [existsPts]

@[ext]
lemma hom_ext {Y : TopCat} (f g : Space L E ⟶ Y) (h : ∀ x ∈ all, f x = g x) : f = g := by
  ext x; exact h _ <| mem_all x

/-! ### Open sets -/

/-- The smallest open set containing `x`: everything above it. -/
def up (x : Space L E) : Finset (Space L E) := Finset.univ.filter (x ≤ ·)

@[simp, grind =] lemma mem_up {x y : Space L E} : y ∈ up x ↔ x ≤ y := by simp [up]

lemma mem_up_iff_specializes {x y : Space L E} : y ∈ up x ↔ y ⤳ x := by
  simp [up, IsUpperSet.specializes_iff_le]

instance (U : Set (Space L E)) [DecidablePred (· ∈ U)] : Decidable (IsOpen U) :=
  decidable_of_iff (∀ a b : Space L E, a ≤ b → a ∈ U → b ∈ U)
    IsUpperSet.isOpen_iff_isUpperSet.symm

@[simp] lemma isOpen_up (x : Space L E) : IsOpen (up x : Set (Space L E)) := by
  rw [IsUpperSet.isOpen_iff_isUpperSet, IsUpperSet]; intro _ _ h; simp; grind

lemma isOpen_iff_eq_biUnion_up {U : Finset (Space L E)} :
    IsOpen (U : Set (Space L E)) ↔ U = U.biUnion up := by
  rw [IsUpperSet.isOpen_iff_isUpperSet]
  refine ⟨fun hU => ?_, fun hU a b hab ha => ?_⟩
  · ext y
    simp only [Finset.mem_biUnion]
    exact ⟨fun hy => ⟨y, hy, mem_up.2 le_rfl⟩, fun ⟨x, hx, hxy⟩ => hU (mem_up.1 hxy) hx⟩
  · rw [Finset.mem_coe, hU, Finset.mem_biUnion] at ha ⊢
    obtain ⟨x, hx, hxa⟩ := ha
    exact ⟨x, hx, mem_up.2 ((mem_up.1 hxa).trans hab)⟩

lemma up_eq_nhdsKer (x : Space L E) : up x = nhdsKer {x} := by
  symm; simp [up]; rfl

open TopologicalSpace in
lemma ups_basis : IsTopologicalBasis
    (Set.range fun (x : Space L E) ↦ (up x : Set (Space L E))) := by
  fapply IsTopologicalBasis.of_hasBasis_nhds; intro x
  simp_rw [Set.mem_range, ← exists_and_right, and_comm]
  fapply nhds_basis_nhdsKer_singleton x |>.to_hasBasis'
  · rintro ⟨⟩ ⟨⟩; simpa [up, Set.Ici] using ⟨x, by simp⟩
  · rintro s ⟨y, hxy, rfl⟩
    rw [mem_nhds_iff]; use up y
    simp [up] at hxy; simp [IsUpperSet.isOpen_iff_isUpperSet, up, hxy, monotone_le]

/-- The unions of `up x` over the subsets of `l`. -/
def opensAux : List (Space L E) → Finset (Finset (Space L E))
  | [] => {∅}
  | x :: xs => opensAux xs ∪ (opensAux xs).image (· ∪ up x)

lemma mem_opensAux {U : Finset (Space L E)} :
    ∀ l, U ∈ opensAux l ↔ ∃ T : Finset (Space L E), (∀ t ∈ T, t ∈ l) ∧ U = T.biUnion up
  | [] => by
    simp only [opensAux, Finset.mem_singleton, List.not_mem_nil, imp_false]
    refine ⟨fun h => ⟨∅, by simp, by simp [h]⟩, fun ⟨T, hT, h⟩ => ?_⟩
    rw [Finset.eq_empty_of_forall_notMem hT] at h
    simpa using h
  | x :: xs => by
    classical
    simp only [opensAux, Finset.mem_union, Finset.mem_image, mem_opensAux xs, List.mem_cons]
    constructor
    · rintro (⟨T, hT, rfl⟩ | ⟨_, ⟨T, hT, rfl⟩, rfl⟩)
      · exact ⟨T, fun t ht => .inr (hT t ht), rfl⟩
      · refine ⟨insert x T, fun t ht => ?_, by rw [Finset.biUnion_insert, Finset.union_comm]⟩
        rcases Finset.mem_insert.1 ht with rfl | ht
        exacts [.inl rfl, .inr (hT t ht)]
    · rintro ⟨T, hT, rfl⟩
      by_cases hx : x ∈ T
      · refine .inr ⟨_, ⟨T.erase x, fun t ht => ?_, rfl⟩, ?_⟩
        · obtain ⟨hne, ht⟩ := Finset.mem_erase.1 ht
          exact (hT t ht).resolve_left hne
        · rw [Finset.union_comm, ← Finset.biUnion_insert, Finset.insert_erase hx]
      · exact .inl ⟨T, fun t ht => (hT t ht).resolve_left (by rintro rfl; exact hx ht), rfl⟩

/-- All open sets, as a `Finset`. `mem_opens` shows that these are exactly the open sets, and
`forall_isOpen` and `exists_isOpen` turn quantifiers over open sets into quantifiers over `opens`.
Open sets are unions of the minimal open sets `up x`, so `opens` is computed by adding the
points one at a time. -/
def opens : Finset (Finset (Space L E)) := opensAux all

theorem mem_opens {U : Finset (Space L E)} : U ∈ opens ↔ IsOpen (U : Set (Space L E)) := by
  rw [opens, mem_opensAux, isOpen_iff_eq_biUnion_up]
  exact ⟨fun ⟨T, _, hU⟩ => by
    rw [hU, ← isOpen_iff_eq_biUnion_up, Finset.coe_biUnion]
    exact isOpen_biUnion fun x _ => isOpen_iff_eq_biUnion_up.2 (by
      ext y; simp only [Finset.mem_biUnion]
      exact ⟨fun h => ⟨y, h, mem_up.2 le_rfl⟩,
        fun ⟨z, hz, hyz⟩ => mem_up.2 ((mem_up.1 hz).trans (mem_up.1 hyz))⟩),
    fun h => ⟨U, fun t _ => mem_all t, h⟩⟩

theorem forall_isOpen {P : Set (Space L E) → Prop} :
    (∀ U, IsOpen U → P U) ↔ ∀ U : Finset (Space L E), U ∈ opens → P U := by
  refine ⟨fun h U hU => h _ (mem_opens.1 hU), fun h U hU => ?_⟩
  classical
  simpa using h U.toFinset (mem_opens.2 (by simpa using hU))

theorem exists_isOpen {P : Set (Space L E) → Prop} :
    (∃ U, IsOpen U ∧ P U) ↔ ∃ U : Finset (Space L E), U ∈ opens ∧ P U := by
  refine ⟨fun ⟨U, hU, h⟩ => ?_, fun ⟨U, hU, h⟩ => ⟨_, mem_opens.1 hU, h⟩⟩
  classical
  exact ⟨U.toFinset, mem_opens.2 (by simpa using hU), by simpa using h⟩

theorem isOpen_iff {U : Set (Space L E)} :
    IsOpen U ↔ ∃ U' : Finset (Space L E), U' ∈ opens ∧ (U : Set (Space L E)) = U' := by
  rw [← exists_isOpen]; simp

/-! ### Closed sets -/

/-- The smallest closed set containing `x`, i.e. the closure of `{x}`: everything below it. -/
def down (x : Space L E) : Finset (Space L E) := Finset.univ.filter (· ≤ x)

@[simp, grind =] lemma mem_down {x y : Space L E} : y ∈ down x ↔ y ≤ x := by simp [down]

lemma coe_down (x : Space L E) : (down x : Set (Space L E)) = closure {x} := by
  ext y
  rw [Finset.mem_coe, mem_down, IsUpperSet.closure_singleton]
  rfl

instance (U : Set (Space L E)) [DecidablePred (· ∈ U)] : Decidable (IsClosed U) :=
  decidable_of_iff (∀ a b : Space L E, b ≤ a → a ∈ U → b ∈ U)
    IsUpperSet.isClosed_iff_isLower.symm

/-- All closed sets, as a `Finset`: the complements of `opens`. `mem_closeds` shows that these
are exactly the closed sets, and `forall_isClosed` and `exists_isClosed` turn quantifiers over
closed sets into quantifiers over `closeds`. -/
def closeds : Finset (Finset (Space L E)) := opens.image (·ᶜ)

theorem mem_closeds {U : Finset (Space L E)} :
    U ∈ closeds ↔ IsClosed (U : Set (Space L E)) := by
  rw [closeds, Finset.mem_image, ← isOpen_compl_iff, ← Finset.coe_compl, ← mem_opens]
  exact ⟨fun ⟨V, hV, h⟩ => h ▸ (compl_compl V).symm ▸ hV, fun h => ⟨_, h, compl_compl U⟩⟩

theorem forall_isClosed {P : Set (Space L E) → Prop} :
    (∀ U, IsClosed U → P U) ↔ ∀ U : Finset (Space L E), U ∈ closeds → P U := by
  refine ⟨fun h U hU => h _ (mem_closeds.1 hU), fun h U hU => ?_⟩
  classical
  simpa using h U.toFinset (mem_closeds.2 (by simpa using hU))

theorem exists_isClosed {P : Set (Space L E) → Prop} :
    (∃ U, IsClosed U ∧ P U) ↔ ∃ U : Finset (Space L E), U ∈ closeds ∧ P U := by
  refine ⟨fun ⟨U, hU, h⟩ => ?_, fun ⟨U, hU, h⟩ => ⟨_, mem_closeds.1 hU, h⟩⟩
  classical
  exact ⟨U.toFinset, mem_closeds.2 (by simpa using hU), by simpa using h⟩

lemma closure_eq (s : Set (Space L E)) : closure s = ⋃ x ∈ s, down x := by
  ext y; simp [mem_down, IsUpperSet.closure_eq_lowerClosure]

/-- The continuous map sending the `i`-th point to the `tbl[i]`-th point (indices are taken
modulo `L'.length`, and missing entries default to `0`). Both side conditions are meant to be
discharged by `decide`; the second is monotonicity, i.e. continuity. It is stated in `Type`, so
that it contains no universe variables.

`simp` (and `grind`) evaluate it at points, by the simproc `Space.reduceTableApply`: it rewrites
`homOfTable tbl _ _ pt(a)` to the canonical form `Space.mk k _` of the image. It isn't reducible,
so that `grind` (which unfolds reducible definitions) leaves it to that simproc. -/
def homOfTable (tbl : List ℕ) (h : 0 < L'.length)
    (mono : ∀ x y : Pts.{0} L E, x ≤ y →
      (Pts.ofNat h (tbl.getD x.idx 0) : Pts.{0} L' E') ≤ Pts.ofNat h (tbl.getD y.idx 0)) :
    Space.{u} L E ⟶ Space.{u} L' E' :=
  ConcreteCategory.ofHom ⟨fun x => mk (tbl.getD x.idx 0 % L'.length) (Nat.mod_lt _ h),
    IsUpperSet.monotone_iff_continuous.1 fun x y hxy => mono ⟨x.idx⟩ ⟨y.idx⟩ hxy⟩

instance : LocallyFiniteOrder (Space.{u} L E) :=
  .ofIcc' _ (fun x y ↦ up x ∩ down y) fun a b x ↦ by simp

@[simp] lemma finsetIcc_def (a b : ↑(Space L E)) : Finset.Icc a b = up a ∩ down b := rfl

@[simp] lemma finsetIco_def (a b : ↑(Space L E)) : Finset.Ico a b = up a ∩ (down b \ up b) := by
  ext x; simpa using fun _ ↦ by rfl

@[simp] lemma finsetIoc_def (a b : ↑(Space L E)) : Finset.Ioc a b = (up a \ down a) ∩ down b := by
  ext x; simpa using fun _ ↦ by rfl

@[simp] lemma finsetIoo_def (a b : ↑(Space L E)) :
    Finset.Ioo a b = (up a \ down a) ∩ (down b \ up b) := by
  ext x; simpa using by congr!

-- Note: edit docs in Mathlib.Order.Interval.Finset.Defs; `LocallyFiniteOrderTop/Bot` instances
-- are *much* weaker than `LocallyFiniteOrder` + `OrderTop/Bot`, because they can be defined on
-- preorders that only have local minima/maxima.

instance : LocallyFiniteOrderTop (Space.{u} L E) := .ofIci' _ up (fun a x ↦ by simp)
instance : LocallyFiniteOrderBot (Space.{u} L E) := .ofIic' _ down (fun a x ↦ by simp)

@[simp] lemma finsetIci_def (a : ↑(Space L E)) : Finset.Ici a = up a := rfl
@[simp] lemma finsetIoi_def (a : ↑(Space L E)) : Finset.Ioi a = (up a \ down a) := by
  ext x; simp; rfl

@[simp] lemma finsetIic_def (a : ↑(Space L E)) : Finset.Iic a = down a := rfl
@[simp] lemma finsetIio_def (a : ↑(Space L E)) : Finset.Iio a = (down a \ up a) := by
  ext x; simp; rfl

