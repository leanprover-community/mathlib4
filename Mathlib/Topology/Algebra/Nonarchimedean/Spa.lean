module

public import Mathlib.RingTheory.Valuation.ContinuousValuation
public import Mathlib.Topology.Order

/-!
# The adic spectrum `Spa(A, A⁺)` as a set and topological space

For a topological ring `A` and a subring `A⁺ ⊆ A`, the adic spectrum
`Spa(A, A⁺)` is the set of continuous valuations `v` on `A` with
`v(f) ≤ 1` for all `f ∈ A⁺` (Wedhorn, Def. 7.23, p. 62). The rational
subsets `R(T/s) := {v | ∀ t ∈ T, v(t) ≤ v(s) ≠ 0}` (Wedhorn, Def. 7.29,
p. 62) generate the topology.

## Main definitions
* `SpaPoint A A⁺` — a point of the adic spectrum: a continuous valuation
  `v : A → Γ₀` with `v(f) ≤ 1` for all `f ∈ A⁺`.
* `SpaPoint.rationalSubset s T` — the rational subset `R(T/s)`.
* `SpaPoint.instTopologicalSpace` — the topology generated by the rational
  subsets (with `T · A` open in `A`).

## Implementation notes

Wedhorn defines `Spa(A, A⁺)` as a subspace of the valuation spectrum
`Spv(A)`; the spectrum itself is the subject of a separate PR
(`ValuationSpectrum`). This file works with the equivalent element-level
notion (a bundled continuous valuation with a fixed value group), which is
self-contained; the comparison with the spectrum subspace can be added once
the spectrum PR lands. The subring `A⁺` is kept general (the *ring of
integral elements* of Wedhorn, Def. 7.14 is a specialization).

## References
* [Wedhorn] T. Wedhorn, *Adic Spaces*, arXiv:1910.05934, Def. 7.23, Def. 7.29,
  Rem. 7.30 (pp. 62–63).
-/

@[expose] public section

variable {A : Type*} [CommRing A] [TopologicalSpace A] (Aplus : Subring A)

/-- A point of the adic spectrum `Spa(A, A⁺)`: a continuous valuation
`v : A → Γ₀` with `v(f) ≤ 1` for all `f ∈ A⁺` (Wedhorn, Def. 7.23, p. 62:
"`Spa A = {v ∈ Cont(A); v(f) ≤ 1 for all f ∈ A⁺}`"). -/
structure SpaPoint (A : Type*) [CommRing A] [TopologicalSpace A]
    (Aplus : Subring A) where
  /-- The value group of the valuation. -/
  Γ₀ : Type*
  [instLinearOrderedCommGroupWithZero : LinearOrderedCommGroupWithZero Γ₀]
  [instTopologicalSpace : TopologicalSpace Γ₀]
  [instOrderTopology : OrderTopology Γ₀]
  /-- The continuous valuation defining the point. -/
  v : ContinuousValuation A Γ₀
  /-- The point condition: `v(f) ≤ 1` for all `f ∈ A⁺`. -/
  le_one : ∀ f ∈ Aplus, v f ≤ 1

attribute [instance] SpaPoint.instLinearOrderedCommGroupWithZero
attribute [instance] SpaPoint.instTopologicalSpace
attribute [instance] SpaPoint.instOrderTopology

namespace SpaPoint

variable {A : Type*} [CommRing A] [TopologicalSpace A] (Aplus : Subring A)

/-- The rational subset `R(T/s) := {v ∈ Spa A | ∀ t ∈ T, v(t) ≤ v(s) ≠ 0}`
(Wedhorn, Def. 7.29, p. 62). -/
def rationalSubset (s : A) (T : Finset A) : Set (SpaPoint A Aplus) :=
  {v | (∀ t ∈ T, v.v t ≤ v.v s) ∧ v.v s ≠ 0}

/-- The topology on `Spa(A, A⁺)` generated by the rational subsets
`R(T/s)` with `T · A` open in `A` (Wedhorn, Def. 7.29, p. 62: "the
topology of Spa A"; the rational subsets are open by construction). -/
instance spaTopologicalSpace : TopologicalSpace (SpaPoint A Aplus) :=
  TopologicalSpace.generateFrom
    {U | ∃ (s : A) (T : Finset A),
      IsOpen ((Ideal.span (T : Set A)) : Set A) ∧ U = rationalSubset (A := A) (Aplus := Aplus) s T}

/-- Every rational subset `R(T/s)` with `T · A` open is open in `Spa(A, A⁺)`. -/
theorem isOpen_rationalSubset (s : A) (T : Finset A)
    (hT : IsOpen ((Ideal.span (T : Set A)) : Set A)) :
    IsOpen (rationalSubset (A := A) (Aplus := Aplus) s T) := by
  -- the generating family contains rationalSubset s T by construction
  exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨s, T, hT, rfl⟩

/-- The rational subset `R(f/1)` is the set of points with `|f| ≤ 1`
(Wedhorn, Rem. 7.30(4), p. 63: "`R(f/1) = {x ∈ Spa A; |f(x)| ≤ 1}` is an
open rational subset for all `f ∈ A`"). -/
theorem mem_rationalSubset_one {f : A} (v : SpaPoint A Aplus) :
    v ∈ rationalSubset (A := A) (Aplus := Aplus) (1 : A) {f} ↔ v.v f ≤ 1 := by
  constructor
  · intro h
    have hle : f ∈ ({f} : Finset A) := by simp
    exact (h.1 f hle).trans (le_of_eq (by simp [map_one v.v]))
  · intro hf
    constructor
    · intro t ht
      have ht' : t = f := by simpa using ht
      rw [ht']
      -- v f ≤ v 1 = 1
      have hv1 : v.v (1 : A) = 1 := map_one v.v
      rw [hv1]
      exact hf
    · intro h0
      have hv1 : v.v (1 : A) = 1 := map_one v.v
      rw [hv1] at h0
      exact one_ne_zero h0

/-- Wedhorn, Rem. 7.30(3), p. 63: `R(T/s) = R(T ∪ {s}/s)` — one may always
assume `s ∈ T`. -/
theorem rationalSubset_insert_self (s : A) (T : Finset A) [DecidableEq A] :
    rationalSubset (A := A) (Aplus := Aplus) s T =
      rationalSubset (A := A) (Aplus := Aplus) s (insert s T) := by
  ext v
  constructor
  · rintro ⟨hT, hs⟩
    refine ⟨?_, hs⟩
    intro t ht
    rcases Finset.mem_insert.mp ht with rfl | ht
    · rfl
    · exact hT t ht
  · rintro ⟨hT, hs⟩
    exact ⟨fun t ht => hT t (by simp [ht]), hs⟩

/-- Wedhorn, Rem. 7.30(4), p. 63: for `s` a unit, `R(T/s)` is always a rational
subset, hence open — since `R(T/s) = R(T ∪ {s}/s)` and the ideal `(T ∪ {s})·A`
contains the unit `s` and is therefore the whole ring. -/
theorem isOpen_rationalSubset_of_unit (s : A) (T : Finset A) [DecidableEq A]
    (hs : IsUnit s) :
    IsOpen (rationalSubset (A := A) (Aplus := Aplus) s T) := by
  rw [rationalSubset_insert_self]
  apply isOpen_rationalSubset
  -- the ideal spanned by T ∪ {s} contains the unit s, hence is ⊤, which is open
  have hspan_eq : Ideal.span ((insert s T : Finset A) : Set A) = ⊤ := by
    rcases hs with ⟨u, hu⟩
    -- s ∈ span; and 1 = s * ↑u⁻¹ ∈ span
    have hmem_s : s ∈ Ideal.span ((insert s T : Finset A) : Set A) := by
      exact Ideal.subset_span (by simp)
    have h1 : (1 : A) = s * (↑(u⁻¹ : Aˣ) : A) := by
      calc
        (1 : A) = ↑u * ↑(u⁻¹ : Aˣ) := by
          simp
        _ = s * ↑(u⁻¹ : Aˣ) := by rw [hu]
    have hone_mem : (1 : A) ∈ Ideal.span ((insert s T : Finset A) : Set A) := by
      rw [h1]
      exact Ideal.mul_mem_right (↑(u⁻¹ : Aˣ)) _ hmem_s
    exact (Ideal.eq_top_iff_one _).mpr hone_mem
  rw [hspan_eq]
  exact isOpen_univ

/-- Wedhorn, Rem. 7.30(5), p. 63, one direction: `R(T₁/s₁) ∩ R(T₂/s₂) ⊆
R(T₁T₂/s₁s₂)`, where `T₁T₂ = {t₁t₂ | tᵢ ∈ Tᵢ}`. (The reverse inclusion needs
the ordered-group cancellation for the value group and is stated separately —
see the project notes.) -/
theorem rationalSubset_inter_subset (s₁ : A) (T₁ : Finset A) (s₂ : A)
    (T₂ : Finset A) [DecidableEq A] :
    rationalSubset (A := A) (Aplus := Aplus) s₁ T₁ ∩
        rationalSubset (A := A) (Aplus := Aplus) s₂ T₂ ⊆
      rationalSubset (A := A) (Aplus := Aplus) (s₁ * s₂)
        (T₁.product T₂ |>.image fun p : A × A => p.1 * p.2) := by
  rintro v ⟨⟨hT1, hs1⟩, ⟨hT2, hs2⟩⟩
  constructor
  · intro t ht
    rcases Finset.mem_image.mp ht with ⟨p, hp, rfl⟩
    rcases Finset.mem_product.mp hp with ⟨hp1, hp2⟩
    -- v(p.1 * p.2) = v p.1 * v p.2 ≤ v s₁ * v s₂ = v (s₁ * s₂)
    have hmul1 : v.v (p.1 * p.2) = v.v p.1 * v.v p.2 := map_mul v.v p.1 p.2
    have hmul2 : v.v (s₁ * s₂) = v.v s₁ * v.v s₂ := map_mul v.v s₁ s₂
    rw [hmul1, hmul2]
    exact mul_le_mul' (hT1 p.1 hp1) (hT2 p.2 hp2)
  · intro h0
    -- v (s₁ * s₂) ≠ 0
    have hne : v.v (s₁ * s₂) ≠ 0 := by
      rw [map_mul]
      exact mul_ne_zero hs1 hs2
    exact hne h0

end SpaPoint
