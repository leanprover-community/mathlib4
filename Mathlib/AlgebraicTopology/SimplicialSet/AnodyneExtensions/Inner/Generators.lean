module

public import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.PushoutProduct
public import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Retract
public import Mathlib.CategoryTheory.LiftingProperties.PushoutProduct
public import Mathlib.CategoryTheory.MorphismProperty.Comma

/-!
# Generators for inner anodyne extensions

Proves that the following families generate the class of inner anodyne extensions:
* `SSet.horn₂₁.monomorphismPushoutProducts`: the family of all pushout-products of `Λ[2, 1].ι` with
  monomorphisms.
* `SSet.horn₂₁.boundaryPushoutProducts`: the family of all pushout-products of `Λ[2, 1].ι` with
  boundary inclusions.

## Main Results

- `SSet.horn₂₁.rlp_monomorphismPushoutProducts`: inner fibrations are exactly the morphisms
  which have the right lifting property with respect to `monomorphismPushoutProducts`.
- `SSet.horn₂₁.llp_rlp_monomorphismPushoutProducts`: inner anodyne extensions are generated by
  the family of all pushout-products of `Λ[2, 1].ι` with monomorphisms,
  i.e. `monomorphismPushoutProducts.rlp.llp = innerAnodyneExtnensions.`
- `SSet.horn₂₁.rlp_boundaryPushoutProducts`: inner fibrations are exactly the morphisms
  which have the right lifting property with respect to `boundaryPushoutProducts`.
- `SSet.horn₂₁.llp_rlp_boundaryPushoutProducts`: inner anodyne extensions are generated by
  the family of all pushout-products of `Λ[2, 1].ι` with boundary inclusions,
  i.e. `boundaryPushoutProducts.rlp.llp = innerAnodyneExtnensions.`
- `SSet.horn₂₁.innerFibration_iff_pullbackObjObjπ`: a morphism is an inner fibration
  if and only if its pullback-hom with `Λ[2, 1].ι` is an inner fibration.
- `SSet.horn₂₁.innerFibration_iff_rlp_monomorphisms_pullbackObjObjπ`: equivalently,
  this pullback-hom has the right lifting property with respect to all monomorphisms.

The corresponding characterizations of quasicategories are in
`Mathlib.AlgebraicTopology.Quasicategory.Exponential`.

-/

@[expose] public section

universe u

namespace SSet

open CategoryTheory Simplicial MonoidalCategory CartesianMonoidalCategory Functor

namespace horn₂₁

open MorphismProperty Arrow

/-- The morphism property of pushout-products of `Λ[2, 1].ι` with monomorphisms. -/
def monomorphismPushoutProducts : MorphismProperty SSet.{u} :=
  ((monomorphisms SSet).arrowObj.strictMap (pushoutProduct.obj Λ[2, 1].ι)).toMorphismProperty

lemma innerHornInclusions_le_retracts_monomorphismPushoutProducts :
    innerHornInclusions.{u} ≤ monomorphismPushoutProducts.retracts := by
  rintro _ _ _ @⟨n, i, h0, hn⟩
  exact ⟨_, _, _, innerHornRetract i h0 hn,
    ⟨CategoryTheory.Arrow.mk Λ[n + 2, i].ι, monomorphisms.infer_property Λ[n + 2, i].ι⟩⟩

lemma monomorphismPushoutProducts_le_innerAnodyneExtensions :
    monomorphismPushoutProducts.{u} ≤ innerAnodyneExtensions := by
  rintro _ _ _ ⟨j, hj : Mono j.hom⟩
  exact innerAnodyneExtensions_pushoutObjObjι' (j := j.hom) (PushoutObjObj.ofHasPushout _ _ _)
    (innerAnodyneExtensions.horn_ι (by grind) (by grind))

lemma rlp_monomorphismPushoutProducts :
    monomorphismPushoutProducts.{u}.rlp = innerFibrations := by
  apply le_antisymm
  · rw [← rlp_retracts monomorphismPushoutProducts]
    exact antitone_rlp innerHornInclusions_le_retracts_monomorphismPushoutProducts
  · rw [← rlp_innerAnodyneExtensions]
    exact antitone_rlp monomorphismPushoutProducts_le_innerAnodyneExtensions

lemma llp_rlp_monomorphismPushoutProducts :
    monomorphismPushoutProducts.{u}.rlp.llp = innerAnodyneExtensions := by
  rw [rlp_monomorphismPushoutProducts]
  rfl

/-- The morphism property of pushout-products of `Λ[2, 1].ι` with boundary inclusions. -/
def boundaryPushoutProducts : MorphismProperty SSet.{u} :=
  (modelCategoryQuillen.I.arrowObj.strictMap (pushoutProduct.obj Λ[2, 1].ι)).toMorphismProperty

lemma boundaryPushoutProducts_le_monomorphismPushoutProducts :
    boundaryPushoutProducts.{u} ≤ monomorphismPushoutProducts :=
  (arrowObjOrderIso _).symm.monotone (ObjectProperty.strictMap_monotone
    ((arrowObjOrderIso _).monotone modelCategoryQuillen.I_le_monomorphisms) _)

lemma rlp_boundaryPushoutProducts :
    boundaryPushoutProducts.{u}.rlp = innerFibrations := by
  rw [← rlp_monomorphismPushoutProducts]
  refine le_antisymm ?_ (antitone_rlp boundaryPushoutProducts_le_monomorphismPushoutProducts)
  rintro _ _ p hp _ _ _ ⟨j, hj : Mono j.hom⟩
  change HasLiftingProperty (Λ[2, 1].ι □ j.hom).hom p
  rw [PushoutProduct.hasLiftingProperty_mk_iff]
  suffices (monomorphisms _).rlp _ from this j.hom inferInstance
  rw [rlp_monomorphisms]
  rintro _ _ _ ⟨n⟩
  rw [← PushoutProduct.hasLiftingProperty_mk_iff]
  exact hp _ ⟨_, ⟨n⟩⟩

lemma llp_rlp_boundaryPushoutProducts :
    boundaryPushoutProducts.{u}.rlp.llp = innerAnodyneExtensions := by
  rw [rlp_boundaryPushoutProducts]
  rfl

open MonoidalClosed

section

variable {E B : SSet.{u}} {p : E ⟶ B} (sq : internalHom.PullbackObjObj Λ[2, 1].ι p)

lemma innerFibration_iff_pullbackObjObjπ : InnerFibration p ↔ InnerFibration sq.π := by
  constructor
  · intro
    exact innerFibration_pullbackObjObjπ sq
  · intro h
    rw [innerFibration_iff]
    rintro _ _ _ @⟨n, i, h0, hn⟩
    let sq' := PushoutObjObj.ofHasPushout (curriedTensor SSet.{u}) Λ[2, 1].ι Λ[n + 2, i].ι
    let : HasLiftingProperty sq'.ι p :=
      (internalHomAdjunction₂.hasLiftingProperty_iff sq' sq).2 (h.mem _ ⟨i, h0, hn⟩)
    exact (innerHornRetract i h0 hn).leftLiftingProperty p

lemma innerFibration_iff_rlp_monomorphisms_pullbackObjObjπ :
    InnerFibration p ↔ (monomorphisms SSet).rlp sq.π := by
  rw [innerFibration_iff, ← rlp_monomorphismPushoutProducts]
  constructor
  · intro hp A B i hi
    rw [← internalHomAdjunction₂.hasLiftingProperty_iff (PushoutObjObj.ofHasPushout ..) sq]
    exact hp _ ⟨CategoryTheory.Arrow.mk i, hi⟩
  · rintro h _ _ _ ⟨j, hj⟩
    exact (internalHomAdjunction₂.hasLiftingProperty_iff
      (PushoutObjObj.ofHasPushout ..) sq).2 (h j.hom hj)

end

end horn₂₁

end SSet
