module

public import Mathlib.AlgebraicTopology.SimplexCategory.Truncated

/-!
# Properties of morphisms in the simplex category

In this file, we show that morphisms in the simplex category
are generated by faces and degeneracies. This is stated by
saying that if `W : MorphismProperty SimplexCategory` is
multiplicative, and contains faces and degeneracies, then `W = ⊤`.
We first prove the stamentes in `SimplexCategory.Truncated d`, and then in `SimplexCategory`

-/

public section

open CategoryTheory Simplicial

namespace SimplexCategory

namespace Truncated

/-- In the truncated simplex category, a property of morphisms which holds for identities and is
stable under postcomposition with faces holds for all monomorphisms. -/
lemma mono_induction {d : ℕ} {motive : ∀ {x y : Truncated d}, (x ⟶ y) → Prop}
    (id : ∀ x, motive (𝟙 x))
    (comp_δ : ∀ {x : Truncated d} {n : ℕ} (hn : n < d) (f : x ⟶ ⟨⦋n⦌, by dsimp; lia⟩)
      (i : Fin (n + 2)), motive f → motive (f ≫ Truncated.δ d i (by dsimp; lia) (by dsimp; lia)))
    {x y : Truncated d} (f : x ⟶ y) [hf : Mono f] : motive f := by
  obtain ⟨⟨a⟩, ha⟩ := x
  obtain ⟨⟨b⟩, hb⟩ := y
  rw [mono_iff] at hf
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le (len_le_of_mono f.hom)
  induction c with
  | zero => exact ObjectProperty.hom_ext _ (eq_id_of_mono f.hom) ▸ id _
  | succ c hc =>
    obtain ⟨i, g, hg⟩ := eq_comp_δ_of_not_surjective f.hom fun h ↦ by
      have := epi_iff_surjective.mpr h
      grind [len_le_of_epi f.hom]
    have hc' : a + c < d := by dsimp at hb; lia
    let g' := Hom.tr g ha hc'.le
    rw [InducedCategory.hom_ext hg]
    exact comp_δ hc' g' i (hc hc'.le g' (mono_of_mono_fac hg.symm))

/-- In the truncated simplex category, a property of morphisms which holds for identities and is
stable under precomposition with degeneracies holds for all epimorphisms. -/
lemma epi_induction {d : ℕ} {motive : ∀ {x y : Truncated d}, (x ⟶ y) → Prop}
    (id : ∀ x, motive (𝟙 x))
    (σ_comp : ∀ {n : ℕ} {y : Truncated d} (hn : n < d) (i : Fin (n + 1))
      (f : ⟨⦋n⦌, by dsimp; lia⟩ ⟶ y),
      motive f → motive (Truncated.σ d i (by dsimp; lia) (by dsimp; lia) ≫ f))
    {x y : Truncated d} (f : x ⟶ y) [hf : Epi f] : motive f := by
  obtain ⟨⟨a⟩, ha⟩ := x
  obtain ⟨⟨b⟩, hb⟩ := y
  rw [epi_iff] at hf
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le (len_le_of_epi f.hom)
  induction c with
  | zero => exact ObjectProperty.hom_ext _ (eq_id_of_epi f.hom) ▸ id _
  | succ c hc =>
    obtain ⟨i, g, hg⟩ := eq_σ_comp_of_not_injective f.hom fun h ↦ by
      have := mono_iff_injective.mpr h; grind [len_le_of_mono f.hom]
    have hc' : b + c < d := by dsimp at ha; lia
    let g' := Hom.tr g hc'.le hb
    rw[InducedCategory.hom_ext hg]
    exact σ_comp hc' i g' (hc hc'.le g' (epi_of_epi_fac hg.symm))

/-- Morphisms in `Truncated d` are generated by faces and degeneracies. -/
lemma morphismProperty_eq_top
    {d : ℕ} (W : MorphismProperty (Truncated d)) [W.IsMultiplicative]
    (δ_mem : ∀ (n : ℕ) (hn : n < d) (i : Fin (n + 2)),
      W (Truncated.δ d i (by dsimp; lia) (by dsimp; lia)))
    (σ_mem : ∀ (n : ℕ) (hn : n < d) (i : Fin (n + 1)),
      W (Truncated.σ d i (by dsimp; lia) (by dsimp; lia))) :
    W = ⊤ := by
  refine eq_top_iff.mpr fun a b f _ ↦ ?_
  obtain ⟨c, e, m, he, hm, rfl⟩ := exists_epi_mono_factorization f
  exact W.comp_mem e m
    (epi_induction (motive := fun g ↦ W g) W.id_mem
      (fun hn i _ h ↦ W.comp_mem _ _ (σ_mem _ hn i) h) e)
    (mono_induction (motive := fun g ↦ W g) W.id_mem
      (fun hn _ i h ↦ W.comp_mem _ _ h (δ_mem _ hn i)) m)

end Truncated

/-- A property of morphisms which holds for identities and is stable under postcomposition with
faces holds for all monomorphisms. -/
lemma mono_induction {motive : ∀ {x y : SimplexCategory}, (x ⟶ y) → Prop}
    (id : ∀ x, motive (𝟙 x))
    (comp_δ : ∀ {x : SimplexCategory} {n : ℕ} (f : x ⟶ ⦋n⦌) (i : Fin (n + 2)),
      motive f → motive (f ≫ δ i))
    {x y : SimplexCategory} (f : x ⟶ y) [hf : Mono f] : motive f :=
  Truncated.mono_induction (motive := fun g ↦ motive g.hom) (fun _ ↦ id _)
    (fun _ g i h ↦ comp_δ g.hom i h)
    (Truncated.Hom.tr f (le_max_left _ y.len) (le_max_right x.len _))
    (hf := Truncated.mono_iff.mpr hf)

/-- A property of morphisms which holds for identities and is stable under precomposition with
degeneracies holds for all epimorphisms. -/
lemma epi_induction {motive : ∀ {x y : SimplexCategory}, (x ⟶ y) → Prop}
    (id : ∀ x, motive (𝟙 x))
    (σ_comp : ∀ {n : ℕ} {y : SimplexCategory} (i : Fin (n + 1)) (f : ⦋n⦌ ⟶ y),
      motive f → motive (σ i ≫ f))
    {x y : SimplexCategory} (f : x ⟶ y) [hf : Epi f] : motive f :=
  Truncated.epi_induction (motive := fun g ↦ motive g.hom) (fun _ ↦ id _)
    (fun _ i g h ↦ σ_comp i g.hom h)
    (Truncated.Hom.tr f (le_max_left _ y.len) (le_max_right x.len _))
    (hf := Truncated.epi_iff.mpr hf)

/-- Morphisms in `SimplexCategory` are generated by faces and degeneracies. -/
lemma morphismProperty_eq_top
    (W : MorphismProperty SimplexCategory) [W.IsMultiplicative]
    (δ_mem : ∀ {n : ℕ} (i : Fin (n + 2)), W (SimplexCategory.δ i))
    (σ_mem : ∀ {n : ℕ} (i : Fin (n + 1)), W (SimplexCategory.σ i)) :
    W = ⊤ := by
  ext a b f
  simp only [MorphismProperty.top_apply, iff_true]
  change W.inverseImage (Truncated.inclusion (max a.len b.len))
    (Truncated.Hom.tr f (by simp) (by simp))
  have hW (d : ℕ) : W.inverseImage (Truncated.inclusion d) = ⊤ :=
    Truncated.morphismProperty_eq_top _ (fun _ _ i ↦ δ_mem i)
      (fun _ _ i ↦ σ_mem i)
  simp only [hW, MorphismProperty.top_apply]

end SimplexCategory
