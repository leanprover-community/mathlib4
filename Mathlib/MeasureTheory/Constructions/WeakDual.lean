module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Metrizable
public import Mathlib.MeasureTheory.Constructions.Projective
public import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated
public import Mathlib.Topology.Algebra.Module.Spaces.WeakDual

/-!
# The cylinder σ-algebra on the weak dual

Given a measurable space structure on the scalars `𝕜`, the *cylinder σ-algebra* on
`WeakDual 𝕜 E` is the smallest σ-algebra for which all evaluation maps `T ↦ T x`, `x : E`, are
measurable. Equivalently, it is the pullback of the product σ-algebra on `E → 𝕜` along the
coercion `T ↦ (x ↦ T x)`, in the same way as the weak-* topology is the topology induced by
the product topology along this map.

This is the σ-algebra on which measures on spaces of distributions (random distributions,
generalized random fields) are usually constructed, e.g. by the Bochner–Minlos theorem.

The cylinder σ-algebra is always contained in the Borel σ-algebra of the weak-* topology
(`WeakDual.cylinderMeasurableSpace_le_borel`), but the two differ in general. In keeping with
the convention that the measurable structure of a topological space is its Borel σ-algebra, we
do not register the cylinder σ-algebra as an instance: `WeakDual.cylinderMeasurableSpace` is a
definition, which can be turned into a local instance when needed.

## Main definitions

* `WeakDual.cylinderMeasurableSpace 𝕜 E`: the cylinder σ-algebra on `WeakDual 𝕜 E`.

## Main statements

* `WeakDual.cylinderMeasurableSpace_eq_iSup`: the cylinder σ-algebra is the supremum of the
  σ-algebras generated by the evaluation maps.
* `WeakDual.measurable_cylinder_iff`: a map into `WeakDual 𝕜 E` is measurable for the cylinder
  σ-algebra iff all its evaluations are measurable.
* `WeakDual.cylinderMeasurableSpace_le_borel`: the cylinder σ-algebra is contained in the Borel
  σ-algebra of the weak-* topology.
* `WeakDual.ext_of_forall_finset_map_eq`: two finite measures for the cylinder σ-algebra are equal
  as soon as they have the same finite-dimensional marginals `T ↦ (T x)_{x ∈ I}`, `I` finite.
* `WeakDual.map_eq_iff_forall_finset_map_eq`: two random elements of `WeakDual 𝕜 E` have the same
  law iff they have the same finite-dimensional laws.
* `WeakDual.cylinderMeasurableSpace_eq_comap_of_denseRange`: if `𝕜` is metrizable and `E` is a
  Fréchet–Urysohn space (e.g. first-countable), then the cylinder σ-algebra is generated by the
  evaluations along any family with dense range.
* `WeakDual.ext_of_forall_finset_map_eq_of_denseRange`: in that case, finite-dimensional marginals
  along a family with dense range already determine a finite measure.
* `WeakDual.countablyGenerated_cylinderMeasurableSpace`: if moreover `E` is separable and the
  σ-algebra of `𝕜` is countably generated, then the cylinder σ-algebra is countably generated.

## References

* [V. I. Bogachev, *Measure theory*][bogachev2007]

## Tags

weak dual, cylinder σ-algebra, finite-dimensional distributions, random distributions
-/

@[expose] public section

noncomputable section

open MeasureTheory Set

/-- Two finite measures on a space whose σ-algebra is the pullback of a product σ-algebra along
`F` are equal if their finite-dimensional projections along `F` are equal. -/
private theorem MeasureTheory.Measure.ext_of_eq_comap_pi {X ι : Type*} {β : ι → Type*}
    [∀ i, MeasurableSpace (β i)] {mX : MeasurableSpace X} {F : X → ∀ i, β i}
    (hF : mX = .comap F .pi) {μ ν : Measure X} [IsFiniteMeasure μ]
    (h : ∀ I : Finset ι, μ.map (fun x ↦ I.restrict (F x)) = ν.map (fun x ↦ I.restrict (F x))) :
    μ = ν := by
  have hFm : Measurable F := by
    rw [measurable_iff_comap_le, hF]
  have key : μ.map F = ν.map F := by
    have hμ : IsProjectiveLimit (μ.map F) (fun I ↦ μ.map (fun x ↦ I.restrict (F x))) := fun I ↦ by
      rw [Measure.map_map (Finset.measurable_restrict I) hFm]
      rfl
    have hν : IsProjectiveLimit (ν.map F) (fun I ↦ μ.map (fun x ↦ I.restrict (F x))) := fun I ↦ by
      rw [Measure.map_map (Finset.measurable_restrict I) hFm]
      exact (h I).symm
    exact hμ.unique hν
  ext s hs
  rw [hF] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  rw [← Measure.map_apply hFm ht, key, Measure.map_apply hFm ht]

namespace WeakDual

variable (𝕜 E : Type*) [CommSemiring 𝕜] [TopologicalSpace 𝕜] [ContinuousAdd 𝕜]
  [ContinuousConstSMul 𝕜 𝕜] [AddCommMonoid E] [Module 𝕜 E] [TopologicalSpace E] [MeasurableSpace 𝕜]

/-- The cylinder σ-algebra on `WeakDual 𝕜 E`: the smallest σ-algebra making all evaluation maps
`T ↦ T x` measurable. It is defined as the pullback of the product σ-algebra on `E → 𝕜` along
`T ↦ (x ↦ T x)`.

This is not an instance: it is contained in the Borel σ-algebra of the weak-* topology
(`WeakDual.cylinderMeasurableSpace_le_borel`), but differs from it in general. -/
@[instance_reducible]
def cylinderMeasurableSpace : MeasurableSpace (WeakDual 𝕜 E) :=
  .comap (fun (T : WeakDual 𝕜 E) (x : E) ↦ T x) .pi

variable {𝕜 E}

/-- The cylinder σ-algebra is the supremum of the σ-algebras generated by the evaluation maps. -/
theorem cylinderMeasurableSpace_eq_iSup :
    cylinderMeasurableSpace 𝕜 E =
      ⨆ x : E, MeasurableSpace.comap (fun T : WeakDual 𝕜 E ↦ T x) ‹MeasurableSpace 𝕜› := by
  simp only [cylinderMeasurableSpace, MeasurableSpace.pi, MeasurableSpace.comap_iSup,
    MeasurableSpace.comap_comp]
  rfl

/-- The cylinder σ-algebra is contained in the Borel σ-algebra of the weak-* topology. -/
theorem cylinderMeasurableSpace_le_borel [BorelSpace 𝕜] :
    cylinderMeasurableSpace 𝕜 E ≤ borel (WeakDual 𝕜 E) := by
  borelize (WeakDual 𝕜 E)
  exact (measurable_pi_iff.2 fun x ↦ (eval_continuous x).measurable).comap_le

/-- The cylinder σ-algebra is contained in any σ-algebra containing the open sets of the weak-*
topology. -/
theorem cylinderMeasurableSpace_le [BorelSpace 𝕜] {m : MeasurableSpace (WeakDual 𝕜 E)}
    [OpensMeasurableSpace (WeakDual 𝕜 E)] : cylinderMeasurableSpace 𝕜 E ≤ m :=
  cylinderMeasurableSpace_le_borel.trans OpensMeasurableSpace.borel_le

section Cylinder

attribute [local instance] cylinderMeasurableSpace

/-- A map into `WeakDual 𝕜 E` is measurable for the cylinder σ-algebra iff all its evaluations
are measurable. -/
theorem measurable_cylinder_iff {α : Type*} [MeasurableSpace α] {f : α → WeakDual 𝕜 E} :
    Measurable f ↔ ∀ x : E, Measurable fun a ↦ f a x := by
  rw [← measurable_pi_iff, measurable_iff_comap_le, measurable_iff_comap_le,
    cylinderMeasurableSpace, MeasurableSpace.comap_comp]
  rfl

/-- The map `T ↦ (x ↦ T x)` is measurable for the cylinder σ-algebra. -/
theorem measurable_coeFn_cylinder : Measurable fun (T : WeakDual 𝕜 E) (x : E) ↦ T x :=
  comap_measurable _

/-- The evaluation maps are measurable for the cylinder σ-algebra. -/
theorem measurable_eval_cylinder (x : E) : Measurable fun T : WeakDual 𝕜 E ↦ T x :=
  measurable_cylinder_iff.1 measurable_id x

/-- **Finite-dimensional marginals determine a measure on the weak dual.** Two finite measures
on `WeakDual 𝕜 E` with the cylinder σ-algebra are equal if their images under the maps
`T ↦ (T x)_{x ∈ I}` agree for all finite sets `I ⊆ E`. -/
theorem ext_of_forall_finset_map_eq {μ ν : Measure (WeakDual 𝕜 E)} [IsFiniteMeasure μ]
    (h : ∀ I : Finset E, μ.map (fun T (x : I) ↦ T x) = ν.map (fun T (x : I) ↦ T x)) :
    μ = ν :=
  Measure.ext_of_eq_comap_pi (F := fun (T : WeakDual 𝕜 E) (x : E) ↦ T x) rfl h

/-- Two random elements of `WeakDual 𝕜 E` (for the cylinder σ-algebra) have the same law iff
they have the same finite-dimensional laws. -/
theorem map_eq_iff_forall_finset_map_eq {Ω Ω' : Type*} {mΩ : MeasurableSpace Ω}
    {mΩ' : MeasurableSpace Ω'} {P : Measure Ω} {P' : Measure Ω'} [IsFiniteMeasure P]
    {X : Ω → WeakDual 𝕜 E} {Y : Ω' → WeakDual 𝕜 E} (hX : AEMeasurable X P)
    (hY : AEMeasurable Y P') :
    P.map X = P'.map Y ↔
      ∀ I : Finset E, P.map (fun ω (x : I) ↦ X ω x) = P'.map (fun ω (x : I) ↦ Y ω x) := by
  have hm (I : Finset E) : Measurable fun (T : WeakDual 𝕜 E) (x : I) ↦ T x :=
    measurable_pi_iff.2 fun x ↦ measurable_eval_cylinder (x : E)
  have hX' (I : Finset E) :
      P.map (fun ω (x : I) ↦ X ω x) = (P.map X).map (fun T (x : I) ↦ T x) := by
    rw [AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hX]
    rfl
  have hY' (I : Finset E) :
      P'.map (fun ω (x : I) ↦ Y ω x) = (P'.map Y).map (fun T (x : I) ↦ T x) := by
    rw [AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hY]
    rfl
  refine ⟨fun h I ↦ by rw [hX', hY', h], fun h ↦ ext_of_forall_finset_map_eq fun I ↦ ?_⟩
  rw [← hX', ← hY', h I]

end Cylinder

section DenseRange

variable [FrechetUrysohnSpace E] [TopologicalSpace.PseudoMetrizableSpace 𝕜] [BorelSpace 𝕜]

/-- If `𝕜` is metrizable and `E` is a Fréchet–Urysohn space (e.g. a first-countable space), the
cylinder σ-algebra on `WeakDual 𝕜 E` is generated by the evaluations along any family with dense
range. -/
theorem cylinderMeasurableSpace_eq_comap_of_denseRange {ι : Type*} {d : ι → E}
    (hd : DenseRange d) :
    cylinderMeasurableSpace 𝕜 E =
      .comap (fun (T : WeakDual 𝕜 E) (i : ι) ↦ T (d i)) .pi := by
  set m : MeasurableSpace (WeakDual 𝕜 E) := .comap (fun (T : WeakDual 𝕜 E) (i : ι) ↦ T (d i)) .pi
  refine le_antisymm ?_ ?_
  · have hk (i : ι) : Measurable[m] fun T : WeakDual 𝕜 E ↦ T (d i) :=
      measurable_pi_iff.1 (comap_measurable (m := .pi) fun (T : WeakDual 𝕜 E) (i : ι) ↦ T (d i))
        i
    refine (measurable_pi_iff.2 fun x ↦ ?_).comap_le
    obtain ⟨v, hv, hvx⟩ := mem_closure_iff_seq_limit.1 (hd x)
    choose j hj using hv
    refine measurable_of_tendsto_metrizable (fun n ↦ hk (j n)) (tendsto_pi_nhds.2 fun T ↦ ?_)
    simp only [hj]
    exact ((map_continuous T).tendsto x).comp hvx
  · let := cylinderMeasurableSpace 𝕜 E
    exact (measurable_pi_iff.2 fun i ↦ measurable_eval_cylinder (d i)).comap_le

section Cylinder

attribute [local instance] cylinderMeasurableSpace

/-- If `𝕜` is metrizable and `E` is a Fréchet–Urysohn space (e.g. a first-countable space), two
finite measures on `WeakDual 𝕜 E` with the cylinder σ-algebra are equal as soon as their
finite-dimensional marginals along a family with dense range agree. -/
theorem ext_of_forall_finset_map_eq_of_denseRange {ι : Type*} {d : ι → E} (hd : DenseRange d)
    {μ ν : Measure (WeakDual 𝕜 E)} [IsFiniteMeasure μ]
    (h : ∀ I : Finset ι, μ.map (fun T (i : I) ↦ T (d i)) = ν.map (fun T (i : I) ↦ T (d i))) :
    μ = ν :=
  Measure.ext_of_eq_comap_pi (F := fun (T : WeakDual 𝕜 E) (i : ι) ↦ T (d i))
    (cylinderMeasurableSpace_eq_comap_of_denseRange hd) h

/-- If `E` is separable and Fréchet–Urysohn (e.g. a separable metrizable space), `𝕜` is
metrizable and its σ-algebra is countably generated, then the cylinder σ-algebra on
`WeakDual 𝕜 E` is countably generated. -/
theorem countablyGenerated_cylinderMeasurableSpace [TopologicalSpace.SeparableSpace E]
    [MeasurableSpace.CountablyGenerated 𝕜] : MeasurableSpace.CountablyGenerated (WeakDual 𝕜 E) := by
  obtain ⟨d, hd⟩ := TopologicalSpace.exists_dense_seq E
  have heq : cylinderMeasurableSpace 𝕜 E =
      ⨆ k : ℕ, MeasurableSpace.comap (fun T : WeakDual 𝕜 E ↦ T (d k)) ‹MeasurableSpace 𝕜› := by
    rw [cylinderMeasurableSpace_eq_comap_of_denseRange hd]
    simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
    rfl
  have hk (k : ℕ) := (MeasurableSpace.CountablyGenerated.comap (α := WeakDual 𝕜 E)
    (fun T ↦ T (d k))).isCountablyGenerated
  choose b hbc hb using hk
  refine ⟨⟨⋃ k, b k, countable_iUnion hbc, ?_⟩⟩
  change cylinderMeasurableSpace 𝕜 E = _
  rw [heq, ← MeasurableSpace.iSup_generateFrom]
  exact iSup_congr hb

end Cylinder

end DenseRange

end WeakDual

end
