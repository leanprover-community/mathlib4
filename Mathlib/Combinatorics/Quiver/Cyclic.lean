public import Mathlib.Data.Nat.Find
public import Mathlib.Order.Lattice.Nat
public import Mathlib.Data.Nat.ModEq

/-!
# Quiver periodicity and aperiodicity

Period, index of imprimitivity, and cyclic partitions for strongly connected quivers.

## Main definitions

* `CycleLengths`: lengths of positive cycles at a vertex.
* `indexOfImprimitivity`: gcd of cycle lengths.

## Tags

quiver, aperiodic, primitive matrix, Perron–Frobenius theorem
-/

@[expose] public section

namespace Quiver
variable {V : Type*} [Quiver V]

/-- Lengths of positive cycles at a vertex `i`. -/
def CycleLengths (i : V) : Set ℕ := {k | k > 0 ∧ ∃ p : Path i i, p.length = k}

/-- The set of common divisors of all cycle lengths at `i`. (If there are no cycles this is all
  of `ℕ`.) -/
def commonDivisorsSet (i : V) : Set ℕ := {d | ∀ k ∈ CycleLengths i, d ∣ k}

lemma one_mem_commonDivisorsSet (i : V) : 1 ∈ commonDivisorsSet i := fun _ _ ↦ one_dvd _

lemma commonDivisorsSet_nonempty (i : V) : (commonDivisorsSet i).Nonempty :=
  ⟨1, one_mem_commonDivisorsSet i⟩

/-- The additive subgroup of `ℤ` generated by the cycle lengths at `i`. -/
def cycleSubgroup (i : V) : AddSubgroup ℤ :=
  AddSubgroup.closure ((fun k : ℕ ↦ (k : ℤ)) '' CycleLengths i)

lemma cast_mem_cycleSubgroup {i : V} {k : ℕ} (hk : k ∈ CycleLengths i) :
    (k : ℤ) ∈ cycleSubgroup i :=
  AddSubgroup.subset_closure ⟨k, hk, rfl⟩

lemma cycleSubgroup_eq_bot {i : V} (h : ¬ (CycleLengths i).Nonempty) : cycleSubgroup i = ⊥ := by
  rw [Set.not_nonempty_iff_eq_empty] at h
  simp [cycleSubgroup, h]

/-- The period of a vertex `i`: the greatest common divisor of the lengths of the cycles at `i`,
realised as the least positive element of the subgroup of `ℤ` that they generate.

If there are no cycles at `i` this is `0`. -/
noncomputable def period (i : V) : ℕ := sInf {n | 0 < n ∧ (n : ℤ) ∈ cycleSubgroup i}

lemma period_pos_and_mem {i : V} (h : (CycleLengths i).Nonempty) :
    0 < period i ∧ (period i : ℤ) ∈ cycleSubgroup i := by
  obtain ⟨k, hk⟩ := h
  have hne : {n : ℕ | 0 < n ∧ (n : ℤ) ∈ cycleSubgroup i}.Nonempty :=
    ⟨k, hk.1, cast_mem_cycleSubgroup hk⟩
  exact Nat.sInf_mem hne

lemma period_pos_of_nonempty_cycles (i : V) (h_nonempty : (CycleLengths i).Nonempty) :
    period i > 0 := (period_pos_and_mem h_nonempty).1

lemma period_eq_zero_of_isEmpty {i : V} (h : ¬ (CycleLengths i).Nonempty) : period i = 0 := by
  have : {n : ℕ | 0 < n ∧ (n : ℤ) ∈ cycleSubgroup i} = ∅ := by
    ext n
    simp only [Set.mem_empty_iff_false, iff_false]
    rintro ⟨hn, hmem⟩
    rw [cycleSubgroup_eq_bot h, AddSubgroup.mem_bot] at hmem
    exact absurd (by exact_mod_cast hmem : n = 0) hn.ne'
  rw [period, this, Nat.sInf_empty]

/-- The period divides every element of the subgroup generated by the cycle lengths. -/
lemma period_dvd_of_mem_cycleSubgroup {i : V} (h : (CycleLengths i).Nonempty) {x : ℤ}
    (hx : x ∈ cycleSubgroup i) : (period i : ℤ) ∣ x := by
  obtain ⟨hpos, hmem⟩ := period_pos_and_mem h
  have hp : (0 : ℤ) < (period i : ℤ) := by exact_mod_cast hpos
  have hrmem : x % (period i : ℤ) ∈ cycleSubgroup i := by
    have hx' : x - (period i : ℤ) * (x / (period i : ℤ)) ∈ cycleSubgroup i :=
      sub_mem hx (by simpa [mul_comm, zsmul_eq_mul] using
        AddSubgroup.zsmul_mem _ hmem (x / (period i : ℤ)))
    simpa [Int.emod_def] using hx'
  refine Int.dvd_of_emod_eq_zero ?_
  by_contra hne
  have h0 : 0 < x % (period i : ℤ) :=
    lt_of_le_of_ne (Int.emod_nonneg x hp.ne') (Ne.symm hne)
  have hlt : x % (period i : ℤ) < (period i : ℤ) := Int.emod_lt_of_pos x hp
  have : period i ≤ (x % (period i : ℤ)).toNat :=
    Nat.sInf_le ⟨by omega, by simpa [Int.toNat_of_nonneg h0.le] using hrmem⟩
  omega

/-- The period divides every cycle length. -/
lemma divides_cycle_length {i : V} {k : ℕ} (hk : k ∈ CycleLengths i) : period i ∣ k := by
  have : (period i : ℤ) ∣ (k : ℤ) :=
    period_dvd_of_mem_cycleSubgroup ⟨k, hk⟩ (cast_mem_cycleSubgroup hk)
  exact_mod_cast this

lemma period_divides_cycle_lengths (i : V) : ∀ {k}, k ∈ CycleLengths i → period i ∣ k :=
  divides_cycle_length

lemma period_mem_commonDivisorsSet (i : V) : period i ∈ commonDivisorsSet i :=
  fun _ hk ↦ divides_cycle_length hk

/-- Universal property: every common divisor of the cycle lengths divides the period. This is what
makes `period` the *greatest* common divisor. -/
lemma dvd_period {i : V} {m : ℕ} (hm : ∀ k ∈ CycleLengths i, m ∣ k) : m ∣ period i := by
  rcases Set.eq_empty_or_nonempty (CycleLengths i) with hempty | h
  · simp [period_eq_zero_of_isEmpty (by rw [hempty]; exact Set.not_nonempty_empty)]
  · have key : ∀ x ∈ cycleSubgroup i, (m : ℤ) ∣ x := by
      intro x hx
      induction hx using AddSubgroup.closure_induction with
      | mem y hy =>
        obtain ⟨k, hk, rfl⟩ := hy
        change (m : ℤ) ∣ (k : ℤ)
        exact_mod_cast hm k hk
      | zero => simp
      | add a b _ _ ha hb => exact dvd_add ha hb
      | neg a _ ha => exact (dvd_neg).2 ha
    have := key _ (period_pos_and_mem h).2
    exact_mod_cast this

/-- Characterisation of `period`: it is a common divisor of the cycle lengths, and every common
divisor divides it. -/
lemma period_spec (i : V) : (∀ k ∈ CycleLengths i, period i ∣ k) ∧
    (∀ m, (∀ k ∈ CycleLengths i, m ∣ k) → m ∣ period i) :=
  ⟨fun _ hk ↦ divides_cycle_length hk, fun _ hm ↦ dvd_period hm⟩

/-- Every common divisor of the cycle lengths is at most the period, provided a cycle exists. -/
lemma commonDivisor_le_period (i : V) {m : ℕ} (hm : ∀ k ∈ CycleLengths i, m ∣ k)
    (h : (CycleLengths i).Nonempty) : m ≤ period i :=
  Nat.le_of_dvd (period_pos_of_nonempty_cycles i h) (dvd_period hm)

/-- Cycle lengths at a vertex are closed under addition: concatenate the two cycles. -/
lemma add_mem_CycleLengths {i : V} {a b : ℕ} (ha : a ∈ CycleLengths i)
    (hb : b ∈ CycleLengths i) : a + b ∈ CycleLengths i := by
  obtain ⟨ha0, p, hp⟩ := ha
  obtain ⟨hb0, q, hq⟩ := hb
  exact ⟨by omega, p.comp q, by simp [Path.length_comp, hp, hq]⟩

lemma nsmul_mem_CycleLengths {i : V} {a : ℕ} (ha : a ∈ CycleLengths i) {m : ℕ} (hm : 0 < m) :
    m * a ∈ CycleLengths i := by
  induction m with
  | zero => omega
  | succ k ih =>
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · simpa using ha
    · simpa [Nat.succ_mul] using add_mem_CycleLengths (ih hk) ha

/-- Every element of the subgroup generated by the cycle lengths is a difference of two elements
of `CycleLengths i ∪ {0}`. -/
lemma exists_sub_repr_of_mem_cycleSubgroup {i : V} {x : ℤ} (hx : x ∈ cycleSubgroup i) :
    ∃ p q : ℕ, (p = 0 ∨ p ∈ CycleLengths i) ∧ (q = 0 ∨ q ∈ CycleLengths i) ∧
      x = (p : ℤ) - (q : ℤ) := by
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨k, hk, rfl⟩ := hy
    exact ⟨k, 0, Or.inr hk, Or.inl rfl, by simp⟩
  | zero => exact ⟨0, 0, Or.inl rfl, Or.inl rfl, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨p₁, q₁, hp₁, hq₁, rfl⟩ := ha
    obtain ⟨p₂, q₂, hp₂, hq₂, rfl⟩ := hb
    refine ⟨p₁ + p₂, q₁ + q₂, ?_, ?_, by simp only [Nat.cast_add]; omega⟩
    · rcases hp₁ with rfl | hp₁
      · simpa using hp₂
      · rcases hp₂ with rfl | hp₂
        · exact Or.inr (by simpa using hp₁)
        · exact Or.inr (add_mem_CycleLengths hp₁ hp₂)
    · rcases hq₁ with rfl | hq₁
      · simpa using hq₂
      · rcases hq₂ with rfl | hq₂
        · exact Or.inr (by simpa using hq₁)
        · exact Or.inr (add_mem_CycleLengths hq₁ hq₂)
  | neg a _ ha =>
    obtain ⟨p, q, hp, hq, rfl⟩ := ha
    exact ⟨q, p, hq, hp, by omega⟩

/-- If the period at `i` is `1`, then either `1` is itself a cycle length, or there are two
cycles at `i` whose lengths are consecutive. -/
lemma exists_consecutive_of_period_eq_one {i : V} (h : period i = 1)
    (hne : (CycleLengths i).Nonempty) :
    (1 : ℕ) ∈ CycleLengths i ∨ ∃ q, q ∈ CycleLengths i ∧ q + 1 ∈ CycleLengths i := by
  have h1 : ((1 : ℕ) : ℤ) ∈ cycleSubgroup i := by
    have h2 := (period_pos_and_mem hne).2
    rwa [h] at h2
  obtain ⟨p, q, hp, hq, hpq⟩ := exists_sub_repr_of_mem_cycleSubgroup h1
  have hp1 : p = q + 1 := by omega
  have hpmem : p ∈ CycleLengths i := hp.resolve_left (by omega)
  rcases hq with rfl | hq
  · exact Or.inl (by simpa [hp1] using hpmem)
  · exact Or.inr ⟨q, hq, by rw [← hp1]; exact hpmem⟩

/-- **Aperiodicity is cofinite**: if the period at `i` is `1`, then every sufficiently large
natural number is the length of a cycle at `i`. -/
theorem exists_forall_ge_mem_CycleLengths_of_period_eq_one {i : V} (h : period i = 1)
    (hne : (CycleLengths i).Nonempty) : ∃ N, ∀ n, N ≤ n → n ∈ CycleLengths i := by
  rcases exists_consecutive_of_period_eq_one h hne with h1 | ⟨q, hq, hq1⟩
  · exact ⟨1, fun n hn ↦ by simpa using nsmul_mem_CycleLengths h1 (m := n) (by omega)⟩
  refine ⟨q * q, fun n hn ↦ ?_⟩
  have hq0 : 0 < q := hq.1
  have hk : q ≤ n / q := (Nat.le_div_iff_mul_le hq0).2 hn
  have hr : n % q < q := Nat.mod_lt _ hq0
  have hrk : n % q ≤ n / q := le_trans hr.le hk
  have hsplit : (n / q - n % q) * q + n % q * (q + 1) = n := by
    have h1 : n / q - n % q + n % q = n / q := by omega
    have h2 : n % q * (q + 1) = n % q * q + n % q := Nat.mul_succ _ _
    rw [h2, ← Nat.add_assoc, ← Nat.add_mul, h1]
    exact Nat.div_add_mod' n q
  rw [← hsplit]
  rcases Nat.eq_zero_or_pos (n % q) with hr0 | hr0
  · rw [hr0]
    simpa using nsmul_mem_CycleLengths hq (m := n / q) (by omega)
  · rcases Nat.eq_zero_or_pos (n / q - n % q) with hd0 | hd0
    · rw [hd0]
      simpa using nsmul_mem_CycleLengths hq1 (m := n % q) hr0
    · exact add_mem_CycleLengths (nsmul_mem_CycleLengths hq hd0)
        (nsmul_mem_CycleLengths hq1 hr0)

/--
**Theorem: In a strongly connected quiver, the period is the same for all vertices**.
-/
theorem period_constant_of_strongly_connected (h_sc : Quiver.IsSStronglyConnected V) :
    ∀ i j : V, period i = period j := by
  intro i j
  obtain ⟨p, hp_pos⟩ := h_sc i j
  obtain ⟨q, hq_pos⟩ := h_sc j i
  have h_div_j : ∀ k ∈ CycleLengths j, period i ∣ k := by
    intro k hk
    obtain ⟨hk_pos, ⟨c, hc_len⟩⟩ := hk
    have ht_pos : 0 < (p.comp q).length := lt_of_lt_of_le hp_pos (by simp [Path.length_comp])
    have ht_mem : (p.comp q).length ∈ CycleLengths i := ⟨ht_pos, ⟨p.comp q, rfl⟩⟩
    refine (Nat.dvd_add_right ((period_spec i).1 _ ht_mem)).1 ?_
    let t' : ℕ := ((p.comp c).comp q).length
    have : p.length + k + q.length = t' := by aesop
    have h_dvd_t' : period i ∣ t' :=
      (period_spec i).1 _ ⟨lt_of_lt_of_le hk_pos (by grind), ⟨(p.comp c).comp q, rfl⟩⟩
    have h_eq : t' = (p.comp q).length + k := by
      simp [t', Path.length_comp, hc_len, Nat.add_assoc, Nat.add_comm]
    grind
  have h_div_i : ∀ k ∈ CycleLengths i, period j ∣ k := by
    intro k hk
    obtain ⟨hk_pos, ⟨c, hc_len⟩⟩ := hk
    have h_dvd_t : period j ∣ (q.comp p).length := (period_spec j).1 _
      ⟨lt_of_lt_of_le hq_pos (by simp [Path.length_comp]), ⟨q.comp p, rfl⟩⟩
    refine (Nat.dvd_add_right h_dvd_t).1 ?_
    · let t' : ℕ := ((q.comp c).comp p).length
      have : q.length + k + p.length = t' := by
        simp [t', Path.length_comp, hc_len, Nat.add_comm, Nat.add_left_comm]
      have h_dvd_t' : period j ∣ t' :=
        (period_spec j).1 _ ⟨lt_of_lt_of_le hk_pos (by lia), ⟨(q.comp c).comp p, rfl⟩⟩
      have h_eq : t' = (q.comp p).length + k := by
        simp [t', Path.length_comp, hc_len, Nat.add_comm, Nat.add_left_comm]
      grind
  exact Nat.dvd_antisymm (dvd_period h_div_j) (dvd_period h_div_i)

/-- The index of imprimitivity of a strongly connected quiver: the common period of its
vertices. Requires `Nonempty` to select an arbitrary vertex. -/
noncomputable def indexOfImprimitivity [Nonempty V] (_G : Quiver V) : ℕ :=
  period (Classical.arbitrary V)

/-- A strongly connected quiver is aperiodic if its index of imprimitivity is 1. -/
def IsAperiodic [Nonempty V] (G : Quiver V) : Prop :=
  indexOfImprimitivity G = 1

/-! # Cyclic Structure and Frobenius Normal Form -/

/-- A cyclic partition of the vertices with period h.
    The partition is represented by a map from `V` to `Fin h`.
    Edges only go from one class to the next one cyclically.
    We define the successor within `Fin h` by modular addition of 1 (staying in `Fin h`). -/
def IsCyclicPartition {h : ℕ} (h_pos : 0 < h) (partition : V → Fin h) : Prop :=
  let succMod : Fin h → Fin h := fun x => ⟨(x.val + 1) % h, Nat.mod_lt _ h_pos⟩
  ∀ i j : V, Nonempty (i ⟶ j) → partition j = succMod (partition i)

/-- If the right factor of a composed path has positive length, the composed cycle at `i`
belongs to `CycleLengths i`. -/
lemma mem_CycleLengths_of_comp_right {i v : V} (p : Path i v) (s : Path v i)
    (hs_pos : 0 < s.length) :
    (p.comp s).length ∈ CycleLengths i :=
  ⟨lt_of_lt_of_le hs_pos (by simp [Path.length_comp]), ⟨p.comp s, rfl⟩⟩

/-- Variant: if we first extend a path by a single edge using `cons` and then compose on the right
with a positive-length path back to the base, we still get a cycle length in `CycleLengths`. -/
lemma mem_CycleLengths_of_cons_comp_right {i v w : V} (p : Path i v) (e : v ⟶ w) (s : Path w i)
    (hs_pos : 0 < s.length) :
    (((p.cons e).comp s).length) ∈ CycleLengths i :=
  mem_CycleLengths_of_comp_right (p := p.cons e) (s := s) hs_pos

/--
Theorem: A strongly connected quiver with index of imprimitivity h admits a cyclic partition.
-/
theorem exists_cyclic_partition_of_strongly_connected [Nonempty V]
    (h_sc : Quiver.IsSStronglyConnected V) :
    ∀ (h_pos : 0 < indexOfImprimitivity (inferInstance : Quiver V)),
      ∃ partition : V → Fin (indexOfImprimitivity (inferInstance : Quiver V)),
        IsCyclicPartition h_pos partition := by
  intro h_pos
  let h := indexOfImprimitivity (inferInstance : Quiver V)
  change ∃ partition : V → Fin h, IsCyclicPartition h_pos partition
  let i0 : V := Classical.arbitrary V
  have hpaths : ∀ v : V, ∃ p : Path i0 v, 0 < p.length := fun v => h_sc i0 v
  let chosen : ∀ v : V, { p : Path i0 v // 0 < p.length } :=
    fun v => ⟨Classical.choose (hpaths v), Classical.choose_spec (hpaths v)⟩
  let P : ∀ v : V, Path i0 v := fun v => (chosen v).1
  let partition : V → Fin h := fun v => ⟨(P v).length % h, Nat.mod_lt _ h_pos⟩
  refine ⟨partition, fun i j hij ↦ ?_⟩
  obtain ⟨e⟩ := hij
  obtain ⟨s, hs_pos⟩ := h_sc j i0
  apply Fin.ext
  calc (P j).length % h = ((P i).length + 1) % h := ?_
       _   = ((P i).length % h + 1) % h := ?_
  · have hdvd1 : h ∣ ((P j).comp s).length :=
      divides_cycle_length (mem_CycleLengths_of_comp_right (p := P j) (s := s) hs_pos)
    have h1 : Nat.ModEq h ((P j).length + s.length) 0 := by
      simpa [Nat.ModEq, Path.length_comp] using Nat.mod_eq_zero_of_dvd hdvd1
    have hdvd2 : h ∣ (((P i).cons e).comp s).length :=
      divides_cycle_length
        (mem_CycleLengths_of_cons_comp_right (p := P i) (e := e) (s := s) hs_pos)
    have h2 : Nat.ModEq h ((P i).length + 1 + s.length) 0 := by
      simpa [Nat.ModEq, Path.length_comp, Path.length_cons, Nat.add_assoc] using
        Nat.mod_eq_zero_of_dvd hdvd2
    simpa [Nat.ModEq] using Nat.ModEq.add_right_cancel' s.length (h1.trans h2.symm)
  · rw [Nat.add_mod]; by_cases h1 : h = 1 <;> aesop

end Quiver
