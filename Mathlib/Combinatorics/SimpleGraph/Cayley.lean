module

public import Mathlib.Algebra.Group.Pointwise.Set.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
### Definition of Cayley graphs

This file defines and proves several fact about Cayley graphs.
A Cayley graph over type `M` with generators `s : Set M` is a graph in which two vertices `u ≠ v`
are adjacent if and only if there is some `g ∈ s` such that `u * g = v` or `v * g = u`.
The elements of `s` are called generators.

## Main declarations

* `SimpleGraph.mulCayley s`: the Cayley graph over `M` induced by `[Mul M]` with generators `s`.
* `SimpleGraph.addCayley s`: the Cayley graph over `M` induced by `[Add M]` with generators `s`.

## Main results

* `SimpleGraph.reachable_mulCayley_iff`: in a group, `v` is reachable from `u` in the Cayley graph
  if and only if `u⁻¹ * v` lies in the subgroup generated by `s`.
* `SimpleGraph.connected_mulCayley_iff`: in a group, the Cayley graph is connected if and only if
  `s` generates the group.

## TODOS
* Add API describing behaviour w/r/t `MulOpposite`.
* Add lemma showing this graph is the same as `SimpleGraph.circulantGraph` in appropriate settings.

-/

@[expose] public section

namespace SimpleGraph

/-- The Cayley graph induced by an operation `[Mul M]` with generators `s` -/
@[to_additive /-- The Cayley graph induced by an operation `[Add M]` with generators `s` -/]
def mulCayley {M : Type*} (s : Set M) [Mul M] : SimpleGraph M :=
  fromRel (∃ g ∈ s, · * g = ·)

variable {M : Type*} (s : Set M)

section Mul
variable [Mul M]

/-- See `mulCayley_adj` for the more convenient form in a `Group`. -/
@[to_additive /-- See `addCayley_adj` for the more convenient form in an `AddGroup`. -/]
lemma mulCayley_adj' (u v : M) :
    (mulCayley s).Adj u v ↔ u ≠ v ∧ ∃ g ∈ s, u * g = v ∨ u = v * g := by
  simp [mulCayley, ← exists_or, ← and_or_left, eq_comm]

@[to_additive]
lemma mulCayley_le_iff (G : SimpleGraph M) :
    mulCayley s ≤ G ↔ ∀ g ∈ s, ∀ a, a * g ≠ a → G.Adj (a * g) a := by
  rw [SimpleGraph.le_iff_adj]
  simp only [mulCayley_adj', ne_eq, and_imp, forall_exists_index]
  constructor
  · intro h g hg a ha
    exact h (a * g) a ha g hg (Or.inr rfl)
  · rintro h v w hvw g hg (rfl | rfl)
    · exact (h g hg v (hvw ·.symm)).symm
    · exact h g hg w hvw

@[to_additive]
instance [Fintype M] [DecidableEq M] [DecidablePred (· ∈ s)] :
    DecidableRel (mulCayley s).Adj := fun u v =>
  decidable_of_iff (u ≠ v ∧ ∃ g ∈ s, u * g = v ∨ u = v * g) (mulCayley_adj' s u v).symm

variable (M) in
/-- `mulCayley` is a left (order-)adjoint. -/
@[to_additive /-- `addCayley` is a left (order-)adjoint. -/]
lemma mulCayley_gc :
    GaloisConnection (mulCayley ·) ({g : M | ∀ a, a * g ≠ a → ·.Adj (a * g) a}) := by
  intro S G
  simp [mulCayley_le_iff, Set.subset_def]

@[to_additive]
theorem mulCayley_monotone : Monotone (mulCayley (M := M) ·) :=
  (mulCayley_gc M).monotone_l

@[to_additive (attr := gcongr)]
theorem mulCayley_mono {U V : Set M} (hUV : U ⊆ V) : mulCayley U ≤ mulCayley V :=
  mulCayley_monotone hUV

@[to_additive (attr := simp)]
theorem mulCayley_empty : mulCayley (∅ : Set M) = ⊥ := (mulCayley_gc M).l_bot

@[to_additive (attr := simp)]
theorem mulCayley_union (s₁ s₂ : Set M) : mulCayley (s₁ ∪ s₂) = mulCayley s₁ ⊔ mulCayley s₂ :=
  (mulCayley_gc M).l_sup

end Mul

section Semigroup
variable [Semigroup M]

@[to_additive (attr := simp)]
theorem mulCayley_adj_mul_iff_right [IsLeftCancelMul M] {s : Set M} {u v d : M} :
    (mulCayley s).Adj (d * u) (d * v) ↔ (mulCayley s).Adj u v := by
  simp [mulCayley_adj', mul_assoc]

end Semigroup

section MulOneClass
variable [MulOneClass M]

@[to_additive (attr := simp)]
theorem mulCayley_erase_one : mulCayley (s \ {1}) = mulCayley s := by
  nth_rw 2 [← Set.sdiff_union_inter s {1}]
  rw [mulCayley_union]
  ext u v
  simp +contextual [mulCayley_adj']

@[to_additive (attr := simp)]
theorem mulCayley_insert_one : mulCayley (insert 1 s) = mulCayley s := by
  simp [← Set.union_singleton, ← mulCayley_erase_one]

@[to_additive (attr := simp)]
theorem mulCayley_singleton_one : mulCayley ({1} : Set M) = ⊥ := by
  rw [← mulCayley_erase_one, Set.sdiff_self, mulCayley_empty]

end MulOneClass

section Monoid
variable [Monoid M]

/-- If `x` lies in the submonoid generated by `s`, then `u * x` is reachable from `u` in the
Cayley graph. -/
@[to_additive /-- If `x` lies in the additive submonoid generated by `s`, then `u + x` is
reachable from `u` in the Cayley graph. -/]
theorem reachable_mulCayley_mul_of_mem_submonoidClosure {s : Set M} {x : M}
    (hx : x ∈ Submonoid.closure s) (u : M) : (mulCayley s).Reachable u (u * x) := by
  induction hx using Submonoid.closure_induction generalizing u with
  | mem x hx =>
    by_cases hux : u = u * x
    · rw [← hux]
    · apply Adj.reachable
      rw [mulCayley_adj']
      exact ⟨hux, x, hx, Or.inl rfl⟩
  | one => rw [mul_one]
  | mul x y _ _ hx hy =>
    rw [← mul_assoc]
    exact (hx u).trans (hy (u * x))

end Monoid

section Group
variable [Group M]

@[to_additive]
lemma mulCayley_adj (u v : M) :
    (mulCayley s).Adj u v ↔ u ≠ v ∧ (u⁻¹ * v ∈ s ∨ v⁻¹ * u ∈ s) := by
  simp [mulCayley_adj', ← eq_inv_mul_iff_mul_eq (b := u), ← inv_mul_eq_iff_eq_mul (a := v),
    and_or_left, exists_or]

@[to_additive (attr := simp)]
theorem mulCayley_inv : mulCayley s⁻¹ = mulCayley s := by
  ext u v
  simp [mulCayley_adj, or_comm]

@[to_additive]
instance [DecidableEq M] [DecidablePred (· ∈ s)] : DecidableRel (mulCayley s).Adj :=
  fun u v => decidable_of_iff (u ≠ v ∧ (u⁻¹ * v ∈ s ∨ v⁻¹ * u ∈ s)) (mulCayley_adj s u v).symm

@[to_additive (attr := simp)]
theorem mulCayley_univ : mulCayley (Set.univ : Set M) = ⊤ := by
  ext _ _
  simp [mulCayley_adj]

@[to_additive (attr := simp)]
theorem mulCayley_compl_singleton_one : mulCayley ({1}ᶜ : Set M) = ⊤ := by
  simp [Set.compl_eq_univ_sdiff]

/-! ### Darts of graphs on groups -/

/-- For a dart `d` of a graph on a group, `d.fstInvMulSnd` is the group element `d.fst⁻¹ * d.snd`,
so that `d.fst * d.fstInvMulSnd = d.snd`. -/
@[to_additive /-- For a dart `d` of a graph on an additive group, `d.fstNegAddSnd` is the element
`-d.fst + d.snd`, so that `d.fst + d.fstNegAddSnd = d.snd`. -/]
private def Dart.fstInvMulSnd {H : SimpleGraph M} (d : H.Dart) : M := d.fst⁻¹ * d.snd

/-- For the dart from `u` to `v`, `fstInvMulSnd` is `u⁻¹ * v`. -/
@[to_additive (attr := simp) /-- For the dart from `u` to `v`, `fstNegAddSnd` is `-u + v`. -/]
private lemma Dart.fstInvMulSnd_mk {H : SimpleGraph M} {u v : M} (h : H.Adj u v) :
    (⟨(u, v), h⟩ : H.Dart).fstInvMulSnd = u⁻¹ * v := rfl

/-- For a dart of the Cayley graph, `fstInvMulSnd` lies in the subgroup generated by `s`. -/
@[to_additive /-- For a dart of the Cayley graph, `fstNegAddSnd` lies in the additive subgroup
generated by `s`. -/]
private lemma Dart.fstInvMulSnd_mem_subgroupClosure {s : Set M} (d : (mulCayley s).Dart) :
    d.fstInvMulSnd ∈ Subgroup.closure s :=
  have fstInvMulSnd_mem_union_inv : d.fstInvMulSnd ∈ s ∪ s⁻¹ := by
    have hadj := mulCayley_adj s d.fst d.snd
    have h := (hadj.mp d.adj).right
    rw [Dart.fstInvMulSnd]
    simpa using h
  Set.union_subset Subgroup.subset_closure (Subgroup.inv_subset_closure s)
    fstInvMulSnd_mem_union_inv

/-- For a walk from `u` to `v`, the product of `fstInvMulSnd` over its darts is `u⁻¹ * v`. -/
@[to_additive /-- For a walk from `u` to `v`, the sum of `fstNegAddSnd` over its darts is
`-u + v`. -/]
private lemma Walk.prod_map_fstInvMulSnd_darts {H : SimpleGraph M} {u v : M} (p : H.Walk u v) :
    (p.darts.map Dart.fstInvMulSnd).prod = u⁻¹ * v := by
  induction p <;> simp_all [mul_assoc]

/-! ### Connectedness -/

/-- `v` is reachable from `u` in the Cayley graph if and only if `u⁻¹ * v` lies in the subgroup
generated by `s`. -/
@[to_additive /-- `v` is reachable from `u` in the Cayley graph if and only if `-u + v` lies in
the additive subgroup generated by `s`. -/]
theorem reachable_mulCayley_iff (u v : M) :
    (mulCayley s).Reachable u v ↔ u⁻¹ * v ∈ Subgroup.closure s := by
  constructor
  · intro h
    obtain ⟨p⟩ := h
    rw [← p.prod_map_fstInvMulSnd_darts]
    apply List.prod_induction (· ∈ Subgroup.closure s)
    · intro a b ha hb
      exact mul_mem ha hb
    · exact one_mem _
    · rw [List.forall_mem_map]
      intro d _
      exact d.fstInvMulSnd_mem_subgroupClosure
  · intro h
    rw [← Subgroup.mem_toSubmonoid, Subgroup.closure_toSubmonoid] at h
    have hreach := reachable_mulCayley_mul_of_mem_submonoidClosure h u
    simpa using hreach

/-- The Cayley graph is preconnected if and only if `s` generates the group. -/
@[to_additive /-- The Cayley graph is preconnected if and only if `s` generates the additive
group. -/]
theorem preconnected_mulCayley_iff : (mulCayley s).Preconnected ↔ Subgroup.closure s = ⊤ := by
  rw [Preconnected, Subgroup.eq_top_iff']
  simp_rw [reachable_mulCayley_iff]
  exact ⟨fun h g ↦ by simpa using h 1 g, fun h u v ↦ h _⟩

/-- The Cayley graph is connected if and only if `s` generates the group. -/
@[to_additive /-- The Cayley graph is connected if and only if `s` generates the additive
group. -/]
theorem connected_mulCayley_iff : (mulCayley s).Connected ↔ Subgroup.closure s = ⊤ := by
  rw [connected_iff, and_iff_left ⟨1⟩, preconnected_mulCayley_iff]

end Group

end SimpleGraph
