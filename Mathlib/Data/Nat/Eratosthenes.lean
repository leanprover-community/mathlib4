module

public import Mathlib.Data.List.Basic
public import Mathlib.Data.List.Intervals
public import Mathlib.Data.Nat.Prime.Basic
public import Mathlib.NumberTheory.PrimeCounting

/-!
# Sieve of Eratosthenes

This file implements a pure functional Sieve of Eratosthenes in Lean 4 and formally proves its
soundness, completeness, and equivalence with Mathlib's canonical prime finset `Nat.primesLE`.

## Main definitions

* `Nat.dropMultiples`: Filters a list by removing elements divisible by a pivot `p`.
* `Nat.eratosthenesAux`: Auxiliary recursive sieve function operating on lists.
* `Nat.eratosthenes`: Generates all prime numbers up to `n` as a `List ℕ`.

## Main results

* `Nat.eratosthenes_sound`: Every number generated by `Nat.eratosthenes n` is prime.
* `Nat.eratosthenes_complete`: Every prime `p ≤ n` belongs to `Nat.eratosthenes n`.
* `Nat.eratosthenes_eq_primesLE`: The finset of primes generated by `Nat.eratosthenes n` equals
  `Nat.primesLE n`.
-/

public section

namespace Nat

/-- Drops all multiples of `p` from `xs`. -/
def dropMultiples (p : ℕ) (xs : List ℕ) : List ℕ :=
  xs.filter (fun x => ¬ (p ∣ x))

/-- Membership in `dropMultiples` is membership in `xs` without being divisible by `p`. -/
lemma mem_dropMultiples {p x : ℕ} {xs : List ℕ} :
    x ∈ dropMultiples p xs ↔ x ∈ xs ∧ ¬ (p ∣ x) := by
  simp [dropMultiples]

/-- Filtering does not increase list length. -/
lemma length_dropMultiples_le (p : ℕ) (xs : List ℕ) :
    (dropMultiples p xs).length ≤ xs.length :=
  List.length_filter_le _ _

/-- Auxiliary recursive step of the Sieve of Eratosthenes. -/
def eratosthenesAux : List ℕ → List ℕ
  | [] => []
  | p :: xs => p :: eratosthenesAux (dropMultiples p xs)
termination_by l => l.length
decreasing_by exact Nat.lt_succ_of_le (length_dropMultiples_le p xs)

/-- Generates the list of primes up to `n` using the Sieve of Eratosthenes. -/
def eratosthenes (n : ℕ) : List ℕ :=
  eratosthenesAux (List.Ico 2 (n + 1))

/-- Any element produced by `eratosthenesAux xs` belongs to the input list `xs`. -/
lemma mem_of_mem_eratosthenesAux {x : ℕ} {xs : List ℕ}
    (h : x ∈ eratosthenesAux xs) : x ∈ xs := by
  induction xs using eratosthenesAux.induct with
  | case1 =>
    rw [eratosthenesAux] at h; cases h
  | case2 p ys ih =>
    rw [eratosthenesAux] at h
    simp only [List.mem_cons] at h
    rcases h with rfl | hmem
    · exact .head _
    · exact .tail _ (mem_dropMultiples.mp (ih hmem)).1

/-- In a strictly increasing list, earlier elements surviving the sieve cannot divide
later surviving elements. -/
lemma not_dvd_of_pairwise {xs : List ℕ} (hpw : xs.Pairwise (· < ·))
    {q y : ℕ} (hq : q ∈ eratosthenesAux xs) (hy : y ∈ eratosthenesAux xs) (hlt : q < y) :
    ¬ (q ∣ y) := by
  induction xs using eratosthenesAux.induct generalizing q y with
  | case1 =>
    rw [eratosthenesAux] at hq; cases hq
  | case2 p ys ih =>
    rw [eratosthenesAux] at hq hy
    simp only [List.mem_cons] at hq hy
    obtain ⟨hp_lt, hpw_ys⟩ := List.pairwise_cons.mp hpw
    rcases hq with rfl | hq_tl <;> rcases hy with rfl | hy_tl
    · exact (hlt.ne rfl).elim
    · exact (mem_dropMultiples.mp (mem_of_mem_eratosthenesAux hy_tl)).2
    · have h_lt_q := hp_lt q (mem_dropMultiples.mp (mem_of_mem_eratosthenesAux hq_tl)).1
      exact (lt_asymm h_lt_q hlt).elim
    · exact ih (hpw_ys.filter _) hq_tl hy_tl hlt

/-- Any prime `q` appearing in `xs` (with elements `≥ 2`) survives `eratosthenesAux xs`. -/
lemma mem_eratosthenesAux_of_prime {q : ℕ} (hq : q.Prime) {xs : List ℕ}
    (h_mem : q ∈ xs) (h_two : ∀ x ∈ xs, 2 ≤ x) : q ∈ eratosthenesAux xs := by
  induction xs using eratosthenesAux.induct with
  | case1 => contradiction
  | case2 p ys ih =>
    rw [eratosthenesAux]
    by_cases heq : q = p
    · exact heq ▸ .head _
    · refine .tail _ (ih ?_ fun x hx => h_two x (.tail _ (mem_dropMultiples.mp hx).1))
      refine mem_dropMultiples.mpr ⟨match h_mem with
        | .head _ => (heq rfl).elim
        | .tail _ h => h, ?_⟩
      intro hdvd
      have := (hq.eq_one_or_self_of_dvd p hdvd).resolve_left (Nat.ne_of_gt (h_two p (.head _)))
      subst this
      exact heq rfl

/-- Completeness: every prime `p ≤ n` belongs to `eratosthenes n`. -/
theorem eratosthenes_complete {n p : ℕ} (hpn : p ≤ n) (hp : p.Prime) :
    p ∈ eratosthenes n := by
  refine mem_eratosthenesAux_of_prime hp ?_ (fun _ hx => (List.Ico.mem.mp hx).1)
  rw [List.Ico.mem]
  exact ⟨hp.two_le, Nat.lt_succ_of_le hpn⟩

/-- Soundness: every element in `eratosthenes n` is prime. -/
theorem eratosthenes_sound (n : ℕ) : ∀ p ∈ eratosthenes n, p.Prime := by
  intro y hy
  have hymem := List.Ico.mem.mp (mem_of_mem_eratosthenesAux hy)
  have hy2 : 2 ≤ y := hymem.1
  have hyn : y ≤ n := Nat.le_of_lt_succ hymem.2
  have hy_ne_one : y ≠ 1 := Nat.ne_of_gt hy2
  have h_pos : 0 < y := Nat.lt_of_lt_of_le (by decide) hy2
  let q := y.minFac
  have hq_prime : q.Prime := Nat.minFac_prime hy_ne_one
  have hq_le : q ≤ y := Nat.minFac_le h_pos
  have hq_in : q ∈ eratosthenes n := eratosthenes_complete (hq_le.trans hyn) hq_prime
  by_cases hlt : q < y
  · exact (not_dvd_of_pairwise (List.Ico.pairwise_lt 2 (n + 1))
      hq_in hy hlt (Nat.minFac_dvd y)).elim
  · have heq : q = y := hq_le.antisymm (Nat.le_of_not_lt hlt)
    rwa [← heq]

/-- Mathlib set equivalence: `eratosthenes n` produces exactly `Nat.primesLE n`. -/
theorem eratosthenes_eq_primesLE (n : ℕ) :
    (eratosthenes n).toFinset = Nat.primesLE n := by
  ext x
  simp only [List.mem_toFinset, Nat.mem_primesLE]
  constructor
  · intro hx
    have hp := eratosthenes_sound n x hx
    have hmem := List.Ico.mem.mp (mem_of_mem_eratosthenesAux hx)
    exact ⟨Nat.le_of_lt_succ hmem.2, hp⟩
  · rintro ⟨hle, hp⟩
    exact eratosthenes_complete hle hp

end Nat
