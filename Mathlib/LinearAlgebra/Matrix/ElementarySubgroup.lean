module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Mathlib.RingTheory.LocalRing.Basic

/-!
# The elementary subgroup `E(n, R)` of `SL(n, R)`

The elementary subgroup `E(n, R)` of `SL(n, R)` is the subgroup generated by the transvections
`1 + single i j c`, for `i ≠ j`.

## References

* [H. Bass, *K-theory and stable algebra*][Bass1964]
-/

@[expose] public section

namespace Matrix.SpecialLinearGroup

open TransvectionStruct

variable {n m R S : Type*} [DecidableEq n] [Fintype n] [DecidableEq m] [Fintype m] [CommRing R]
  [CommRing S]

variable (n R) in
/-- The elementary subgroup `E(n, R)` of `SL(n, R)`: the subgroup generated by the transvections. -/
def elementary : Subgroup (SpecialLinearGroup n R) :=
  .closure (Set.range toSpecialLinearGroup)

@[simp]
lemma toSpecialLinearGroup_mem_elementary (t : TransvectionStruct n R) :
    t.toSpecialLinearGroup ∈ elementary n R :=
  Subgroup.subset_closure (Set.mem_range_self t)

@[simp]
lemma transvection_mem_elementary {i j : n} (hij : i ≠ j) (c : R) :
    SpecialLinearGroup.transvection hij c ∈ elementary n R :=
  toSpecialLinearGroup_mem_elementary ⟨i, j, hij, c⟩

/-- A subgroup of `SL(n, R)` that contains every transvection contains `E(n, R)`. -/
lemma elementary_le_iff {H : Subgroup (SpecialLinearGroup n R)} :
    elementary n R ≤ H ↔ ∀ t : TransvectionStruct n R, t.toSpecialLinearGroup ∈ H :=
  (Subgroup.closure_le H).trans Set.range_subset_iff

lemma list_prod_toSpecialLinearGroup_mem_elementary (L : List (TransvectionStruct n R)) :
    (L.map toSpecialLinearGroup).prod ∈ elementary n R :=
  list_prod_mem (List.forall_mem_map.2 fun t _ ↦ toSpecialLinearGroup_mem_elementary t)

lemma map_elementary_le (f : R →+* S) : (elementary n R).map (map f) ≤ elementary n S :=
  Subgroup.map_le_iff_le_comap.mpr <| elementary_le_iff.mpr fun t ↦ by
    simp [toSpecialLinearGroup_mem_elementary]

lemma map_elementary_of_surjective {f : R →+* S} (hf : Function.Surjective f) :
    (elementary n R).map (map f) = elementary n S := by
  refine (map_elementary_le f).antisymm (elementary_le_iff.mpr fun t ↦ ?_)
  obtain ⟨t, rfl⟩ := TransvectionStruct.map_surjective f hf t
  exact ⟨_, toSpecialLinearGroup_mem_elementary t, map_toSpecialLinearGroup f t⟩

/-- If `E(n, S) = SL(n, S)`, then `SL(n, R) → SL(n, S)` is surjective for every surjective ring hom
`f : R →+* S`. -/
theorem map_surjective_of_elementary_eq_top {f : R →+* S} (hf : Function.Surjective f)
    (h : elementary n S = ⊤) :
    Function.Surjective (map f : SpecialLinearGroup n R →* SpecialLinearGroup n S) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← h, ← map_elementary_of_surjective hf]
  exact Subgroup.map_le_range ..

/-- Reindexing along `e : n ≃ m` maps `E(n, R)` onto `E(m, R)`. -/
lemma map_reindexMulEquiv_elementary (e : n ≃ m) :
    (elementary n R).map (reindexMulEquiv R e : SpecialLinearGroup n R →* SpecialLinearGroup m R) =
      elementary m R := by
  have h : reindexMulEquiv R e ∘ toSpecialLinearGroup = toSpecialLinearGroup ∘ reindexEquiv e := by
    funext _
    exact Subtype.ext (toMatrix_reindexEquiv e _).symm
  simp [elementary, MonoidHom.map_closure, ← Set.range_comp, h,
    (reindexEquiv_surjective e).range_comp]

lemma map_sumInl_elementary_le (p : Type*) [DecidableEq p] [Fintype p] :
    (elementary n R).map (sumInl p) ≤ elementary (n ⊕ p) R :=
  Subgroup.map_le_iff_le_comap.mpr <| elementary_le_iff.mpr fun t ↦ by
    simp [toSpecialLinearGroup_mem_elementary]

lemma range_sumInl_le_elementary (p : Type*) [DecidableEq p] [Fintype p]
    (h : elementary n R = ⊤) : (sumInl p).range ≤ elementary (n ⊕ p) R := by
  rw [MonoidHom.range_eq_map, ← h]
  exact map_sumInl_elementary_le p

/-- If the entry of `A` in position `(j, b)` is a unit, then a transvection turns the entry in
position `(i, b)` into `1`, for any `i ≠ j`. -/
lemma exists_mem_elementary_mul_apply_eq_one {i j : n} (hij : i ≠ j) {b : n}
    (A : SpecialLinearGroup n R) (h : IsUnit (A j b)) :
    ∃ g ∈ elementary n R, (g * A) i b = 1 :=
  ⟨transvection hij ((1 - A i b) * ↑h.unit⁻¹), transvection_mem_elementary hij _, by
    rw [coe_mul, transvection_coe, ← Matrix.transvection, transvection_mul_apply_same, mul_assoc,
      h.val_inv_mul, mul_one, add_sub_cancel]⟩

/-- If some entry of the last column of `A ∈ SL(m ⊕ Unit, R)` is a unit, then an element of
`E(m ⊕ Unit, R)` turns the last diagonal entry of `A` into `1`. -/
lemma exists_mem_elementary_mul_apply_inr_inr_eq_one (A : SpecialLinearGroup (m ⊕ Unit) R)
    {i : m ⊕ Unit} (hi : IsUnit (A i (.inr ()))) :
    ∃ g ∈ elementary (m ⊕ Unit) R, (g * A) (.inr ()) (.inr ()) = 1 := by
  rcases i with k | ⟨⟩
  · exact exists_mem_elementary_mul_apply_eq_one Sum.inr_ne_inl A hi
  rcases isEmpty_or_nonempty m with hm | ⟨⟨k⟩⟩
  · have hA := A.det_coe
    rw [det_eq_elem_of_subsingleton _ (.inr ())] at hA
    exact ⟨1, one_mem _, by rwa [one_mul]⟩
  · obtain ⟨g₁, hg₁, h₁⟩ := exists_mem_elementary_mul_apply_eq_one (i := .inl k) Sum.inl_ne_inr A hi
    have hu : IsUnit ((g₁ * A) (.inl k) (.inr ())) := by simp [h₁]
    obtain ⟨g₂, hg₂, h₂⟩ := exists_mem_elementary_mul_apply_eq_one Sum.inr_ne_inl (g₁ * A) hu
    exact ⟨g₂ * g₁, mul_mem hg₂ hg₁, by rwa [mul_assoc]⟩

/-- Suppose that `E(r, R) = SL(r, R)`, and that every `A ∈ SL(r + 1, R)` can be
multiplied on the left by an element of `E(r + 1, R)` so as to have a unit in its last column.
Then `E(r + 1, R) = SL(r + 1, R)`. -/
theorem elementary_sum_unit_eq_top {r : ℕ} (hr : elementary (Fin r) R = ⊤)
    (hR : ∀ A : SpecialLinearGroup (Fin r ⊕ Unit) R,
      ∃ g ∈ elementary (Fin r ⊕ Unit) R, ∃ i, IsUnit ((g * A) i (.inr ()))) :
    elementary (Fin r ⊕ Unit) R = ⊤ := by
  refine eq_top_iff.mpr fun A _ ↦ ?_
  obtain ⟨g₁, hg₁, i, hi⟩ := hR A
  obtain ⟨g₂, hg₂, h₁⟩ := exists_mem_elementary_mul_apply_inr_inr_eq_one (g₁ * A) hi
  have hu : IsUnit ((g₂ * (g₁ * A)) (.inr ()) (.inr ())) := by simp [h₁]
  obtain ⟨L, L', hLL', hlast⟩ := Pivot.exists_isTwoBlockDiagonal_and_last_eq_of_isUnit _ hu
  have hmem : (L.map toSpecialLinearGroup).prod * (g₂ * (g₁ * A)) *
      (L'.map toSpecialLinearGroup).prod ∈ elementary (Fin r ⊕ Unit) R :=
    range_sumInl_le_elementary Unit hr <| mem_range_sumInl_iff.mpr
      ⟨by simpa using hLL', by ext; simpa [toBlocks₂₂, h₁] using hlast⟩
  rwa [mul_mem_cancel_right (list_prod_toSpecialLinearGroup_mem_elementary L'),
    mul_mem_cancel_left (list_prod_toSpecialLinearGroup_mem_elementary L),
    mul_mem_cancel_left, mul_mem_cancel_left hg₁] at hmem

/-- `E(n, R) = SL(n, R)` as soon as, in every size `r + 1`, every element of `SL(r + 1, R)` can be
multiplied on the left by an element of `E(r + 1, R)` so as to have a unit in its last column. -/
theorem elementary_eq_top_of_forall_exists_isUnit
    (hR : ∀ r < Fintype.card n, ∀ A : SpecialLinearGroup (Fin r ⊕ Unit) R,
      ∃ g ∈ elementary (Fin r ⊕ Unit) R, ∃ i, IsUnit ((g * A) i (.inr ()))) :
    elementary n R = ⊤ := by
  have ind (r : ℕ) (hr : r ≤ Fintype.card n) : elementary (Fin r) R = ⊤ := by
    induction r with
    | zero => exact Subsingleton.elim _ _
    | succ r ih =>
      have e : Fin r ⊕ Unit ≃ Fin (r + 1) := Fintype.equivOfCardEq (by simp)
      simp [← map_reindexMulEquiv_elementary e,
        elementary_sum_unit_eq_top (ih (Nat.le_of_succ_le hr)) (hR _ hr)]
  simp [← map_reindexMulEquiv_elementary (Fintype.equivFin n).symm, ind _ le_rfl]

/-- For a local ring `R` we have `SL(n, R) = E(n, R)`. -/
theorem elementary_eq_top_of_isLocalRing [IsLocalRing R] : elementary n R = ⊤ :=
  elementary_eq_top_of_forall_exists_isUnit fun r _ A ↦ by
    have h : IsUnit ((A⁻¹ * A) (.inr ()) (.inr ())) := by simp
    obtain ⟨i, -, hi⟩ := IsLocalRing.exists_of_isUnit_sum (by rwa [coe_mul, mul_apply] at h)
    exact ⟨1, one_mem _, i, by simpa using isUnit_of_mul_isUnit_right hi⟩

end Matrix.SpecialLinearGroup
