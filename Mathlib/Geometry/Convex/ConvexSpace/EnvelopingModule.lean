module

public import Mathlib.Algebra.Module.Congruence.Defs
public import Mathlib.Algebra.Module.Torsion.Field
public import Mathlib.Geometry.Convex.ConvexSpace.Module

import Mathlib.Tactic.Abel
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Module

/-!
# The enveloping module of a convex space

This file constructs, for a convex space `X` over a linearly ordered field `K`, a `K`-module
`Convexity.EnvelopingModule K X` together with a canonical affine map
`Convexity.EnvelopingModule.of : X → EnvelopingModule K X`.

This map is injective precisely when `X` is a cancellative convex space. In particular, **every
cancellative convex space embeds along an affine map into a module**.

## Main declarations

* `Convexity.EnvelopingModule K X`: The enveloping module of the convex space `X`.
* `Convexity.EnvelopingModule.of`: The canonical map `X → EnvelopingModule K X`.
* `Convexity.EnvelopingModule.isAffineMap_of`: The canonical map is affine.
* `Convexity.EnvelopingModule.of_injective`: The canonical map is injective when `X` is
  cancellative.
* `Convexity.isCancelConvexSpace_iff_injective_of`: A convex space is cancellative iff it embeds
  into its enveloping module.

## Implementation notes

`EnvelopingModule K X` is the quotient of the free module `X →₀ K` by the congruence
`Convexity.envelopingCon K X`, which relates `f` and `g` whenever
`f + c • w₂.weights = g + c • w₁.weights` for some `0 ≤ c` and some `w₁, w₂` in the standard
simplex over `X` with the same convex combination.

Two design points:
* We quotient by a `ModuleCon` rather than by a `Submodule` so that nothing here needs subtraction.
* We do *not* take the congruence generated by those relations: the point of the above description
  is that it is explicit enough to read off injectivity of `of` from it, while already being
  transitive and additive. Merging two such relations into one is where `K` being a field is used.
-/

open Finsupp Function

@[expose] public noncomputable section

namespace Convexity
variable {K X : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] [ConvexSpace K X]

variable (K) in
/-- `f` and `g` in `X →₀ K` are *enveloping-related* if they differ by a nonnegative multiple of
the weights of two elements of the standard simplex over `X` with equal convex combination, in the
sense that `f + c • w₂.weights = g + c • w₁.weights`.

This is the congruence defining `Convexity.EnvelopingModule`, see `Convexity.envelopingCon`. -/
def EnvelopingRel (f g : X →₀ K) : Prop :=
  f = g ∨ ∃ c : K, ∃ w₁ w₂ : StdSimplex K X,
    0 ≤ c ∧ w₁.sConvexComb = w₂.sConvexComb ∧ f + c • w₂.weights = g + c • w₁.weights

@[refl] lemma EnvelopingRel.refl (f : X →₀ K) : EnvelopingRel K f f := .inl rfl

lemma EnvelopingRel.symm {f g : X →₀ K} : EnvelopingRel K f g → EnvelopingRel K g f
  | .inl h => .inl h.symm
  | .inr ⟨c, w₁, w₂, hc, hw, h⟩ => .inr ⟨c, w₂, w₁, hc, hw.symm, h.symm⟩

/-- Two nonnegative multiples of differences of simplices with equal convex combinations merge into
a single one. This is where `K` being a field is used: the merged simplices are the
`c / (c + d) : d / (c + d)` combinations of the original ones. -/
private lemma exists_merge {c d : K} (hc : 0 ≤ c) (hd : 0 ≤ d) (hcd : 0 < c + d)
    {w₁ w₂ v₁ v₂ : StdSimplex K X} (hw : w₁.sConvexComb = w₂.sConvexComb)
    (hv : v₁.sConvexComb = v₂.sConvexComb) :
    ∃ u₁ u₂ : StdSimplex K X, u₁.sConvexComb = u₂.sConvexComb ∧
      (c + d) • u₁.weights = c • w₁.weights + d • v₁.weights ∧
      (c + d) • u₂.weights = c • w₂.weights + d • v₂.weights := by
  have he₀ : c + d ≠ 0 := hcd.ne'
  have hce : 0 ≤ c / (c + d) := div_nonneg hc hcd.le
  have hde : 0 ≤ d / (c + d) := div_nonneg hd hcd.le
  have hcde : c / (c + d) + d / (c + d) = 1 := by field_simp
  have h₁ : (c + d) * (c / (c + d)) = c := by field_simp
  have h₂ : (c + d) * (d / (c + d)) = d := by field_simp
  refine ⟨convexCombPair _ _ hce hde hcde w₁ v₁, convexCombPair _ _ hce hde hcde w₂ v₂,
    by rw [sConvexComb_convexCombPair, sConvexComb_convexCombPair, hw, hv], ?_, ?_⟩ <;>
  · rw [StdSimplex.weights_convexCombPair]
    simp only [smul_add, smul_smul, h₁, h₂]

lemma EnvelopingRel.add {f₁ g₁ f₂ g₂ : X →₀ K} (h₁ : EnvelopingRel K f₁ g₁)
    (h₂ : EnvelopingRel K f₂ g₂) : EnvelopingRel K (f₁ + f₂) (g₁ + g₂) := by
  obtain rfl | ⟨c, w₁, w₂, hc, hw, h₁⟩ := h₁
  · obtain rfl | ⟨d, v₁, v₂, hd, hv, h₂⟩ := h₂
    · exact .inl rfl
    · exact .inr ⟨d, v₁, v₂, hd, hv, by rw [add_assoc, h₂, add_assoc]⟩
  obtain rfl | ⟨d, v₁, v₂, hd, hv, h₂⟩ := h₂
  · exact .inr ⟨c, w₁, w₂, hc, hw, by rw [add_right_comm, h₁, add_right_comm]⟩
  rcases eq_or_lt_of_le (add_nonneg hc hd) with he | he
  · obtain ⟨rfl, rfl⟩ : c = 0 ∧ d = 0 := ⟨by linarith, by linarith⟩
    simp only [zero_smul, add_zero] at h₁ h₂
    exact .inl (by rw [h₁, h₂])
  obtain ⟨u₁, u₂, hu, hu₁, hu₂⟩ := exists_merge hc hd he hw hv
  refine .inr ⟨c + d, u₁, u₂, he.le, hu, ?_⟩
  rw [hu₁, hu₂]
  calc f₁ + f₂ + (c • w₂.weights + d • v₂.weights)
      = (f₁ + c • w₂.weights) + (f₂ + d • v₂.weights) := by abel
    _ = (g₁ + c • w₁.weights) + (g₂ + d • v₁.weights) := by rw [h₁, h₂]
    _ = g₁ + g₂ + (c • w₁.weights + d • v₁.weights) := by abel

lemma EnvelopingRel.trans {f g h : X →₀ K} (h₁ : EnvelopingRel K f g) (h₂ : EnvelopingRel K g h) :
    EnvelopingRel K f h := by
  obtain rfl | ⟨c, w₁, w₂, hc, hw, h₁⟩ := h₁
  · exact h₂
  obtain rfl | ⟨d, v₁, v₂, hd, hv, h₂⟩ := h₂
  · exact .inr ⟨c, w₁, w₂, hc, hw, h₁⟩
  rcases eq_or_lt_of_le (add_nonneg hc hd) with he | he
  · obtain ⟨rfl, rfl⟩ : c = 0 ∧ d = 0 := ⟨by linarith, by linarith⟩
    simp only [zero_smul, add_zero] at h₁ h₂
    exact .inl (h₁.trans h₂)
  obtain ⟨u₁, u₂, hu, hu₁, hu₂⟩ := exists_merge hc hd he hw hv
  refine .inr ⟨c + d, u₁, u₂, he.le, hu, ?_⟩
  rw [hu₁, hu₂]
  calc f + (c • w₂.weights + d • v₂.weights)
      = (f + c • w₂.weights) + d • v₂.weights := by abel
    _ = (g + d • v₂.weights) + c • w₁.weights := by rw [h₁]; abel
    _ = (h + d • v₁.weights) + c • w₁.weights := by rw [h₂]
    _ = h + (c • w₁.weights + d • v₁.weights) := by abel

lemma EnvelopingRel.smul (a : K) {f g : X →₀ K} : EnvelopingRel K f g →
    EnvelopingRel K (a • f) (a • g)
  | .inl h => .inl (by rw [h])
  | .inr ⟨c, w₁, w₂, hc, hw, h⟩ => by
    rcases le_total 0 a with ha | ha
    · exact .inr ⟨a * c, w₁, w₂, mul_nonneg ha hc, hw,
        by rw [mul_smul, mul_smul, ← smul_add, ← smul_add, h]⟩
    · refine .inr ⟨-a * c, w₂, w₁, by nlinarith, hw.symm, ?_⟩
      have h' : f = g + c • w₁.weights - c • w₂.weights := by rw [← h]; abel
      rw [h']
      module

variable (K X) in
/-- The congruence on the free module `X →₀ K` on a convex space `X` by which one quotients to get
the enveloping module of `X`. -/
def envelopingCon : ModuleCon K (X →₀ K) where
  r := EnvelopingRel K
  iseqv := ⟨.refl, .symm, .trans⟩
  add' := .add
  smul := .smul

variable (K X) in
/-- The enveloping module of a convex space `X` over a linearly ordered field `K`.

This is the quotient of the free module `X →₀ K` by the relations identifying a point of the
standard simplex with the point mass at its convex combination. It receives a canonical affine map
from `X`, which is injective exactly when `X` is cancellative. -/
abbrev EnvelopingModule : Type _ := (envelopingCon K X).Quotient

namespace EnvelopingModule

instance : ConvexSpace K (EnvelopingModule K X) := .ofModule

instance : IsModuleConvexSpace K (EnvelopingModule K X) where sConvexComb_eq_sum _ := rfl

variable (K X) in
/-- The projection from the free module onto the enveloping module, as a linear map. -/
def mkQ : (X →₀ K) →ₗ[K] EnvelopingModule K X where
  toFun f := Quotient.mk _ f
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma mkQ_eq_mkQ {f g : X →₀ K} : mkQ K X f = mkQ K X g ↔ EnvelopingRel K f g := by
  change Quotient.mk (envelopingCon K X).toSetoid f = Quotient.mk _ g ↔ _
  exact Quotient.eq

variable (K) in
/-- The canonical map from a convex space to its enveloping module.

This map is affine, see `Convexity.EnvelopingModule.isAffineMap_of`, and injective as soon as the
convex space is cancellative, see `Convexity.EnvelopingModule.of_injective`. -/
def of (x : X) : EnvelopingModule K X := mkQ K X (single x 1)

lemma of_apply (x : X) : of K x = mkQ K X (single x 1) := rfl

/-- The congruence defining the enveloping module identifies a point of the standard simplex with
the point mass at its convex combination. -/
lemma mkQ_single_sConvexComb (w : StdSimplex K X) :
    mkQ K X (single w.sConvexComb 1) = mkQ K X w.weights :=
  mkQ_eq_mkQ.2 <| .inr ⟨1, .single w.sConvexComb, w, zero_le_one, by simp, by simp [add_comm]⟩

private lemma mkQ_eq_sum (f : X →₀ K) : mkQ K X f = f.sum fun x r ↦ r • of K x := by
  conv_lhs => rw [← Finsupp.sum_single f]
  rw [map_finsuppSum]
  exact Finsupp.sum_congr fun x _ ↦ by
    rw [of_apply, ← map_smul, smul_single, smul_eq_mul, mul_one]

@[fun_prop]
lemma isAffineMap_of : IsAffineMap K (of K : X → EnvelopingModule K X) where
  map_sConvexComb w := by
    rw [sConvexComb_map, iConvexComb_eq_sum, ← mkQ_eq_sum, of_apply]
    exact mkQ_single_sConvexComb w

/-- The canonical map from a cancellative convex space to its enveloping module is injective.

In other words, every cancellative convex space embeds along an affine map into a module. -/
lemma of_injective [IsCancelConvexSpace K X] : Injective (of K : X → EnvelopingModule K X) := by
  rintro x y hxy
  obtain h | ⟨c, w₁, w₂, hc, hw, key⟩ := mkQ_eq_mkQ.1 hxy
  · exact single_left_injective one_ne_zero h
  rcases eq_or_lt_of_le hc with rfl | hc
  · exact single_left_injective one_ne_zero (by simpa using key)
  have ht₀ : (0 : K) < 1 + c := by linarith
  have ht₁ : (1 : K) + c ≠ 0 := ht₀.ne'
  have ha : (0 : K) < 1 / (1 + c) := div_pos one_pos ht₀
  have hb : (0 : K) ≤ c / (1 + c) := div_nonneg hc.le ht₀.le
  have hab : 1 / (1 + c) + c / (1 + c) = 1 := by field_simp
  -- Both sides of `key` are nonnegative and have total `1 + c`, so scaling by `1 / (1 + c)`
  -- exhibits them as two elements of the standard simplex.
  have hweights :
      (convexCombPair _ _ ha.le hb hab (StdSimplex.single x) w₂).weights =
        (convexCombPair _ _ ha.le hb hab (StdSimplex.single y) w₁).weights := by
    have hscale := congrArg (fun z ↦ (1 / (1 + c)) • z) key
    simpa [StdSimplex.weights_convexCombPair, smul_add, smul_smul, div_eq_mul_inv, mul_comm]
      using hscale
  have := congrArg StdSimplex.sConvexComb (StdSimplex.weights_inj.1 hweights)
  rw [sConvexComb_convexCombPair, sConvexComb_convexCombPair, sConvexComb_single,
    sConvexComb_single, hw] at this
  exact convexCombPair_left_injective ha hb hab _ this

end EnvelopingModule

/-- A convex space over a linearly ordered field is cancellative precisely when it embeds into its
enveloping module. -/
lemma isCancelConvexSpace_iff_injective_of :
    IsCancelConvexSpace K X ↔ Injective (EnvelopingModule.of K : X → EnvelopingModule K X) where
  mp _ := EnvelopingModule.of_injective
  mpr h := .of_injective EnvelopingModule.isAffineMap_of h

end Convexity
