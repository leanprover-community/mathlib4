module

public import Mathlib.Algebra.Group.Subgroup.Map
public import Mathlib.Data.Fintype.Pi
public import Mathlib.Data.Fintype.Sum
public import Mathlib.Data.List.OfFn
public import Mathlib.Geometry.Group.InfiniteBinaryTree
public import Mathlib.GroupTheory.Index

/-!
# Generators of the Grigorchuk group

The Grigorchuk group is the subgroup of `InfiniteBinaryTree.TreeAut` generated by four
involutions `a`, `b`, `c`, `d`. The generator `a` swaps the two children of the root.
The other three are determined by the recursive relations
`b = phi a c`, `c = phi a d`, `d = phi 1 b`, which specify the action on each word
by recursion on length.

The generators satisfy `a² = b² = c² = d² = 1`, `bc = d`, `cd = b`, `db = c`,
and therefore `bcd = 1`. They also satisfy the torsion relations
`(ad)⁴ = (ac)⁸ = (ab)¹⁶ = 1`.

* `Grigorchuk.G` is the subgroup of `TreeAut` generated by `{a, b, c, d}`.
* `Grigorchuk.st n` is the stabilizer in `G` of the vertices of length `n`.
  The index `[G : St_G(1)]` is `2`, and in general
  `[G : St_G(n)] ≤ 2^(2^n - 1)`.

## References

The construction follows Grigorchuk, *On the Milnor problem of group growth*,
Soviet Math. Dokl. 28 (1983), and Grigorchuk, *Degrees of growth of finitely generated
groups and the theory of invariant means*, Izv. Akad. Nauk SSSR Ser. Mat. 48 (1984).

## Tags

Grigorchuk group, geometric group theory
-/

@[expose] public section

open InfiniteBinaryTree InfiniteBinaryTree.TreeAut

namespace Grigorchuk

/-- An index in `{0, 1, 2}` is `0`, `1` or `2`. -/
lemma fin3_eq_zero_or_one_or_two (k : Fin 3) : k = 0 ∨ k = 1 ∨ k = 2 := by
  have : k.val = 0 ∨ k.val = 1 ∨ k.val = 2 := by omega
  rcases this with h | h | h <;> simp [Fin.ext_iff, h]

/-- Simultaneous action of the generators `b`, `c`, `d`.
Index `0` is `b`, `1` is `c`, `2` is `d`. -/
def bcdFun (k : Fin 3) : InfiniteBinaryTree → InfiniteBinaryTree
  | [] => []
  | i :: w =>
    if k = 0 then
      i :: bif i == 0 then (swapRoot : TreeAut) w else bcdFun 1 w
    else if k = 1 then
      i :: bif i == 0 then (swapRoot : TreeAut) w else bcdFun 2 w
    else
      i :: bif i == 0 then w else bcdFun 0 w

@[simp] lemma bcdFun_nil (k : Fin 3) : bcdFun k [] = [] := rfl

lemma bcdFun_zero_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    bcdFun 0 (i :: w) = i :: bif i == 0 then (swapRoot : TreeAut) w else bcdFun 1 w := by
  simp [bcdFun]

lemma bcdFun_one_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    bcdFun 1 (i :: w) = i :: bif i == 0 then (swapRoot : TreeAut) w else bcdFun 2 w := by
  simp [bcdFun]

lemma bcdFun_two_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    bcdFun 2 (i :: w) = i :: bif i == 0 then w else bcdFun 0 w := by
  simp [bcdFun]

lemma swapRoot_apply_apply (w : InfiniteBinaryTree) : swapRoot (swapRoot w) = w := by
  cases w with
  | nil => rfl
  | cons i rest =>
    have : (1 + 1 : Fin 2) = 0 := rfl
    simp [swapRoot_cons, add_assoc, this]

lemma bcdFun_involutive (k : Fin 3) (v : InfiniteBinaryTree) : bcdFun k (bcdFun k v) = v := by
  induction v generalizing k with
  | nil => rfl
  | cons i w ih =>
    rcases fin3_eq_zero_or_one_or_two k with hk | hk | hk <;>
      rcases fin2_eq_zero_or_one i with hi | hi
    · simp [bcdFun, hk, hi, swapRoot_apply_apply]
    · simp [bcdFun, hk, hi, ih 1]
    · simp [bcdFun, hk, hi, swapRoot_apply_apply]
    · simp [bcdFun, hk, hi, ih 2]
    · simp [bcdFun, hk, hi]
    · simp [bcdFun, hk, hi, ih 0]

lemma bcdFun_isPrefix (k : Fin 3) (v w : InfiniteBinaryTree) :
    v <+: w ↔ bcdFun k v <+: bcdFun k w := by
  induction v generalizing w k with
  | nil => simp [List.nil_prefix]
  | cons i a ih =>
    cases w with
    | nil =>
      rcases fin3_eq_zero_or_one_or_two k with hk | hk | hk <;> simp [bcdFun, hk]
    | cons j b =>
      rcases fin3_eq_zero_or_one_or_two k with hk | hk | hk <;>
        rcases fin2_eq_zero_or_one i with hi | hi <;>
          rcases fin2_eq_zero_or_one j with hj | hj
      · simpa [bcdFun, hk, hi, hj, List.cons_prefix_cons] using swapRoot.map_isPrefix a b
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons, ih 1]
      · simpa [bcdFun, hk, hi, hj, List.cons_prefix_cons] using swapRoot.map_isPrefix a b
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons, ih 2]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons]
      · simp [bcdFun, hk, hi, hj, List.cons_prefix_cons, ih 0]

/-- The generator among `b`, `c`, `d` with the given index. -/
def bcd (k : Fin 3) : TreeAut where
  toEquiv :=
    { toFun := bcdFun k
      invFun := bcdFun k
      left_inv := bcdFun_involutive k
      right_inv := bcdFun_involutive k }
  map_isPrefix := bcdFun_isPrefix k

/-- The generator `a`: swap the two children of the root. -/
def a : TreeAut := swapRoot

/-- The generator `b`, satisfying `b = phi a c`. -/
def b : TreeAut := bcd 0

/-- The generator `c`, satisfying `c = phi a d`. -/
def c : TreeAut := bcd 1

/-- The generator `d`, satisfying `d = phi 1 b`. -/
def d : TreeAut := bcd 2

@[simp] lemma a_eq_swapRoot : a = swapRoot := rfl

@[simp] lemma a_root : a root = root := swapRoot_root

@[simp] lemma a_cons (i : Fin 2) (w : InfiniteBinaryTree) : a (i :: w) = (i + 1) :: w :=
  swapRoot_cons i w

@[simp] lemma b_root : b root = root := rfl

@[simp] lemma c_root : c root = root := rfl

@[simp] lemma d_root : d root = root := rfl

@[simp] lemma b_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    b (i :: w) = i :: bif i == 0 then a w else c w := by
  simp [b, c, a, bcd, bcdFun]

@[simp] lemma c_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    c (i :: w) = i :: bif i == 0 then a w else d w := by
  simp [c, d, a, bcd, bcdFun]

@[simp] lemma d_cons (i : Fin 2) (w : InfiniteBinaryTree) :
    d (i :: w) = i :: bif i == 0 then w else b w := by
  simp [b, d, bcd, bcdFun]

lemma b_eq_phi : b = phi a c :=
  TreeAut.ext fun v ↦ by
    cases v with
    | nil => rfl
    | cons i w =>
      rcases fin2_eq_zero_or_one i with hi | hi <;> simp [hi, phi_cons]

lemma c_eq_phi : c = phi a d :=
  TreeAut.ext fun v ↦ by
    cases v with
    | nil => rfl
    | cons i w =>
      rcases fin2_eq_zero_or_one i with hi | hi <;> simp [hi, phi_cons]

lemma d_eq_phi : d = phi (1 : TreeAut) b :=
  TreeAut.ext fun v ↦ by
    cases v with
    | nil => rfl
    | cons i w =>
      rcases fin2_eq_zero_or_one i with hi | hi <;> simp [hi, phi_cons]

@[simp] lemma a_mul_self : a * a = 1 := swapRoot_mul_self

@[simp] lemma b_mul_self : b * b = 1 :=
  TreeAut.ext fun v ↦ by
    simp only [mul_apply, one_apply, b, bcd]
    exact bcdFun_involutive 0 v

@[simp] lemma c_mul_self : c * c = 1 :=
  TreeAut.ext fun v ↦ by
    simp only [mul_apply, one_apply, c, bcd]
    exact bcdFun_involutive 1 v

@[simp] lemma d_mul_self : d * d = 1 :=
  TreeAut.ext fun v ↦ by
    simp only [mul_apply, one_apply, d, bcd]
    exact bcdFun_involutive 2 v

lemma a_inv : a⁻¹ = a := inv_eq_of_mul_eq_one_right a_mul_self

lemma b_inv : b⁻¹ = b := inv_eq_of_mul_eq_one_right b_mul_self

lemma c_inv : c⁻¹ = c := inv_eq_of_mul_eq_one_right c_mul_self

lemma d_inv : d⁻¹ = d := inv_eq_of_mul_eq_one_right d_mul_self

/-- The identities `bc = d`, `cd = b` and `db = c` hold pointwise. -/
lemma bc_cd_db_apply (v : InfiniteBinaryTree) :
    (b * c) v = d v ∧ (c * d) v = b v ∧ (d * b) v = c v := by
  induction v with
  | nil => exact ⟨rfl, rfl, rfl⟩
  | cons i w ih =>
    obtain ⟨ihbc, ihcd, ihdb⟩ := ih
    rcases fin2_eq_zero_or_one i with hi | hi
    · simp [hi, mul_apply, swapRoot_apply_apply]
    · refine ⟨?_, ?_, ?_⟩
      · simpa [hi, mul_apply] using ihcd
      · simpa [hi, mul_apply] using ihdb
      · simpa [hi, mul_apply] using ihbc

lemma bc_eq_d : b * c = d :=
  TreeAut.ext fun v ↦ (bc_cd_db_apply v).1

lemma cd_eq_b : c * d = b :=
  TreeAut.ext fun v ↦ (bc_cd_db_apply v).2.1

lemma db_eq_c : d * b = c :=
  TreeAut.ext fun v ↦ (bc_cd_db_apply v).2.2

@[simp] lemma bcd_eq_one : b * c * d = 1 := by
  rw [mul_assoc, cd_eq_b, b_mul_self]

lemma a_mul_phi_mul_a (f₀ f₁ : TreeAut) : a * phi f₀ f₁ * a = phi f₁ f₀ :=
  swapRoot_mul_phi_mul_swapRoot f₀ f₁

lemma phi_pow (f₀ f₁ : TreeAut) (n : ℕ) : phi f₀ f₁ ^ n = phi (f₀ ^ n) (f₁ ^ n) := by
  induction n with
  | zero => simp [phi_one]
  | succ n ih =>
    rw [pow_succ, pow_succ, pow_succ, ih, phi_mul]

lemma conj_a_pow (x : TreeAut) (n : ℕ) : (a * x * a) ^ n = a * x ^ n * a := by
  induction n with
  | zero => simp
  | succ n ih =>
    have haa : a * a = 1 := a_mul_self
    calc
      (a * x * a) ^ (n + 1) = (a * x ^ n * a) * (a * x * a) := by rw [pow_succ, ih]
      _ = a * (x ^ n * (a * a * (x * a))) := by simp only [mul_assoc]
      _ = a * (x ^ n * (1 * (x * a))) := by rw [haa]
      _ = a * (x ^ n * (x * a)) := by rw [one_mul]
      _ = a * x ^ (n + 1) * a := by
        rw [← mul_assoc (x ^ n), ← pow_succ]
        simp only [mul_assoc]

lemma ad_pow_two : (a * d) ^ 2 = phi b b := by
  calc
    (a * d) ^ 2 = a * d * a * d := pow_two _
    _ = a * phi (1 : TreeAut) b * a * phi (1 : TreeAut) b := by rw [d_eq_phi]
    _ = (a * phi (1 : TreeAut) b * a) * phi (1 : TreeAut) b := by simp [mul_assoc]
    _ = phi b 1 * phi (1 : TreeAut) b := by rw [a_mul_phi_mul_a]
    _ = phi (b * 1) (1 * b) := (phi_mul ..).symm
    _ = phi b b := by simp

lemma ad_pow_four : (a * d) ^ 4 = 1 := by
  have h : (a * d) ^ 4 = ((a * d) ^ 2) ^ 2 := by rw [← pow_mul]
  rw [h, ad_pow_two, pow_two, ← phi_mul, b_mul_self, phi_one]

lemma da_eq_conj_ad : d * a = a * (a * d) * a := by
  simp [← mul_assoc]

lemma da_pow_four : (d * a) ^ 4 = 1 := by
  rw [da_eq_conj_ad, conj_a_pow, ad_pow_four]
  simp

lemma ac_pow_two : (a * c) ^ 2 = phi (d * a) (a * d) := by
  calc
    (a * c) ^ 2 = a * c * a * c := pow_two _
    _ = a * phi a d * a * phi a d := by rw [c_eq_phi]
    _ = (a * phi a d * a) * phi a d := by simp [mul_assoc]
    _ = phi d a * phi a d := by rw [a_mul_phi_mul_a]
    _ = phi (d * a) (a * d) := (phi_mul ..).symm

lemma ac_pow_eight : (a * c) ^ 8 = 1 := by
  have h : (a * c) ^ 8 = ((a * c) ^ 2) ^ 4 := by rw [← pow_mul]
  rw [h, ac_pow_two, phi_pow, da_pow_four, ad_pow_four, phi_one]

lemma ca_eq_conj_ac : c * a = a * (a * c) * a := by
  simp [← mul_assoc]

lemma ca_pow_eight : (c * a) ^ 8 = 1 := by
  rw [ca_eq_conj_ac, conj_a_pow, ac_pow_eight]
  simp

lemma ab_pow_two : (a * b) ^ 2 = phi (c * a) (a * c) := by
  calc
    (a * b) ^ 2 = a * b * a * b := pow_two _
    _ = a * phi a c * a * phi a c := by rw [b_eq_phi]
    _ = (a * phi a c * a) * phi a c := by simp [mul_assoc]
    _ = phi c a * phi a c := by rw [a_mul_phi_mul_a]
    _ = phi (c * a) (a * c) := (phi_mul ..).symm

lemma ab_pow_sixteen : (a * b) ^ 16 = 1 := by
  have h : (a * b) ^ 16 = ((a * b) ^ 2) ^ 8 := by rw [← pow_mul]
  rw [h, ab_pow_two, phi_pow, ca_pow_eight, ac_pow_eight, phi_one]

/-- The standard generating set of the Grigorchuk group. -/
def generators : Set TreeAut := {a, b, c, d}

/-- The Grigorchuk group, as a subgroup of `TreeAut`. -/
def G : Subgroup TreeAut := .closure generators

@[simp] lemma a_mem_G : a ∈ G := Subgroup.subset_closure (by simp [generators])

@[simp] lemma b_mem_G : b ∈ G := Subgroup.subset_closure (by simp [generators])

@[simp] lemma c_mem_G : c ∈ G := Subgroup.subset_closure (by simp [generators])

@[simp] lemma d_mem_G : d ∈ G := Subgroup.subset_closure (by simp [generators])

/-- Automorphisms that fix every vertex of length `n`. -/
def stabilizerLevel (n : ℕ) : Subgroup TreeAut where
  carrier := {f | ∀ v : InfiniteBinaryTree, v.length = n → f v = v}
  one_mem' := by simp
  mul_mem' := by
    intro f g hf hg v hv
    simp [mul_apply, hg v hv, hf v hv]
  inv_mem' := by
    intro f hf v hv
    have hlen : (f⁻¹ v).length = n := by
      simpa [inv_eq_symm] using f.symm.map_length v ▸ hv
    have hfix := hf (f⁻¹ v) hlen
    have : f (f⁻¹ v) = v := by
      simp [inv_eq_symm, Equiv.apply_symm_apply]
    rw [this] at hfix
    exact hfix.symm

@[simp] lemma mem_stabilizerLevel {n : ℕ} {f : TreeAut} :
    f ∈ stabilizerLevel n ↔ ∀ v : InfiniteBinaryTree, v.length = n → f v = v :=
  Iff.rfl

lemma a_notMem_stabilizerLevel_one : a ∉ stabilizerLevel 1 := by
  intro h
  have := h [0] (by simp)
  simp at this

lemma b_mem_stabilizerLevel_one : b ∈ stabilizerLevel 1 := by
  intro v hv
  obtain ⟨i, rfl⟩ := List.length_eq_one_iff.mp hv
  rcases fin2_eq_zero_or_one i with hi | hi
  · simpa [hi] using map_root a
  · simpa [hi] using map_root c

lemma c_mem_stabilizerLevel_one : c ∈ stabilizerLevel 1 := by
  intro v hv
  obtain ⟨i, rfl⟩ := List.length_eq_one_iff.mp hv
  rcases fin2_eq_zero_or_one i with hi | hi
  · simpa [hi] using map_root a
  · simpa [hi] using map_root d

lemma d_mem_stabilizerLevel_one : d ∈ stabilizerLevel 1 := by
  intro v hv
  obtain ⟨i, rfl⟩ := List.length_eq_one_iff.mp hv
  rcases fin2_eq_zero_or_one i with hi | hi
  · simp [hi]
  · simpa [hi] using map_root b

/-- The stabilizer of level `n` in the Grigorchuk group. -/
def st (n : ℕ) : Subgroup G := (stabilizerLevel n).subgroupOf G

lemma b_mem_st_one : (⟨b, b_mem_G⟩ : G) ∈ st 1 :=
  b_mem_stabilizerLevel_one

lemma c_mem_st_one : (⟨c, c_mem_G⟩ : G) ∈ st 1 :=
  c_mem_stabilizerLevel_one

lemma d_mem_st_one : (⟨d, d_mem_G⟩ : G) ∈ st 1 :=
  d_mem_stabilizerLevel_one

lemma a_notMem_st_one : (⟨a, a_mem_G⟩ : G) ∉ st 1 :=
  a_notMem_stabilizerLevel_one

open Multiplicative

lemma activity_nil (f : TreeAut) : activity f [] = activity f root := rfl

lemma activity_one : activity (1 : TreeAut) [] = 0 := by
  have h : (1 : TreeAut) [0] = [0] := rfl
  have hs := apply_singleton (1 : TreeAut) 0
  rw [firstLetter_zero, ← activity_nil] at hs
  exact (List.cons_eq_cons.mp (hs.symm.trans h)).1

lemma activity_mul (f g : TreeAut) :
    activity (f * g) [] = activity f [] + activity g [] := by
  have hfg : (f * g) [0] = [activity (f * g) []] := by
    simpa [firstLetter_zero, activity_nil] using apply_singleton (f * g) 0
  have h : (f * g) [0] = [activity g [] + activity f []] := by
    simp only [mul_apply]
    rw [apply_singleton, firstLetter_zero, activity_nil, apply_singleton,
      firstLetter_eq_add_activity, activity_nil]
  have := (List.cons_eq_cons.mp (hfg.symm.trans h)).1
  rw [this, add_comm]

lemma activity_a : activity a [] = 1 := by
  have h : a [0] = [1] := by simp
  have hs := apply_singleton a 0
  rw [firstLetter_zero, ← activity_nil] at hs
  exact (List.cons_eq_cons.mp (hs.symm.trans h)).1

/-- The activity at the root is a homomorphism `TreeAut → ℤ/2`. -/
noncomputable def activityRootHom : TreeAut →* Multiplicative (ZMod 2) where
  toFun f := ofAdd (if activity f [] = 0 then (0 : ZMod 2) else 1)
  map_one' := by
    change ofAdd (if activity (1 : TreeAut) [] = 0 then (0 : ZMod 2) else 1) = 1
    rw [activity_one]
    rfl
  map_mul' f g := by
    rcases fin2_eq_zero_or_one (activity f []) with hf | hf <;>
      rcases fin2_eq_zero_or_one (activity g []) with hg | hg
    · rw [activity_mul, hf, hg]; rfl
    · rw [activity_mul, hf, hg]; rfl
    · rw [activity_mul, hf, hg]; rfl
    · have : (1 + 1 : Fin 2) = 0 := rfl
      rw [activity_mul, hf, hg, this]; rfl

lemma activityRootHom_eq_one {f : TreeAut} :
    activityRootHom f = 1 ↔ activity f [] = 0 := by
  change ofAdd (if activity f [] = 0 then (0 : ZMod 2) else 1) = 1 ↔ activity f [] = 0
  rcases fin2_eq_zero_or_one (activity f []) with h | h <;> simp [h]

lemma activity_eq_zero_iff_mem_stabilizerLevel_one {f : TreeAut} :
    activity f [] = 0 ↔ f ∈ stabilizerLevel 1 := by
  constructor
  · intro hf v hv
    obtain ⟨i, rfl⟩ := List.length_eq_one_iff.mp hv
    rw [apply_singleton, firstLetter_eq_add_activity, ← activity_nil, hf, add_zero]
  · intro hf
    have h := hf [0] (by simp)
    have hs := apply_singleton f 0
    rw [firstLetter_zero, ← activity_nil] at hs
    exact (List.cons_eq_cons.mp (hs.symm.trans h)).1

lemma activityRootHom_ker : activityRootHom.ker = stabilizerLevel 1 := by
  ext f
  simp only [MonoidHom.mem_ker, activityRootHom_eq_one,
    activity_eq_zero_iff_mem_stabilizerLevel_one]

/-- The activity at the root, restricted to the Grigorchuk group. -/
noncomputable def activityHomG : G →* Multiplicative (ZMod 2) :=
  activityRootHom.comp G.subtype

lemma activityHomG_ker : activityHomG.ker = st 1 := by
  ext x
  simp only [activityHomG, MonoidHom.comp_apply, MonoidHom.mem_ker, Subgroup.coe_subtype, st,
    Subgroup.mem_subgroupOf, activityRootHom_eq_one,
    activity_eq_zero_iff_mem_stabilizerLevel_one]

lemma activityHomG_surjective : Function.Surjective activityHomG := by
  intro x
  rcases zmod2_eq_zero_or_one x.toAdd with h | h
  · refine ⟨1, ?_⟩
    have hx : x = 1 := by rw [← ofAdd_toAdd x, h]; rfl
    simp [hx]
  · refine ⟨⟨a, a_mem_G⟩, ?_⟩
    have hx : x = ofAdd 1 := by rw [← ofAdd_toAdd x, h]
    change ofAdd (if activity a [] = 0 then (0 : ZMod 2) else 1) = x
    rw [activity_a, hx]
    rfl

lemma st_one_index : (st 1).index = 2 := by
  rw [← activityHomG_ker, Subgroup.index_ker, MonoidHom.range_eq_top.mpr activityHomG_surjective,
    Subgroup.card_top, Nat.card_congr (Multiplicative.toAdd (α := ZMod 2)),
    Nat.card_eq_fintype_card, ZMod.card]

lemma apply_succ (f : TreeAut) (v : InfiniteBinaryTree) (i : Fin 2) :
    f (v ++ [i]) = f v ++ [i + activity f v] := by
  rcases fin2_eq_zero_or_one i with hi | hi
  · simpa [hi, succ] using apply_succ_zero f v
  · obtain ⟨j, hj⟩ := exists_apply_succ f v 1
    have h0 := apply_succ_zero f v
    have hne : f (v ++ [0]) ≠ f (v ++ [1]) :=
      f.toEquiv.injective.ne (by simp)
    have hjne : j ≠ activity f v := by
      intro h
      apply hne
      simp only [succ] at h0 hj
      rw [h0, hj, h]
    have hjact : j = activity f v + 1 := by
      rcases fin2_eq_zero_or_one j with hj0 | hj1 <;>
        rcases fin2_eq_zero_or_one (activity f v) with ha | ha
      · exact (hjne (hj0.trans ha.symm)).elim
      · simp [hj0, ha]
      · simp [hj1, ha]
      · exact (hjne (hj1.trans ha.symm)).elim
    rw [hi]
    simp only [succ] at hj
    rw [hj, hjact, add_comm]

lemma apply_eq_of_mem_stabilizerLevel {n : ℕ} {f : TreeAut} (hf : f ∈ stabilizerLevel n)
    {v : InfiniteBinaryTree} (hv : v.length ≤ n) : f v = v := by
  let w := v ++ List.replicate (n - v.length) 0
  have hwlen : w.length = n := by simp [w]; omega
  have hfw : f w = w := hf w hwlen
  have hpref : f v <+: w := by
    have : v <+: w := List.prefix_append _ _
    simpa [hfw] using (f.map_isPrefix_iff).mp this
  have : f v = w.take v.length := by
    simpa [f.map_length] using (List.prefix_iff_eq_take.mp hpref)
  have htake : w.take v.length = v := by
    simp [w]
  rw [this, htake]

lemma apply_eq_of_activity_eq {f g : TreeAut} :
    ∀ {n : ℕ} {v : InfiniteBinaryTree},
      (∀ u : InfiniteBinaryTree, u.length < n → activity f u = activity g u) →
        v.length = n → f v = g v := by
  intro n v
  induction v using List.reverseRecOn generalizing n with
  | nil =>
    intro _ hv
    cases n with
    | zero => exact (map_root f).trans (map_root g).symm
    | succ _ => simp at hv
  | append_singleton w i ih =>
    intro hact hv
    cases n with
    | zero => simp at hv
    | succ n =>
      have hw : w.length = n := by simpa using hv
      have hfg : f w = g w := ih (fun u hu => hact u (Nat.lt_succ_of_lt hu)) hw
      have hwact : activity f w = activity g w := hact w (by simp [hw])
      rw [apply_succ, apply_succ, hfg, hwact]

/-- Words of length `n` are functions `Fin n → Fin 2`. -/
def wordsLengthEquiv (n : ℕ) :
    {v : InfiniteBinaryTree // v.length = n} ≃ (Fin n → Fin 2) where
  toFun v i := v.val[i.val]'(by omega)
  invFun f := ⟨List.ofFn f, List.length_ofFn⟩
  left_inv := fun ⟨v, hv⟩ => Subtype.ext <| by
    apply List.ext_getElem
    · simp [hv]
    · intro i _ _
      simp [List.getElem_ofFn]
  right_inv := fun f => funext fun i => by
    simp [List.getElem_ofFn]

/-- A word of length less than `n + 1` has length less than `n`, or length exactly `n`. -/
def wordsBelowSuccEquiv (n : ℕ) :
    {v : InfiniteBinaryTree // v.length < n + 1} ≃
      {v : InfiniteBinaryTree // v.length < n} ⊕ {v : InfiniteBinaryTree // v.length = n} where
  toFun v :=
    if h : v.val.length < n then .inl ⟨v.val, h⟩
    else .inr ⟨v.val, le_antisymm (Nat.le_of_lt_succ v.property) (le_of_not_gt h)⟩
  invFun
    | .inl v => ⟨v.val, Nat.lt_succ_of_lt v.property⟩
    | .inr v => ⟨v.val, Nat.lt_succ_of_le v.property.le⟩
  left_inv := fun ⟨v, hv⟩ => by
    by_cases h : v.length < n <;> simp [h]
  right_inv
    | .inl ⟨v, hv⟩ => by simp [hv]
    | .inr ⟨v, hv⟩ => by simp [hv]

instance instIsEmptyWordsBelowZero : IsEmpty {v : InfiniteBinaryTree // v.length < 0} :=
  ⟨fun ⟨_, h⟩ => (Nat.not_lt_zero _ h).elim⟩

instance instFintypeWordsLength (n : ℕ) : Fintype {v : InfiniteBinaryTree // v.length = n} :=
  Fintype.ofEquiv _ (wordsLengthEquiv n).symm

instance instFintypeWordsBelow : (n : ℕ) → Fintype {v : InfiniteBinaryTree // v.length < n}
  | 0 => Fintype.ofIsEmpty
  | n + 1 =>
    have := instFintypeWordsBelow n
    Fintype.ofEquiv _ (wordsBelowSuccEquiv n).symm

lemma card_wordsLength (n : ℕ) :
    Nat.card {v : InfiniteBinaryTree // v.length = n} = 2 ^ n := by
  rw [Nat.card_congr (wordsLengthEquiv n), Nat.card_fun, Nat.card_eq_fintype_card, Fintype.card_fin,
    Nat.card_eq_fintype_card, Fintype.card_fin]

lemma card_wordsBelow :
    ∀ n, Nat.card {v : InfiniteBinaryTree // v.length < n} = 2 ^ n - 1
  | 0 => by
    rw [Nat.card_of_isEmpty]
    rfl
  | n + 1 => by
    rw [Nat.card_congr (wordsBelowSuccEquiv n), Nat.card_sum, card_wordsBelow n, card_wordsLength n]
    have : 1 ≤ 2 ^ n := Nat.one_le_two_pow
    omega

/-- The tuple of activities of `f` at all vertices of length less than `n`. -/
noncomputable def activityBelow (n : ℕ) (f : TreeAut) :
    {v : InfiniteBinaryTree // v.length < n} → Fin 2 :=
  fun v => activity f v.val

lemma activityBelow_eq_of_mul_mem {n : ℕ} {f g : TreeAut}
    (h : f⁻¹ * g ∈ stabilizerLevel n) : activityBelow n f = activityBelow n g := by
  funext ⟨v, hv⟩
  have hfix : (f⁻¹ * g) (v ++ [0]) = v ++ [0] :=
    apply_eq_of_mem_stabilizerLevel h (by simp; omega)
  have hfg : f (v ++ [0]) = g (v ++ [0]) := by
    rw [mul_apply, inv_eq_symm, symm_apply] at hfix
    exact ((Equiv.symm_apply_eq f.toEquiv).mp hfix).symm
  have hfeq : f v ++ [activity f v] = g v ++ [activity g v] := by
    simpa [apply_succ, zero_add] using hfg
  exact (List.cons_eq_cons.mp (List.append_inj hfeq (by simp)).2).1

lemma mul_mem_stabilizerLevel_of_activityBelow_eq {n : ℕ} {f g : TreeAut}
    (h : activityBelow n f = activityBelow n g) : f⁻¹ * g ∈ stabilizerLevel n := by
  intro v hv
  have hact : ∀ u : InfiniteBinaryTree, u.length < n → activity f u = activity g u :=
    fun u hu => congr_fun h ⟨u, hu⟩
  have hfg : f v = g v := apply_eq_of_activity_eq hact hv
  rw [mul_apply, inv_eq_symm, symm_apply, ← hfg]
  exact Equiv.symm_apply_apply f.toEquiv v

/-- Activities below level `n` descend to the quotient by `stabilizerLevel n`. -/
noncomputable def activityBelowQuot (n : ℕ) :
    TreeAut ⧸ stabilizerLevel n → ({v : InfiniteBinaryTree // v.length < n} → Fin 2) :=
  Quotient.lift (activityBelow n) fun _ _ hfg =>
    activityBelow_eq_of_mul_mem (QuotientGroup.leftRel_apply.mp hfg)

lemma activityBelowQuot_injective (n : ℕ) : Function.Injective (activityBelowQuot n) := by
  intro x y
  refine Quotient.inductionOn₂ x y fun f g h => ?_
  apply Quotient.sound
  exact QuotientGroup.leftRel_apply.mpr (mul_mem_stabilizerLevel_of_activityBelow_eq h)

instance (n : ℕ) : Finite (TreeAut ⧸ stabilizerLevel n) :=
  Finite.of_injective _ (activityBelowQuot_injective n)

lemma stabilizerLevel_index_le (n : ℕ) :
    (stabilizerLevel n).index ≤ 2 ^ (2 ^ n - 1) := by
  rw [Subgroup.index_eq_card]
  refine (Nat.card_le_card_of_injective (activityBelowQuot n) (activityBelowQuot_injective n)).trans
    ?_
  rw [Nat.card_fun, Nat.card_eq_fintype_card, Fintype.card_fin, card_wordsBelow]

/-- The inclusion of `G`-cosets of `st n` into the cosets of `stabilizerLevel n` in `TreeAut`. -/
def stQuotEmbed (n : ℕ) : G ⧸ st n → TreeAut ⧸ stabilizerLevel n :=
  Quotient.map' (fun g : G => (g : TreeAut)) fun a b hab => by
    rw [QuotientGroup.leftRel_apply] at hab ⊢
    simpa [st, Subgroup.mem_subgroupOf] using hab

lemma stQuotEmbed_injective (n : ℕ) : Function.Injective (stQuotEmbed n) := by
  intro x y
  refine Quotient.inductionOn₂ x y fun a b h => ?_
  rw [QuotientGroup.eq]
  have : (a : TreeAut)⁻¹ * (b : TreeAut) ∈ stabilizerLevel n := by
    rw [← QuotientGroup.eq]
    simpa [stQuotEmbed] using h
  simpa [st, Subgroup.mem_subgroupOf] using this

lemma st_index_le_stabilizerLevel_index (n : ℕ) :
    (st n).index ≤ (stabilizerLevel n).index := by
  rw [Subgroup.index_eq_card, Subgroup.index_eq_card]
  exact Nat.card_le_card_of_injective _ (stQuotEmbed_injective n)

/-- The index of the level-`n` stabilizer in `G` is at most `2^(2^n - 1)`. -/
lemma st_index_le (n : ℕ) : (st n).index ≤ 2 ^ (2 ^ n - 1) :=
  (st_index_le_stabilizerLevel_index n).trans (stabilizerLevel_index_le n)

end Grigorchuk
