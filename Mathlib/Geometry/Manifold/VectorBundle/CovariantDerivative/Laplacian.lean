module

public import Mathlib.Geometry.Manifold.VectorBundle.CovariantDerivative.Hessian
public import Mathlib.Analysis.Normed.Module.Basic
public import Mathlib.Analysis.InnerProductSpace.Defs
public import Mathlib.Topology.VectorBundle.Riemannian
public import Mathlib.Geometry.Manifold.IsManifold.Basic
public import Mathlib.Analysis.InnerProductSpace.Dual
public import Mathlib.LinearAlgebra.Trace
public import Mathlib.Algebra.BigOperators.Group.Finset.Defs


/-!
# Laplacian

We define the connection Laplacian `Δ` on a manifold `M` endowed with metric `g` as the trace of the
covariant Hessian operator `Δ v = tr_g Hess(v) = ∑ i, Hess(v) (g⁻¹ b.coord i) (b i)`

## Main definitions and results

* `CovariantDerivative.laplacian`: a connection Laplacian `Δ` on `(M, g)` defined in
  a basis-independent way

* `CovariantDerivative.laplacian_eq_sum_of_basis`: connection Laplacian expressed as an explicit
  trace of the Hessian operator with the basis vectors

## Implementation notes

To perform the index contraction when taking the trace of the Hessian, we could assume the inner
product on the tangent space at every point `x : M`. However, we don't use any of the properties of
the inner product space, so instead, here we only assume the existence of the inverse metric at
each point `x`: `g_inv x : (TangentSpace I x →ₗ[𝕜] 𝕜) →ₗ[𝕜] TangentSpace I x)`. This allows us to
generalize the definition of the Laplacian to pseudo-Riemannian manifolds.

If this inverse metric is required to be consistent with the inner product structure on the tangent
space, such as generated by
```lean
variable [RiemannianBundle (TangentSpace I : M → _)]
```
this can be phrased as
```lean
abbrev g_inv (x : M) : (TangentSpace I x →ₗ[ℝ] ℝ) →ₗ[ℝ] TangentSpace I x :=
  (LinearMap.toContinuousLinearMap.trans
    (InnerProductSpace.toDual ℝ (TangentSpace I x)).symm.toLinearEquiv).toLinearMap
```

-/

open Bundle Finset Module

public noncomputable section

namespace CovariantDerivative

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜]

-- Base manifold
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E] [FiniteDimensional 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I 1 M] [ContMDiffVectorBundle 1 E (TangentSpace I : M → _) I]

-- Fiber bundle
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {V : M → Type*} [TopologicalSpace (TotalSpace F V)]
  [∀ x, AddCommGroup (V x)] [∀ x, Module 𝕜 (V x)]
  [∀ x : M, TopologicalSpace (V x)]
  [∀ x, IsTopologicalAddGroup (V x)] [∀ x, ContinuousSMul 𝕜 (V x)]
  [FiberBundle F V] [VectorBundle 𝕜 F V]

-- Covariant derivatives and the tangent bundle and on the fiber bundle V
variable (covTM : CovariantDerivative I E (TangentSpace I : M → _))
  (cov : CovariantDerivative I F V)

variable (g_inv : (x : M) → (TangentSpace I x →ₗ[𝕜] 𝕜) →ₗ[𝕜] TangentSpace I x)

-- Section of the bundle V
variable (v : (x : M) → V x)

def laplacian (x : M) : V x :=
  TensorProduct.lift ((covTM.hessian cov v x).toLinearMap₁₂ ∘ₗ g_inv x)
    ((dualTensorHomEquiv 𝕜 _ _).symm LinearMap.id)

variable {ι : Type*} [Fintype ι]

open scoped Classical in
theorem laplacian_eq_sum_of_basis (x : M) (b : Basis ι 𝕜 (TangentSpace I x)) :
    (laplacian covTM cov g_inv v x)
      = ∑ i, (covTM.hessian cov v x ((g_inv x) (b.coord i)) (b i)) := by
  unfold laplacian
  rw [dualTensorHomEquiv_eq_dualTensorHomEquivOfBasis b]
  simp [dualTensorHomEquivOfBasis]

end CovariantDerivative
